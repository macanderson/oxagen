{
  "projectId": "f3a06086-f960-4be5-a06c-e5cdd416ade7",
  "shape": "storybook",
  "pkg": "@oxagen/ui",
  "globalName": "OxagenUI",
  "entry": "packages/ui/src/index.ts",
  "storybookStatic": ".design-sync/sb-reference",
  "storybookConfigDir": "packages/ui/.storybook",
  "titleMap": {
    "Marks": "OxagenWordmark",
    "Toast": "ToastProvider"
  },
  "provider": {
    "component": "ThemeProvider",
    "props": {
      "initialTheme": "light",
      "defaultTheme": "light",
      "disableTransitionOnChange": true
    }
  },
  "guidelinesGlob": ["THEME.md"],
  "readmeHeader": ".design-sync/conventions.md",
  "tokenKinds": ".design-sync/token-kinds.json",
  "overrides": {
    "Dialog": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Select": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Menu": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Popover": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Tooltip": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "ToastProvider": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Sheet": {
      "cardMode": "single",
      "primaryStory": "Right Open"
    }
  },
  "extraFonts": ["../../.design-sync/fonts-dejavu.css"]
}
