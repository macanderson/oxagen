{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `build` runs `tsc --noEmit` (type-check) then `node build-node.mjs`,
      // which emits `dist/server.cjs` — the same bundle `build:node` produces
      // and `package-for-node.sh` ships to the EC2 nodes. Building the artifact
      // production actually runs means a bundling failure surfaces in `turbo run
      // build` rather than first in a deploy.
      //
      // It replaced a `node build.mjs` emitting a Vercel Build Output API dir at
      // `.vercel/output`, which nothing consumed once the deploy moved to AWS.
      // Env is the service's runtime contract: the Hono server calls loadEnv()
      // at boot.
      "outputs": ["dist/**"],
      "env": [
        "DATABASE_URL",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USERNAME",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_DATABASE",
        "NEO4J_URI",
        "NEO4J_USERNAME",
        "NEO4J_PASSWORD",
        "NEO4J_DATABASE",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "GOOGLE_LOGIN_CLIENT_ID",
        "GOOGLE_LOGIN_CLIENT_SECRET",
        "GOOGLE_DATA_CLIENT_ID",
        "GOOGLE_DATA_CLIENT_SECRET",
        "GITHUB_LOGIN_CLIENT_ID",
        "GITHUB_LOGIN_CLIENT_SECRET",
        "AUTH_TOKEN_ENCRYPTION_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "OXAGEN_TARGET_MARGIN",
        "OXAGEN_METER_MARKUP",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "AI_GATEWAY_API_KEY",
        "OXAGEN_LLM_FAST",
        "OXAGEN_LLM_BALANCED",
        "OXAGEN_LLM_PRECISE",
        "IAM_ENFORCEMENT_ENABLED",
        "STRIPE_TAX_ENABLED",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL"
      ]
    }
  }
}
