{
  "name": "@oxagen/api",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "start": "tsx --env-file=.env.local src/index.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.json --noEmit && node build-node.mjs",
    "build:node": "node build-node.mjs",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint src --max-warnings 0",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "cms:crm-backfill": "tsx --env-file-if-exists=.env.local src/scripts/cms-crm-backfill.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@oxagen/agent": "workspace:*",
    "@oxagen/ai": "workspace:*",
    "@oxagen/auth": "workspace:*",
    "@oxagen/billing": "workspace:*",
    "@oxagen/config": "workspace:*",
    "@oxagen/crypto": "workspace:*",
    "@oxagen/database": "workspace:*",
    "@oxagen/done-record": "workspace:*",
    "@oxagen/github": "workspace:*",
    "@oxagen/handlers": "workspace:*",
    "@oxagen/iam": "workspace:*",
    "@oxagen/ingestion": "workspace:*",
    "@oxagen/inngest-functions": "workspace:*",
    "@oxagen/notifications": "workspace:*",
    "@oxagen/oxagen": "workspace:*",
    "@oxagen/plugins": "workspace:*",
    "@oxagen/rules": "workspace:*",
    "@oxagen/run-ledger": "workspace:*",
    "@oxagen/storage": "workspace:*",
    "@oxagen/telemetry": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "ai": "7.0.111",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "inngest": "3.54.2",
    "pino": "10.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@oxagen/recorder": "workspace:*",
    "@vitest/coverage-v8": "3.2.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "vitest": "3.2.6"
  }
}
