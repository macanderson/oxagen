{
  "name": "@oxagen/api",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "start": "tsx --env-file=.env.local src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "1.19.14",
    "@oxagen/agent": "workspace:*",
    "@oxagen/agent-engine": "workspace:*",
    "@oxagen/ai": "workspace:*",
    "@oxagen/auth": "workspace:*",
    "@oxagen/billing": "workspace:*",
    "@oxagen/config": "workspace:*",
    "@oxagen/crypto": "workspace:*",
    "@oxagen/database": "workspace:*",
    "@oxagen/handlers": "workspace:*",
    "@oxagen/iam": "workspace:*",
    "@oxagen/ingestion": "workspace:*",
    "@oxagen/inngest-functions": "workspace:*",
    "@oxagen/notifications": "workspace:*",
    "@oxagen/oxagen": "workspace:*",
    "@oxagen/plugins": "workspace:*",
    "@oxagen/telemetry": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "ai": "7.0.14",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.23",
    "inngest": "3.54.2",
    "pino": "9.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "0.28.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
