{
  "name": "@oxagen/schemas",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "Static hosting for Oxagen JSON Schemas (schemas.oxagen.sh) so editors get $schema autocompletion for Oxagen configuration files.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
