{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".vercel/output/**", ".xmcp/**", "dist/**"],
      "env": [
        "MCP_PORT",
        "DATABASE_URL",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USERNAME",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_DATABASE",
        "NEO4J_URI",
        "NEO4J_USERNAME",
        "NEO4J_PASSWORD",
        "NEO4J_DATABASE",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "GOOGLE_LOGIN_CLIENT_ID",
        "GOOGLE_LOGIN_CLIENT_SECRET",
        "GOOGLE_DATA_CLIENT_ID",
        "GOOGLE_DATA_CLIENT_SECRET",
        "GITHUB_LOGIN_CLIENT_ID",
        "GITHUB_LOGIN_CLIENT_SECRET",
        "GITHUB_DATA_CLIENT_ID",
        "GITHUB_DATA_CLIENT_SECRET",
        "AUTH_TOKEN_ENCRYPTION_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "OXAGEN_TARGET_MARGIN",
        "OXAGEN_METER_MARKUP",
        "AI_GATEWAY_API_KEY",
        "OXAGEN_LLM_FAST",
        "OXAGEN_LLM_BALANCED",
        "OXAGEN_LLM_PRECISE",
        "SANDBOX_ENABLED",
        "SANDBOX_DRIVER",
        "MODAL_RUNNER_URL",
        "MODAL_RUNNER_TOKEN",
        "VERCEL_SANDBOX_TOKEN",
        "VERCEL_SANDBOX_TEAM_ID",
        "VERCEL_SANDBOX_PROJECT_ID",
        "IAM_ENFORCEMENT_ENABLED",
        "STRIPE_TAX_ENABLED",
        "TENANT_RLS_ENFORCEMENT_ENABLED",
        "BLOB_READ_WRITE_TOKEN",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "VERCEL"
      ],
      "passThroughEnv": ["VERCEL_URL"]
    }
  }
}
