{
  "extends": ["//"],
  "tasks": {
    // fumadocs-mdx generates `.source/` (gitignored) from `content/` +
    // `source.config.ts`. `src/lib/source.ts` imports `@/.source/server`, so
    // anything that reads types (typecheck, build) must run after this task —
    // otherwise a clean checkout cannot typecheck.
    "gen:source": {
      "inputs": ["content/**", "source.config.ts", "package.json"],
      "outputs": [".source/**"]
    },
    // `.source/**` is not an input (#4918). It is generated and gitignored, and
    // on CI it hashed differently on every run: four main runs on 2026-10-01
    // gave this task four hashes while gen:source kept one, so it never hit the
    // cache. The gen:source edge carries the same information. Its hash covers
    // `content/**`, `source.config.ts`, and the fumadocs-mdx version, and turbo
    // folds it into this task's hash.
    "typecheck": {
      "dependsOn": ["^build", "gen:source"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "gen:source"],
      "outputs": [".next/**", "!.next/cache/**"],
      // Fumadocs static documentation site — depends only on @oxagen/ui and the
      // local MDX source, and never calls loadEnv() or any backend. No secret
      // env affects the bundle, so a key rotation must NOT invalidate this build.
      "env": ["NEXT_PUBLIC_APP_URL"],
      "passThroughEnv": ["VERCEL", "VERCEL_URL"]
    }
  }
}
