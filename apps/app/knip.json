{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,template,default,error,loading,not-found,forbidden,unauthorized}.{ts,tsx}!",
    "src/app/global-{error,not-found}.{ts,tsx}!",
    "src/proxy.ts!",
    "instrumentation.ts!",
    "next.config.ts!",
    "src/i18n/request.ts!"
  ],
  "project": ["src/**/*.{ts,tsx}!"],
  "playwright": false,
  "ignore": [
    "src/test/**",
    "src/**/*.builders.ts",
    "src/server/viewer.testing.ts",
    "src/**/*.type-test.ts",
    "src/data/unrecorded.ts",
    "src/ui/not-recorded.tsx"
  ],
  "preprocessor": "./knip.preprocessor.ts",
  "ignoreIssues": {
    "src/features/run/replay-actions.tsx": ["files"]
  },
  "tags": ["-deregistered", "-internal"]
}
