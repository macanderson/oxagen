    "entry": "the concrete UI affordance that invokes the capability (form submit, button, toggle) — human-readable",
    "testid": "optional data-testid on the entry-point element, for e2e assertion",
    "proof": "path to the runtime proof: verifications/<session>/<name>.png OR an apps/app/e2e/<slug>.spec.ts",
    "verifiedAt": "YYYY-MM-DD the proof was captured against a working page",
    "verifiedBy": "session id / agent that captured the proof"
  },
