{
  "name": "@oxagen/app",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000 & storybook dev -p 6007 --no-open & wait",
    "kill": "lsof -ti tcp:3000,6007 | xargs kill -9 2>/dev/null; true",
    "build": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=5120 next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean:cache": "rm -rf .next/dev/cache",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build"
  },
