{
  "name": "@oxagen/cli",
  "version": "2.1.1",
  "description": "Oxagen CLI — agentic coding powered by Oxagen's knowledge-graph context engine",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "oxagen": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "oxagen",
    "cli",
    "agentic",
    "coding",
    "ai",
    "agent",
    "context-engine"
  ],
  "homepage": "https://github.com/oxagen/oxagen-monorepo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxagen/oxagen-monorepo.git",
    "directory": "apps/cli"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "start": "tsx src/index.tsx",
    "build": "tsc && node scripts/copy-runtime-assets.mjs",
    "bundle": "node scripts/bundle.mjs",
    "prepublish:standalone": "node scripts/prepare-standalone-publish.mjs",
    "publish:standalone": "pnpm run bundle && pnpm run prepublish:standalone",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.7",
    "@ai-sdk/gateway": "4.0.11",
    "@ai-sdk/openai-compatible": "3.0.5",
    "@ai-sdk/provider": "4.0.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@oxagen/agent-engine": "workspace:*",
    "@oxagen/ai": "workspace:*",
    "@oxagen/agent-artifacts": "workspace:*",
    "@oxagen/billing": "workspace:*",
    "@oxagen/code-graph": "workspace:*",
    "@oxagen/engram": "workspace:*",
    "@oxagen/mcp-config": "workspace:*",
    "@oxagen/replay": "workspace:*",
    "ai": "7.0.14",
    "cli-highlight": "2.1.11",
    "commander": "12.1.0",
    "ink": "7.1.0",
    "marked": "15.0.12",
    "marked-terminal": "7.3.0",
    "react": "19.2.6",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "fastembed": "2.1.0",
    "node-llama-cpp": "3.19.0"
  },
  "devDependencies": {
    "@oxagen/telemetry": "workspace:*",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "0.28.0",
    "ink-testing-library": "4.0.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
