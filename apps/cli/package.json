{
  "name": "@oxagen/cli",
  "version": "2.1.3",
  "description": "Oxagen governance CLI — spend, lineage, grounding, credentials, and audit (agentic coding lives in the stella CLI)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "oxagen": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "oxagen",
    "cli",
    "ai",
    "agent",
    "governance",
    "metering",
    "knowledge-graph"
  ],
  "homepage": "https://github.com/macanderson/oxagen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macanderson/oxagen.git",
    "directory": "apps/cli"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "prepublish:standalone": "node scripts/prepare-standalone-publish.mjs",
    "publish:standalone": "pnpm run bundle && pnpm run prepublish:standalone",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "compile": "pnpm run bundle && node ../../tools/sea/compile.mjs --entry dist-standalone/sea/oxagen.cjs --name oxagen --out dist-bin --asset cedar_wasm_bg.wasm=node_modules/@cedar-policy/cedar-wasm/nodejs/cedar_wasm_bg.wasm"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.13.0",
    "@oxagen/billing": "workspace:*",
    "@oxagen/oxagen": "workspace:*",
    "@oxagen/recorder": "workspace:*",
    "@oxagen/steering-check": "workspace:*",
    "@oxagen/steering-freshness": "workspace:*",
    "commander": "12.1.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@oxagen/telemetry": "workspace:*",
    "@types/node": "25.9.8",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "0.28.2",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
