{
  "name": "@oxagen/cli",
  "version": "0.6.3",
  "description": "Oxagen CLI — agentic coding powered by Oxagen's knowledge-graph context engine",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "oxagen": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "oxagen",
    "cli",
    "agentic",
    "coding",
    "ai",
    "agent",
    "context-engine"
  ],
  "homepage": "https://github.com/oxagen/oxagen-monorepo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxagen/oxagen-monorepo.git",
    "directory": "apps/cli"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "start": "tsx src/index.tsx",
    "build": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "prepublish:standalone": "node scripts/prepare-standalone-publish.mjs",
    "publish:standalone": "pnpm run bundle && pnpm run prepublish:standalone",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@inkjs/ui": "2.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@oxagen/engram": "workspace:*",
    "@oxagen/mcp-config": "workspace:*",
    "ai": "6.0.197",
    "commander": "12.1.0",
    "ink": "7.1.0",
    "react": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "0.28.0",
    "ink-testing-library": "4.0.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
