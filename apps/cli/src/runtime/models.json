      "vendor": "anthropic",
      "contextWindow": 200000,
      "tools": true
    },
    "sonnet-5": {
      "slug": "anthropic/claude-sonnet-5",
      "vendor": "anthropic",
      "contextWindow": 200000,
      "tools": true
    },
    "fable": {
      "slug": "anthropic/claude-fable-5",
      "vendor": "anthropic",
      "contextWindow": 200000,
      "tools": true
    },
    "openai-most-capable-coding-model": {
      "slug": "openai/gpt-5.5-pro",
      "vendor": "openai",
      "contextWindow": 400000,
      "tools": true
    }
  },

  "registry": {
    "coordinatorCandidates": ["on-device", "haiku"],
    "workerModels": {
      "defaultCode": "sonnet-5",
      "cheapBasic": "haiku"
    },
    "judgeModels": {
      "default": "openai-most-capable-coding-model",
      "rule": "Must differ from the worker model for the same task."
    }
  },

  "cliCommands": {
    "models list": "Show registry, capability scores, and which fits this device.",
    "models active": "Show the current coordinator model and its kind (on-device | cloud).",
    "models pull": "Trigger the optional on-device download and cache it.",
    "models status": "Show cache location, size, checksum state, and device fit."
  }
