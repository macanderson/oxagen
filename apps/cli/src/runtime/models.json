{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Model runtime registry for the oxagen CLI (Group 1). Defines the on-device capability table, cloud models, and how the resolver picks the best on-device code model for the current device. The capability table is data, not code: the default on-device model updates as rows are edited, without a code change. codeScore is a curated 0..1 code-benchmark ranking (HumanEval / LiveCodeBench relative). sizeBytes are approximate and advisory (progress + pre-flight only); the SHA-256 manifest is the integrity gate. sha256 left empty = trust-on-first-use: pinned to the cache manifest on first download, then enforced.",

  "config": {
    "runtime": {
      "coordinator": "on-device",
      "onDevice": {
        "autoDownload": true,
        "modelId": "auto",
        "cacheDir": "~/.oxagen/models",
        "verifyChecksum": true,
        "quantizationPreference": ["q8", "q6", "q5", "q4"]
      }
    }
  },

