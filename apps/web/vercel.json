{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/field-manual",
      "destination": "/read?e=field-manual",
      "permanent": false
    },
    {
      "source": "/field-manual/(.*)",
      "destination": "/read?e=field-manual",
      "permanent": false
    },
    {
      "source": "/research/deterministic-systems-optimizations-for-ai-agents",
      "destination": "/read?e=page-flip-reader",
      "permanent": false
    },
    {
      "source": "/research/deterministic-systems-optimizations-for-ai-agents/index.html",
      "destination": "/read?e=page-flip-reader",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
