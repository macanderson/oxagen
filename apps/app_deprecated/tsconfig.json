{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // A Next app emits no declarations; with the base config's `declaration: true`
    // the staged pre-commit typecheck (a narrowed program) hits TS2883 when
    // better-auth's client types resolve the hoisted @types/react 19.3.0 while
    // this app's JSX resolves 19.2.15. Declaration-emit diagnostics are moot here.
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "google.maps", "@testing-library/jest-dom"]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".storybook/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".next", "e2e"]
}
