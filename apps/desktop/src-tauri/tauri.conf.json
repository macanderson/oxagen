{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxagen",
  "version": "../package.json",
  "identifier": "sh.oxagen.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oxagen",
        "width": 600,
        "height": 760,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "\u00a9 Oxagen",
    "shortDescription": "Put this machine's coding-agent sessions under Oxagen control",
    "longDescription": "Installs the oxagen and tacho command-line tools (linked onto PATH automatically), signs the machine in to an Oxagen organization, and wraps Claude Code, Codex, Cursor, and stella, plus any custom agent that reports through `tacho hook`, under the workspace its agents report to.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/tacho", "binaries/oxagen"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      },
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NkZCRUVGMTY4QkY2NUMKUldSYzlvc1c3NzV2RlpQU1dzMk9aZVJKZW16dFpybmdpK1ZiSEZ3am85Zm41clh3bHcrSjRFM1YK",
      "endpoints": [
        "https://github.com/macanderson/oxagen/releases/download/desktop-latest/latest.json"
      ]
    }
  }
}
