#!/usr/bin/env bash
#
# Bootstrap for the Oxagen data node.
#
# Runs once on first boot, and again whenever this file changes — the instance
# is replaced on edit, which is safe because everything durable lives on a
# separate EBS volume that survives the replacement.
#
# Written to be re-runnable rather than assumed-once: it formats the data
# volume only if it has no filesystem, and Compose converges the containers
# rather than recreating them. A bootstrap that destroys data when it runs
# twice is a bootstrap that destroys data.

set -euxo pipefail

exec > >(tee /var/log/oxagen-bootstrap.log) 2>&1

NAME="${name}"
REGION="${region}"

# ---------------------------------------------------------------------------
# Packages
# ---------------------------------------------------------------------------

dnf -y update
dnf -y install docker

# The Compose plugin is not in the AL2023 repositories; install it where Docker
# looks for CLI plugins.
COMPOSE_VERSION=v2.32.4
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL \
  "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-aarch64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Cap every container's logs before the daemon starts, rather than per service
# in the compose file below. There is no /etc/docker/daemon.json on this node
# and json-file has no default limit, so a container logs until the disk is
# gone. Caddy -- which is NOT in the compose below and so a per-service block
# would have missed -- was already at 166 MB when #1305 was investigated.
#
# Logs were not what filled the root volume that day (release directories
# were), and this is the secondary item #1305 keeps rather than the cause. It
# is here because the daemon-wide default is one file and covers containers
# this compose does not define.
#
# 10m x 3 matches what deploy-service.sh already passes per app container, so
# the two halves of the box agree.
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'DAEMONEOF'
{
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "3" }
}
DAEMONEOF

systemctl enable --now docker

# ---------------------------------------------------------------------------
# Data volume
# ---------------------------------------------------------------------------

# The attachment is asynchronous and races this script on a cold boot, so wait
# for the device rather than assuming it. NVMe renames /dev/sdf, which is why
# the device is found by listing unmounted disks rather than by name.
DATA_DEV=""
for _ in $(seq 1 60); do
  for candidate in /dev/nvme1n1 /dev/sdf /dev/xvdf; do
    if [[ -b $candidate ]]; then
      DATA_DEV=$candidate
      break 2
    fi
  done
  sleep 5
done

if [[ -z $DATA_DEV ]]; then
  echo "FATAL: data volume never appeared; refusing to start databases on the root disk" >&2
  exit 1
fi

# Format only when there is no filesystem. `blkid` failing is the signal for a
# blank volume; on every subsequent boot it succeeds and this is skipped, which
# is what keeps a re-run from erasing the databases.
if ! blkid "$DATA_DEV"; then
  mkfs.xfs "$DATA_DEV"
fi

mkdir -p /data
DATA_UUID=$(blkid -s UUID -o value "$DATA_DEV")
if ! grep -q "$DATA_UUID" /etc/fstab; then
  # `nofail` so a missing volume degrades to an unbooted database rather than
  # an instance stuck in emergency mode with no SSM agent to log in through.
  echo "UUID=$DATA_UUID /data xfs defaults,nofail 0 2" >> /etc/fstab
fi
mount -a

mkdir -p /data/{postgres,neo4j/data,neo4j/logs,clickhouse,clickhouse-config}

# ---------------------------------------------------------------------------
# ClickHouse: size its logging to this node, not to the machine it imagines
#
# This module is not instantiated by stacks-new/ — the new account uses
# Redshift Serverless for analytics and runs no self-hosted ClickHouse, so
# the incident below cannot recur there. Carried anyway: the fix was
# measured by hand on the old node and lived only on a laptop and in a
# now-archived repository, and a module that is still in the tree can still
# be stood up.
# ---------------------------------------------------------------------------

# The compose block below caps ClickHouse's memory because it sizes caches from
# total RAM. Its *logging* defaults need the same treatment and did not get it,
# which cost this node a day.
#
# metric_log and asynchronous_metric_log write a row every second, and the
# shipped logger level is <trace>. On 2026-08-25 that produced ~160 log lines a
# second and 68M rows of metric logging on a database holding ten rows of real
# data. Merging that backlog kept hitting the container's mem_limit — 37,300
# MEMORY_LIMIT_EXCEEDED — and every failed retry logged more, creating more
# parts to merge. CPU climbed from 35% to 85% over 26 hours until the box sat
# pinned at its burst ceiling with zero credits.
#
# Mounted as a single file rather than over config.d/, so ClickHouse's own
# docker_related_config.xml survives. See macanderson/oxagen#1305.
cat >/data/clickhouse-config/zz-oxagen-limits.xml <<'CHXMLEOF'
<clickhouse>
    <logger>
        <level>warning</level>
    </logger>

    <asynchronous_metric_log remove="1"/>
    <metric_log remove="1"/>
    <text_log remove="1"/>
    <trace_log remove="1"/>

    <!-- Sized to the container, not the host: the stock 5 GB mark cache is
         four times this container's entire memory limit. -->
    <mark_cache_size>268435456</mark_cache_size>
    <max_server_memory_usage>1073741824</max_server_memory_usage>
</clickhouse>
CHXMLEOF
chmod 644 /data/clickhouse-config/zz-oxagen-limits.xml

# ---------------------------------------------------------------------------
# Swap
# ---------------------------------------------------------------------------

# Three engines on 4 GiB have no headroom for a transient spike, and the Linux
# OOM killer resolves that by killing the largest process — which is always a
# database. Swap converts a crash into a slowdown. It is not a substitute for
# memory, and if this file is regularly swapping, the instance is too small.
if [[ ! -f /swapfile ]]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi
swapon -a || true

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# Read at boot from Parameter Store rather than baked into this file: user data
# is readable from the instance metadata service by anything running on the
# box, so a password written here would be readable by every process on it.
get_secret() {
  aws ssm get-parameter \
    --region "$REGION" \
    --name "/$NAME/$1/password" \
    --with-decryption \
    --query 'Parameter.Value' \
    --output text
}

POSTGRES_PASSWORD=$(get_secret postgres)
NEO4J_PASSWORD=$(get_secret neo4j)
CLICKHOUSE_PASSWORD=$(get_secret clickhouse)

mkdir -p /opt/oxagen
umask 077

cat > /opt/oxagen/.env <<ENVEOF
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
NEO4J_PASSWORD=$NEO4J_PASSWORD
CLICKHOUSE_PASSWORD=$CLICKHOUSE_PASSWORD
ENVEOF
chmod 600 /opt/oxagen/.env

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------

# Every port is bound to 127.0.0.1, never 0.0.0.0. The security group already
# admits nothing, but binding to loopback means that a future rule opening a
# port by mistake still does not expose a database — two independent controls
# rather than one. Access is by SSM port-forward, which terminates on the
# instance and therefore reaches loopback.
cat > /opt/oxagen/docker-compose.yml <<'COMPOSEEOF'
name: oxagen-data

services:
  postgres:
    # pgvector's own image, which is upstream Postgres with the extension
    # already built — the alternative is compiling it on every rebuild.
    image: pgvector/pgvector:pg${postgres_version}
    restart: unless-stopped
    ports:
      - "127.0.0.1:5432:5432"
    environment:
      POSTGRES_USER: oxagen
      POSTGRES_DB: oxagen
      POSTGRES_PASSWORD: $${POSTGRES_PASSWORD}
    volumes:
      - /data/postgres:/var/lib/postgresql/data
    mem_limit: 768m
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U oxagen -d oxagen"]
      interval: 15s
      timeout: 5s
      retries: 10

  neo4j:
    # Community 5 speaks Cypher and, since 5.11, carries native vector indexes
    # — so an embedding is a property on a node and is queried by the same
    # language as the graph around it, which is what this workload needs.
    image: neo4j:${neo4j_version}
    restart: unless-stopped
    ports:
      - "127.0.0.1:7474:7474"
      - "127.0.0.1:7687:7687"
    environment:
      NEO4J_AUTH: neo4j/$${NEO4J_PASSWORD}
      # Sized explicitly: Neo4j's defaults assume it owns the machine and will
      # claim a share of RAM that leaves nothing for the other two engines.
      NEO4J_server_memory_heap_initial__size: 512m
      NEO4J_server_memory_heap_max__size: 512m
      NEO4J_server_memory_pagecache_size: 512m
    volumes:
      - /data/neo4j/data:/data
      - /data/neo4j/logs:/logs
    mem_limit: 1536m
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:7474 >/dev/null || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 10
      start_period: 60s

  clickhouse:
    image: ${clickhouse_image}
    restart: unless-stopped
    ports:
      - "127.0.0.1:8123:8123"
      - "127.0.0.1:9000:9000"
    environment:
      CLICKHOUSE_USER: oxagen
      CLICKHOUSE_PASSWORD: $${CLICKHOUSE_PASSWORD}
      CLICKHOUSE_DB: oxagen
      # ClickHouse assumes it is alone on the host and sizes its caches from
      # total RAM. Uncapped here it takes the memory the other two need.
      CLICKHOUSE_SKIP_USER_SETUP: "0"
    volumes:
      - /data/clickhouse:/var/lib/clickhouse
      - /data/clickhouse-config/zz-oxagen-limits.xml:/etc/clickhouse-server/config.d/zz-oxagen-limits.xml:ro
    mem_limit: 1280m
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8123/ping >/dev/null || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 10
      start_period: 30s
COMPOSEEOF

cd /opt/oxagen
docker compose up -d

# pgvector ships in the image but is not enabled in a database until asked.
# Retried rather than assumed ready: Postgres accepts connections a moment
# after the container starts, and this runs immediately after.
for _ in $(seq 1 30); do
  if docker compose exec -T postgres psql -U oxagen -d oxagen -c "CREATE EXTENSION IF NOT EXISTS vector;"; then
    break
  fi
  sleep 5
done

echo "oxagen data node bootstrap complete"
