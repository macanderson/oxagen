#!/usr/bin/env bash
#
# Bootstrap for the Oxagen app node.
#
# Runs once on first boot, and again whenever this file changes — the instance
# is replaced on edit. Written to be re-runnable rather than assumed-once, same
# discipline as the old account's data-node bootstrap: it formats the data
# volume only if it has no filesystem, and `docker compose up -d` converges
# rather than recreates.
#
# This file used to say the replacement was safe "because Neo4j's data lives on
# a separate EBS volume that survives it". Neo4j's does. Nothing else did, and
# the sentence stopped anyone asking what else was on the box.
#
# On 2026-09-08 a replacement took the root disk with the platform's six
# services, ClickHouse and the real Caddyfile on it, and brought the node back
# carrying a placeholder that answers /healthz and 503s everything else. The
# target group read healthy. Five hostnames served 503 for two hours and
# nothing reported it.
#
# So this bootstrap returns the node to SERVING rather than to a placeholder:
# both engines, the node scripts from the deploy bucket, and every service that
# has an artifact there. A replacement is a recovery, not an outage waiting for
# someone to notice.

set -euxo pipefail

exec > >(tee /var/log/oxagen-bootstrap.log) 2>&1

NAME="${name}"
REGION="${region}"

# ---------------------------------------------------------------------------
# Packages
# ---------------------------------------------------------------------------

dnf -y update
dnf -y install docker

COMPOSE_VERSION=v2.32.4
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL \
  "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-aarch64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

systemctl enable --now docker

# ---------------------------------------------------------------------------
# Swap
# ---------------------------------------------------------------------------

# The Linux OOM killer resolves a memory spike by killing the largest process,
# which on a box holding Neo4j and ClickHouse is always a database. Swap turns
# that crash into a slowdown.
#
# It is a margin, not capacity. `instance_type` is where capacity is decided,
# and it was raised to `t4g.large` in the same change that put ClickHouse back
# here — sizing this node to hold two databases with room to spare rather than
# to fit them exactly and hope. If this node swaps steadily, it is still too
# small, and the fix is that variable rather than a bigger swapfile.
if [[ ! -f /swapfile ]]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 600 /swapfile
  mkswap /swapfile >/dev/null
  grep -q '^/swapfile' /etc/fstab || echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi
swapon -a || true

# ---------------------------------------------------------------------------
# The data volume — Neo4j and ClickHouse both live on it
# ---------------------------------------------------------------------------

DATA_DEV=""
for _ in $(seq 1 60); do
  for candidate in /dev/nvme1n1 /dev/sdf /dev/xvdf; do
    if [[ -b $candidate ]]; then
      DATA_DEV=$candidate
      break 2
    fi
  done
  sleep 5
done

if [[ -z $DATA_DEV ]]; then
  echo "FATAL: data volume never appeared; refusing to start Neo4j on the root disk" >&2
  exit 1
fi

if ! blkid "$DATA_DEV"; then
  mkfs.xfs "$DATA_DEV"
fi

mkdir -p /data
DATA_UUID=$(blkid -s UUID -o value "$DATA_DEV")
if ! grep -q "$DATA_UUID" /etc/fstab; then
  echo "UUID=$DATA_UUID /data xfs defaults,nofail 0 2" >> /etc/fstab
fi
mount -a

mkdir -p /data/neo4j/data /data/neo4j/logs

# ---------------------------------------------------------------------------
# Neo4j credential, read from Parameter Store rather than baked into this
# file: user data is readable from the instance metadata service by anything
# running on the box.
# ---------------------------------------------------------------------------

NEO4J_PASSWORD=$(aws ssm get-parameter \
  --region "$REGION" \
  --name "/$NAME/neo4j/password" \
  --with-decryption \
  --query 'Parameter.Value' \
  --output text)

mkdir -p /opt/oxagen/neo4j
umask 077
cat > /opt/oxagen/neo4j/.env <<ENVEOF
NEO4J_PASSWORD=$NEO4J_PASSWORD
ENVEOF
chmod 600 /opt/oxagen/neo4j/.env

cat > /opt/oxagen/neo4j/docker-compose.yml <<'COMPOSEEOF'
name: oxagen-neo4j

services:
  neo4j:
    image: neo4j:${neo4j_version}
    restart: unless-stopped
    ports:
      - "127.0.0.1:7474:7474"
      - "127.0.0.1:7687:7687"
    environment:
      NEO4J_AUTH: neo4j/$${NEO4J_PASSWORD}
      NEO4J_server_memory_heap_initial__size: 768m
      NEO4J_server_memory_heap_max__size: 768m
      NEO4J_server_memory_pagecache_size: 512m
    volumes:
      - /data/neo4j/data:/data
      - /data/neo4j/logs:/logs
    mem_limit: 1792m
    logging:
      driver: awslogs
      options:
        awslogs-region: "${region}"
        awslogs-group: /${name}/neo4j
        awslogs-create-group: "true"
        awslogs-stream: neo4j
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:7474 >/dev/null || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 10
      start_period: 60s
COMPOSEEOF

cd /opt/oxagen/neo4j
docker compose --env-file .env up -d

# ---------------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------------

# Self-hosted on this node rather than a managed service (#2693), and declared
# here rather than started by hand — which is how it actually ran from the
# 2026-08-27 cutover until a node replacement removed it and nothing brought it
# back. Its data is on /data, so it survives a replacement exactly as Neo4j's
# does; only the container was ever missing.
mkdir -p /data/clickhouse /data/clickhouse-config

# The logging defaults are the dangerous part, not the cache sizes.
# `metric_log` and `asynchronous_metric_log` write a row a second and the
# shipped level is <trace>. On the old data node that produced 68M rows of
# metric logging over a database holding ten rows of real data, and merging the
# backlog held the box at its CPU burst ceiling for 26 hours — see
# macanderson/oxagen#1305. Mounted as a single file so ClickHouse's own
# docker_related_config.xml survives.
cat > /data/clickhouse-config/zz-oxagen-limits.xml <<'CHXMLEOF'
<clickhouse>
    <logger><level>warning</level></logger>

    <asynchronous_metric_log remove="1"/>
    <metric_log remove="1"/>
    <text_log remove="1"/>
    <trace_log remove="1"/>

    <!-- Sized to the container, not the host. ClickHouse reads total RAM and
         sizes from it, so on an 8 GiB box it would help itself to several
         times what this container is allowed. 1.5 GiB against a 2 GiB
         mem_limit leaves the container room to breathe before the cgroup
         kills it, which is the failure this bounds. -->
    <mark_cache_size>268435456</mark_cache_size>
    <max_server_memory_usage>1610612736</max_server_memory_usage>
</clickhouse>
CHXMLEOF
chmod 644 /data/clickhouse-config/zz-oxagen-limits.xml

CLICKHOUSE_PASSWORD=$(aws ssm get-parameter \
  --region "$REGION" \
  --name "/$NAME/clickhouse/password" \
  --with-decryption \
  --query 'Parameter.Value' \
  --output text)

mkdir -p /opt/oxagen/clickhouse
umask 077
cat > /opt/oxagen/clickhouse/.env <<ENVEOF
CLICKHOUSE_PASSWORD=$CLICKHOUSE_PASSWORD
ENVEOF
chmod 600 /opt/oxagen/clickhouse/.env

cat > /opt/oxagen/clickhouse/docker-compose.yml <<'COMPOSEEOF'
name: oxagen-clickhouse

services:
  clickhouse:
    image: ${clickhouse_image}
    restart: unless-stopped
    ports:
      - "127.0.0.1:8123:8123"
      - "127.0.0.1:9000:9000"
    environment:
      CLICKHOUSE_USER: oxagen
      CLICKHOUSE_PASSWORD: $${CLICKHOUSE_PASSWORD}
      CLICKHOUSE_DB: oxagen
    volumes:
      - /data/clickhouse:/var/lib/clickhouse
      - /data/clickhouse-config/zz-oxagen-limits.xml:/etc/clickhouse-server/config.d/zz-oxagen-limits.xml:ro
    mem_limit: 2048m
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    logging:
      driver: awslogs
      options:
        awslogs-region: "${region}"
        awslogs-group: /${name}/clickhouse
        awslogs-create-group: "true"
        awslogs-stream: clickhouse
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8123/ping >/dev/null || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 10
      start_period: 60s
COMPOSEEOF

cd /opt/oxagen/clickhouse
docker compose --env-file .env up -d

# ---------------------------------------------------------------------------
# Caddy — a placeholder config that answers /healthz, so the ALB's health
# check goes green before tools/install-node-scripts.sh has ever run. The
# real Caddyfile and the platform's own services arrive by the deploy path.
# ---------------------------------------------------------------------------

mkdir -p /opt/oxagen/bin /opt/oxagen/services /opt/oxagen/caddy

# This placeholder deliberately does NOT answer /healthz 200.
#
# It used to, so the target group would go green before the deploy path had
# ever run. That is what made 2026-09-08 invisible: the node came back with
# only this config, the ALB called it healthy, and five hostnames served 503
# for two hours with every dashboard green. A health check that passes while
# nothing is served is not a health check.
#
# Unhealthy is the honest answer until a real service is behind it. The
# bootstrap below is what makes that recoverable without a person: if it
# succeeds the real Caddyfile replaces this within a few minutes, and if it
# fails the node stays visibly unhealthy instead of quietly wrong.
cat > /opt/oxagen/caddy/Caddyfile <<'CADDYEOF'
:80 {
	respond 503
}
CADDYEOF

docker run -d \
  --name oxagen-caddy \
  --restart unless-stopped \
  --network host \
  --log-driver awslogs \
  --log-opt awslogs-region="${region}" \
  --log-opt awslogs-group=/${name}/caddy \
  --log-opt awslogs-create-group=true \
  --log-opt awslogs-stream=caddy \
  -v /opt/oxagen/caddy:/etc/caddy \
  caddy:2

# ---------------------------------------------------------------------------
# Back to serving
# ---------------------------------------------------------------------------

# The node scripts and the platform's services used to arrive only by a deploy
# somebody triggered. That made a replacement a half-built box: the engines ran
# and nothing else did, and the next deploy failed anyway because CI addressed
# the old instance by id. Both halves are fixed — CI resolves the node by tag
# now — and this is the half that belongs on the node.
#
# `tools/install-node-scripts.sh` uploads to the same two prefixes this reads,
# and stays the way a CHANGE to those scripts reaches the node. Its header's
# reasoning — that nothing should sync them mid-deploy, because a script
# rewriting itself during a deploy fails worse than a stale one — is about
# steady state and is untouched. This is boot, where the alternative to
# fetching them is not having them.
aws s3 sync "s3://${deploy_bucket}/_bin/" /opt/oxagen/bin/ --region "$REGION" --only-show-errors
chmod 0755 /opt/oxagen/bin/*.sh || true

# The real Caddyfile, replacing the 503 placeholder above. Absent on a first
# ever provision, which is why this does not fail the boot.
#
# It is fetched to a temp path and VALIDATED before it replaces the placeholder.
# This used to copy the object straight over /opt/oxagen/caddy/Caddyfile and
# then `caddy reload ... || true`, which had two failure modes and no signal for
# either:
#
#   - the running container kept the placeholder in memory because the reload
#     was refused, while the file on disk was already the broken one — so the
#     node served nothing, and the next container restart (this container is
#     `--restart unless-stopped`) could not start Caddy at all;
#   - `|| true` erased the difference between "no config published yet", which
#     is normal on a first provision, and "the published config is broken",
#     which is an outage. Both looked like a quiet boot.
#
# Validating first means a broken object cannot destroy the placeholder. The
# node then stays visibly unhealthy — the placeholder deliberately does not
# answer /healthz 200, see the note above it — which is the honest answer and
# the one the 2026-09-08 incident is about.
#
# The boot continues either way, on purpose. Aborting here would skip the
# service restore loop below and turn a Caddy problem into a node with no
# services on it, which is a worse recovery than a node that is loudly
# unhealthy. Loud, not fatal.
# ── The same node-wide lock the installer takes ─────────────────────────────
#
# This bootstrap is the SECOND writer of the paths below. `install-node-scripts.sh`
# writes the same `/tmp/Caddyfile.incoming` and the same
# `/opt/oxagen/caddy/Caddyfile`, and until this block took the lock only one of
# the two participants held it — which is a lock over half a transaction. The
# interleaving is not hypothetical, it is the deployment path: changing this file
# REPLACES the instance, so a replacement node is running this bootstrap exactly
# when an operator is most likely to be running the installer.
#
#   installer fetches candidate B -> /tmp/Caddyfile.incoming = B
#   this bootstrap fetches the canonical object -> same path, now A
#   installer validates and reloads             -> the node runs A
#   installer exits 0, and its caller publishes B, which nothing validated
#
# Same lock file, same `flock`, so there is one mechanism and not two. What
# differs is the response to not getting it, and the difference is this file's
# own doctrine rather than a new idea: the installer FAILS (SSM reports Failed,
# nothing is promoted, an operator retries), because a refused install costs
# nothing. A bootstrap cannot fail here. Aborting the boot for a lock would be
# the "fatal" this file rejects three paragraphs up — a node that never joins
# the target group is worse than a node that is loudly unhealthy — so a bootstrap
# that cannot take the lock SKIPS the Caddy step, keeps the 503 placeholder, and
# goes on to restore its services. That is also the correct outcome rather than
# merely the safe one: whoever holds the lock is an installer that is about to
# reload this node with a config it validated.
#
# Scoped to a subshell rather than held to process exit, which is the opposite of
# the installer's choice and for the same reason. There the lock must outlive the
# script so the `trap ... EXIT` restore runs inside it. Here the restore is inline
# in the `else` below, so the subshell already contains it — and holding the lock
# to the end of THIS script would keep it through the service-restore loop, for
# minutes, which would time out every concurrent installer instead of serialising
# with it.
#
# `set -e` is on, so the acquisition is written as a tested `if` and the subshell
# closes with `|| echo`: neither a lock we did not get nor a step that failed
# inside may end the boot.
#
# The markers around it are load-bearing, for the same reason the installer's
# are: they let this block be run against stubs in a test, and the defect it was
# fixed for is an INTERLEAVING of two scripts, which no reading of either one
# decides.
# >>> caddy-bootstrap
(
if ! command -v flock >/dev/null; then
  # Proceed unlocked, loudly. A missing flock is a node-image regression rather
  # than a concurrency event, and turning it into "this node never serves" is
  # the fatal-not-loud direction this file exists to reject.
  echo "CADDY BOOTSTRAP: flock is missing — proceeding WITHOUT serialising against a concurrent install" >&2
elif ! flock -x -w 60 200; then
  echo "caddy: an install holds /opt/oxagen/caddy-install.lock — skipping the config step" >&2
  echo "caddy: keeping the 503 placeholder; that install is reloading this node with a config it validated" >&2
  exit 0
fi

if aws s3 cp "s3://${deploy_bucket}/_caddy/Caddyfile" /tmp/Caddyfile.incoming \
     --region "$REGION" --only-show-errors; then
  if docker run --rm -v /tmp/Caddyfile.incoming:/etc/caddy/Caddyfile:ro caddy:2 \
       caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile; then
    # Kept so the reload failure below can put back what Caddy is actually
    # running. Validation proves the file PARSES; it does not prove the running
    # process took it, and a validated config whose reload fails transiently was
    # left on disk exactly like a broken one — the same window the comment above
    # describes, reached through the other door.
    #
    # This file is read later by install-node-scripts.sh, whose `cmp -s` treats
    # it as "the config Caddy accepted". One left here unaccepted makes that
    # comparison report "unchanged", which skips the reload and promotes the
    # candidate as successful — so a bootstrap that quietly leaves the wrong
    # file reopens the TRUST_EDGE_CLIENT_IP_HEADER hazard from the installer
    # side. The file has to mean what the installer reads it to mean.
    cp /opt/oxagen/caddy/Caddyfile /tmp/Caddyfile.accepted
    cp /tmp/Caddyfile.incoming /opt/oxagen/caddy/Caddyfile
    if docker exec oxagen-caddy caddy reload \
         --config /etc/caddy/Caddyfile --adapter caddyfile; then
      echo "caddy: published config installed and reloaded"
    else
      cp /tmp/Caddyfile.accepted /opt/oxagen/caddy/Caddyfile
      echo "CADDY BOOTSTRAP: config validated but reload FAILED — node is not serving" >&2
      echo "CADDY BOOTSTRAP: restored the config Caddy is running, so a later install still reloads" >&2
    fi
    rm -f /tmp/Caddyfile.accepted
  else
    echo "CADDY BOOTSTRAP: published s3://${deploy_bucket}/_caddy/Caddyfile FAILED validation" >&2
    echo "CADDY BOOTSTRAP: keeping the 503 placeholder; this node will stay unhealthy on purpose" >&2
  fi
  rm -f /tmp/Caddyfile.incoming
else
  echo "caddy: no published config yet (first provision) — keeping the 503 placeholder"
fi
) 200>/opt/oxagen/caddy-install.lock || echo "CADDY BOOTSTRAP: the caddy config step did not complete — continuing the boot" >&2
# <<< caddy-bootstrap

# Every service with an artifact. Read from the bucket rather than listed here,
# so adding a service to the platform does not also mean editing this file and
# replacing the node to apply it.
#
# `|| true` per service on purpose: one service whose artifact is stale or
# broken must not stop the other five coming back. deploy-service.sh rolls a
# failed service back to its previous release on its own, and the endpoint
# check in CI is what judges the result. Losing five to save one is the wrong
# trade during a recovery.
if [[ -x /opt/oxagen/bin/deploy-service.sh ]]; then
  for artifact in $(aws s3 ls "s3://${deploy_bucket}/_deploy/" --region "$REGION" \
                      | awk '{print $4}' | grep -E '\-standalone\.tgz$' || true); do
    service="$${artifact%-standalone.tgz}"
    echo "restoring $service"
    /opt/oxagen/bin/deploy-service.sh "$service" || echo "WARNING: $service did not come back"
  done
fi

echo "oxagen app node bootstrap complete"
