#!/bin/bash -e
# Runs on every boot of a runner instance (ci-start-runner.service). It wraps the
# start script of github-aws-runners/terraform-aws-github-runner at the release
# vendored in vendor/start-runner.sh, the same way the module's own Packer
# images wrap it (images/start-runner.sh upstream).
exec > >(tee /var/log/runner-startup.log | logger -t user-data -s 2>/dev/console) 2>&1

cd /opt/actions-runner

${start_runner}
