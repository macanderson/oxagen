.DS_Store
.env
.env.local
.env.*.local
.worktrees
.claude/worktrees/
.ignore

# Node
node_modules
.pnpm-store
*.log
npm-debug.log*
yarn-debug.log*

# Build artifacts
dist
.next
.turbo
out
build
coverage
.vercel

# Developer-local symlinks
.cache
.venv
target

# TS incremental
*.tsbuildinfo

# Drizzle
packages/database/drizzle/.meta

# Playwright and E2E test artifacts
test-results
playwright-report
**/__tests__/screenshots/
**/e2e/screenshots/

# Editors
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.env*
.env*.local

# Stripe webhook tunnel pidfile (written by `pnpm dev`, *.log already ignored)
.stripe-listen.pid

# Inngest dev server pidfile (written by `pnpm dev`, *.log already ignored)
.inngest-dev.pid

# Plaintext credential dumps — never commit (real DB/secret values live here)
database-creds.txt
*-creds.txt
*.creds

# Private keys / certs — defensive: never commit key material
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# Next.js generates next-env.d.ts on every build/dev; its content is
# build-environment-specific and the file says "do not edit". Regenerated by
# `next build` (the CI "Build app" step runs before typecheck).
**/next-env.d.ts

# xmcp generates these on every build (.xmcp/ = rspack glue, xmcp-env.d.ts =
# ambient ref). Not needed for `tsc --noEmit`; regenerated by `xmcp build`.
**/.xmcp/
**/xmcp-env.d.ts

.claude/worktrees

# Per-org Vercel access tokens for `pnpm vercel:rotate-ai-key` — live secrets
vercel.tokens.json

# Plaintext credential dump (full env contract; live secrets)
creds.txt

# Local dev login credentials for browser-driven frontend verification
creds.json

# env-manager local secrets mirror (GCP Secret Manager values + metadata).
# Built by `pnpm env:secrets:pull`; holds live secret values — never commit.
secrets.db
secrets.db-journal
secrets.db-wal
secrets.db-shm
tools/env-manager/secrets.db*

# playwright test artifacts
.playwright-mcp*/
.playwright*
.superpowers/

# OpenTofu / Terraform
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/crash.log
**/crash.*.log

# Test results folder
.test-results/

# Artifact files — error logs, test output (security risk: stack traces, paths, credentials)
errors.txt
test_output.json
.linear-triage/
research-swarm-complete-verified.png

# Storybook static build output
storybook-static/
.devtools

# transient per-package typecheck configs from tools/scripts/typecheck-staged.mjs
tsconfig.staged-*.json
nautilus-demo/
.playwright-mcp/
verifications/

# Build artifact: standalone CLI bundle (regenerated by `pnpm --filter @oxagen/cli bundle`)
apps/cli/dist-standalone/

# Terminal-Bench run outputs (ephemeral, regenerated per run)
bench/terminal-bench/results-*/

# Local eval-run artifacts (regenerated by `pnpm eval`)
tools/eval-out/

# Vitest temp bundling artifacts (accidentally git-tracked in the past; see dead-code audit)
**/vitest.config.ts.timestamp-*

# Generated codemap/report scratch output
.reports/

# Personal CLI settings scope (may contain MCP credentials) — never commit
.oxagen/settings.local.json

# Stella agent local state (context/memory DBs; the agent now lives in its
# own repo — accidentally git-tracked in the past, pruned with crates/)
.stella/

# Python bytecode caches (orphaned .pyc files were git-tracked in bench/
# after their sources were removed)
__pycache__/
*.pyc

# stores anthropic api token safe from claude code so it doesn't burn api usage
.anthropic-api-key
# stores `manderson` team linked vercel api key
.ai-gateway-api-key

# Orphaned atomic-write temp files (writer creates `<file>.tmp.<pid>.<hash>`,
# writes, then renames; an interrupted write leaves the temp behind). These must
# never be committed — one leaked into #807 as page.tsx.tmp.45759.f25485f00a57.
*.tmp.*
*.tmp
Icon

# Local backup of the pre-reorg brand assets (kept on disk as a safety copy;
# the reorganized layout lives in docs/brand/). Never commit the duplicate.
docs/brand_old/

# design-sync (claude.ai/design) — generated + transient
.ds-sync/
ds-bundle/
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.design-sync/*.log
.design-sync/upload-*.json
