.DS_Store
.env
.env.local
.env.*.local
.worktrees
.claude/worktrees/
.ignore

# Node
node_modules
.pnpm-store
*.log
npm-debug.log*
yarn-debug.log*

# Build artifacts
dist
.next
.turbo
out
build
coverage
.vercel

# Developer-local symlinks
.cache
.venv
target

# TS incremental
*.tsbuildinfo

# Drizzle
packages/database/drizzle/.meta

# Playwright and E2E test artifacts
test-results
playwright-report
**/__tests__/screenshots/
**/e2e/screenshots/

# Editors
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.env*
.env*.local

# Stripe webhook tunnel pidfile (written by `pnpm dev`, *.log already ignored)
.stripe-listen.pid

# Plaintext credential dumps — never commit (real DB/secret values live here)
database-creds.txt
*-creds.txt
*.creds

# Private keys / certs — defensive: never commit key material
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# Next.js generates next-env.d.ts on every build/dev; its content is
# build-environment-specific and the file says "do not edit". Regenerated by
# `next build` (the CI "Build app" step runs before typecheck).
**/next-env.d.ts

# xmcp generates these on every build (.xmcp/ = rspack glue, xmcp-env.d.ts =
# ambient ref). Not needed for `tsc --noEmit`; regenerated by `xmcp build`.
**/.xmcp/
**/xmcp-env.d.ts

.claude/worktrees

# Plaintext credential dump (full env contract; live secrets)
creds.txt

# Local dev login credentials for browser-driven frontend verification
creds.json

# playwright test artifacts
.playwright-mcp*/
.playwright*
.superpowers/

# Test results folder
.test-results/

# Artifact files — error logs, test output (security risk: stack traces, paths, credentials)
errors.txt
test_output.json
