{
  "name": "@oxagen/ontology",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./migrate": "./src/migrate.ts",
    "./types": "./src/types.ts",
    "./labels": "./src/labels.ts",
    "./tenant": "./src/tenant.ts",
    "./temporal": "./src/temporal.ts",
    "./ann": "./src/ann.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "migrate": "tsx src/migrate.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@oxagen/config": "workspace:*",
    "@oxagen/telemetry": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "neo4j-driver": "5.28.3"
  },
  "devDependencies": {
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "2.1.9",
    "@vitest/coverage-v8": "2.1.9"
  }
}
