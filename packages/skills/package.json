{
  "name": "@oxagen/skills",
  "version": "2.1.1",
  "description": "Agent skill definitions for the Oxagen CLI — run `npx @oxagen/skills install` to add them to ~/.oxagen/skills",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "oxagen-skills": "./bin/oxagen-skills.mjs"
  },
  "files": [
    "bin",
    "skills",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./loader": "./src/loader.ts",
    "./registry": "./src/registry.ts",
    "./types": "./src/types.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./bin/oxagen-skills.mjs",
    "exports": {
      ".": "./bin/oxagen-skills.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oxageninc/oxagen-platform.git",
    "directory": "packages/skills"
  },
  "license": "UNLICENSED",
  "scripts": {
    "gen:skills": "tsx scripts/embed-skills.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@oxagen/agent-artifacts": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3",
    "vitest": "2.1.9",
    "@vitest/coverage-v8": "2.1.9"
  }
}
