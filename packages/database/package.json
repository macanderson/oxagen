{
  "name": "@oxagen/database",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./security": "./src/security.ts",
    "./seed": "./src/seed.ts",
    "./tenant": "./src/tenant.ts",
    "./tenant.mock": "./src/tenant.mock.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "generate": "drizzle-kit generate",
    "migrate": "echo 'drizzle-kit migrate is disabled. Use pnpm db:migrate (repo root) or pnpm atlas:apply for Postgres.' && exit 1",
    "atlas:diff": "atlas migrate diff --env local",
    "atlas:apply": "atlas migrate apply --env local",
    "atlas:status": "atlas migrate status --env local",
    "atlas:validate": "atlas migrate validate --dir \"file://atlas/migrations\"",
    "studio": "drizzle-kit studio",
    "db:seed-books": "tsx --env-file-if-exists=.env.local src/seed-book-editions.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@oxagen/compliance": "workspace:*",
    "@oxagen/config": "workspace:*",
    "@oxagen/oxagen": "workspace:*",
    "@oxagen/telemetry": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pino": "9.14.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "2.1.9",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
