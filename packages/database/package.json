{
  "name": "@oxagen/database",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./security": "./src/security.ts",
    "./seed": "./src/seed.ts",
    "./tenant": "./src/tenant.ts",
    "./tenant.mock": "./src/tenant.mock.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "generate": "drizzle-kit generate",
    "migrate": "echo 'drizzle-kit migrate is disabled. Run: pnpm db:migrate (from repo root) — the canonical multi-store runner. The drizzle journal is NOT the source of truth.' && exit 1",
    "studio": "drizzle-kit studio",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@oxagen/config": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@oxagen/telemetry": "workspace:*",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "2.1.9",
    "@vitest/coverage-v8": "2.1.9"
  }
}
