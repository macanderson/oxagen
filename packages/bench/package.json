{
  "name": "@oxagen/bench",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx src/migrate.ts",
    "list": "tsx src/cli.ts list",
    "replay": "tsx src/cli.ts replay",
    "backfill": "tsx ../../tools/scripts/bench-backfill.ts"
  },
  "dependencies": {
    "@oxagen/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
