{
  "name": "@oxagen/stella-engine-client",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/fake-engine.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run --exclude '**/*.smoke.test.ts'",
    "test:coverage": "vitest run --coverage --exclude '**/*.smoke.test.ts'",
    "test:smoke": "vitest run src/stella-serve.smoke.test.ts"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.4",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
