{
  "name": "@oxagen/telemetry",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bench-client": "./src/bench-client.ts",
    "./client": "./src/client.ts",
    "./migrate": "./src/migrate.ts",
    "./tenant": "./src/tenant.ts",
    "./usage-events": "./src/usage-events.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "migrate": "tsx src/migrate.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clickhouse/client": "1.19.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@oxagen/compliance": "workspace:*",
    "@oxagen/config": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.7.1",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
