{
  "name": "@oxagen/telemetry",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./migrate": "./src/migrate.ts",
    "./usage-events": "./src/usage-events.ts",
    "./request-admission": "./src/request-admission.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "migrate": "tsx src/migrate.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clickhouse/client": "1.23.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@oxagen/compliance": "workspace:*",
    "@oxagen/config": "workspace:*",
    "@oxagen/recorder": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@vitest/coverage-v8": "3.2.6",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "vitest": "3.2.6"
  }
}
