{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxagen.sh/schemas/done-record/v1.json",
  "title": "Done record",
  "description": "work.done_records.body: what done means for one work item. A check makes a criterion held. An oracle run again in a contained verify stage makes it proven.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "item",
    "lineage",
    "criteria"
  ],
  "properties": {
    "schema": {
      "const": "done-record/v1"
    },
    "item": {
      "$ref": "#/$defs/workItemId"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "drafted_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "decision"
      ],
      "description": "The model route and triage decision that drafted the record. Absent when a person wrote it.",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "$ref": "#/$defs/triageId"
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "by",
        "at"
      ],
      "description": "Written when a person locks the record. The digest is SHA-256 over the record in RFC 8785 form, with lock left out.",
      "properties": {
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "by": {
          "$ref": "#/$defs/actor"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128,
      "description": "A person's or an agent's handle in the workspace."
    },
    "lineage": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$",
      "maxLength": 200,
      "description": "A dotted lineage, such as aintel.core.bug-fixer."
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256: and 64 lowercase hex characters."
    },
    "triageId": {
      "type": "string",
      "pattern": "^tri_[0-9A-Za-z]+$",
      "description": "A triage decision's public id."
    },
    "workItemId": {
      "type": "string",
      "pattern": "^wi_[0-9A-Za-z]+$",
      "description": "A work item's public id."
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "tag"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "enum": [
            "code",
            "test",
            "docs",
            "review"
          ]
        },
        "check": {
          "$ref": "#/$defs/check"
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        },
        "negative": {
          "type": "string",
          "minLength": 1,
          "description": "A case that must fail. Required by lint when the text names a threshold, a boundary, or only."
        }
      }
    },
    "check": {
      "description": "One of the six check kinds. There is no seventh.",
      "oneOf": [
        {
          "$ref": "#/$defs/runCheck"
        },
        {
          "$ref": "#/$defs/fileCheck"
        },
        {
          "$ref": "#/$defs/diffCheck"
        },
        {
          "$ref": "#/$defs/toolsCheck"
        },
        {
          "$ref": "#/$defs/budgetCheck"
        },
        {
          "$ref": "#/$defs/humanCheck"
        }
      ]
    },
    "runCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1,
          "default": 600
        }
      }
    },
    "fileCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "exists": {
              "type": "boolean"
            },
            "contains": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "diffCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff"
      ],
      "properties": {
        "diff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "**"
              ]
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          }
        }
      }
    },
    "toolsCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools"
      ],
      "properties": {
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deny"
          ],
          "properties": {
            "deny": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "budgetCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget"
      ],
      "properties": {
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 1
            },
            "minutes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stop_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 3
            }
          }
        }
      }
    },
    "humanCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human"
      ],
      "properties": {
        "human": {
          "type": "string",
          "minLength": 1,
          "description": "The person who signs."
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "example",
            "predicate",
            "invariant",
            "schema",
            "executable",
            "differential",
            "property",
            "replay",
            "policy",
            "budget",
            "provenance",
            "structural",
            "convergence",
            "formal"
          ],
          "description": "One of the fourteen deterministic oracle classes."
        },
        "witness": {
          "type": "string",
          "minLength": 1,
          "description": "The file that holds the oracle's evaluator or its expected output."
        }
      }
    }
  }
}
