  "files": [
    {
      "path": "proto/ledger.proto",
      "text": "syntax = \"proto3\";\n\npackage a_intel.ledger.v1;\n\nimport \"google/protobuf/any.proto\";\nimport \"google/protobuf/timestamp.proto\";\n\noption go_package = \"github.com/a-intel/ledger/gen/ledgerv1\";\n\nservice Ledger {\n  rpc GetEntry(GetEntryRequest) returns (Entry) {\n    option idempotency_level = NO_SIDE_EFFECTS;\n  }\n  rpc PostEntry(PostEntryRequest) returns (Entry);\n  rpc ReverseEntry(ReverseEntryRequest) returns (Entry) {\n    option idempotency_level = IDEMPOTENT;\n  }\n  rpc ListEntries(ListEntriesRequest) returns (stream Entry) {\n    option idempotency_level = NO_SIDE_EFFECTS;\n  }\n  rpc UploadEntries(stream PostEntryRequest) returns (UploadSummary);\n  rpc SyncEntries(stream PostEntryRequest) returns (stream Entry);\n}\n\nmessage Money {\n  int64 amount = 1;\n  string currency = 2;\n}\n\nmessage Entry {\n  string id = 1;\n  string account_id = 2;\n  EntryKind kind = 3;\n  Money money = 4;\n  google.protobuf.Timestamp posted_at = 5;\n  map<string, string> labels = 6;\n  repeated string related_ids = 7;\n  google.protobuf.Any detail = 8;\n  oneof source {\n    string invoice_id = 9;\n    string transfer_id = 10;\n    string manual_note = 11;\n  }\n  bool reversed = 12;\n}\n\nmessage GetEntryRequest {\n  string id = 1;\n}\n\nmessage PostEntryRequest {\n  string account_id = 1;\n  EntryKind kind = 2;\n  Money money = 3;\n  map<string, string> labels = 4;\n  google.protobuf.Any detail = 5;\n  oneof source {\n    string invoice_id = 6;\n    string transfer_id = 7;\n    string manual_note = 8;\n  }\n}\n\nmessage ReverseEntryRequest {\n  string id = 1;\n  string reason = 2;\n}\n\nmessage ListEntriesRequest {\n  string account_id = 1;\n  google.protobuf.Timestamp since = 2;\n}\n\nmessage UploadSummary {\n  int32 posted = 1;\n  repeated string entry_ids = 2;\n}\n\nenum EntryKind {\n  ENTRY_KIND_UNSPECIFIED = 0;\n  ENTRY_KIND_DEBIT = 1;\n  ENTRY_KIND_CREDIT = 2;\n}\n"
    }
  ],
  "listed": [
    {
      "kind": "client_stream",
      "name": "a_intel.ledger.v1.Ledger/UploadEntries",
      "reason": "A client-streaming method takes a stream of requests, and one tool call sends one, so it never becomes a tool."
    },
