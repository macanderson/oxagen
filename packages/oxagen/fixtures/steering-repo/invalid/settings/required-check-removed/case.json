{
  "check": "settings",
  "rule": "required-check-removed",
  "severity": "error",
  "description": "GitLab merge requests no longer require the status Oxagen steering.",
  "refused_by_reader": false,
  "changed": [],
  "removed": [],
  "expect": [
    {
      "path": "merge_requests.required_status"
    }
  ],
  "actual_settings": {
    "provider": "gitlab",
    "settings": {
      "visibility": "private",
      "default_branch": "main",
      "protected_branches": {
        "main": {
          "push_access": "no_one",
          "merge_access": "oxagen-steering",
          "allow_force_push": false
        }
      },
      "merge_requests": {
        "squash_option": "always",
        "only_allow_merge_if_pipeline_succeeds": true,
        "remove_source_branch_after_merge": true,
        "reset_approvals_on_push": true,
        "required_status": ""
      },
      "ci_cd": {
        "builds_access_level": "disabled"
      }
    }
  }
}
