    "./registry": "./src/registry.ts",
    "./kernel": "./src/kernel.ts",
    "./platform-operator": "./src/platform-operator.ts",
    "./handler-error": "./src/handler-error.ts",
    "./agent-credential": "./src/agent-credential.ts",
    "./cli-session": "./src/cli-session.ts",
    "./ledger-run-token": "./src/ledger-run-token.ts",
    "./agent-schema": "./src/agent-schema.ts",
    "./avatar": "./src/avatar.ts",
    "./interactive-agent": "./src/interactive-agent.ts",
    "./capability-meta": "./src/capability-meta.ts",
    "./lib/relationship-type-pattern": "./src/lib/relationship-type-pattern.ts",
    "./types": "./src/types.ts",
    "./iam": "./src/iam/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./tacho/command-limits": "./src/tacho/command-limits.ts",
    "./tacho/schemas": "./src/tacho/schemas.ts",
    "./mandates/schemas": "./src/mandates/schemas.ts",
    "./approval-rules/schemas": "./src/approval-rules/schemas.ts",
    "./mandates/schemas.sample": "./src/mandates/schemas.sample.ts",
    "./client-ip": "./src/client-ip.ts",
    "./skill-frontmatter": "./src/skill-frontmatter.ts",
    "./skills": "./src/skills.ts",
    "./configuration-clone": "./src/configuration-clone.ts",
    "./context-record-label": "./src/context-record-label.ts"
