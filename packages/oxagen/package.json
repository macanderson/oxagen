    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@oxagen/config": "workspace:*",
    "@oxagen/run-evidence": "workspace:*",
    "@oxagen/tacho": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "zod": "3.25.76",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "2.1.9",
    "@vitest/coverage-v8": "2.1.9"
  }
