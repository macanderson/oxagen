{
  "name": "@oxagen/oxagen",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts/*": "./src/contracts/*.ts",
    "./registry": "./src/registry.ts",
    "./kernel": "./src/kernel.ts",
    "./agent-schema": "./src/agent-schema.ts",
    "./trigger-conditions": "./src/trigger-conditions.ts",
    "./avatar": "./src/avatar.ts",
    "./interactive-agent": "./src/interactive-agent.ts",
    "./capability-meta": "./src/capability-meta.ts",
    "./types": "./src/types.ts",
    "./iam": "./src/iam/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./plugins": "./src/plugins/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@oxagen/agent-artifacts": "workspace:*",
    "@oxagen/config": "workspace:*",
    "@oxagen/sandbox": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "2.1.9",
    "@vitest/coverage-v8": "2.1.9"
  }
}
