{
  "name": "@oxagen/engram",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./store": "./src/store/index.ts",
    "./migration": "./src/migration/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval:golden": "tsx src/eval/run-golden.ts",
    "eval:export": "tsx src/eval/run-golden.ts --export"
  },
  "dependencies": {
    "@clickhouse/client": "1.19.0",
    "@oxagen/config": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "blake3": "2.1.7",
    "duckdb": "1.3.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "2.1.9",
    "@vitest/coverage-v8": "2.1.9"
  }
}
