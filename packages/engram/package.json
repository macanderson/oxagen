{
  "name": "@oxagen/engram",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./store": "./src/store/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval:golden": "tsx src/eval/run-golden.ts",
    "eval:export": "tsx src/eval/run-golden.ts --export"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "0.0.4",
    "@oxagen/ai": "workspace:*",
    "tiktoken": "1.0.22",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "duckdb": "1.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
