    "@oxagen/database": "workspace:*",
    "@oxagen/ontology": "workspace:*",
    "@oxagen/sandbox": "workspace:*",
    "@oxagen/telemetry": "workspace:*",
    "ai": "4.3.19",
    "drizzle-orm": "0.45.2",
    "inngest": "3.54.2",
    "neo4j-driver": "5.28.3",
    "@oxagen/oxagen": "workspace:*",
    "pino": "9.14.0",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
