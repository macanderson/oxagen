{
  "name": "@oxagen/agent",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime/*": "./src/runtime/*.ts",
    "./dispatch/*": "./src/dispatch/*.ts",
    "./memory/*": "./src/memory/*.ts",
    "./handlers": "./src/handlers/index.ts",
    "./handlers/*": "./src/handlers/*.ts",
    "./register": "./src/register.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@oxagen/ai": "workspace:*",
    "@oxagen/billing": "workspace:*",
    "@oxagen/config": "workspace:*",
    "@oxagen/crypto": "workspace:*",
    "@oxagen/database": "workspace:*",
    "@oxagen/iam": "workspace:*",
    "@oxagen/mcp-config": "workspace:*",
    "@oxagen/ontology": "workspace:*",
    "@oxagen/oxagen": "workspace:*",
    "@oxagen/plugins": "workspace:*",
    "@oxagen/stella-engine-client": "workspace:*",
    "@oxagen/telemetry": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "ai": "7.0.14",
    "drizzle-orm": "0.45.2",
    "pino": "9.14.0",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
