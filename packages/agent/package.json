{
  "name": "@oxagen/agent",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime/*": "./src/runtime/*.ts",
    "./dispatch/*": "./src/dispatch/*.ts",
    "./memory/*": "./src/memory/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./handlers": "./src/handlers/index.ts",
    "./handlers/*": "./src/handlers/*.ts",
    "./register": "./src/register.ts",
    "./adapters": "./src/adapters/index.ts",
    "./adapters/*": "./src/adapters/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@oxagen/agent-engine": "workspace:*",
    "@oxagen/ai": "workspace:*",
    "@oxagen/config": "workspace:*",
    "@oxagen/database": "workspace:*",
    "@oxagen/engram": "workspace:*",
    "@oxagen/mcp-config": "workspace:*",
    "@oxagen/ontology": "workspace:*",
    "@oxagen/plugins": "workspace:*",
    "@oxagen/sandbox": "workspace:*",
    "@oxagen/storage": "workspace:*",
    "@oxagen/telemetry": "workspace:*",
    "@oxagen/tenancy": "workspace:*",
    "ai": "6.0.197",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.2",
    "inngest": "3.54.2",
    "neo4j-driver": "5.28.3",
    "@oxagen/oxagen": "workspace:*",
    "pino": "9.14.0",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "2.1.9",
    "@vitest/coverage-v8": "2.1.9"
  }
}
