{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxagen.sh/schemas/training-example/v1.json",
  "title": "Training example",
  "description": "One line of a training export: one done record with a final verdict and 30 days behind its merge, and the session that built against it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "item",
    "record",
    "label",
    "stage",
    "messages",
    "tools",
    "diff",
    "corrections"
  ],
  "properties": {
    "schema": {
      "const": "training-example/v1"
    },
    "item": {
      "$ref": "#/$defs/workItemId"
    },
    "record": {
      "$ref": "#/$defs/sha256",
      "description": "The done record's lock digest."
    },
    "label": {
      "enum": [
        "positive",
        "negative",
        "unlabeled"
      ],
      "description": "positive: proven and not reverted or reopened within 30 days. negative: broken, reverted, or reopened. unlabeled: stayed held."
    },
    "stage": {
      "enum": [
        "build",
        "test",
        "verify",
        "review"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The tool definitions the session received."
    },
    "diff": {
      "type": "string"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "before",
          "after"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "before": {},
          "after": {}
        }
      },
      "description": "Triage corrections people made to the work item."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256: and 64 lowercase hex characters."
    },
    "workItemId": {
      "type": "string",
      "pattern": "^wi_[0-9A-Za-z]+$",
      "description": "A work item's public id."
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tool_call_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
