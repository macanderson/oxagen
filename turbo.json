{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env.example",
    "pnpm-lock.yaml",
    "tsconfig.base.json",
    ".pnpmrc"
  ],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL_ENV",
    "PLATFORM_VERSION",
    "AI_GATEWAY_API_KEY",
    "OXAGEN_LLM_FAST",
    "OXAGEN_LLM_BALANCED",
    "OXAGEN_LLM_PRECISE",
    "OXAGEN_LLM_VIDEO_BASIC",
    "OXAGEN_LLM_VIDEO_ADVANCED",
    "OXAGEN_LLM_IMAGE_BASIC",
    "OXAGEN_LLM_IMAGE_ADVANCED",
    "OXAGEN_USAGE_DISCOUNT_PERCENT",
    "OXAGEN_USAGE_DISCOUNT_INCREMENT",
    "OXAGEN_USAGE_DISCOUNT_CEILING_USD",
    "DATABASE_URL",
    "CLICKHOUSE_URL",
    "CLICKHOUSE_USERNAME",
    "CLICKHOUSE_PASSWORD",
    "CLICKHOUSE_DATABASE",
    "NEO4J_URI",
    "NEO4J_USERNAME",
    "NEO4J_PASSWORD",
    "NEO4J_DATABASE",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "GOOGLE_LOGIN_CLIENT_ID",
    "GOOGLE_LOGIN_CLIENT_SECRET",
    "GOOGLE_DATA_CLIENT_ID",
    "GOOGLE_DATA_CLIENT_SECRET",
    "GITHUB_LOGIN_CLIENT_ID",
    "GITHUB_LOGIN_CLIENT_SECRET",
    "GITHUB_DATA_CLIENT_ID",
    "GITHUB_DATA_CLIENT_SECRET",
    "AUTH_TOKEN_ENCRYPTION_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_PUBLISHABLE_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_TAX_ENABLED",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USERNAME",
    "SMTP_PASSWORD",
    "SMTP_FROM_EMAIL",
    "SMTP_FROM_NAME",
    "SANDBOX_ENABLED",
    "SANDBOX_DRIVER",
    "MODAL_RUNNER_URL",
    "MODAL_RUNNER_TOKEN",
    "VERCEL_SANDBOX_TOKEN",
    "VERCEL_SANDBOX_TEAM_ID",
    "VERCEL_SANDBOX_PROJECT_ID",
    "IAM_ENFORCEMENT_ENABLED",
    "OXAGEN_TARGET_MARGIN",
    "OXAGEN_METER_MARKUP",
    "KNOWLEDGE_GRAPH_ENABLED",
    "TENANT_RLS_ENFORCEMENT_ENABLED",
    "MCP_PORT",
    "LOG_LEVEL",
    "BLOB_READ_WRITE_TOKEN",
    "STORAGE_DRIVER",
    "STORAGE_FS_ROOT",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_DOCS_URL",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
    "GOOGLE_MAPS_URL_SIGNING_SECRET",
    "AUDIT_EXPORT_SIGNING_SECRET",
    "OXAGEN_API_URL",
    "INGESTION_CRYPTO_PROVIDER",
    "AWS_KMS_INGESTION_KEY_ARN",
    "INGESTION_ENCRYPTION_KEY",
    "PRIVACY_ERASURE_GRACE_DAYS",
    "TAVILY_API_KEY",
    "ANTHROPIC_API_KEY",
    "OAUTH_PROXY_PRODUCTION_URL",
    "OAUTH_PROXY_SECRET",
    "APP_URL",
    "MARKETING_URL",
    "A2A_PUBLIC_URL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_SERVICE_NAME",
    "ALERT_WEBHOOK_URL",
    "SERVER_ACTIONS_ALLOWED_ORIGINS"
  ],
  "globalPassThroughEnv": [
    "CI",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "VERCEL",
    "VERCEL_URL"
  ],

  "remoteCache": { "enabled": true },

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "public/**",
        "next.config.*",
        "tsconfig.json",
        "package.json",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/__tests__/**",
        "!vitest.config.*",
        "!vitest.setup.*",
        "!**/.storybook/**",
        "!**/e2e/**"
      ],
      "outputs": [
        "dist/**",
        ".xmcp/**",
        ".vercel/output/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "passThroughEnv": [
        "VERCEL",
        "VERCEL_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "NEXT_PHASE"
      ]
    },

    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tsconfig.json", "package.json"],
      "outputs": []
    },

    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        ".eslintrc.*",
        "eslint.config.*",
        "package.json",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/eslint.next.mjs",
        "$TURBO_ROOT$/eslint.tenancy-seams.mjs"
      ],
      "outputs": []
    },

    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "test/**",
        "tests/**",
        "vitest.config.*"
      ],
      "outputs": ["coverage/**"],
      "env": ["LINEAR_API_KEY", "LINEAR_PROJECT_ID"],
      "passThroughEnv": ["CI"]
    },

    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "test/**",
        "tests/**",
        "vitest.config.*"
      ],
      "outputs": ["coverage/**"],
      "env": ["LINEAR_API_KEY", "LINEAR_PROJECT_ID"],
      "passThroughEnv": ["CI"]
    },

    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "e2e/**", "playwright.config.*"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "E2E_TEST",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USERNAME",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_DATABASE",
        "NEO4J_URI",
        "NEO4J_USERNAME",
        "NEO4J_PASSWORD",
        "NEO4J_DATABASE",
        "STRIPE_SECRET_KEY",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "AUTH_TOKEN_ENCRYPTION_KEY",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INGESTION_CRYPTO_PROVIDER",
        "INGESTION_ENCRYPTION_KEY",
        "AWS_KMS_INGESTION_KEY_ARN",
        "GITHUB_LOGIN_CLIENT_ID",
        "GITHUB_LOGIN_CLIENT_SECRET",
        "GOOGLE_LOGIN_CLIENT_ID",
        "GOOGLE_LOGIN_CLIENT_SECRET",
        "GITHUB_APP_CLIENT_ID",
        "GITHUB_APP_CLIENT_SECRET",
        "GITHUB_APP_INSTALL_STATE_SECRET",
        "GITHUB_APP_SLUG",
        "STORAGE_DRIVER",
        "STORAGE_FS_ROOT",
        "BLOB_READ_WRITE_TOKEN",
        "PLAYWRIGHT_BASE_URL"
      ],
      "passThroughEnv": ["CI", "PLAYWRIGHT_BROWSERS_PATH"]
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USERNAME",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_DATABASE",
        "NEO4J_URI",
        "NEO4J_USERNAME",
        "NEO4J_PASSWORD",
        "NEO4J_DATABASE",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "E2E_TEST",
        "GOOGLE_LOGIN_CLIENT_ID",
        "GOOGLE_LOGIN_CLIENT_SECRET",
        "GOOGLE_DATA_CLIENT_ID",
        "GOOGLE_DATA_CLIENT_SECRET",
        "GITHUB_LOGIN_CLIENT_ID",
        "GITHUB_LOGIN_CLIENT_SECRET",
        "GITHUB_DATA_CLIENT_ID",
        "GITHUB_DATA_CLIENT_SECRET",
        "AUTH_TOKEN_ENCRYPTION_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "OXAGEN_TARGET_MARGIN",
        "OXAGEN_METER_MARKUP",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "AI_GATEWAY_API_KEY",
        "OXAGEN_LLM_FAST",
        "OXAGEN_LLM_BALANCED",
        "OXAGEN_LLM_PRECISE",
        "SANDBOX_ENABLED",
        "SANDBOX_DRIVER",
        "MODAL_RUNNER_URL",
        "MODAL_RUNNER_TOKEN",
        "VERCEL_SANDBOX_TOKEN",
        "VERCEL_SANDBOX_TEAM_ID",
        "VERCEL_SANDBOX_PROJECT_ID",
        "IAM_ENFORCEMENT_ENABLED",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_DOCS_URL",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
        "GOOGLE_MAPS_URL_SIGNING_SECRET"
      ]
    },

    "generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },

    "migrate": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USERNAME",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_DATABASE",
        "NEO4J_URI",
        "NEO4J_USERNAME",
        "NEO4J_PASSWORD",
        "NEO4J_DATABASE"
      ]
    }
  }
}
