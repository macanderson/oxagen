{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env.example",
    "pnpm-lock.yaml",
    "tsconfig.base.json",
    ".npmrc"
  ],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL_ENV",
    "AI_GATEWAY_API_KEY",
    "OXAGEN_LLM_FAST",
    "OXAGEN_LLM_BALANCED",
    "OXAGEN_LLM_PRECISE",
    "OXAGEN_LLM_VIDEO_BASIC",
    "OXAGEN_LLM_VIDEO_ADVANCED",
    "OXAGEN_LLM_IMAGE_BASIC",
    "OXAGEN_LLM_IMAGE_ADVANCED",
    "OXAGEN_USAGE_DISCOUNT_PERCENT",
    "OXAGEN_USAGE_DISCOUNT_INCREMENT",
    "OXAGEN_USAGE_DISCOUNT_CEILING_USD"
  ],
  "globalPassThroughEnv": ["CI", "TURBO_TOKEN", "TURBO_TEAM", "VERCEL", "VERCEL_URL"],

  "remoteCache": { "enabled": true },

  "tasks": {

    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "public/**", "next.config.*", "tsconfig.json", "package.json"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".xmcp/**", ".vercel/output/**"],
      "passThroughEnv": ["VERCEL", "VERCEL_URL", "NEXT_PHASE"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "GOOGLE_LOGIN_CLIENT_ID",
        "GOOGLE_LOGIN_CLIENT_SECRET",
        "GOOGLE_DATA_CLIENT_ID",
        "GOOGLE_DATA_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "AUTH_TOKEN_ENCRYPTION_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "SMTP_FROM_EMAIL",
        "SMTP_FROM_NAME",
        "SANDBOX_ENABLED",
        "SANDBOX_DRIVER",
        "MODAL_RUNNER_URL",
        "MODAL_RUNNER_TOKEN",
        "VERCEL_SANDBOX_TOKEN",
        "VERCEL_SANDBOX_TEAM_ID",
        "VERCEL_SANDBOX_PROJECT_ID",
        "IAM_ENFORCEMENT_ENABLED",
        "OXAGEN_TARGET_MARGIN",
        "OXAGEN_METER_MARKUP",
        "KNOWLEDGE_GRAPH_ENABLED",
        "LOG_LEVEL",
        "BLOB_READ_WRITE_TOKEN",
        "STRIPE_TAX_ENABLED",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USERNAME",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_DATABASE",
        "NEO4J_URI",
        "NEO4J_USERNAME",
        "NEO4J_PASSWORD",
        "NEO4J_DATABASE",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
        "GOOGLE_MAPS_URL_SIGNING_SECRET"
      ]
    },

    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tsconfig.json", "package.json"],
      "outputs": ["*.tsbuildinfo"]
    },

    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "src/**", ".eslintrc.*", "eslint.config.*", "package.json"],
      "outputs": []
    },

    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "test/**", "tests/**", "vitest.config.*"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USERNAME",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_DATABASE",
        "NEO4J_URI",
        "NEO4J_USERNAME",
        "NEO4J_PASSWORD",
        "NEO4J_DATABASE",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "GOOGLE_LOGIN_CLIENT_ID",
        "GOOGLE_LOGIN_CLIENT_SECRET",
        "GOOGLE_DATA_CLIENT_ID",
        "GOOGLE_DATA_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "AUTH_TOKEN_ENCRYPTION_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "OXAGEN_TARGET_MARGIN",
        "OXAGEN_METER_MARKUP",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "AI_GATEWAY_API_KEY",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "OXAGEN_LLM_FAST",
        "OXAGEN_LLM_BALANCED",
        "OXAGEN_LLM_PRECISE",
        "SANDBOX_ENABLED",
        "SANDBOX_DRIVER",
        "MODAL_RUNNER_URL",
        "MODAL_RUNNER_TOKEN",
        "VERCEL_SANDBOX_TOKEN",
        "VERCEL_SANDBOX_TEAM_ID",
        "VERCEL_SANDBOX_PROJECT_ID",
        "IAM_ENFORCEMENT_ENABLED",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "LINEAR_API_KEY",
        "LINEAR_PROJECT_ID"
      ],
      "passThroughEnv": ["CI"]
    },

    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "test/**", "tests/**", "vitest.config.*"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USERNAME",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_DATABASE",
        "NEO4J_URI",
        "NEO4J_USERNAME",
        "NEO4J_PASSWORD",
        "NEO4J_DATABASE",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "GOOGLE_LOGIN_CLIENT_ID",
        "GOOGLE_LOGIN_CLIENT_SECRET",
        "GOOGLE_DATA_CLIENT_ID",
        "GOOGLE_DATA_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "AUTH_TOKEN_ENCRYPTION_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "OXAGEN_TARGET_MARGIN",
        "OXAGEN_METER_MARKUP",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "AI_GATEWAY_API_KEY",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "OXAGEN_LLM_FAST",
        "OXAGEN_LLM_BALANCED",
        "OXAGEN_LLM_PRECISE",
        "SANDBOX_ENABLED",
        "SANDBOX_DRIVER",
        "MODAL_RUNNER_URL",
        "MODAL_RUNNER_TOKEN",
        "VERCEL_SANDBOX_TOKEN",
        "VERCEL_SANDBOX_TEAM_ID",
        "VERCEL_SANDBOX_PROJECT_ID",
        "IAM_ENFORCEMENT_ENABLED",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "LINEAR_API_KEY",
        "LINEAR_PROJECT_ID"
      ],
      "passThroughEnv": ["CI"]
    },

    "test:e2e": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "e2e/**", "playwright.config.*"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "E2E_TEST"
      ],
      "passThroughEnv": ["CI"]
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USERNAME",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_DATABASE",
        "NEO4J_URI",
        "NEO4J_USERNAME",
        "NEO4J_PASSWORD",
        "NEO4J_DATABASE",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "GOOGLE_LOGIN_CLIENT_ID",
        "GOOGLE_LOGIN_CLIENT_SECRET",
        "GOOGLE_DATA_CLIENT_ID",
        "GOOGLE_DATA_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "AUTH_TOKEN_ENCRYPTION_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "OXAGEN_TARGET_MARGIN",
        "OXAGEN_METER_MARKUP",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "AI_GATEWAY_API_KEY",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "OXAGEN_LLM_FAST",
        "OXAGEN_LLM_BALANCED",
        "OXAGEN_LLM_PRECISE",
        "SANDBOX_ENABLED",
        "SANDBOX_DRIVER",
        "MODAL_RUNNER_URL",
        "MODAL_RUNNER_TOKEN",
        "VERCEL_SANDBOX_TOKEN",
        "VERCEL_SANDBOX_TEAM_ID",
        "VERCEL_SANDBOX_PROJECT_ID",
        "IAM_ENFORCEMENT_ENABLED",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
        "GOOGLE_MAPS_URL_SIGNING_SECRET"
      ]
    },

    "generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },

    "migrate": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USERNAME",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_DATABASE",
        "NEO4J_URI",
        "NEO4J_USERNAME",
        "NEO4J_PASSWORD",
        "NEO4J_DATABASE"
      ]
    }
  }
}
