/**
 * The records that have nothing to do with hosting, carried across from the
 * previous DNS provider so that moving the nameservers does not take mail,
 * DKIM signing, or a domain-ownership proof down with it.
 *
 * `imported-dns.json` is generated by `tools/import-dns.py` from an export of
 * the old zone, and is checked in deliberately: a 400-character DKIM public
 * key retyped by hand is a silent mail-delivery failure, and reviewing a
 * generated file against the export is a thing a human can actually do.
 *
 * The apex `MX` in that file is the one record here whose loss would be
 * immediately expensive — it is the Google Workspace mail route for the
 * domain. A nameserver change that omits it does not fail loudly; inbound mail
 * simply starts bouncing.
 */

locals {
  imported_dns = jsondecode(file("${path.module}/imported-dns.json"))
}

resource "aws_route53_record" "imported" {
  for_each = local.imported_dns

  zone_id = aws_route53_zone.oxagen_sh.zone_id
  name    = each.value.name == "" ? "oxagen.sh" : "${each.value.name}.oxagen.sh"
  type    = each.value.type
  ttl     = each.value.ttl
  records = each.value.records
}

# ---------------------------------------------------------------------------
# Subdomains still hosted elsewhere
# ---------------------------------------------------------------------------

# Subdomains still served by the previous host get an explicit record each.
#
# A wildcard was tried here first and must not come back. `*.oxagen.sh` makes
# every name that has no record of its own an alias to another domain, and
# RFC 8659 says a CAA check on an aliased name follows the CNAME — so ACM
# looked up the CAA policy of the *target* domain, found no `amazon.com`, and
# hard-failed with CAA_ERROR. That is not a slow validation that eventually
# succeeds: the certificate goes to FAILED and has to be reissued. It cost
# three reissues of the Stella certificate to find, because the failure names
# CAA and not the wildcard that caused it.
#
# The rule that follows: while any certificate in this zone is issued or
# renewed by ACM, this zone must contain no wildcard CNAME. Renewal re-runs
# validation, so adding one later breaks certificates that are working today.
#
# Each entry is temporary. It disappears when that subdomain moves to AWS.
resource "aws_route53_record" "legacy_host" {
  for_each = var.legacy_subdomains

  zone_id = aws_route53_zone.oxagen_sh.zone_id
  name    = "${each.key}.oxagen.sh"
  type    = "CNAME"
  ttl     = 300
  records = [each.value]
}

# ---------------------------------------------------------------------------
# Certificate authority authorisation
# ---------------------------------------------------------------------------

# Rewritten rather than carried over, and this is load-bearing: the previous
# zone authorised `pki.goog`, `sectigo.com` and `letsencrypt.org`, and a CAA
# record set that does not name Amazon forbids ACM from issuing for this
# domain at all. Copied verbatim, every certificate in this stack would fail
# validation — and CAA failures are quiet, surfacing only as a request that
# never leaves PENDING_VALIDATION.
#
# The three existing issuers stay because they are in use elsewhere: Google
# issues for the Workspace-hosted names, and dropping an issuer that something
# still relies on breaks its next renewal rather than anything visible today.
resource "aws_route53_record" "caa" {
  zone_id = aws_route53_zone.oxagen_sh.zone_id
  name    = "oxagen.sh"
  type    = "CAA"
  ttl     = 300

  records = [for issuer in var.caa_issuers : "0 issue \"${issuer}\""]
}
