{
  "name": "oxagen-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx tools/scripts/dev.ts",
    "kill": "tsx tools/scripts/kill.ts",
    "env:pull": "tsx tools/scripts/env-pull.ts",
    "env:manager": "pnpm --filter @oxagen/env-manager dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @oxagen/app exec playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env.local tools/scripts/db-migrate.ts",
    "db:generate": "pnpm --filter @oxagen/database run generate",
    "db:check": "tsx --env-file-if-exists=.env.local tools/scripts/db-check.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local tools/scripts/db-reset.ts",
    "check:manifest": "node tools/scripts/check_manifest.mjs",
    "gate": "turbo run lint typecheck test build --filter=...[origin/main] && pnpm check:manifest && pnpm test:e2e",
    "release:patch": "changeset version --type patch && pnpm install && git add -A && git commit -m 'chore: release patch' && pnpm changeset tag",
    "release:minor": "changeset version --type minor && pnpm install && git add -A && git commit -m 'chore: release minor' && pnpm changeset tag",
    "release:major": "changeset version --type major && pnpm install && git add -A && git commit -m 'chore: release major' && pnpm changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@eslint/js": "9.39.4",
    "@types/node": "25.9.1",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "tsx": "4.22.3",
    "turbo": "2.9.16",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.2",
      "typescript": "6.0.3"
    },
    "onlyBuiltDependencies": [
      "cpu-features",
      "esbuild",
      "protobufjs",
      "sharp",
      "ssh2",
      "unrs-resolver"
    ]
  }
}
