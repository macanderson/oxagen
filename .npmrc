auto-install-peers=true
strict-peer-dependencies=false
shared-workspace-lockfile=true
link-workspace-packages=deep
prefer-workspace-packages=true
node-linker=hoisted

# Force deterministic installs everywhere (incl. Vercel, which otherwise
# runs a non-frozen `pnpm install` and re-resolves peer deps — drifting
# TypeScript/zod/drizzle versions and breaking type inference in the build).
# Use `pnpm install --no-frozen-lockfile` locally when intentionally
# changing dependencies.
frozen-lockfile=true
