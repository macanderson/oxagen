        "~/.aws/credentials",
        "~/.ssh",
        "~/.config/gcloud"
      ]
    }
  },
  "spinnerTipsEnabled": true,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "oxagenating",
      "everyday I'm hustling",
      "i get knocked down but i get up again",
      "oh danny you're never gonna keep me down",
      "i saw the sign and it opened up my eyes",
      "i dont want to be your downfall",
      "code so clean you could eat off it",
      "refactoring your mom...",
      "huntie singing",
      "huntie is rooting for you"
