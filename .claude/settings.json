{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_USE_WORKTREES": "1",
    "CLAUDE_CODE_MAX_WORKTREES": "6",
    "CLAUDE_CODE_MAX_PARALLEL_AGENTS": "6",
    "CLAUDE_CODE_WORKTREE_BASE_DIR": "${CLAUDE_PROJECT_DIR}/.worktrees",
    "CLAUDE_CODE_AGENT_TEAM_SIZE": "6",
    "CLAUDE_CODE_BACKGROUND_AGENTS": "1"
  },
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "Grep",
      "Glob",
      "Write",
      "KillShell",
      "Edit",
      "Read",
      "ExitPlanMode",
      "LSP",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "TodoWrite",
      "TaskGet",
      "TaskCreate",
      "TaskList",
      "TaskStop",
      "TaskUpdate",
      "Skill",
      "TaskOutput",
      "Agent",
      "ToolSearch",
      "mcp__github__*",
      "mcp__vercel__*"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/scripts/hook-guard.sh\" lint 20 'pnpm lint --filter=...[HEAD] >/dev/null 2>&1 && echo \"\u2713 Lint passed\" || echo \"\u26a0 Lint found issues\"'",
            "timeout": 60,
            "statusMessage": "Linting changed packages...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\u2139 CI runs the authoritative full gate on every push/PR (GitHub Actions). The local pre-commit/push full-gate hook is intentionally disabled \u2014 running turbo test:coverage+build on every commit across concurrent sessions saturated RAM and ballooned swap/compressor to ~100GB. Run `pnpm gate` manually before marking a body of work ready to merge.'",
            "timeout": 5,
            "statusMessage": "CI gate runs on push/PR (local full-gate hook disabled)...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/scripts/hook-guard.sh\" backfill 120 'if [[ -n \"$PRODUCTION_ANALYTICS_URL\" && -n \"$PRODUCTION_ANALYTICS_USER\" && -n \"$PRODUCTION_ANALYTICS_PASSWORD\" ]]; then ./node_modules/.bin/tsx tools/scripts/backfill-claude-telemetry.ts >/dev/null 2>&1 || true; fi'",
            "timeout": 90,
            "statusMessage": "Backfilling telemetry (debounced)...",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-full-test-builds.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".cache",
      ".turbo",
      ".next",
      ".venv",
      "target",
      "dist"
    ],
    "sparsePaths": ["apps", "packages", "tools", ".agents", ".claude"],
    "baseRef": "fresh",
    "bgIsolation": "none"
  },
  "enabledPlugins": {
    "explanatory-output-style@claude-plugins-official": false,
    "playground@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": false,
    "deploy-on-aws@claude-plugins-official": false,
    "terraform@claude-plugins-official": false,
    "aws-serverless@claude-plugins-official": false,
    "migration-to-aws@claude-plugins-official": false,
    "aws-dev-toolkit@claude-plugins-official": false,
    "aws-core@claude-plugins-official": false,
    "databases-on-aws@claude-plugins-official": false,
    "aws-agents@claude-plugins-official": false,
    "redis-development@claude-plugins-official": false,
    "clickhouse@claude-plugins-official": false,
    "clickhouse-best-practices@claude-plugins-official": false,
    "aws-startup-advisor@claude-plugins-official": false,
    "claude-api@anthropic-agent-skills": false,
    "document-skills@anthropic-agent-skills": false,
    "modern-web-guidance@googlechrome": true,
    "superpowers@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "fastMode": false,
  "awaySummaryEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
P1 · Issue Kind (Bug|Feature|Improvement|Chore) · Functional Area · Issue summary (short)
Labels must include: 1 priority label, at least 1 kind label (defect/feature etc), and at least one area label  and at least

