{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": false,
  "cleanupPeriodDays": 60,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "10",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_MAX_RETRIES": "2",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "0",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "ANTHROPIC_MODEL": "haiku",
    "OTEL_METRICS_EXPORTER": "posthog",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "LSP",
      "NotebookEdit",
      "Skill",
      "Agent",
      "TodoWrite",
      "ToolSearch",
      "WebSearch",
      "WebFetch",
      "ExitPlanMode",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "KillShell",
      "PowerShell",
      "Read(.env)",
      "Read(.env.*.local)",
      "Read(.env.local)",
      "mcp__plugin_stripe_stripe__*",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__*",
      "mcp__chrome-devtools__*",
      "mcp__oxagen__*",
      "mcp__plugin_oxagen_oxagen__*",
      "mcp__plugin_oxagen__*",
      "mcp__plugin_pyright-lsp__*",
      "mcp__plugin_typescript-lsp__*",
      "mcp__plugin_agent-sdk-dev__*",
      "mcp__plugin_mcp-server-dev__*",
      "mcp__plugin_posthog_posthog__*",
      "mcp__plugin_dev__*",
      "mcp__plugin_github_github__*",
      "mcp__plugin_playwright_playwright__*",
      "mcp__claude_ai_Linear__*",
      "mcp__claude_ai_Vercel__*"
    ],
    "deny": [
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/config)",
      "Read(./*.pem)",
      "Read(./*.key)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(./credentials/**)",
      "Read(./private/**)",
      "Bash(curl * | sh *)",
      "Bash(curl * | bash *)",
      "Bash(wget * | sh *)",
      "Bash(wget * | bash *)",
      "Bash(* | sudo sh *)",
      "Bash(* | sudo bash *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf .git/*)",
      "Bash(rm -rf node_modules /*)",
      "Bash(sudo rm -rf *)",
      "Bash(chmod -R 777 /*)",
      "Bash(chown -R *)",
      "Bash(mkfs* *)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(git push --force * main*)",
      "Bash(git push --force * master*)",
      "Bash(git push --force-with-lease * main*)",
      "Bash(git push --force-with-lease * master*)",
      "Bash(git push -f * main*)",
      "Bash(git push -f * master*)",
      "Bash(git push origin :main*)",
      "Bash(git push origin :master*)",
      "Bash(git push * --delete main*)",
      "Bash(git push * --delete master*)",
      "Bash(git push * --no-verify *)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit *--no-gpg-sign*)",
      "Bash(git commit *-c commit.gpgsign=false*)",
      "Bash(git rebase * main*)",
      "Bash(git rebase * master*)",
      "Bash(git reset --hard origin/main*)",
      "Bash(git reset --hard origin/master*)",
      "Bash(git reset --hard HEAD~*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D master*)",
      "Bash(git branch -D origin/main*)",
      "Bash(git branch -D origin/master*)",
      "Bash(git checkout -- *)",
      "Bash(git restore --staged --worktree --source *)",
      "Bash(git clean -fdx *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(cargo publish *)",
      "Bash(uv publish *)",
      "Bash(terraform force-unlock*)",
      "Bash(tofu force-unlock*)",
      "Bash(gcloud * delete *)",
      "Bash(gcloud * update *)",
      "Bash(gcloud * create *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl create *)",
      "Bash(aws * delete *)",
      "Bash(aws * create *)",
      "Bash(aws * update *)",
      "Bash(az * delete *)",
      "Bash(az * create *)",
      "Bash(az * update *)",
      "Bash(docker push *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(psql *DROP DATABASE*)",
      "Bash(psql *DROP SCHEMA*)",
      "Bash(psql *DROP TABLE*)",
      "Bash(psql *TRUNCATE*)",
      "Bash(psql *DELETE FROM*)",
      "Bash(psql *drop database*)",
      "Bash(psql *drop schema*)",
      "Bash(psql *drop table*)",
      "Bash(psql *truncate*)",
      "Bash(psql *delete from*)",
      "Bash(dropdb *)",
      "Bash(mysql *DROP DATABASE*)",
      "Bash(mysql *DROP SCHEMA*)",
      "Bash(mysql *DROP TABLE*)",
      "Bash(mysql *TRUNCATE*)",
      "Bash(mysql *drop database*)",
      "Bash(mysql *drop schema*)",
      "Bash(mysqladmin drop*)",
      "Bash(sqlite3 *DROP TABLE*)",
      "Bash(sqlite3 *.drop *)",
      "Bash(redis-cli FLUSHALL*)",
      "Bash(redis-cli FLUSHDB*)",
      "Bash(redis-cli * FLUSHALL*)",
      "Bash(redis-cli * FLUSHDB*)",
      "Bash(mongo *dropDatabase*)",
      "Bash(mongosh *dropDatabase*)",
      "Bash(alembic downgrade base*)",
      "Bash(alembic downgrade -*)",
      "Bash(prisma migrate reset*)",
      "Bash(terraform destroy*)",
      "Bash(terraform * destroy*)",
      "Bash(gcloud sql instances delete*)",
      "Bash(gcloud sql databases delete*)",
      "Bash(gcloud alloydb clusters delete*)",
      "Bash(gcloud alloydb instances delete*)",
      "Bash(gcloud spanner instances delete*)",
      "Bash(gcloud spanner databases delete*)",
      "Bash(gcloud firestore databases delete*)",
      "Bash(gcloud bigtable instances delete*)",
      "Bash(gcloud redis instances delete*)",
      "Bash(gcloud storage rm -r*)",
      "Bash(gcloud storage buckets delete*)",
      "Bash(gsutil rm -r*)",
      "Bash(gsutil -m rm -r*)",
      "Bash(gcloud projects delete*)",
      "Bash(gcloud secrets delete*)",
      "Bash(gcloud secrets versions destroy*)",
      "Bash(gcloud kms keys versions destroy*)",
      "Bash(gcloud container clusters delete*)",
      "Bash(gcloud run services delete*)",
      "Bash(gcloud compute disks delete*)",
      "Bash(gcloud iam service-accounts delete*)",
      "Bash(aws rds delete-db-instance*)",
      "Bash(aws rds delete-db-cluster*)",
      "Bash(aws rds delete-db-snapshot*)",
      "Bash(aws s3 rb*)",
      "Bash(aws s3 rm * --recursive*)",
      "Bash(aws s3api delete-bucket*)",
      "Bash(aws dynamodb delete-table*)",
      "Bash(aws ec2 terminate-instances*)",
      "Bash(aws iam delete-user*)",
      "Bash(aws iam delete-role*)",
      "Bash(aws secretsmanager delete-secret*)",
      "Bash(aws kms schedule-key-deletion*)",
      "Bash(aws eks delete-cluster*)",
      "Bash(az group delete*)",
      "Bash(az sql db delete*)",
      "Bash(az sql server delete*)",
      "Bash(az postgres server delete*)",
      "Bash(az postgres flexible-server delete*)",
      "Bash(az storage account delete*)",
      "Bash(az storage container delete*)",
      "Bash(az keyvault delete*)",
      "Bash(az keyvault secret delete*)",
      "Bash(az aks delete*)",
      "Bash(kubectl delete namespace*)",
      "Bash(kubectl delete ns *)",
      "Bash(kubectl delete pvc*)",
      "Bash(kubectl delete pv*)",
      "Bash(kubectl delete persistentvolume*)",
      "Bash(kubectl delete persistentvolumeclaim*)",
      "Bash(kubectl delete -f * --all*)",
      "Bash(kubectl delete all --all*)",
      "Bash(kubectl delete crd*)",
      "Bash(kubectl drain * --force*)",
      "Bash(helm uninstall*)",
      "Bash(helm delete*)",
      "Bash(docker volume rm*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opusplan",
  "availableModels": [
    "opus[1m]",
    "opus",
    "sonnet",
    "sonnet[1m]",
    "haiku",
    "opusplan",
    "fable"
  ],
  "enableAllProjectMcpServers": true,
  "skillListingMaxDescChars": 512,
  "skillListingBudgetFraction": 0.002,
  "skillOverrides": {
    "oxagen-code-audit": "name-only",
    "audit-e2e": "name-only",
    "audit-security": "name-only",
    "audit-soc2": "name-only",
    "audit-tenancy": "name-only",
    "audit-tests": "name-only",
    "grep-auditor": "name-only",
    "pr-hygiene-auditor": "name-only",
    "test-build-auditor": "name-only",
    "code-architecture-auditor": "name-only",
    "compliance-tenancy-auditor": "name-only",
    "parity-docs-auditor": "name-only",
    "release-audit": "name-only",
    "prune-stale-branches-and-worktrees": "name-only",
    "remove-deadcode": "name-only",
    "create-auth-skill": "name-only",
    "email-and-password-best-practices": "name-only",
    "two-factor-authentication-best-practices": "name-only",
    "organization-best-practices": "name-only",
    "vendor-better-auth": "name-only",
    "reablocks": "name-only",
    "reagraph": "name-only",
    "reaviz": "name-only",
    "coss-ui": "name-only",
    "oxagen-design-system": "name-only",
    "vercel:bootstrap": "name-only",
    "vercel:status": "name-only",
    "vercel:marketplace": "name-only",
    "vercel:env": "name-only",
    "vercel:knowledge-update": "name-only",
    "vercel:verification": "name-only",
    "vercel:storage": "name-only",
    "vercel:workflow": "name-only",
    "vercel:runtime-cache": "name-only",
    "vercel:deployment-expert": "name-only",
    "vercel:performance-optimizer": "name-only",
    "modern-web-guidance": "name-only",
    "chrome-devtools-mcp": "name-only",
    "keybindings-help": "name-only",
    "update-config": "name-only",
    "iterative-retrieval": "name-only",
    "prompt-optimizer": "name-only",
    "context-budget": "name-only",
    "find-skills": "name-only"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx $CLAUDE_TELEMETRY_LOGGER",
            "timeout": 3,
            "statusMessage": "Recording telemetry...",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx \"$CLAUDE_PROJECT_DIR/tools/scripts/claude-session-summary.ts\"",
            "timeout": 10,
            "statusMessage": "Recording session summary to ClickHouse...",
            "async": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".cache",
      ".turbo",
      ".next",
      ".venv",
      "target",
      "dist"
    ],
    "sparsePaths": ["apps", "packages", "tools", ".agents", ".claude"],
    "baseRef": "head",
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "stripe@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "session-report@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "posthog@claude-plugins-official": false
  },
  "sandbox": {
    "enabled": false,
    "filesystem": {
      "denyRead": ["~/.aws/credentials", "~/.ssh", "~/.config/gcloud"]
    }
  },
  "spinnerTipsEnabled": true,
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "oxagenating",
      "retrieving the best context",
      "analyzing the codebase",
      "formulating a plan",
      "executing the plan",
      "checking for updates",
      "optimizing the prompt",
      "consulting the documentation",
      "and more oxagen things...",
      "hopping around on the graph",
      "summarizing findings",
      "debugging"
    ]
  },
  "alwaysThinkingEnabled": true,
  "companyAnnouncements": ["Oxagen is REAL - let's get it... 🚀"],
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "terminalProgressBarEnabled": true,
  "teammateMode": "auto"
}
