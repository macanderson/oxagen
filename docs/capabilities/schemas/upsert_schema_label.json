{
  "name": "upsert_schema_label",
  "domain": "schema",
  "description": "Create/update a node label on a schema within the draft version.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "schema"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schemaName": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Node label name (e.g. Customer, Contract)"
      },
      "displayName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "maxLength": 2000
      },
      "naturalKeyProps": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "properties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Property name"
            },
            "dataType": {
              "type": "string",
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "date",
                "datetime",
                "url",
                "email",
                "enum",
                "json",
                "array"
              ]
            },
            "required": {
              "type": "boolean",
              "default": false
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "enumValues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "itemType": {
              "type": "string"
            },
            "constraints": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "minLength": {
                  "type": "integer"
                },
                "maxLength": {
                  "type": "integer"
                },
                "pattern": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "description": "Validation constraints mirroring the connector FieldValidation shape"
            },
            "example": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "dataType"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "schemaName",
      "name",
      "displayName"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "labelId": {
        "type": "string"
      },
      "created": {
        "type": "boolean"
      }
    },
    "required": [
      "labelId",
      "created"
    ],
    "additionalProperties": false
  }
}
