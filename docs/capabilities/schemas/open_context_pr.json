{
  "name": "open_context_pr",
  "domain": "context",
  "description": "Open the Context PR for a proposal: a branch from the production branch, the single record file, the PR body with rationale, supporting records and evidence, then the six checks one at a time as GitHub check runs or GitLab commit statuses. In a legacy repository the file is .oxagen/rules/<lineage>.toml on steering/<lineage>. In a steering repository it is a steering record at steering/<kind folder>/<lineage>.md on steering/<lineage>, or for a memory steering/memory/workspace/general/<lineage>.md on memory/<lineage>. A revision is written where the record lives now. A repository-scoped proposal in a steering repository is refused repository_scope_needs_repo unless the record it revises lists its repos. On GitLab the PR is a merge request. Re-runs the checks when the PR is already open.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "governance"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "proposalId": {
        "type": "string"
      }
    },
    "required": [
      "proposalId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "proposalId": {
        "type": "string"
      },
      "lineageId": {
        "type": "string"
      },
      "kind": {
        "type": "string",
        "enum": [
          "rule",
          "constraint",
          "procedure",
          "fact",
          "memory",
          "preference",
          "governance"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "proposed",
          "pr_open",
          "checks_running",
          "checks_passed",
          "checks_failed",
          "merged",
          "rejected"
        ]
      },
      "governanceMode": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "solo",
              "team",
              "regulated"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "pr": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "url": {
                "type": "string"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "github",
                  "gitlab"
                ]
              },
              "repository": {
                "type": "string"
              },
              "baseRef": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "headSha": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "number",
              "url",
              "provider",
              "repository",
              "baseRef",
              "branch",
              "headSha",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "record": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "recordId": {
                "type": "string"
              },
              "recordHash": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "rule",
                  "constraint",
                  "procedure",
                  "fact",
                  "memory",
                  "preference"
                ]
              },
              "force": {
                "type": "string",
                "enum": [
                  "must",
                  "should",
                  "may",
                  "info"
                ]
              },
              "constraintEffect": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "require",
                      "forbid"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sharingScope": {
                "type": "string",
                "enum": [
                  "repository",
                  "workspace"
                ]
              },
              "statement": {
                "type": "string"
              }
            },
            "required": [
              "recordId",
              "recordHash",
              "kind",
              "force",
              "constraintEffect",
              "sharingScope",
              "statement"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "body": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "schema",
                "lineage_uniqueness",
                "record_hash",
                "secret_pii_scan",
                "conflict_against_active",
                "constraint_effect"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "passed",
                "failed"
              ]
            },
            "summary": {
              "type": "string"
            },
            "detailsUrl": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "startedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "completedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "status",
            "summary",
            "detailsUrl",
            "startedAt",
            "completedAt"
          ],
          "additionalProperties": false
        }
      },
      "onMerge": {
        "type": "object",
        "properties": {
          "publishes": {
            "type": "object",
            "properties": {
              "lineageId": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "lineageId",
              "path"
            ],
            "additionalProperties": false
          },
          "bundleVersion": {
            "type": "object",
            "properties": {
              "current": {
                "type": "integer"
              },
              "afterMerge": {
                "type": "integer"
              }
            },
            "required": [
              "current",
              "afterMerge"
            ],
            "additionalProperties": false
          },
          "review": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "publishes",
          "bundleVersion",
          "review"
        ],
        "additionalProperties": false
      },
      "merged": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "commit": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "byUserId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "promotionEventId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recordId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "commit",
              "at",
              "byUserId",
              "promotionEventId",
              "recordId"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "proposalId",
      "lineageId",
      "kind",
      "status",
      "governanceMode",
      "pr",
      "record",
      "body",
      "checks",
      "onMerge",
      "merged"
    ],
    "additionalProperties": false
  }
}
