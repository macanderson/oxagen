{
  "name": "list_eval_runs",
  "domain": "eval",
  "description": "List eval runs for the workspace (optionally scoped to one dataset) with server-side date/status/model filtering, sorting, and pagination — the read that backs a sortable eval-runs table. Rolls up per-run cost and token totals from the ClickHouse metering pipe.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "read"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "datasetPublicId": {
        "type": "string",
        "minLength": 1
      },
      "since": {
        "type": "string"
      },
      "until": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "queued",
          "running",
          "completed",
          "failed",
          "cancelled"
        ]
      },
      "model": {
        "type": "string",
        "minLength": 1
      },
      "sortBy": {
        "type": "string",
        "enum": [
          "score",
          "created",
          "model",
          "status"
        ],
        "default": "created"
      },
      "sortDir": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ],
        "default": "desc"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 25
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string"
            },
            "datasetId": {
              "type": "string"
            },
            "datasetName": {
              "type": "string"
            },
            "datasetSlug": {
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "model",
                    "agent"
                  ]
                },
                "model": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "agentSlug": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "model",
                "agentSlug"
              ],
              "additionalProperties": false
            },
            "judgeModel": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "itemCount": {
              "type": "integer",
              "minimum": 0
            },
            "completedCount": {
              "type": "integer",
              "minimum": 0
            },
            "failedCount": {
              "type": "integer",
              "minimum": 0
            },
            "avgScore": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "passThreshold": {
              "type": "number"
            },
            "costUsdMicros": {
              "type": "number",
              "minimum": 0
            },
            "inputTokens": {
              "type": "number",
              "minimum": 0
            },
            "outputTokens": {
              "type": "number",
              "minimum": 0
            },
            "createdAt": {
              "type": "string"
            },
            "completedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "runId",
            "datasetId",
            "datasetName",
            "datasetSlug",
            "name",
            "target",
            "judgeModel",
            "status",
            "itemCount",
            "completedCount",
            "failedCount",
            "avgScore",
            "passThreshold",
            "costUsdMicros",
            "inputTokens",
            "outputTokens",
            "createdAt",
            "completedAt"
          ],
          "additionalProperties": false
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0
      },
      "allTimeTotal": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "runs",
      "total",
      "allTimeTotal"
    ],
    "additionalProperties": false
  }
}
