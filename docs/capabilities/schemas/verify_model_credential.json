{
  "name": "verify_model_credential",
  "domain": "org",
  "description": "Check a model-vendor API key against the vendor. Pass provider and apiKey (plus baseUrl for an OpenAI-compatible endpoint, and modelMap for a direct vendor) to test a candidate before storing it, or nothing to test the organisation's stored key. Reports whether the vendor accepted it, whether each mapped model can call tools and which tier cannot, and the vendor's reason when either fails. A direct vendor's check sends one forced tool call, capped at a few output tokens, to each mapped model. An OpenAI-compatible endpoint is also asked for one JSON-schema answer.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "enum": [
          "openrouter",
          "gateway",
          "openai",
          "anthropic",
          "openai_compatible"
        ]
      },
      "apiKey": {
        "type": "string",
        "minLength": 8,
        "maxLength": 512
      },
      "baseUrl": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          {
            "type": "null"
          }
        ]
      },
      "toolProbeModel": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          {
            "type": "null"
          }
        ]
      },
      "modelMap": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "fast": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "balanced": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "precise": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false,
    "x-server-validated": true,
    "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "provider": {
        "type": "string",
        "enum": [
          "openrouter",
          "gateway",
          "openai",
          "anthropic",
          "openai_compatible"
        ]
      },
      "latencyMs": {
        "type": "integer",
        "minimum": 0
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "toolCalling": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "toolCallingByTier": {
        "type": "object",
        "properties": {
          "fast": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "balanced": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "precise": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "failingTier": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "precise"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "ok",
      "provider",
      "latencyMs",
      "error",
      "toolCalling"
    ],
    "additionalProperties": false
  }
}
