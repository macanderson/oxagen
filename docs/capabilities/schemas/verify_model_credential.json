{
  "name": "verify_model_credential",
  "domain": "org",
  "description": "Check a model-vendor API key against the vendor without spending tokens. Pass provider and apiKey to test a candidate before storing it, or nothing to test the organisation's stored key. Reports whether the vendor accepted it and, if not, the vendor's reason.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "enum": [
          "openrouter",
          "gateway"
        ]
      },
      "apiKey": {
        "type": "string",
        "minLength": 8,
        "maxLength": 512
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "provider": {
        "type": "string",
        "enum": [
          "openrouter",
          "gateway"
        ]
      },
      "latencyMs": {
        "type": "integer",
        "minimum": 0
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "ok",
      "provider",
      "latencyMs",
      "error"
    ],
    "additionalProperties": false
  }
}
