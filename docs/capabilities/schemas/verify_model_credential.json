{
  "name": "verify_model_credential",
  "domain": "org",
  "description": "Check a model-vendor API key against the vendor. Pass provider and apiKey (and baseUrl plus toolProbeModel for an OpenAI-compatible endpoint) to test a candidate before storing it, or nothing to test the organisation's stored key. Reports whether the vendor accepted it, whether the endpoint can call tools, and the vendor's reason when either fails. Free for the named vendors; an OpenAI-compatible endpoint is asked one forced tool call of at most 16 tokens.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "enum": [
          "openrouter",
          "gateway",
          "openai",
          "anthropic",
          "openai_compatible"
        ]
      },
      "apiKey": {
        "type": "string",
        "minLength": 8,
        "maxLength": 512
      },
      "baseUrl": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          {
            "type": "null"
          }
        ]
      },
      "toolProbeModel": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false,
    "x-server-validated": true,
    "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "provider": {
        "type": "string",
        "enum": [
          "openrouter",
          "gateway",
          "openai",
          "anthropic",
          "openai_compatible"
        ]
      },
      "latencyMs": {
        "type": "integer",
        "minimum": 0
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "toolCalling": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "ok",
      "provider",
      "latencyMs",
      "error",
      "toolCalling"
    ],
    "additionalProperties": false
  }
}
