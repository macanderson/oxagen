{
  "name": "commit_memory_import",
  "domain": "agent",
  "description": "Write a batch of confirmed draft memories into the workspace AgentMemory graph. Per-item error capture — not all-or-nothing. Backs the bulk-import button.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "memory"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "drafts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "lesson": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The atomic lesson/rule to remember, in one or two sentences"
            },
            "memoryClass": {
              "type": "string",
              "enum": [
                "OBSERVATION",
                "RULE",
                "FACT"
              ],
              "default": "OBSERVATION"
            },
            "memoryKind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "The content domain the parser classified this as"
            },
            "enforcementScore": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "default": "user"
            },
            "nodeRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "default": "user-memory"
            },
            "sourceDocument": {
              "type": "string",
              "maxLength": 256,
              "default": ""
            },
            "classified": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "lesson",
            "memoryKind"
          ],
          "additionalProperties": false
        },
        "description": "The confirmed draft memories to persist (max 200 per call)"
      }
    },
    "required": [
      "drafts"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "lesson": {
              "type": "string",
              "description": "Echo of the draft lesson, for client reconciliation"
            },
            "ok": {
              "type": "boolean"
            },
            "memoryId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "error": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "lesson",
            "ok",
            "memoryId",
            "error"
          ],
          "additionalProperties": false
        },
        "description": "Positional results — results[i] corresponds to drafts[i]"
      },
      "imported": {
        "type": "number",
        "description": "Count of drafts written successfully"
      },
      "failed": {
        "type": "number",
        "description": "Count of drafts that failed to write"
      }
    },
    "required": [
      "results",
      "imported",
      "failed"
    ],
    "additionalProperties": false
  }
}
