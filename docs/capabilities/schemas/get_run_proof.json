{
  "name": "get_run_proof",
  "domain": "run",
  "description": "Read one run's proof record: every witness that reported on it with each attempt's target and head results, fingerprints and attestation, the run's verdict, the cost of each witness run, and the workspace's disclosure grain.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runId": {
        "type": "string"
      }
    },
    "required": [
      "runId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runId": {
        "type": "string"
      },
      "verdict": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "flipped",
              "failing",
              "unmoved",
              "unsatisfied",
              "tampered",
              "unverified",
              "waived"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "witnesses": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "witnessId": {
              "type": "string"
            },
            "oracle": {
              "type": "string",
              "enum": [
                "test_flip",
                "build_or_type",
                "property",
                "golden_snapshot",
                "contract",
                "metamorphic",
                "behavioral_probe"
              ]
            },
            "commandDigest": {
              "type": "string"
            },
            "heldOut": {
              "type": "boolean"
            },
            "verdict": {
              "type": "string",
              "enum": [
                "flipped",
                "failing",
                "unmoved",
                "unsatisfied",
                "tampered",
                "unverified",
                "waived"
              ]
            },
            "attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "attemptNo": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "frameSeq": {
                    "type": "string"
                  },
                  "observedAt": {
                    "type": "string"
                  },
                  "targetRef": {
                    "type": "string"
                  },
                  "targetSha": {
                    "type": "string"
                  },
                  "prRef": {
                    "type": "string"
                  },
                  "prSha": {
                    "type": "string"
                  },
                  "targetResult": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "excluded",
                      "inconclusive"
                    ]
                  },
                  "prResult": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "excluded",
                      "inconclusive"
                    ]
                  },
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "flipped",
                      "failing",
                      "unmoved",
                      "unsatisfied",
                      "tampered",
                      "unverified",
                      "waived"
                    ]
                  },
                  "failFingerprint": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "passOutputDigest": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tamperExclusion": {
                    "type": "string",
                    "enum": [
                      "held",
                      "broken"
                    ]
                  },
                  "tamper": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "fingerprintAuthored": {
                            "type": "string"
                          },
                          "fingerprintAtRun": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "fingerprintAuthored",
                          "fingerprintAtRun"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "disclosureGrain": {
                    "type": "string",
                    "enum": [
                      "L0",
                      "L1",
                      "L2",
                      "L3"
                    ]
                  },
                  "witnessRunId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "runnerAttestation": {
                    "type": "object",
                    "properties": {
                      "keyId": {
                        "type": "string"
                      },
                      "signature": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "keyId",
                      "signature"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "attemptNo",
                  "frameSeq",
                  "observedAt",
                  "targetRef",
                  "targetSha",
                  "prRef",
                  "prSha",
                  "targetResult",
                  "prResult",
                  "verdict",
                  "failFingerprint",
                  "passOutputDigest",
                  "tamperExclusion",
                  "tamper",
                  "disclosureGrain",
                  "witnessRunId",
                  "runnerAttestation"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "witnessId",
            "oracle",
            "commandDigest",
            "heldOut",
            "verdict",
            "attempts"
          ],
          "additionalProperties": false
        }
      },
      "witnessRuns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string"
            },
            "cost": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "micros": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "gateway_observed",
                        "client_attested",
                        "mixed",
                        "estimated"
                      ]
                    }
                  },
                  "required": [
                    "micros",
                    "currency",
                    "basis"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "runId",
            "cost"
          ],
          "additionalProperties": false
        }
      },
      "disclosureGrain": {
        "type": "string",
        "enum": [
          "L0",
          "L1",
          "L2",
          "L3"
        ]
      }
    },
    "required": [
      "runId",
      "verdict",
      "witnesses",
      "witnessRuns",
      "disclosureGrain"
    ],
    "additionalProperties": false
  }
}
