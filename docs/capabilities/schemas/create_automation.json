{
  "name": "create_automation",
  "domain": "automation",
  "description": "Create a playbook and trigger for an automation. Use triggerType='event' for graph node changes (e.g. Contact status changes, new Commit nodes), 'schedule' for cron-based runs, or 'api' for manually-triggered playbooks. The steps array scaffolds the initial action — leave it empty to create a blank playbook. Always populate triggerConfig fully based on what the user described. Automations created by an AI agent ALWAYS start disabled regardless of the `enabled` input — a human must explicitly enable them via automation.enable.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "automation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "description": "Human-readable name for this automation"
      },
      "description": {
        "type": "string",
        "maxLength": 500
      },
      "triggerType": {
        "type": "string",
        "enum": [
          "event",
          "schedule",
          "api"
        ],
        "description": "How this automation is triggered: 'event' = graph node change, 'schedule' = cron, 'api' = manual"
      },
      "triggerConfig": {
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "node.created",
              "node.updated",
              "node.deleted"
            ]
          },
          "conditionTree": {
            "x-zod-type": "ZodLazy"
          },
          "propertyConditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "property": {
                  "type": "string",
                  "description": "Property name to evaluate, e.g. 'status', 'value'"
                },
                "fromValue": {},
                "toValue": {},
                "operator": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "gt",
                    "lt",
                    "changed"
                  ],
                  "default": "eq"
                }
              },
              "required": [
                "property"
              ],
              "additionalProperties": false
            }
          },
          "cronExpression": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "default": {}
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Step name"
            },
            "stepType": {
              "type": "string",
              "enum": [
                "agent",
                "tool",
                "condition",
                "webhook",
                "prompt",
                "human_input"
              ],
              "description": "Type of action this step performs"
            },
            "config": {
              "type": "object",
              "additionalProperties": {},
              "default": {}
            }
          },
          "required": [
            "name",
            "stepType"
          ],
          "additionalProperties": false
        },
        "default": []
      },
      "enabled": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "name",
      "triggerType"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "automation_id": {
        "type": "string",
        "description": "Trigger public ID — use this with automation.trigger to fire it manually"
      },
      "playbook_id": {
        "type": "string",
        "description": "Playbook public ID"
      },
      "name": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "triggerType": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean",
        "description": "Whether the trigger is live. False when created by an AI agent — call automation.enable (human-gated) to activate."
      }
    },
    "required": [
      "automation_id",
      "playbook_id",
      "name",
      "status",
      "triggerType",
      "enabled"
    ],
    "additionalProperties": false
  }
}
