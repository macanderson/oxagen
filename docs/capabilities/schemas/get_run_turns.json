{
  "name": "get_run_turns",
  "domain": "run",
  "description": "Read one run's per-turn ledger over every frame it recorded: each turn's model and tool steps, frames, cost and the cost so far, and the input tokens its model calls reported, uncached and read from the cache. A subagent's frames count toward the turn that spawned it.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli"
  ],
  "sensitivity": "medium",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runId": {
        "type": "string"
      }
    },
    "required": [
      "runId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runId": {
        "type": "string"
      },
      "turns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "turn": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "seq": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "frames": {
              "type": "integer",
              "minimum": 0
            },
            "modelSteps": {
              "type": "integer",
              "minimum": 0
            },
            "toolSteps": {
              "type": "integer",
              "minimum": 0
            },
            "cost": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "micros": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "gateway_observed",
                        "client_attested",
                        "mixed",
                        "estimated"
                      ]
                    }
                  },
                  "required": [
                    "micros",
                    "currency",
                    "basis"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "cumulativeCost": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "micros": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "gateway_observed",
                        "client_attested",
                        "mixed",
                        "estimated"
                      ]
                    }
                  },
                  "required": [
                    "micros",
                    "currency",
                    "basis"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "tokens": {
              "type": "object",
              "properties": {
                "inputUncached": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cacheRead": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "inputUncached",
                "cacheRead"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "turn",
            "seq",
            "at",
            "frames",
            "modelSteps",
            "toolSteps",
            "cost",
            "cumulativeCost",
            "tokens"
          ],
          "additionalProperties": false
        },
        "maxItems": 10000
      },
      "complete": {
        "type": "boolean"
      }
    },
    "required": [
      "runId",
      "turns",
      "complete"
    ],
    "additionalProperties": false
  }
}
