{
  "name": "list_slack_channels",
  "domain": "org",
  "description": "List the channels in the organization's connected Slack workspace that steering notices can post to, sorted by name.",
  "mode": "sync",
  "surfaces": [],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "channels": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 32
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "isPrivate": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "name",
            "isPrivate"
          ],
          "additionalProperties": false
        },
        "maxItems": 2000
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "channels",
      "truncated"
    ],
    "additionalProperties": false
  }
}
