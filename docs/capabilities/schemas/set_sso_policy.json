  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ssoRequired": {
        "type": "boolean"
      }
    },
    "required": [
      "ssoRequired"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "policy": {
        "type": "object",
        "properties": {
          "ssoRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "ssoRequired"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "policy"
    ],
    "additionalProperties": false
  }
}
