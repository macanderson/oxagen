{
  "name": "list_nodes",
  "domain": "graph",
  "description": "Paginated browse of customer-context nodes in the workspace graph. Enables graph explorer UI.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "read"
  },
  "chain": {
    "produces": [
      "graph.nodeId"
    ],
    "consumes": [],
    "chainHints": [
      "get_node"
    ]
  },
  "render": {
    "componentId": "graph-node-list-card"
  },
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "labels": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "sourceId": {
        "type": "string"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 250,
        "default": 50
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "query": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "nodes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Node ID (Neo4j UUID)"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Node labels"
            },
            "properties": {
              "type": "object",
              "additionalProperties": {},
              "description": "Node properties"
            },
            "displayName": {
              "type": "string"
            },
            "sourceId": {
              "type": "string"
            },
            "createdAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "labels",
            "properties",
            "displayName"
          ],
          "additionalProperties": false
        }
      },
      "total": {
        "type": "number",
        "description": "Total number of nodes matching the filter"
      },
      "hasMore": {
        "type": "boolean",
        "description": "Whether more nodes exist beyond this page"
      },
      "limit": {
        "type": "number"
      },
      "offset": {
        "type": "number"
      }
    },
    "required": [
      "nodes",
      "total",
      "hasMore",
      "limit",
      "offset"
    ],
    "additionalProperties": false
  }
}
