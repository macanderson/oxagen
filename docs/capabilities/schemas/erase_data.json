{
  "name": "erase_data",
  "domain": "privacy",
  "description": "Request erasure of personal or organizational data (GDPR Article 17 — right to erasure). Requires explicit confirmation. Revokes all sessions immediately; hard-delete is scheduled asynchronously. Emits a webhook event for downstream integrations.",
  "mode": "async",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "destructive",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "privacy"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "enum": [
          "user",
          "org"
        ]
      },
      "orgId": {
        "type": "string",
        "format": "uuid"
      },
      "confirm": {
        "const": true
      }
    },
    "required": [
      "scope",
      "confirm"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "requestId": {
        "type": "string",
        "format": "uuid"
      },
      "status": {
        "const": "queued"
      },
      "effectiveAt": {
        "type": "string"
      }
    },
    "required": [
      "requestId",
      "status",
      "effectiveAt"
    ],
    "additionalProperties": false
  }
}
