{
  "name": "authorize_slack_connection",
  "domain": "org",
  "description": "Finish connecting the organization's Slack workspace with the code Slack returned. Stores the Oxagen bot token encrypted and returns the connection without the token.",
  "mode": "sync",
  "surfaces": [],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "state": {
        "type": "string"
      },
      "code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "required": [
      "state",
      "code"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "configured": {
        "type": "boolean"
      },
      "connected": {
        "type": "boolean"
      },
      "teamName": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          {
            "type": "null"
          }
        ]
      },
      "channel": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 32
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "isPrivate": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "isPrivate"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "lastFailure": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "code",
              "at"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "connectedAt": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "configured",
      "connected",
      "teamName",
      "channel",
      "lastFailure",
      "connectedAt"
    ],
    "additionalProperties": false
  }
}
