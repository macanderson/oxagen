{
  "name": "list_findings",
  "domain": "spend",
  "description": "List this workspace's costed findings ranked by the money at stake (open by default; applied or dismissed most recent first), each with its saving measured minus counterfactual over the runs it cites, its confidence, why and the fix, plus the total saving, its share of the priced spend over the findings' window and that saving annualised.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "open",
          "applied",
          "dismissed"
        ],
        "default": "open"
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "open",
          "applied",
          "dismissed"
        ]
      },
      "window": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "saving": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "micros": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "basis": {
                "type": "string",
                "enum": [
                  "gateway_observed",
                  "client_attested",
                  "mixed",
                  "estimated"
                ]
              }
            },
            "required": [
              "micros",
              "currency",
              "basis"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "spend": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "micros": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "basis": {
                "type": "string",
                "enum": [
                  "gateway_observed",
                  "client_attested",
                  "mixed",
                  "estimated"
                ]
              }
            },
            "required": [
              "micros",
              "currency",
              "basis"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "share": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "annualised": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "micros": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "basis": {
                "type": "string",
                "enum": [
                  "gateway_observed",
                  "client_attested",
                  "mixed",
                  "estimated"
                ]
              }
            },
            "required": [
              "micros",
              "currency",
              "basis"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "counts": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "integer",
            "minimum": 0
          },
          "high": {
            "type": "integer",
            "minimum": 0
          },
          "medium": {
            "type": "integer",
            "minimum": 0
          },
          "operators": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "findings",
          "high",
          "medium",
          "operators"
        ],
        "additionalProperties": false
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "cache_writes_never_read",
                "duplicate_tool_calls",
                "repeated_shell_commands",
                "unpaged_results"
              ]
            },
            "level": {
              "type": "string",
              "enum": [
                "tool",
                "agent",
                "operator",
                "workspace"
              ]
            },
            "subject": {
              "type": "string"
            },
            "saving": {
              "type": "object",
              "properties": {
                "micros": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "gateway_observed",
                    "client_attested",
                    "mixed",
                    "estimated"
                  ]
                }
              },
              "required": [
                "micros",
                "currency",
                "basis"
              ],
              "additionalProperties": false
            },
            "confidence": {
              "type": "string",
              "enum": [
                "high",
                "medium"
              ]
            },
            "window": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "why": {
              "type": "string"
            },
            "fix": {
              "type": "string"
            },
            "runs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "calls": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "applied",
                "dismissed"
              ]
            },
            "detectedAt": {
              "type": "string"
            },
            "decidedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "appliedActionId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "level",
            "subject",
            "saving",
            "confidence",
            "window",
            "why",
            "fix",
            "runs",
            "calls",
            "status",
            "detectedAt",
            "decidedAt",
            "appliedActionId"
          ],
          "additionalProperties": false
        },
        "maxItems": 50
      }
    },
    "required": [
      "status",
      "window",
      "saving",
      "spend",
      "share",
      "annualised",
      "counts",
      "findings"
    ],
    "additionalProperties": false
  }
}
