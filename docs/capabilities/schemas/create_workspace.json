{
  "name": "create_workspace",
  "domain": "workspace",
  "description": "Create a workspace within the active tenant together with its main repository, which is required: a GitHub repository, or a gitlab.com project with a project access token (web app and API only). Refused for a slug already used in the organization, or a repository the org's GitHub App installation cannot reach or another workspace already steers by.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "low",
    "category": "workspace"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "slug": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40,
        "x-server-validated": true,
        "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
      },
      "mainRepo": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "provider": {
                "const": "github",
                "default": "github"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 39
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "owner",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "provider": {
                "const": "gitlab"
              },
              "projectPath": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1024
              },
              "token": {
                "type": "string",
                "minLength": 20,
                "maxLength": 255
              }
            },
            "required": [
              "provider",
              "projectPath",
              "token"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "required": [
      "name",
      "slug",
      "mainRepo"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "publicId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "orgSlug": {
        "type": "string"
      },
      "createdAt": {
        "type": "string"
      },
      "mainRepo": {
        "type": "object",
        "properties": {
          "bindingId": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "gitlab"
            ]
          },
          "fullName": {
            "type": "string",
            "minLength": 1
          },
          "defaultRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "bindingId",
          "connectionId",
          "provider",
          "fullName",
          "defaultRef"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "publicId",
      "name",
      "slug",
      "orgSlug",
      "createdAt",
      "mainRepo"
    ],
    "additionalProperties": false
  }
}
