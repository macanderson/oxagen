{
  "name": "create_workspace",
  "domain": "workspace",
  "description": "Create a workspace within the active tenant together with its main GitHub repository, which is required. Refused for a slug already used in the organization, or a repository the org's GitHub App installation cannot reach or another workspace already steers by.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "low",
    "category": "workspace"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "slug": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40
      },
      "mainRepo": {
        "type": "object",
        "properties": {
          "provider": {
            "const": "github",
            "default": "github"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 39
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "owner",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "name",
      "slug",
      "mainRepo"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "publicId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "orgSlug": {
        "type": "string"
      },
      "createdAt": {
        "type": "string"
      },
      "mainRepo": {
        "type": "object",
        "properties": {
          "bindingId": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          },
          "fullName": {
            "type": "string",
            "minLength": 1
          },
          "defaultRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "bindingId",
          "connectionId",
          "fullName",
          "defaultRef"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "publicId",
      "name",
      "slug",
      "orgSlug",
      "createdAt",
      "mainRepo"
    ],
    "additionalProperties": false
  }
}
