{
  "name": "create_workspace",
  "domain": "workspace",
  "description": "Create a workspace within the active tenant and start provisioning its private steering repo. By default the repo is oxagen-<slug> in the organization's stored GitHub organization or GitLab group. Pass steeringRepo.connection (from list_steering_repo_destinations) to pick the organization or group, and steeringRepo.name to pick the name. The call returns before the repository exists, and the workspace's steering_repo status shows the progress. You no longer pass a main repository: mainRepo is deprecated and ignored. Refused when the organization already has a workspace with that slug.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "low",
    "category": "workspace"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "slug": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40,
        "x-server-validated": true,
        "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
      },
      "mainRepo": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "provider": {
                "const": "github",
                "default": "github"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 39
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "owner",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "provider": {
                "const": "gitlab"
              },
              "projectPath": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1024
              },
              "token": {
                "type": "string",
                "minLength": 20,
                "maxLength": 255
              }
            },
            "required": [
              "provider",
              "projectPath",
              "token"
            ],
            "additionalProperties": false
          }
        ]
      },
      "steeringRepo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "x-server-validated": true,
            "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
          },
          "connection": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "github",
                  "gitlab"
                ]
              },
              "id": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "provider",
              "id"
            ],
            "additionalProperties": false,
            "description": "The GitHub organization, personal GitHub account, or GitLab group to create the steering repo in. One of list_steering_repo_destinations' destinations."
          }
        },
        "additionalProperties": false,
        "description": "Where to create the workspace's steering repo and what to call it. Leave a field out to take its default."
      }
    },
    "required": [
      "name",
      "slug"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "publicId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "orgSlug": {
        "type": "string"
      },
      "createdAt": {
        "type": "string"
      },
      "steering_repo": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "provisioning",
              "ready",
              "failed",
              "blocked"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "publicId",
      "name",
      "slug",
      "orgSlug",
      "createdAt",
      "steering_repo"
    ],
    "additionalProperties": false
  }
}
