{
  "name": "create_api_key",
  "domain": "api_key",
  "description": "Create a new API key for the org. Returns the raw key once — it is never recoverable after this call. Audited as api_key.created.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "organization"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "description": "Human-readable label for the key"
      },
      "scope": {
        "type": "object",
        "additionalProperties": {},
        "default": {}
      },
      "expiresAt": {
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "keyId": {
        "type": "string",
        "description": "Internal UUID of the created key"
      },
      "publicId": {
        "type": "string",
        "description": "Prefixed public identifier (aky_ prefix)"
      },
      "name": {
        "type": "string"
      },
      "keyPrefix": {
        "type": "string",
        "description": "Short prefix stored for index lookup"
      },
      "rawKey": {
        "type": "string",
        "description": "The full API key — shown ONCE, never again"
      },
      "expiresAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "createdAt": {
        "type": "string",
        "description": "ISO-8601 creation timestamp"
      },
      "render": {
        "type": "object",
        "properties": {
          "componentId": {
            "type": "string"
          },
          "props": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "componentId",
          "props"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "keyId",
      "publicId",
      "name",
      "keyPrefix",
      "rawKey",
      "expiresAt",
      "createdAt"
    ],
    "additionalProperties": false
  }
}
