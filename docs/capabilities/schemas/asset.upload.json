{
  "name": "asset.upload",
  "domain": "asset",
  "description": "Ingest a binary asset from a source URL into object storage and return its stored URL and key.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "generation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sourceUrl": {
        "type": "string",
        "format": "uri"
      },
      "kind": {
        "type": "string",
        "enum": [
          "avatar",
          "image",
          "document"
        ]
      },
      "filename": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "sourceUrl",
      "kind"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "format": "uri"
      },
      "key": {
        "type": "string",
        "minLength": 1
      },
      "contentType": {
        "type": "string",
        "minLength": 1
      },
      "bytes": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "url",
      "key",
      "contentType",
      "bytes"
    ],
    "additionalProperties": false
  }
}
