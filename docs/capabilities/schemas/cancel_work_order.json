{
  "name": "cancel_work_order",
  "domain": "work",
  "description": "Withdraw a send that no runtime has claimed. The send ends at once and no run starts.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "item_id": {
        "type": "string"
      },
      "version": {
        "type": "integer",
        "minimum": 0
      },
      "work_order_id": {
        "type": "string"
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "required": [
      "item_id",
      "version",
      "work_order_id",
      "reason"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "held",
              "triaged",
              "needs_info",
              "changed",
              "ready",
              "sent",
              "running",
              "review",
              "done",
              "closed"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "state",
          "revision",
          "version"
        ],
        "additionalProperties": false
      },
      "repeat": {
        "type": "boolean"
      },
      "order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "send": {
