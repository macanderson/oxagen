{
  "name": "set_auto_topup",
  "domain": "billing",
  "description": "Turn automatic top-up on or off for the organization and set how many governed-action-unit blocks each top-up buys.",
  "mode": "sync",
  "surfaces": ["api", "mcp"],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "blocks": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": ["enabled", "blocks"],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "blocks": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": ["enabled", "blocks"],
    "additionalProperties": false
  }
}
