{
  "name": "rotate_agent_credential",
  "domain": "agent",
  "description": "Rotate an agent's long-lived credential: retire the current key and mint a replacement, returned once.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "identity"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "validityDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365,
        "default": 180
      }
    },
    "required": [
      "agentId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string"
      },
      "revokedCredentialId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "credential": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "secret": {
            "type": "string",
            "minLength": 1
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "secret",
          "expiresAt"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "agentId",
      "revokedCredentialId",
      "credential"
    ],
    "additionalProperties": false
  }
}
