{
  "name": "set_model_credential",
  "domain": "org",
  "description": "Store the organisation's own model-vendor API key (OpenRouter or Vercel AI Gateway). While a key is stored, the in-app agent's completions run on it and Oxagen bills nothing for those tokens. The key is envelope-encrypted at rest and never readable back. Replaces any key already stored. Returns the redacted credential view.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "enum": [
          "openrouter",
          "gateway"
        ]
      },
      "apiKey": {
        "type": "string",
        "minLength": 8,
        "maxLength": 512
      }
    },
    "required": [
      "provider",
      "apiKey"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "configured": {
        "type": "boolean"
      },
      "provider": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "openrouter",
              "gateway"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "status": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "keyHint": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "lastVerifiedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "rotatedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "configured",
      "provider",
      "status",
      "keyHint",
      "lastVerifiedAt",
      "rotatedAt"
    ],
    "additionalProperties": false
  }
}
