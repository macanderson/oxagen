{
  "name": "set_model_credential",
  "domain": "org",
  "description": "Store the organisation's own model-vendor API key — OpenRouter, Vercel AI Gateway, OpenAI, Anthropic, or any OpenAI-compatible endpoint given by base URL. Direct-vendor keys also take a model id per tier. While a key is stored, the in-app agent's completions run on it and Oxagen bills nothing for those tokens. The key is envelope-encrypted at rest and never readable back. Replaces any key already stored. Returns the redacted credential view.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "enum": [
          "openrouter",
          "gateway",
          "openai",
          "anthropic",
          "openai_compatible"
        ]
      },
      "apiKey": {
        "type": "string",
        "minLength": 8,
        "maxLength": 512
      },
      "baseUrl": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          {
            "type": "null"
          }
        ]
      },
      "modelMap": {
        "type": "object",
        "properties": {
          "fast": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "balanced": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "precise": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "provider",
      "apiKey"
    ],
    "additionalProperties": false,
    "x-server-validated": true,
    "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "configured": {
        "type": "boolean"
      },
      "provider": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "openrouter",
              "gateway",
              "openai",
              "anthropic",
              "openai_compatible"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "status": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "keyHint": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "baseUrl": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "modelMap": {
        "type": "object",
        "properties": {
          "fast": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "balanced": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "precise": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "lastVerifiedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "rotatedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "configured",
      "provider",
      "status",
      "keyHint",
      "baseUrl",
      "modelMap",
      "lastVerifiedAt",
      "rotatedAt"
    ],
    "additionalProperties": false
  }
}
