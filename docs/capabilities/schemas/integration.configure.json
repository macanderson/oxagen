{
  "name": "integration.configure",
  "domain": "integration",
  "description": "Update plugin instance config: credentials, sync cadence, inference toggles, ontology prompts.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "plugin"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "integrationId": {
        "type": "string",
        "description": "Plugin instance ID"
      },
      "displayName": {
        "type": "string"
      },
      "config": {
        "type": "object",
        "additionalProperties": {}
      },
      "syncCadence": {
        "type": "string",
        "enum": [
          "manual",
          "polling",
          "webhook"
        ]
      },
      "inferenceEnabled": {
        "type": "boolean"
      },
      "ontologyPrompt": {
        "type": "string"
      },
      "semanticEdgePrompt": {
        "type": "string"
      }
    },
    "required": [
      "integrationId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "integrationId": {
        "type": "string"
      },
      "displayName": {
        "type": "string"
      },
      "syncCadence": {
        "type": "string",
        "enum": [
          "manual",
          "polling",
          "webhook"
        ]
      },
      "inferenceEnabled": {
        "type": "boolean"
      },
      "updatedAt": {
        "type": "string"
      }
    },
    "required": [
      "integrationId",
      "displayName",
      "syncCadence",
      "inferenceEnabled",
      "updatedAt"
    ],
    "additionalProperties": false
  }
}
