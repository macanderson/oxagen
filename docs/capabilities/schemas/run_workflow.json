{
  "name": "run_workflow",
  "domain": "workflow",
  "description": "Decompose a large parallel goal into N sub-tasks, dispatch them concurrently via Inngest, and return a live progress component. Use for 10+ parallel data-gathering steps.",
  "mode": "async",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "workflow"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "goal": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "description": "The overarching research or processing goal"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "outputFormat": {
        "type": "string",
        "enum": [
          "json",
          "csv"
        ],
        "default": "json"
      },
      "maxParallelism": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      }
    },
    "required": [
      "goal"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workflowId": {
        "type": "string",
        "description": "Internal UUID of the agent_executions row (origin_type=workflow_run)"
      },
      "publicId": {
        "type": "string",
        "description": "aex_* prefixed public ID of the agent_executions row"
      },
      "status": {
        "const": "planning"
      },
      "render": {
        "type": "object",
        "properties": {
          "componentId": {
            "const": "workflow-progress"
          },
          "props": {
            "type": "object",
            "properties": {
              "workflowId": {
                "type": "string"
              }
            },
            "required": [
              "workflowId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "componentId",
          "props"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "workflowId",
      "publicId",
      "status",
      "render"
    ],
    "additionalProperties": false
  }
}
