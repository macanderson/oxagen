{
  "name": "trigger_automation",
  "domain": "automation",
  "description": "Trigger an automation by ID with an optional payload",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "automation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "automation_id": {
        "type": "string"
      },
      "payload": {
        "type": "object",
        "additionalProperties": {}
      }
    },
    "required": [
      "automation_id"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "execution_id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    },
    "required": [
      "execution_id",
      "status"
    ],
    "additionalProperties": false
  }
}
