{
  "name": "get_user_budget",
  "domain": "user",
  "description": "Read the calling user's saved per-turn budget: whether a dollar ceiling is enforced on each agent turn, the limit in USD, the enforcement mode (grace = allow overage within a grace window; prompt = ask to continue; enforce = hard stop), and the grace-window cushion.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "user"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "limitUsd": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "mode": {
        "type": "string",
        "enum": [
          "grace",
          "prompt",
          "enforce"
        ]
      },
      "graceOveragePct": {
        "type": "number"
      }
    },
    "required": [
      "enabled",
      "limitUsd",
      "mode",
      "graceOveragePct"
    ],
    "additionalProperties": false
  }
}
