{
  "name": "snapshot_sandbox",
  "domain": "agent",
  "description": "Capture a filesystem snapshot of a durable sandbox session so it can be restored after an idle reap or the 24h lifetime ceiling.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "execution"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "description": "Durable-session id (sbx_…) returned by agent.sandbox.start."
      }
    },
    "required": [
      "sessionId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "snapshotId": {
        "type": "string",
        "description": "Filesystem snapshot id, recorded on the session for transparent restore."
      }
    },
    "required": [
      "snapshotId"
    ],
    "additionalProperties": false
  }
}
