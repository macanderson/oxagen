{
  "name": "graph.edge.delete",
  "domain": "graph",
  "description": "Delete a specific typed relationship between two KnowledgeNodes.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "destructive",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "graph"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fromNodeId": {
        "type": "string",
        "description": "publicId of the source KnowledgeNode"
      },
      "toNodeId": {
        "type": "string",
        "description": "publicId of the target KnowledgeNode"
      },
      "edgeType": {
        "type": "string",
        "enum": [
          "RELATED_TO",
          "PART_OF",
          "CAUSED_BY",
          "REFERENCES",
          "SIMILAR_TO",
          "DEPENDS_ON",
          "CREATED_BY",
          "MENTIONS"
        ],
        "description": "Type of relationship to delete"
      }
    },
    "required": [
      "fromNodeId",
      "toNodeId",
      "edgeType"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "deleted": {
        "type": "boolean",
        "description": "True if the relationship was found and deleted; false if it did not exist"
      }
    },
    "required": [
      "deleted"
    ],
    "additionalProperties": false
  }
}
