{
  "name": "list_agent_roles",
  "domain": "agent",
  "description": "List the IAM roles attached to an agent's delegated principal — active, non-expired principal_role_assignments with role identity, scope, and assignment provenance. Read-only governance introspection.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string",
        "minLength": 1,
        "description": "Agent public id (agt_…), UUID, or slug — workspace-scoped"
      }
    },
    "required": [
      "agentId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string",
        "description": "Agent public id (agt_…)"
      },
      "roles": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "assignmentId": {
              "type": "string",
              "description": "Public assignment id (pra_…)"
            },
            "roleId": {
              "type": "string",
              "description": "Public role id (rol_…)"
            },
            "roleName": {
              "type": "string"
            },
            "scopeKind": {
              "type": "string",
              "enum": [
                "org",
                "workspace"
              ]
            },
            "isSystemDefault": {
              "type": "boolean",
              "description": "True for system-seeded agent roles (Agent Observer/Contributor/Operator)"
            },
            "assignedAt": {
              "type": "string",
              "description": "ISO-8601 timestamp of the assignment"
            },
            "assignedBy": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expiresAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "workspaceId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "assignmentId",
            "roleId",
            "roleName",
            "scopeKind",
            "isSystemDefault",
            "assignedAt",
            "assignedBy",
            "expiresAt",
            "workspaceId"
          ],
          "additionalProperties": false
        },
        "description": "Active role assignments, most recent first"
      },
      "total": {
        "type": "integer"
      }
    },
    "required": [
      "agentId",
      "roles",
      "total"
    ],
    "additionalProperties": false
  }
}
