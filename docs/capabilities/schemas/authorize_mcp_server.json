{
  "name": "authorize_mcp_server",
  "domain": "agent",
  "description": "Finish OAuth authorization for an MCP server: exchange the code the authorization server returned, store the tokens encrypted, and list the server's tools",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "state": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "redirectUrl": {
        "type": "string",
        "format": "uri"
      }
    },
    "required": [
      "state",
      "code",
      "redirectUrl"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "mcpServerId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "healthStatus": {
        "type": "string",
        "enum": [
          "healthy",
          "degraded",
          "unreachable"
        ]
      },
      "discoveredTools": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "mcpServerId",
      "name",
      "healthStatus",
      "discoveredTools"
    ],
    "additionalProperties": false
  }
}
