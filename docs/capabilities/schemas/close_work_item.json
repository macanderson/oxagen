{
  "name": "close_work_item",
  "domain": "work",
  "description": "Close a work item without finishing it, as cancelled, declined, or a duplicate. The source issue stays open.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "item_id": {
        "type": "string"
      },
      "version": {
        "type": "integer",
        "minimum": 0
      },
      "resolution": {
        "type": "string",
        "enum": [
          "cancelled",
          "declined",
          "duplicate"
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "required": [
      "item_id",
      "version",
      "resolution",
      "reason"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "held",
              "triaged",
              "needs_info",
              "changed",
              "ready",
              "sent",
              "running",
              "review",
              "done",
              "closed"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "state",
          "revision",
          "version"
        ],
        "additionalProperties": false
      },
      "repeat": {
        "type": "boolean"
      }
    },
    "required": [
      "item",
      "repeat"
    ],
    "additionalProperties": false
  }
}
