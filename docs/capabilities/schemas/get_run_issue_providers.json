{
  "name": "get_run_issue_providers",
  "domain": "run",
  "description": "Read issue provider connections and optionally list authorized Linear teams.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "linearConnectionId": {
        "type": "string",
        "minLength": 1
      },
      "after": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "github": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "connectUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "installUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "manageUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "connected",
          "connectUrl",
          "installUrl",
          "manageUrl"
        ],
        "additionalProperties": false
      },
      "linear": {
        "type": "object",
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "connectionId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "connectionId",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "teams": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "key"
              ],
              "additionalProperties": false
            }
          },
          "hasNextPage": {
            "type": "boolean"
          },
          "endCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "configured",
          "connections",
          "teams",
          "hasNextPage",
          "endCursor"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "github",
      "linear"
    ],
    "additionalProperties": false
  }
}
