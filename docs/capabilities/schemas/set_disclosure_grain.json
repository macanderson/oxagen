{
  "name": "set_disclosure_grain",
  "domain": "evidence",
  "description": "Set the workspace's witness disclosure grain, from L0 (the worker hears only pass or fail) to L3, recorded as a security event.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "grain": {
        "type": "string",
        "enum": [
          "L0",
          "L1",
          "L2",
          "L3"
        ]
      }
    },
    "required": [
      "grain"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "grain": {
        "type": "string",
        "enum": [
          "L0",
          "L1",
          "L2",
          "L3"
        ]
      },
      "previousGrain": {
        "type": "string",
        "enum": [
          "L0",
          "L1",
          "L2",
          "L3"
        ]
      },
      "changedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "grain",
      "previousGrain",
      "changedAt"
    ],
    "additionalProperties": false
  }
}
