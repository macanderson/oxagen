{
  "name": "get_reconcile_status",
  "domain": "schema",
  "description": "Poll the status of a schema reconciliation job.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "schema"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "executionId": {
        "type": "string",
        "minLength": 1,
        "description": "aex_… agent_executions public_id"
      }
    },
    "required": [
      "executionId"
    ],
    "additionalProperties": false
  },
  "output": {
