      "processedNodes": {
        "type": "number"
      },
      "updatedNodes": {
        "type": "number"
      },
      "totalRelationships": {
        "type": "number"
      },
      "processedRelationships": {
        "type": "number"
      },
      "updatedRelationships": {
        "type": "number"
      },
      "prunedNodes": {
        "type": "number"
      },
      "prunedRelationships": {
        "type": "number"
      }
    },
    "required": [
      "status",
      "totalNodes",
      "processedNodes",
      "updatedNodes",
      "totalRelationships",
      "processedRelationships",
      "updatedRelationships",
      "prunedNodes",
      "prunedRelationships"
    ],
    "additionalProperties": false
  }
