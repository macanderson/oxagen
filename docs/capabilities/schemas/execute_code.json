{
  "name": "execute_code",
  "domain": "agent",
  "description": "Execute a code snippet in an isolated sandbox and return stdout, stderr, and exit code. Supports node, python, and shell. Requires SANDBOX_ENABLED=true.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "execution"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "language": {
        "type": "string",
        "enum": [
          "node",
          "python",
          "shell"
        ],
        "description": "Runtime language"
      },
      "code": {
        "type": "string",
        "minLength": 1,
        "description": "Source code to execute"
      },
      "files": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "stdin": {
        "type": "string"
      },
      "env": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "environmentId": {
        "type": "string",
        "minLength": 1
      },
      "sandboxTemplateId": {
        "type": "string",
        "minLength": 1
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 300000,
        "default": 30000
      },
      "memoryMb": {
        "type": "integer",
        "minimum": 64,
        "maximum": 2048,
        "default": 256
      },
      "network": {
        "type": "string",
        "enum": [
          "allow",
          "deny"
        ],
        "default": "deny"
      }
    },
    "required": [
      "language",
      "code"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "exitCode": {
        "type": "integer"
      },
      "stdout": {
        "type": "string"
      },
      "stderr": {
        "type": "string"
      },
      "executionMs": {
        "type": "integer"
      },
      "timedOut": {
        "type": "boolean"
      },
      "oomKilled": {
        "type": "boolean"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "exitCode",
      "stdout",
      "stderr",
      "executionMs",
      "timedOut",
      "oomKilled"
    ],
    "additionalProperties": false
  }
}
