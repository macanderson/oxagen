{
  "name": "resume_repo",
  "domain": "repo",
  "description": "Resume automatic syncing for a paused repository connection.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "ingestion"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repoId": {
        "type": "string",
        "description": "Repository connection ID"
      }
    },
    "required": [
      "repoId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repoId": {
        "type": "string"
      },
      "status": {
        "const": "active"
      },
      "resumedAt": {
        "type": "string"
      },
      "nextSyncAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "repoId",
      "status",
      "resumedAt",
      "nextSyncAt"
    ],
    "additionalProperties": false
  }
}
