{
  "name": "agent.trigger.update",
  "domain": "agent",
  "description": "Update an existing agent trigger in place — replaces its type-specific binding and enabled flag, re-validated against agentTriggerSchema",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "mutation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "triggerId": {
        "type": "string",
        "description": "Trigger public id (atr_…) or UUID"
      },
      "trigger": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "manual",
              "schedule",
              "event"
            ]
          },
          "eventSource": {
            "type": "string"
          },
          "eventType": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          },
          "filter": {
            "type": "object",
            "properties": {
              "branches": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pathGlobs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "conditions": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "additionalProperties": false
          },
          "schedule": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "triggerId",
      "trigger"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "triggerId": {
        "type": "string"
      },
      "triggerType": {
        "type": "string",
        "enum": [
          "manual",
          "schedule",
          "event"
        ]
      },
      "enabled": {
        "type": "boolean"
      }
    },
    "required": [
      "triggerId",
      "triggerType",
      "enabled"
    ],
    "additionalProperties": false
  }
}
