{
  "name": "get_integration",
  "domain": "integration",
  "description": "Get full details of a single plugin instance including schema and configuration.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "plugin"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "integrationId": {
        "type": "string",
        "description": "Plugin instance ID"
      }
    },
    "required": [
      "integrationId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "pluginId": {
        "type": "string"
      },
      "displayName": {
        "type": "string"
      },
      "version": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "paused",
          "failed",
          "pending_setup"
        ]
      },
      "config": {
        "type": "object",
        "additionalProperties": {}
      },
      "schema": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": {}
          },
          {
            "type": "null"
          }
        ]
      },
      "entityCount": {
        "type": "number"
      },
      "lastSyncAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "errorMessage": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "createdAt": {
        "type": "string"
      },
      "updatedAt": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "pluginId",
      "displayName",
      "version",
      "status",
      "config",
      "schema",
      "entityCount",
      "lastSyncAt",
      "errorMessage",
      "createdAt",
      "updatedAt"
    ],
    "additionalProperties": false
  }
}
