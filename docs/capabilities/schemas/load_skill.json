{
  "name": "load_skill",
  "domain": "agent",
  "description": "Load and register a workspace skill at runtime — resolves the requested version, validates dependencies, and returns the skill body and available capabilities",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "skillSlug": {
        "type": "string"
      },
      "version": {
        "type": "string"
      },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "skillSlug"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "skillSlug": {
        "type": "string"
      },
      "loaded": {
        "type": "boolean"
      },
      "versionLoaded": {
        "type": "number"
      },
      "body": {
        "type": "string"
      },
      "capabilities": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "dependencyErrors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "slug",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "skillSlug",
      "loaded",
      "versionLoaded",
      "body",
      "capabilities",
      "dependencyErrors"
    ],
    "additionalProperties": false
  }
}
