{
  "name": "register_agent",
  "domain": "agent",
  "description": "Register an agent identity in this workspace: its principal, default role and a long-lived credential shown once. The definition is committed to the repository separately.",
  "mode": "sync",
  "surfaces": ["api", "cli"],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "identity"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "minLength": 1,
        "maxLength": 18
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "description": {
        "type": "string",
        "maxLength": 1024
      },
      "harness": {
        "type": "string",
        "enum": ["stella", "claude-code", "claude-agent-sdk", "custom"]
      },
      "validityDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365,
        "default": 180
      }
    },
    "required": ["slug", "name", "harness"],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string"
      },
      "slug": {
        "type": "string",
        "minLength": 1
      },
      "agentKey": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "principalId": {
        "type": "string"
      },
      "credential": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "secret": {
            "type": "string",
            "minLength": 1
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": ["id", "secret", "expiresAt"],
        "additionalProperties": false
      }
    },
    "required": ["agentId", "slug", "agentKey", "principalId", "credential"],
    "additionalProperties": false
  }
}
