{
  "name": "register_agent",
  "domain": "agent",
  "description": "Register an agent in this workspace: one operator on one runtime with one harness, carrying a toolbelt. Mints its principal, default role, first version and a long-lived credential shown once.",
  "mode": "sync",
  "surfaces": [
    "api",
    "cli"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "identity"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "slug": {
        "type": "string",
        "minLength": 1,
        "maxLength": 18
      },
      "description": {
        "type": "string",
        "maxLength": 1024
      },
      "harness": {
        "type": "string",
        "enum": [
          "stella",
          "claude-code",
          "codex",
          "cursor",
          "claude-agent-sdk",
          "custom"
        ]
      },
      "runtimeId": {
        "type": "string"
      },
      "toolbeltId": {
        "type": "string"
      },
      "validityDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365,
        "default": 180
      }
    },
    "required": [
      "name",
      "harness",
      "runtimeId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string"
      },
      "slug": {
        "type": "string",
        "minLength": 1
      },
      "agentKey": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "principalId": {
        "type": "string"
      },
      "runtime": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ],
        "additionalProperties": false
      },
      "toolbelt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "all_tools",
              "custom"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "kind"
        ],
        "additionalProperties": false
      },
      "version": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "credential": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "secret": {
            "type": "string",
            "minLength": 1
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "secret",
          "expiresAt"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "agentId",
      "slug",
      "agentKey",
      "principalId",
      "runtime",
      "toolbelt",
      "version",
      "credential"
    ],
    "additionalProperties": false
  }
}
