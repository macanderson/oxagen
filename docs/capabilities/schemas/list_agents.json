{
  "name": "list_agents",
  "domain": "agent",
  "description": "List the agents registered in this workspace with their purpose, principal, harness, operator, status, enrollment and credential counts, live host, latest enforcement tier, active mandates, and the 30-day run, spend, token and incident figures the stores record. Retired (deregistered) agents are left out unless includeRetired is true.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      },
      "cursor": {
        "type": "string",
        "maxLength": 256
      },
      "includeRetired": {
        "type": "boolean",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "slug": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "agentKey": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "harness": {
              "type": "string",
              "enum": [
                "stella",
                "claude-code",
                "codex",
                "cursor",
                "claude-agent-sdk",
                "custom"
              ]
            },
            "runtime": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "slug": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "slug"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "toolbelt": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "slug": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "all_tools",
                        "custom"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "slug",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "principalId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "operatorId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "operatorName": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "unenrolled",
                "enrolled",
                "suspended",
                "retired"
              ]
            },
            "tier": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "enforcementTier": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "contained",
                    "gateway",
                    "harness",
                    "observe"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "beltSize": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "runs30d": {
              "type": "integer",
              "minimum": 0
            },
            "spend30d": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "micros": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "gateway_observed",
                        "client_attested",
                        "mixed",
                        "estimated"
                      ]
                    }
                  },
                  "required": [
                    "micros",
                    "currency",
                    "basis"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "tokens30d": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "input": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "cacheRead": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "cacheReadRate": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sessions": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "total",
                    "input",
                    "cacheRead",
                    "cacheReadRate",
                    "sessions"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "proven30d": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "mandates": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "incidents": {
              "type": "integer",
              "minimum": 0
            },
            "tamperIncidents": {
              "type": "integer",
              "minimum": 0
            },
            "tamperIncidentsRecorded": {
              "type": "integer",
              "minimum": 0
            },
            "credentials": {
              "type": "integer",
              "minimum": 0
            },
            "hosts": {
              "type": "integer",
              "minimum": 0
            },
            "host": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "registeredAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "slug",
            "name",
            "description",
            "agentKey",
            "harness",
            "runtime",
            "toolbelt",
            "principalId",
            "operatorId",
            "operatorName",
            "status",
            "tier",
            "enforcementTier",
            "beltSize",
            "runs30d",
            "spend30d",
            "tokens30d",
            "proven30d",
            "mandates",
            "incidents",
            "tamperIncidents",
            "tamperIncidentsRecorded",
            "credentials",
            "hosts",
            "host",
            "registeredAt"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "nextCursor": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "totals": {
        "type": "object",
        "properties": {
          "identities": {
            "type": "integer",
            "minimum": 0
          },
          "retired": {
            "type": "integer",
            "minimum": 0
          },
          "enrolled": {
            "type": "integer",
            "minimum": 0
          },
          "unenrolled": {
            "type": "integer",
            "minimum": 0
          },
          "holdingMandate": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "mandateHolders": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 100
          },
          "tamperIncidents": {
            "type": "integer",
            "minimum": 0
          },
          "tamper": {
            "type": "object",
            "properties": {
              "recorded": {
                "type": "integer",
                "minimum": 0
              },
              "open": {
                "type": "integer",
                "minimum": 0
              },
              "newest": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "agentKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "minLength": 1
                      },
                      "detectedAt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "agentKey",
                      "kind",
                      "detectedAt"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "recorded",
              "open",
              "newest"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "identities",
          "retired",
          "enrolled",
          "unenrolled",
          "holdingMandate",
          "mandateHolders",
          "tamperIncidents",
          "tamper"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "items",
      "nextCursor",
      "totals"
    ],
    "additionalProperties": false
  }
}
