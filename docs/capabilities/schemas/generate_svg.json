{
  "name": "generate_svg",
  "domain": "svg",
  "description": "Generate clean, sanitized, inline SVG markup from a natural-language prompt. The SVG uses currentColor and CSS custom properties so it adapts to light and dark mode. Script tags and inline event handlers are stripped before the output is returned. The generated SVG is also persisted as a conversation file (generated_assets row + blob storage) so it appears in the Conversation Files panel; persistence failures never fail the generation. Returns the SVG markup, a title, the persisted asset's serve URL, and a render directive so the output renders inline in chat.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "generation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string"
      },
      "width": {
        "type": "integer",
        "minimum": 0
      },
      "height": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "prompt"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "svg": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "assetPublicId": {
        "type": "string"
      },
      "serveUrl": {
        "type": "string"
      },
      "persistWarning": {
        "type": "string"
      },
      "render": {
        "type": "object",
        "properties": {
          "componentId": {
            "type": "string"
          },
          "props": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "componentId",
          "props"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "svg",
      "title",
      "render"
    ],
    "additionalProperties": false
  }
}
