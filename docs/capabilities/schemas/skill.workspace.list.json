{
  "name": "skill.workspace.list",
  "domain": "skill",
  "description": "List skills available in the workspace",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "skill"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workspace_id": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "skills": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "name",
            "description",
            "enabled"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "skills"
    ],
    "additionalProperties": false
  }
}
