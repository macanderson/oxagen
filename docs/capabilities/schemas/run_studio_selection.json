{
  "name": "run_studio_selection",
  "domain": "tool",
  "description": "Run a server folder's selection tests: ask the workspace's model to pick one of the server's tools for each task in tests/selection.jsonl, and count the hits and misses. Runs only when asked. Each task is one model call, billed as in-app agent spend, and one run asks at most 50 tasks.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "governance"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "server": {
        "type": "string",
        "x-server-validated": true,
        "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
      }
    },
    "required": [
      "server"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "server": {
        "type": "string"
      },
      "basis": {
        "type": "string",
        "enum": [
          "draft",
          "published"
        ]
      },
      "revision": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "model": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "counts": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "hits": {
            "type": "integer",
            "minimum": 0
          },
          "misses": {
            "type": "integer",
            "minimum": 0
          },
          "malformed": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "total",
          "hits",
          "misses",
          "malformed",
          "skipped"
        ],
        "additionalProperties": false
      },
      "cases": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "task": {
                  "type": "string"
                },
                "expected": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "hit",
                    "miss"
                  ]
                },
                "chosen": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "line",
                "task",
                "expected",
                "status",
                "chosen"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "task": {
                  "type": "string"
                },
                "expected": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "malformed",
                    "skipped"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "line",
                "task",
                "expected",
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "required": [
      "server",
      "basis",
      "revision",
      "model",
      "counts",
      "cases"
    ],
    "additionalProperties": false
  }
}
