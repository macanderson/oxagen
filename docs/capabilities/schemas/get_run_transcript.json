{
  "name": "get_run_transcript",
  "domain": "run",
  "description": "Read one run as a transcript at a zoom level (turns, steps or everything), derived on the server from its frames and retained bodies, with the cost each entry folds.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runId": {
        "type": "string"
      },
      "zoom": {
        "type": "string",
        "enum": [
          "turns",
          "steps",
          "everything"
        ]
      }
    },
    "required": [
      "runId",
      "zoom"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "zoom": {
        "type": "string",
        "enum": [
          "turns",
          "steps",
          "everything"
        ]
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "seq": {
              "type": "string"
            },
            "endSeq": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "turn",
                "model_call",
                "tool_call",
                "frame"
              ]
            },
            "type": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "text": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 16384
                },
                {
                  "type": "null"
                }
              ]
            },
            "truncated": {
              "type": "boolean"
            },
            "fidelity": {
              "type": "string",
              "enum": [
                "full",
                "digest_only"
              ]
            },
            "frames": {
              "type": "integer",
              "minimum": 0
            },
            "cost": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "micros": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "gateway_observed",
                        "client_attested",
                        "mixed",
                        "estimated"
                      ]
                    }
                  },
                  "required": [
                    "micros",
                    "currency",
                    "basis"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "seq",
            "endSeq",
            "at",
            "kind",
            "type",
            "label",
            "text",
            "truncated",
            "fidelity",
            "frames",
            "cost"
          ],
          "additionalProperties": false
        }
      },
      "complete": {
        "type": "boolean"
      }
    },
    "required": [
      "zoom",
      "entries",
      "complete"
    ],
    "additionalProperties": false
  }
}
