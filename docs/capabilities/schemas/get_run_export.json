{
  "name": "get_run_export",
  "domain": "run",
  "description": "Read one run export: its status, the bundle's digest and size once it is built, the error if the job failed, and a download URL that expires.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "run"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "exportId": {
        "type": "string"
      }
    },
    "required": [
      "exportId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "exportId": {
        "type": "string"
      },
      "runId": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "queued",
          "building",
          "ready",
          "failed"
        ]
      },
      "createdAt": {
        "type": "string"
      },
      "completedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "bundleDigest": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "bundleBytes": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "merkleRoot": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "frameCount": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "download": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "expiresAt": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "expiresAt"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "exportId",
      "runId",
      "status",
      "createdAt",
      "completedAt",
      "bundleDigest",
      "bundleBytes",
      "merkleRoot",
      "frameCount",
      "error",
      "download"
    ],
    "additionalProperties": false
  }
}
