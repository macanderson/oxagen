              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "publicId",
          "orgId",
          "workspaceId",
          "title",
          "goal",
          "status",
          "planJson",
          "totalTasks",
          "completedTasks",
          "failedTasks",
          "maxParallelism",
          "outputFormat",
          "resultUrl",
          "startedAt",
          "completedAt",
          "createdAt",
