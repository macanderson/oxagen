{
  "name": "get_dataset",
  "domain": "eval",
  "description": "Fetch one eval dataset by public id along with a page of its items (input, expected output, metadata). Paginated via limit + cursor to avoid loading an unbounded item set.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "read"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "datasetPublicId": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50
      },
      "cursor": {
        "type": "string"
      }
    },
    "required": [
      "datasetPublicId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "dataset": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "traces"
            ]
          },
          "itemCount": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "datasetId",
          "name",
          "slug",
          "description",
          "source",
          "itemCount",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string"
            },
            "input": {
              "type": "string"
            },
            "expectedOutput": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "metadata": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "required": [
            "itemId",
            "input",
            "expectedOutput",
            "metadata"
          ],
          "additionalProperties": false
        }
      },
      "nextCursor": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "dataset",
      "items",
      "nextCursor"
    ],
    "additionalProperties": false
  }
}
