{
  "name": "preview_skill_search",
  "domain": "skill",
  "description": "Preview approved skill resolution at a published configuration version. Shows a person withheld names and reasons without loading skills into a run.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "medium",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "required": [
      "version",
      "query"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "string"
      },
      "repositoryCommitSha": {
        "type": "string"
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 48
            },
            "version": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "description": {
              "type": "string",
              "maxLength": 8000
            },
            "tokenCost": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "id",
            "version",
            "digest",
            "source",
            "description",
            "tokenCost",
            "score"
          ],
          "additionalProperties": false
        }
      },
      "withheld": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 48
            },
            "reason": {
              "type": "string",
              "enum": [
                "out_of_scope",
                "unapproved_digest"
              ]
            }
          },
          "required": [
            "id",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "tokenCost": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "version",
      "repositoryCommitSha",
      "results",
      "withheld",
      "tokenCost"
    ],
    "additionalProperties": false
  }
}
