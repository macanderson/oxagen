{
  "name": "issue_run_token",
  "domain": "run",
  "description": "Issue a fifteen-minute evidence credential for one existing run attempt.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runId": {
        "type": "string"
      },
      "attemptId": {
        "type": "string"
      }
    },
    "required": [
      "runId",
      "attemptId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "token": {
        "type": "string"
      },
      "expiresAt": {
        "type": "string"
      }
    },
    "required": [
      "token",
      "expiresAt"
    ],
    "additionalProperties": false
  }
}
