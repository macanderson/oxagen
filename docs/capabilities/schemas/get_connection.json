{
  "name": "get_connection",
  "domain": "connection",
  "description": "Get details of a single data source connection.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "read"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connectionId": {
        "type": "string",
        "minLength": 1,
        "description": "Public ID or internal UUID of the connection"
      }
    },
    "required": [
      "connectionId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "publicId": {
        "type": "string"
      },
      "connectorId": {
        "type": "string"
      },
      "displayName": {
        "type": "string"
      },
      "authScheme": {
        "type": "string"
      },
      "deliveryMethod": {
        "type": "string"
      },
      "deliveryConfig": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": {}
          },
          {
            "type": "null"
          }
        ]
      },
      "status": {
        "type": "string"
      },
      "entityCount": {
        "type": "number"
      },
      "lastSyncAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "errorMessage": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "healthStatus": {
        "type": "string",
        "enum": [
          "healthy",
          "degraded",
          "errored"
        ]
      },
      "consecutiveFailureCount": {
        "type": "number"
      },
      "lastPollAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "nextPollAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "lastErrorAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "createdAt": {
        "type": "string"
      },
      "updatedAt": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "publicId",
      "connectorId",
      "displayName",
      "authScheme",
      "deliveryMethod",
      "deliveryConfig",
      "status",
      "entityCount",
      "lastSyncAt",
      "errorMessage",
      "healthStatus",
      "consecutiveFailureCount",
      "lastPollAt",
      "nextPollAt",
      "lastErrorAt",
      "createdAt",
      "updatedAt"
    ],
    "additionalProperties": false
  }
}
