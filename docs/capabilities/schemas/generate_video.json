{
  "name": "generate_video",
  "domain": "video",
  "description": "Generate a short video from a text prompt. Optionally accepts duration, aspect ratio, and style hints. Creates a pending asset row, dispatches the async Veo render job, and returns a queued job reference and a render directive so the chat UI immediately shows the video-result component (componentId \"video-result\").",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "video"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "durationSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 60
      },
      "aspectRatio": {
        "type": "string",
        "enum": [
          "16:9",
          "9:16",
          "1:1"
        ]
      },
      "style": {
        "type": "string"
      },
      "model": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "prompt"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "const": "queued"
      },
      "jobId": {
        "type": "string",
        "minLength": 1
      },
      "serveUrl": {
        "type": "string"
      },
      "durationAdjustment": {
        "type": "object",
        "properties": {
          "requestedSeconds": {
            "type": "number"
          },
          "effectiveSeconds": {
            "type": "number"
          },
          "supportedSeconds": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "supportedSeconds": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "closestSeconds": {
                  "type": "number"
                }
              },
              "required": [
                "model",
                "supportedSeconds",
                "closestSeconds"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "requestedSeconds",
          "effectiveSeconds",
          "supportedSeconds",
          "alternatives"
        ],
        "additionalProperties": false
      },
      "render": {
        "type": "object",
        "properties": {
          "componentId": {
            "const": "video-result"
          },
          "props": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "notice": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "prompt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "componentId",
          "props"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "status",
      "jobId",
      "serveUrl",
      "render"
    ],
    "additionalProperties": false
  }
}
