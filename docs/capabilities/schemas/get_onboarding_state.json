{
  "name": "get_onboarding_state",
  "domain": "onboarding",
  "description": "Where the signed-in person is in the onboarding gate: the current step, the gate's workspace, and the first frame once one arrived.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "low",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "step": {
        "type": "string",
        "enum": [
          "organization",
          "wrap",
          "run",
          "unlocked"
        ]
      },
      "workspace": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "slug": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "slug"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "firstFrameAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "firstRunId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "step",
      "workspace",
      "firstFrameAt",
      "firstRunId"
    ],
    "additionalProperties": false
  }
}
