{
  "name": "recall_memory",
  "domain": "agent",
  "description": "Query Neo4j AgentMemory by semantic similarity with optional class/enforcement filters; returns ranked memories scoped to the workspace",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "memory"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1
      },
      "memoryClass": {
        "type": "string",
        "enum": [
          "OBSERVATION",
          "RULE",
          "FACT"
        ]
      },
      "minEnforcement": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "limit": {
        "type": "integer",
        "minimum": 0,
        "maximum": 50,
        "default": 10
      },
      "nodeRef": {
        "type": "string"
      },
      "executionRef": {
        "type": "string"
      },
      "agentId": {
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "memories": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "nodeRef": {
              "type": "string"
            },
            "memoryClass": {
              "type": "string",
              "enum": [
                "OBSERVATION",
                "RULE",
                "FACT"
              ]
            },
            "memoryKind": {
              "type": "string"
            },
            "lesson": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "confidenceScore": {
              "type": "number"
            },
            "enforcementScore": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "score": {
              "type": "number"
            },
            "createdAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "nodeRef",
            "memoryClass",
            "memoryKind",
            "lesson",
            "source",
            "confidenceScore",
            "enforcementScore",
            "score",
            "createdAt"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "memories"
    ],
    "additionalProperties": false
  }
}
