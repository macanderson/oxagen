{
  "name": "semantic.edge.list",
  "domain": "semantic",
  "description": "Paginated browse of inferred semantic edges for a workspace. Supports filtering by relationship type, connector source, and confidence band.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "graph"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "type": {
        "type": "string"
      },
      "sourceId": {
        "type": "string"
      },
      "confidenceMin": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "confidenceMax": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 250,
        "default": 50
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "edges": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Unique edge identifier"
            },
            "sourceNodeId": {
              "type": "string",
              "description": "publicId of the source KnowledgeNode"
            },
            "targetNodeId": {
              "type": "string",
              "description": "publicId of the target KnowledgeNode"
            },
            "type": {
              "type": "string",
              "description": "Relationship type as inferred by the LLM (customer-defined, not an enum)"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Inference confidence score 0.0–1.0"
            },
            "source": {
              "type": "object",
              "properties": {
                "connectorId": {
                  "type": "string",
                  "description": "Connector that owns the source node"
                },
                "sourceId": {
                  "type": "string",
                  "description": "Connector-internal source identifier"
                }
              },
              "required": [
                "connectorId",
                "sourceId"
              ],
              "additionalProperties": false
            },
            "inferredAt": {
              "type": "string",
              "description": "ISO-8601 timestamp when the edge was inferred"
            },
            "approved": {
              "type": "boolean"
            },
            "approvedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "approvedBy": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "sourceNodeId",
            "targetNodeId",
            "type",
            "confidence",
            "source",
            "inferredAt"
          ],
          "additionalProperties": false
        }
      },
      "total": {
        "type": "number",
        "description": "Total edges matching the filter (before pagination)"
      },
      "limit": {
        "type": "number"
      },
      "offset": {
        "type": "number"
      }
    },
    "required": [
      "edges",
      "total",
      "limit",
      "offset"
    ],
    "additionalProperties": false
  }
}
