{
  "name": "semantic.edge.infer",
  "domain": "semantic",
  "description": "Run LLM inference to discover and link nodes across sources with confidence scores. Triggers an async job; edges above the confidenceThreshold are auto-accepted, edges below it are staged for UI review via semantic.edge.suggest.",
  "mode": "async",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "graph"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sourceIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "maxEdgesPerNode": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 10
      },
      "dryRun": {
        "type": "boolean",
        "default": false
      },
      "semanticEdgePrompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "description": "Custom prompt instructing the LLM on how to identify and type relationships between nodes"
      },
      "confidenceThreshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.8
      }
    },
    "required": [
      "semanticEdgePrompt"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "jobId": {
        "type": "string",
        "description": "Background job ID — poll via the job status mechanism or listen for webhook completion"
      },
      "status": {
        "const": "queued"
      },
      "estimatedNodes": {
        "type": "number",
        "description": "Approximate number of nodes that will be evaluated for relationships"
      },
      "dryRun": {
        "type": "boolean",
        "description": "Mirrors the dryRun input flag"
      }
    },
    "required": [
      "jobId",
      "status",
      "estimatedNodes",
      "dryRun"
    ],
    "additionalProperties": false
  }
}
