{
  "name": "graph.node.delete",
  "domain": "graph",
  "description": "Delete a KnowledgeNode and all its relationships from the graph.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "destructive",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "graph"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "nodeId": {
        "type": "string",
        "description": "publicId of the KnowledgeNode to delete"
      }
    },
    "required": [
      "nodeId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "deleted": {
        "type": "boolean",
        "description": "True if the node was found and deleted; false if it did not exist"
      }
    },
    "required": [
      "deleted"
    ],
    "additionalProperties": false
  }
}
