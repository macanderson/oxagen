{
  "name": "semantic.edge.approve",
  "domain": "semantic",
  "description": "Approve or reject an inferred semantic edge candidate. Approved edges are materialised as permanent :SEMANTIC_EDGE relationships in Neo4j; rejected edges are soft-dismissed with an audit trail.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "graph"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "edgeId": {
        "type": "string",
        "minLength": 1,
        "description": "UUID of the InferredEdge node to act on"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "reject"
        ],
        "description": "'approve' materialises the edge as permanent; 'reject' dismisses it with audit trail"
      },
      "comment": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "required": [
      "edgeId",
      "decision"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "edgeId": {
        "type": "string",
        "description": "The InferredEdge id that was acted on"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "reject"
        ]
      },
      "permanentEdgeId": {
        "type": "string"
      }
    },
    "required": [
      "edgeId",
      "decision"
    ],
    "additionalProperties": false
  }
}
