{
  "name": "graph.node.upsert",
  "domain": "graph",
  "description": "MERGE a KnowledgeNode in the graph. Creates or updates by externalId, or by a natural key derived from label+displayName+workspaceId.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "graph"
  },
  "chain": {
    "produces": [
      "graph.nodeId"
    ],
    "consumes": [
      "entity",
      "graph.label",
      "document.text"
    ],
    "chainHints": [
      "graph.edge.upsert"
    ]
  },
  "render": {
    "componentId": "graph-node-card",
    "recordLinks": [
      {
        "field": "nodeId",
        "recordType": "graph.node"
      }
    ]
  },
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "description": "User-defined node type, e.g. Person, Company, Topic"
      },
      "displayName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "description": "Human-readable name for the node"
      },
      "description": {
        "type": "string",
        "maxLength": 2000
      },
      "properties": {
        "type": "object",
        "additionalProperties": {}
      },
      "externalId": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [
      "label",
      "displayName"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "nodeId": {
        "type": "string",
        "description": "publicId of the upserted node"
      },
      "created": {
        "type": "boolean",
        "description": "True if the node was newly created, false if it was updated"
      }
    },
    "required": [
      "nodeId",
      "created"
    ],
    "additionalProperties": false
  }
}
