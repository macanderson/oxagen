{
  "name": "record_finding_fix",
  "domain": "spend",
  "description": "Record that the fix an open finding names was applied (org Owner or Admin): the finding becomes applied with the request id of this call, and later passes cite only runs that start after it.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "mutation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "findingId": {
        "type": "string"
      }
    },
    "required": [
      "findingId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "finding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cache_writes_never_read",
              "duplicate_tool_calls",
              "repeated_shell_commands",
              "unpaged_results"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "tool",
              "agent",
              "operator",
              "workspace"
            ]
          },
          "subject": {
            "type": "string"
          },
          "saving": {
            "type": "object",
            "properties": {
              "micros": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "basis": {
                "type": "string",
                "enum": [
                  "gateway_observed",
                  "client_attested",
                  "mixed",
                  "estimated"
                ]
              }
            },
            "required": [
              "micros",
              "currency",
              "basis"
            ],
            "additionalProperties": false
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium"
            ]
          },
          "window": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "why": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "runs": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "calls": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "applied",
              "dismissed"
            ]
          },
          "detectedAt": {
            "type": "string"
          },
          "decidedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "appliedActionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "level",
          "subject",
          "saving",
          "confidence",
          "window",
          "why",
          "fix",
          "runs",
          "calls",
          "status",
          "detectedAt",
          "decidedAt",
          "appliedActionId"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "finding"
    ],
    "additionalProperties": false
  }
}
