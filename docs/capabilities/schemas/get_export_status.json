{
  "name": "get_export_status",
  "domain": "privacy",
  "description": "Read the status of one of the calling user's own data exports, with the download link once it is ready.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "low",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "exportId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "exportId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "exportId": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "queued",
          "processing",
          "ready",
          "failed"
        ]
      },
      "downloadUrl": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "completedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "exportId",
      "status",
      "downloadUrl",
      "completedAt"
    ],
    "additionalProperties": false
  }
}
