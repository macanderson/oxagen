{
  "name": "fetch_web_page",
  "domain": "web",
  "description": "Fetch a URL and return its content as clean markdown text. Useful for reading web pages, documentation, or articles.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "search"
  },
  "chain": {
    "produces": [
      "document.text"
    ],
    "consumes": [
      "url"
    ],
    "chainHints": [
      "generate_document"
    ]
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "format": "uri"
      },
      "extractMarkdown": {
        "type": "boolean",
        "default": true
      },
      "timeout": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 30000,
        "default": 10000
      }
    },
    "required": [
      "url"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "format": "uri"
      },
      "title": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "wordCount": {
        "type": "integer",
        "minimum": 0
      },
      "fetchedAt": {
        "type": "string"
      },
      "statusCode": {
        "type": "integer"
      }
    },
    "required": [
      "url",
      "title",
      "content",
      "wordCount",
      "fetchedAt",
      "statusCode"
    ],
    "additionalProperties": false
  }
}
