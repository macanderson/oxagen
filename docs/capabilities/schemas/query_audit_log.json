{
  "name": "query_audit_log",
  "domain": "audit",
  "description": "Query the org's security audit events (security_events) with filters — actor, capability, outcome, event type, time range — returning a time-ordered feed. Read-only.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "read"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "source": {
        "type": "string",
        "enum": [
          "all",
          "security"
        ],
        "default": "all"
      },
      "eventType": {
        "type": "string",
        "description": "Exact event-type match (e.g. 'billing.plan_changed')"
      },
      "actorUserId": {
        "type": "string",
        "description": "Filter by the acting user's id"
      },
      "actorPublicId": {
        "type": "string",
        "description": "Filter by the acting user's public id (usr_…)"
      },
      "capability": {
        "type": "string",
        "description": "Filter by capability name"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "allow",
          "deny",
          "error",
          "success"
        ],
        "description": "Filter by authz outcome"
      },
      "workspaceId": {
        "type": "string",
        "description": "Restrict to one workspace (default: all in org)"
      },
      "from": {
        "type": "string",
        "description": "Inclusive ISO-8601 lower bound on occurredAt"
      },
      "to": {
        "type": "string",
        "description": "Exclusive ISO-8601 upper bound on occurredAt"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "events": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The security event's id"
            },
            "source": {
              "type": "string",
              "enum": [
                "security"
              ],
              "description": "Which audit spine the event came from"
            },
            "eventType": {
              "type": "string",
              "description": "Event classification (e.g. capability.invoke_denied)"
            },
            "occurredAt": {
              "type": "string",
              "description": "ISO-8601 timestamp of when the event occurred"
            },
            "actorUserId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "User who triggered the event, when known"
            },
            "actorPublicId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The acting user's public id (usr_…), when the user exists"
            },
            "workspaceId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "workspaceSlug": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The workspace's slug, when the event names a workspace"
            },
            "capability": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Capability name for capability.* security events"
            },
            "outcome": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Authz outcome for security events (allow/deny/error/success)"
            },
            "ip": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client IP address, when recorded"
            },
            "userAgent": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client user agent, when recorded"
            },
            "requestId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "source",
            "eventType",
            "occurredAt",
            "actorUserId",
            "actorPublicId",
            "workspaceId",
            "workspaceSlug",
            "capability",
            "outcome",
            "ip",
            "userAgent",
            "requestId"
          ],
          "additionalProperties": false
        },
        "description": "Matching events, newest first"
      },
      "total": {
        "type": "integer",
        "description": "Number of events in this page"
      },
      "hasMore": {
        "type": "boolean",
        "description": "Whether more events exist beyond this page"
      },
      "limit": {
        "type": "integer"
      },
      "offset": {
        "type": "integer"
      }
    },
    "required": [
      "events",
      "total",
      "hasMore",
      "limit",
      "offset"
    ],
    "additionalProperties": false
  }
}
