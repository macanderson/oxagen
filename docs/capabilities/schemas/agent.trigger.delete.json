  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "mutation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "triggerId": {
        "type": "string",
        "description": "Trigger public id (atr_…) or UUID"
      }
    },
    "required": [
      "triggerId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "triggerId": {
        "type": "string"
      },
      "deleted": {
        "type": "boolean"
      }
    },
    "required": [
      "triggerId",
      "deleted"
    ],
    "additionalProperties": false
  }
}
