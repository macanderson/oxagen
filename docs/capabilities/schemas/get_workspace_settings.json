{
  "name": "get_workspace_settings",
  "domain": "workspace",
  "description": "Read the active workspace's general settings: name, slug, description, and the effective consequence-role map for mandates.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "workspace"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "avatarUrl": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "consequenceRoles": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Owner",
              "Admin",
              "Compliance",
              "Billing"
            ]
          },
          "minItems": 1
        }
      },
      "steering": {
        "type": "object",
        "properties": {
          "autoSync": {
            "type": "boolean",
            "description": "Pull .oxagen/ forward from the production branch without being asked, when the checkout is behind it"
          },
          "blockStaleRuns": {
            "type": "boolean",
            "description": "Refuse to run a prompt while .oxagen/ is behind the production branch"
          }
        },
        "required": [
          "autoSync",
          "blockStaleRuns"
        ],
        "additionalProperties": false
      },
      "runEnrichmentEnabled": {
        "type": "boolean"
      }
    },
    "required": [
      "name",
      "slug",
      "description",
      "avatarUrl",
      "consequenceRoles",
      "steering"
    ],
    "additionalProperties": false
  }
}
