{
  "name": "start_background_task",
  "domain": "agent",
  "description": "Dispatch a long-running task as a durable Inngest job; the chat returns a task handle the user can monitor in the tray",
  "mode": "async",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "background"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "kind": {
        "type": "string"
      },
      "payload": {},
      "label": {
        "type": "string"
      }
    },
    "required": [
      "kind",
      "payload"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "taskId": {
        "type": "string"
      },
      "inngestRunId": {
        "type": "string"
      }
    },
    "required": [
      "taskId",
      "inngestRunId"
    ],
    "additionalProperties": false
  }
}
