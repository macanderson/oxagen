{
  "name": "activate_skill_version",
  "domain": "skill",
  "description": "Re-point a skill's active version to a chosen (possibly older) skill_versions row. Sets activated_by_user_id and activated_at on the skill row. Exactly one version is active at any time per skill.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "skill"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "skillId": {
        "type": "string",
        "description": "Public ID of the skill (e.g. 'skl_...') or its slug"
      },
      "versionNumber": {
        "type": "integer",
        "minimum": 1,
        "description": "Version number to activate"
      }
    },
    "required": [
      "skillId",
      "versionNumber"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "skillId": {
        "type": "string",
        "description": "Public ID of the skill"
      },
      "activeVersionNumber": {
        "type": "integer",
        "description": "Version number now active"
      },
      "activatedAt": {
        "type": "string",
        "description": "ISO 8601 timestamp of activation"
      }
    },
    "required": [
      "skillId",
      "activeVersionNumber",
      "activatedAt"
    ],
    "additionalProperties": false
  }
}
