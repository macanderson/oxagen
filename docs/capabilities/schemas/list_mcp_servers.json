{
  "name": "list_mcp_servers",
  "domain": "agent",
  "description": "List registered external MCP servers in the active workspace with their current health",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "servers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "publicId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "transportType": {
              "type": "string",
              "enum": [
                "streamable-http",
                "sse",
                "stdio"
              ]
            },
            "endpointUrl": {
              "type": "string"
            },
            "healthStatus": {
              "type": "string",
              "enum": [
                "healthy",
                "degraded",
                "unreachable",
                "unknown"
              ]
            },
            "lastHealthcheckAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "toolCount": {
              "type": "integer",
              "minimum": 0
            },
            "authKind": {
              "type": "string",
              "enum": [
                "oauth",
                "bearer",
                "header",
                "none"
              ],
              "default": "none"
            },
            "iconUrl": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "authorization": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "connected",
                        "needs_reauth",
                        "revoked",
                        "not_connected"
                      ]
                    },
                    "expiresAt": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "refreshable": {
                      "type": "boolean"
                    },
                    "lastRefreshedAt": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "state",
                    "expiresAt",
                    "refreshable",
                    "lastRefreshedAt"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "publicId",
            "name",
            "transportType",
            "endpointUrl",
            "healthStatus",
            "lastHealthcheckAt",
            "toolCount"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "servers"
    ],
    "additionalProperties": false
  }
}
