{
  "name": "list_approvals",
  "domain": "agent",
  "description": "List the workspace's pending tool-call approvals, soonest expiry first, cursor-paged, optionally narrowed to one run",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "approval"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      },
      "cursor": {
        "type": "string",
        "maxLength": 256
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "runId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "requester": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "string"
            },
            "expiresAt": {
              "type": "string"
            },
            "mandateId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "autoEligibility": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "ruleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "maxItems": 64
                    },
                    "floor": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ruleId",
                    "ok",
                    "reasons",
                    "floor"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "chain": {
              "type": "object",
              "properties": {
                "agentKey": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rule": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "agentKey",
                "rule"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "runId",
            "tool",
            "requester",
            "createdAt",
            "expiresAt",
            "mandateId",
            "autoEligibility",
            "chain"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "nextCursor": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "items",
      "nextCursor"
    ],
    "additionalProperties": false
  }
}
