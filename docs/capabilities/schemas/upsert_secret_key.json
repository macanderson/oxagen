{
  "name": "upsert_secret_key",
  "domain": "secret",
  "description": "Create or update a vault secret key (workspace root). Sensitive keys (default) are envelope-encrypted; an optional default value applies when an environment has no override.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "high",
    "category": "secret"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "minLength": 1
      },
      "sensitive": {
        "type": "boolean",
        "default": true
      },
      "memo": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "defaultValue": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "key"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false
  }
}
