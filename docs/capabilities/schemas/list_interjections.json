{
  "name": "list_interjections",
  "domain": "agent",
  "description": "List the questions agents in this workspace paused to ask a person, soonest expiry first, cursor-paged, optionally narrowed to one run",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "approval"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "open": {
        "type": "boolean",
        "default": true
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      },
      "cursor": {
        "type": "string",
        "maxLength": 256
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "runId": {
              "type": "string"
            },
            "agentKey": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "raisedAt": {
              "type": "string"
            },
            "expiresAt": {
              "type": "string"
            },
            "answeredAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "answer": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "answeredBy": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "question",
                "repo_unknown"
              ]
            },
            "raisedSeq": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "body": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "interjection_key": {
                      "type": "string"
                    },
                    "reason": {
                      "const": "repo_unknown"
                    },
                    "question": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "remote_digest": {
                      "type": "string"
                    },
                    "remote_digest_folded": {
                      "type": "string"
                    },
                    "timeout_ms": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "expires_at": {
                      "type": "string",
                      "x-server-validated": true,
                      "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
                    },
                    "on_timeout": {
                      "const": "deny"
                    },
                    "paths": {
                      "type": "array",
                      "items": [
                        {
                          "type": "object",
                          "properties": {
                            "path": {
                              "const": "link"
                            },
                            "workspace_slug": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            },
                            "config_version": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 64
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "skills_pinned": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "linked_repositories": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "path",
                            "workspace_slug",
                            "config_version",
                            "skills_pinned",
                            "linked_repositories"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "path": {
                              "const": "create"
                            },
                            "proposed_name": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 120
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "proposed_slug": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 64
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "skills_enabled": {
                              "const": false
                            }
                          },
                          "required": [
                            "path",
                            "proposed_name",
                            "proposed_slug",
                            "skills_enabled"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "interjection_key",
                    "reason",
                    "question",
                    "remote_digest",
                    "timeout_ms",
                    "expires_at",
                    "on_timeout",
                    "paths"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "repository": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "path": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "link",
                    "create",
                    "deny"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "receiptId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "runId",
            "agentKey",
            "question",
            "raisedAt",
            "expiresAt",
            "answeredAt",
            "answer",
            "answeredBy",
            "kind",
            "raisedSeq",
            "body",
            "repository",
            "path",
            "receiptId"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "nextCursor": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "items",
      "nextCursor"
    ],
    "additionalProperties": false
  }
}
