{
  "name": "run_capability_chain",
  "domain": "agent",
  "description": "Plan and execute a chain of capabilities to accomplish a goal. An LLM planner reads the capability catalog (with produces/consumes chain hints), the workspace prompt, and the enabled skills to draft an ordered plan; the executor threads each step's output into dependent steps' inputs through the invoke() kernel, then synthesizes a natural-language summary. Destructive or approval-required capabilities are planned but never auto-executed.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "agent"
  },
  "chain": {
    "produces": [
      "document.text"
    ],
    "consumes": [],
    "chainHints": [
      "generate_document"
    ]
  },
  "render": {
    "componentId": "capability-chain-card"
  },
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "goal": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "description": "What to accomplish"
      },
      "maxSteps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "default": 6
      },
      "autoExecute": {
        "type": "boolean",
        "default": true
      },
      "context": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "required": [
      "goal"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "goal": {
        "type": "string"
      },
      "plan": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Unique step id within the plan (e.g. 'step1')"
            },
            "capability": {
              "type": "string",
              "description": "The capability name this step invokes"
            },
            "rationale": {
              "type": "string",
              "description": "Why this step is part of the plan"
            },
            "inputJson": {
              "type": "string",
              "description": "JSON object for the capability input. May reference a prior step's output via $steps.<id>.<dotpath> (e.g. $steps.step1.nodeId), resolved by the executor."
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "required": [
            "id",
            "capability",
            "rationale",
            "inputJson"
          ],
          "additionalProperties": false
        }
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "capability": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "success",
                "error",
                "skipped"
              ]
            },
            "input": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {}
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {},
            "error": {
              "type": "string"
            },
            "durationMs": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "capability",
            "rationale",
            "status",
            "input",
            "durationMs"
          ],
          "additionalProperties": false
        }
      },
      "summary": {
        "type": "string"
      },
      "executed": {
        "type": "boolean"
      }
    },
    "required": [
      "goal",
      "plan",
      "steps",
      "summary",
      "executed"
    ],
    "additionalProperties": false
  }
}
