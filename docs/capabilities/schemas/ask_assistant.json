{
  "name": "ask_assistant",
  "domain": "assistant",
  "description": "Take one turn with the in-app agent: append the message to a conversation, record the turn as a run of its own, drive it on the assistant engine with every completion and tool call answered by Oxagen, and return the reply with the run it was recorded as.",
  "mode": "async",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "conversation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "conversationId": {
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string"
              }
            ]
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "content": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32768
      },
      "pageContext": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "route": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "orgSlug": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "workspaceSlug": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "entityId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "entityLabel": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "route",
              "orgSlug",
              "workspaceSlug"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "goal": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxRounds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 3
          }
        },
        "required": [
          "statement"
        ],
        "additionalProperties": false
      },
      "turnId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "content"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "conversationId": {
        "type": "string",
        "format": "uuid"
      },
      "conversationPublicId": {
        "type": "string"
      },
      "userMessageId": {
        "type": "string",
        "format": "uuid"
      },
      "assistantMessageId": {
        "type": "string",
        "format": "uuid"
      },
      "runId": {
        "type": "string"
      },
      "reply": {
        "type": "string"
      },
      "parkedCards": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "approvalId": {
              "type": "string",
              "minLength": 1
            },
            "capability": {
              "type": "string",
              "minLength": 1
            },
            "expiresAt": {
              "type": "string"
            }
          },
          "required": [
            "approvalId",
            "capability",
            "expiresAt"
          ],
          "additionalProperties": false
        }
      },
      "toolCalls": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "toolCallId": {
              "type": "string",
              "minLength": 1
            },
            "toolName": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "completed",
                "failed",
                "denied",
                "cancelled",
                "parked"
              ]
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            },
            "approvalId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "toolCallId",
            "toolName",
            "outcome",
            "durationMs",
            "approvalId"
          ],
          "additionalProperties": false
        }
      },
      "stopped": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "conversationId",
      "conversationPublicId",
      "userMessageId",
      "assistantMessageId",
      "runId",
      "reply",
      "parkedCards",
      "toolCalls"
    ],
    "additionalProperties": false
  }
}
