{
  "name": "list_prepaid_orders",
  "domain": "billing",
  "description": "List the organization's prepaid orders, newest first: the licence, governed action units and usage credits each invoice sold, with amounts, the service period, status, when the units and credits were granted, and the invoice number and hosted page.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      },
      "cursor": {
        "type": "string",
        "maxLength": 256
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "orderId": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "paid",
                "void",
                "uncollectible"
              ]
            },
            "agreementRef": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "poNumber": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "licence",
                      "gau",
                      "credits"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "amountMicros": {
                    "type": "string"
                  },
                  "periodStart": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "periodEnd": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "description",
                  "quantity",
                  "amountMicros",
                  "periodStart",
                  "periodEnd"
                ],
                "additionalProperties": false
              },
              "maxItems": 3
            },
            "totalMicros": {
              "type": "string"
            },
            "grantOn": {
              "type": "string",
              "enum": [
                "paid",
                "issue"
              ]
            },
            "unitsGrantedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "creditsGrantedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "paidAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "string"
            },
            "invoice": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "number": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "draft",
                        "open",
                        "paid",
                        "void",
                        "uncollectible"
                      ]
                    },
                    "dueAt": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "hostedInvoiceUrl": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "uri"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "invoicePdfUrl": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "uri"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "number",
                    "status",
                    "dueAt",
                    "hostedInvoiceUrl",
                    "invoicePdfUrl"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "orderId",
            "status",
            "agreementRef",
            "poNumber",
            "currency",
            "lines",
            "totalMicros",
            "grantOn",
            "unitsGrantedAt",
            "creditsGrantedAt",
            "paidAt",
            "createdAt",
            "invoice"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "nextCursor": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "items",
      "nextCursor"
    ],
    "additionalProperties": false
  }
}
