{
  "name": "get_run",
  "domain": "run",
  "description": "Read one run's header and, for an evidence-ledger run, one page of its frames from an opaque cursor, optionally waiting for a new frame; a wrapped-agent run answers its header with frames: null.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runId": {
        "type": "string"
      },
      "framesAfter": {
        "type": "string",
        "maxLength": 256
      },
      "frameLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 200
      },
      "waitMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20000,
        "default": 0
      }
    },
    "required": [
      "runId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "ledger",
              "tacho"
            ]
          },
          "agentKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "operatorId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "live",
              "sealed",
              "halted"
            ]
          },
          "turns": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "steps": {
            "type": "integer",
            "minimum": 0
          },
          "frames": {
            "type": "integer",
            "minimum": 0
          },
          "cost": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "micros": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "basis": {
                    "type": "string",
                    "enum": [
                      "gateway_observed",
                      "client_attested",
                      "mixed",
                      "estimated"
                    ]
                  }
                },
                "required": [
                  "micros",
                  "currency",
                  "basis"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "taskRef": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "startedAt": {
            "type": "string"
          },
          "sealedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "source",
          "agentKey",
          "operatorId",
          "status",
          "turns",
          "steps",
          "frames",
          "cost",
          "taskRef",
          "startedAt",
          "sealedAt"
        ],
        "additionalProperties": false
      },
      "frames": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "cursor": {
                      "type": "string"
                    },
                    "seq": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "stage": {
                      "type": "string"
                    },
                    "observedAt": {
                      "type": "string"
                    },
                    "digest": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cursor",
                    "seq",
                    "type",
                    "stage",
                    "observedAt",
                    "digest",
                    "summary"
                  ],
                  "additionalProperties": false
                }
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "frames",
              "cursor"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "run",
      "frames"
    ],
    "additionalProperties": false
  }
}
