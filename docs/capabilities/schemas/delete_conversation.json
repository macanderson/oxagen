{
  "name": "delete_conversation",
  "domain": "conversation",
  "description": "Permanently delete conversations from the user's view (soft-delete: sets deleted_at; row retained for audit, never restorable)",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "destructive",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "conversation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "conversationIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "conversationIds"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "deleted": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "deleted"
    ],
    "additionalProperties": false
  }
}
