{
  "name": "list_repositories",
  "domain": "repository",
  "description": "List the workspace's repositories — its one main repository and every linked one — with each one's role and approved default ref.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli"
  ],
  "sensitivity": "low",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repositories": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "bindingId": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "enum": [
                "main",
                "linked"
              ]
            },
            "provider": {
              "type": "string",
              "enum": [
                "github",
                "gitlab"
              ]
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "fullName": {
              "type": "string",
              "minLength": 1
            },
            "defaultRef": {
              "type": "string",
              "minLength": 1
            },
            "htmlUrl": {
              "type": "string",
              "format": "uri"
            },
            "boundAt": {
              "type": "string"
            },
            "connectionLive": {
              "type": "boolean"
            },
            "events": {
              "type": "string",
              "enum": [
                "installed",
                "suspended",
                "uninstalled",
                "paused",
                "retired",
                "unknown"
              ]
            }
          },
          "required": [
            "bindingId",
            "role",
            "provider",
            "owner",
            "name",
            "fullName",
            "defaultRef",
            "htmlUrl",
            "boundAt",
            "connectionLive",
            "events"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "repositories"
    ],
    "additionalProperties": false
  }
}
