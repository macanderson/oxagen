{
  "name": "set_plugin_secret",
  "domain": "plugin",
  "description": "Store or update an encrypted credential (API key or OAuth token) for a plugin server in this workspace.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "plugin"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "orgListingId": {
        "type": "string"
      },
      "authKind": {
        "type": "string",
        "enum": [
          "oauth",
          "secret"
        ]
      },
      "secret": {
        "type": "string"
      },
      "accessToken": {
        "type": "string"
      },
      "refreshToken": {
        "type": "string"
      }
    },
    "required": [
      "orgListingId",
      "authKind"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      }
    },
    "required": [
      "ok"
    ],
    "additionalProperties": false
  }
}
