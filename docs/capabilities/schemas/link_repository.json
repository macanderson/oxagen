{
  "name": "link_repository",
  "domain": "repository",
  "description": "Open a steering PR that links a GitHub repository to the workspace. The link takes effect when the PR merges.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "vcs"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {
        "const": "github",
        "default": "github"
      },
      "owner": {
        "type": "string",
        "minLength": 1,
        "maxLength": 39
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "required": [
      "owner",
      "name"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fullName": {
        "type": "string",
        "minLength": 1
      },
      "defaultRef": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "proposed",
          "listed"
        ]
      },
      "steeringPullRequest": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "reused": {
                "type": "boolean"
              }
            },
            "required": [
              "number",
              "url",
              "reused"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "fullName",
      "defaultRef",
      "status",
      "steeringPullRequest"
    ],
    "additionalProperties": false
  }
}
