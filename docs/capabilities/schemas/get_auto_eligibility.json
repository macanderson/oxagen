{
  "name": "get_auto_eligibility",
  "domain": "approval_rule",
  "description": "The auto-approval evaluation recorded for one approval request, where the request stands, and who resolved it",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "approval"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "approvalId": {
        "type": "string",
        "x-server-validated": true,
        "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
      }
    },
    "required": [
      "approvalId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "approvalId": {
        "type": "string"
      },
      "state": {
        "type": "string",
        "enum": [
          "pending",
          "approved",
          "denied",
          "expired"
        ]
      },
      "resolvedBy": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "resolvedByName": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          {
            "type": "null"
          }
        ]
      },
      "eligibility": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "ok": {
                "type": "boolean"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "maxItems": 64
              },
              "floor": {
                "type": "boolean"
              }
            },
            "required": [
              "ruleId",
              "ok",
              "reasons",
              "floor"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "approvalId",
      "state",
      "resolvedBy",
      "resolvedByName",
      "eligibility"
    ],
    "additionalProperties": false
  }
}
