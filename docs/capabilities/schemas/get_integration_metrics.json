{
  "name": "get_integration_metrics",
  "domain": "integration",
  "description": "Get sync statistics and metrics for a plugin instance.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "plugin"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "integrationId": {
        "type": "string",
        "description": "Plugin instance ID"
      }
    },
    "required": [
      "integrationId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "integrationId": {
        "type": "string"
      },
      "pluginId": {
        "type": "string"
      },
      "displayName": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "paused",
          "failed",
          "pending_setup"
        ]
      },
      "entityCount": {
        "type": "number"
      },
      "entityCountByType": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      },
      "lastSyncAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "lastSyncDurationMs": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "lastErrorAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "errorMessage": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "integrationId",
      "pluginId",
      "displayName",
      "status",
      "entityCount",
      "entityCountByType",
      "lastSyncAt",
      "lastSyncDurationMs",
      "lastErrorAt",
      "errorMessage"
    ],
    "additionalProperties": false
  }
}
