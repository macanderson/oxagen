{
  "name": "get_subagent_logs",
  "domain": "agent",
  "description": "Generate a downloadable markdown logfile for a fan-out (research swarm or any agent.subagent.dispatch). Includes every child subagent's capability, status, timing, full input (e.g. the search query) and full output (e.g. each result), so the run is traceable down to individual queries and results.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "agent"
  },
  "chain": {
    "produces": [
      "asset.id",
      "document.text"
    ],
    "consumes": [
      "swarm.id"
    ],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fanoutId": {
        "type": "string",
        "description": "The fan-out / dispatch id (the dispatchId from research.swarm.start or agent.subagent.dispatch)"
      },
      "title": {
        "type": "string",
        "maxLength": 200
      }
    },
    "required": [
      "fanoutId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "assetId": {
        "type": "string"
      },
      "publicId": {
        "type": "string"
      },
      "childCount": {
        "type": "number"
      },
      "mimeType": {
        "type": "string"
      },
      "sizeBytes": {
        "type": "number"
      },
      "url": {
        "type": "string"
      },
      "serveUrl": {
        "type": "string"
      },
      "render": {
        "type": "object",
        "properties": {
          "componentId": {
            "const": "file-attachment"
          },
          "props": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "const": "document"
              },
              "mimeType": {
                "type": "string"
              },
              "sizeBytes": {
                "type": "number"
              }
            },
            "required": [
              "url",
              "name",
              "kind",
              "mimeType",
              "sizeBytes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "componentId",
          "props"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "assetId",
      "publicId",
      "childCount",
      "mimeType",
      "sizeBytes",
      "url",
      "serveUrl",
      "render"
    ],
    "additionalProperties": false
  }
}
