{
  "name": "get_agent_role",
  "domain": "agent",
  "description": "Get one IAM role's status relative to an agent: whether the agent's delegated principal holds it, the assignment provenance when held, and the role's capability grant list (what attaching it confers). Read-only governance introspection.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string",
        "minLength": 1,
        "description": "Agent public id (agt_…), UUID, or slug — workspace-scoped"
      },
      "roleName": {
        "type": "string",
        "minLength": 1,
        "description": "IAM role name to inspect"
      }
    },
    "required": [
      "agentId",
      "roleName"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string",
        "description": "Agent public id (agt_…)"
      },
      "roleId": {
        "type": "string",
        "description": "Public role id (rol_…)"
      },
      "roleName": {
        "type": "string"
      },
      "assigned": {
        "type": "boolean",
        "description": "True when the agent's principal holds an active assignment"
      },
      "assignment": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "assignmentId": {
                "type": "string",
                "description": "Public assignment id (pra_…)"
              },
              "roleId": {
                "type": "string",
                "description": "Public role id (rol_…)"
              },
              "roleName": {
                "type": "string"
              },
              "scopeKind": {
                "type": "string",
                "enum": [
                  "org",
                  "workspace"
                ]
              },
              "isSystemDefault": {
                "type": "boolean",
                "description": "True for system-seeded agent roles (Agent Observer/Contributor/Operator)"
              },
              "assignedAt": {
                "type": "string",
                "description": "ISO-8601 timestamp of the assignment"
              },
              "assignedBy": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expiresAt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "workspaceId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "assignmentId",
              "roleId",
              "roleName",
              "scopeKind",
              "isSystemDefault",
              "assignedAt",
              "assignedBy",
              "expiresAt",
              "workspaceId"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "grants": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string",
              "description": "Capability name the grant applies to"
            },
            "effect": {
              "type": "string",
              "enum": [
                "allow",
                "deny",
                "require_approval"
              ]
            }
          },
          "required": [
            "capability",
            "effect"
          ],
          "additionalProperties": false
        },
        "description": "Capability grants the role carries"
      }
    },
    "required": [
      "agentId",
      "roleId",
      "roleName",
      "assigned",
      "assignment",
      "grants"
    ],
    "additionalProperties": false
  }
}
