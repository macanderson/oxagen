{
  "name": "delete_role",
  "domain": "iam",
  "description": "Delete a custom IAM role and its grants. Refused for a system role and for a role any principal still holds.",
  "mode": "sync",
  "surfaces": ["api", "mcp", "agent"],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "iam"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "roleId": {
        "type": "string",
        "description": "Public role id (rol_…)"
      }
    },
    "required": ["roleId"],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "The deleted role's public id"
      },
      "name": {
        "type": "string"
      }
    },
    "required": ["id", "name"],
    "additionalProperties": false
  }
}
