{
  "name": "get_schema_registry",
  "domain": "schema",
  "description": "Resolve a workspace's registry: pinned version, draft version, enforcement mode, per-schema enabled state, label/relationship/property tree.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "schema"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "versionId": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "registryId": {
        "type": "string"
      },
      "pinnedVersionId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "draftVersionId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "enforcementMode": {
        "type": "string",
        "enum": [
          "strict",
          "lenient",
          "off"
        ]
      },
      "conformanceFloor": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "schemas": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "schemaName": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "user",
                "connector",
                "recommended"
              ]
            },
            "connectorId": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "description": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "naturalKeyProps": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "properties": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "description": "Property name"
                        },
                        "dataType": {
                          "type": "string",
                          "enum": [
                            "string",
                            "number",
                            "integer",
                            "boolean",
                            "date",
                            "datetime",
                            "url",
                            "email",
                            "enum",
                            "json",
                            "array"
                          ]
                        },
                        "required": {
                          "type": "boolean",
                          "default": false
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "enumValues": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "itemType": {
                          "type": "string"
                        },
                        "constraints": {
                          "type": "object",
                          "properties": {
                            "min": {
                              "type": "number"
                            },
                            "max": {
                              "type": "number"
                            },
                            "minLength": {
                              "type": "integer"
                            },
                            "maxLength": {
                              "type": "integer"
                            },
                            "pattern": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false,
                          "description": "Validation constraints mirroring the connector FieldValidation shape"
                        },
                        "example": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "key",
                        "dataType"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "name",
                  "displayName",
                  "description",
                  "naturalKeyProps",
                  "properties"
                ],
                "additionalProperties": false
              }
            },
            "relationshipTypes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "startLabel": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "endLabel": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cardinality": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "one_to_one",
                          "one_to_many",
                          "many_to_many"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "properties": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "description": "Property name"
                        },
                        "dataType": {
                          "type": "string",
                          "enum": [
                            "string",
                            "number",
                            "integer",
                            "boolean",
                            "date",
                            "datetime",
                            "url",
                            "email",
                            "enum",
                            "json",
                            "array"
                          ]
                        },
                        "required": {
                          "type": "boolean",
                          "default": false
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "enumValues": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "itemType": {
                          "type": "string"
                        },
                        "constraints": {
                          "type": "object",
                          "properties": {
                            "min": {
                              "type": "number"
                            },
                            "max": {
                              "type": "number"
                            },
                            "minLength": {
                              "type": "integer"
                            },
                            "maxLength": {
                              "type": "integer"
                            },
                            "pattern": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false,
                          "description": "Validation constraints mirroring the connector FieldValidation shape"
                        },
                        "example": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "key",
                        "dataType"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "name",
                  "displayName",
                  "startLabel",
                  "endLabel",
                  "cardinality",
                  "properties"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schemaName",
            "displayName",
            "source",
            "enabled",
            "labels",
            "relationshipTypes"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "registryId",
      "pinnedVersionId",
      "draftVersionId",
      "enforcementMode",
      "conformanceFloor",
      "schemas"
    ],
    "additionalProperties": false
  }
}
