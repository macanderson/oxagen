{
  "name": "agent.subagent.aggregate",
  "domain": "agent",
  "description": "Return the current merged results, conflict list, and execution timeline for a subagent fanout. Non-blocking: reports the live status (running until children finish) — durable waiting is handled by the agent.aggregate-fanout Inngest function.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "background"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fanoutId": {
        "type": "string",
        "description": "Public ID of the subagent fanout to aggregate"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1800000,
        "default": 300000
      }
    },
    "required": [
      "fanoutId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fanoutId": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "completed",
          "partial",
          "failed",
          "timed_out"
        ],
        "description": "running/pending = children still executing (aggregatedData null); completed = all succeeded; partial = some succeeded, some failed/incomplete (merged data of the successful subset); failed = none succeeded; timed_out = still unfinished past the snapshot window"
      },
      "totalChildren": {
        "type": "integer"
      },
      "completedChildren": {
        "type": "integer"
      },
      "aggregatedData": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": {}
          },
          {
            "type": "null"
          }
        ]
      },
      "conflicts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "items": {}
            },
            "runIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "key",
            "values",
            "runIds"
          ],
          "additionalProperties": false
        },
        "description": "Keys where two or more runs produced different values"
      },
      "timeline": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string"
            },
            "capabilityName": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "startedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "completedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "errorReason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "runId",
            "capabilityName",
            "status",
            "startedAt",
            "completedAt",
            "errorReason"
          ],
          "additionalProperties": false
        }
      },
      "children": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string"
            },
            "capabilityName": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "input": {},
            "output": {},
            "errorReason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "runId",
            "capabilityName",
            "status",
            "input",
            "output",
            "errorReason"
          ],
          "additionalProperties": false
        },
        "description": "Per-child run with its FULL input + output payloads — the raw fan-out results. Unlike aggregatedData (which deep-merges and collides on shared keys like `results`), this preserves each child's distinct result so callers can present per-task output (e.g. each web.search query's hits)."
      },
      "firstError": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "fanoutId",
      "status",
      "totalChildren",
      "completedChildren",
      "aggregatedData",
      "conflicts",
      "timeline",
      "children",
      "firstError"
    ],
    "additionalProperties": false
  }
}
