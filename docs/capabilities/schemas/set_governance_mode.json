{
  "name": "set_governance_mode",
  "domain": "workspace",
  "description": "Set the steering governance mode of a workspace by writing its governance file: the mode key of steering/governance.toml in a steering repository, or .oxagen/rules/governance.toml in a legacy one. Under solo the change lands at once; under team or regulated it opens a pull request for review, which an org Owner or Admin, or a workspace Owner or Admin, may skip with applyImmediately. In a steering repository the change always travels as a checked pull request, and landing at once merges it through the steering merge queue. A reviewed change there is recorded as a governance proposal, which merge_context_pr lands for an approver. The active workspace unless workspaceId names another one in the organization.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "workspace"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workspaceId": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": [
          "solo",
          "team",
          "regulated"
        ]
      },
      "applyImmediately": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "mode"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "outcome": {
        "type": "string",
        "enum": [
          "applied",
          "proposed",
          "unchanged"
        ]
      },
      "requestedMode": {
        "type": "string",
        "enum": [
          "solo",
          "team",
          "regulated"
        ]
      },
      "previousMode": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "solo",
              "team",
              "regulated"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "effectiveMode": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "solo",
              "team",
              "regulated"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "fullName": {
        "type": "string",
        "minLength": 1
      },
      "productionBranch": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "minLength": 1
      },
      "commitSha": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "pullRequest": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "htmlUrl": {
                "type": "string",
                "format": "uri"
              },
              "reused": {
                "type": "boolean"
              }
            },
            "required": [
              "number",
              "htmlUrl",
              "reused"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "overrodeReview": {
        "type": "boolean"
      }
    },
    "required": [
      "outcome",
      "requestedMode",
      "previousMode",
      "effectiveMode",
      "fullName",
      "productionBranch",
      "path",
      "commitSha",
      "pullRequest",
      "overrodeReview"
    ],
    "additionalProperties": false
  }
}
