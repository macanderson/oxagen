{
  "name": "create_plan",
  "domain": "agent",
  "description": "Create a structured hierarchical execution plan with tasks, dependencies, and approval gates; the plan must be approved via agent.plan.approve before execution proceeds",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "planning"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "goals": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "High-level goals this plan achieves"
      },
      "constraints": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "tasks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "parentTaskId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "capability": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "estimatedDurationMs": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "title"
          ],
          "additionalProperties": false
        }
      },
      "approvalRequired": {
        "type": "boolean",
        "default": true
      },
      "messageId": {
        "type": "string"
      }
    },
    "required": [
      "goals",
      "tasks"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "planId": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "awaiting_approval"
        ]
      },
      "goals": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "tasks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "parentTaskId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "capability": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "estimatedDurationMs": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "title"
          ],
          "additionalProperties": false
        }
      },
      "approvalRequired": {
        "type": "boolean"
      },
      "createdAt": {
        "type": "string"
      }
    },
    "required": [
      "planId",
      "status",
      "goals",
      "tasks",
      "approvalRequired",
      "createdAt"
    ],
    "additionalProperties": false
  }
}
