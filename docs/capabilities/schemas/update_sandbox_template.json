{
  "name": "update_sandbox_template",
  "domain": "sandbox",
  "description": "Update a sandbox template's metadata, provider, runtime, resources, network, secret selection, literal config, packages, or active state. A default template cannot be deactivated — promote another first.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "configuration"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
