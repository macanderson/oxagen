    "type": "object",
    "properties": {
      "templateId": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "slug": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "provider": {
        "type": "string",
        "enum": [
          "modal",
          "vercel",
          "docker"
        ]
      },
      "runtime": {
