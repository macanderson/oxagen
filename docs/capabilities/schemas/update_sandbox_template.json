            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "resources": {
        "type": "object",
        "properties": {
          "vcpu": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "memoryMb": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8192
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300000
          },
          "diskMb": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20480
          }
        },
        "additionalProperties": false
      },
      "network": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "public",
              "static_egress",
              "aws_privatelink",
              "gcp_psc",
              "reverse_tunnel",
              "ssh_bastion"
            ]
          },
          "config": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": false
      },
      "secretSelection": {
        "anyOf": [
          {
            "const": "all"
          },
          {
            "type": "object",
            "properties": {
              "keyPublicIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "keyPublicIds"
            ],
            "additionalProperties": false
          }
        ]
      },
      "literalEnv": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "packages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "manager": {
              "type": "string",
              "enum": [
                "apt",
                "cargo",
                "gem",
                "go",
                "npm",
                "pnpm",
                "yarn",
                "pip",
                "poetry",
                "uv"
              ]
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            }
          },
          "required": [
            "manager"
          ],
          "additionalProperties": false
        }
      },
      "isActive": {
        "type": "boolean"
