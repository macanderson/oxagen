{
  "name": "cancel_workflow",
  "domain": "workflow",
  "description": "Cancel a running or planning workflow, stopping all in-flight sub-tasks",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "workflow"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workflowId": {
        "type": "string",
        "minLength": 1,
        "description": "Public ID (wfr_*) or internal UUID of the workflow run"
      }
    },
    "required": [
      "workflowId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "cancelled": {
        "type": "boolean"
      }
    },
    "required": [
      "cancelled"
    ],
    "additionalProperties": false
  }
}
