{
  "name": "bind_main_repository",
  "domain": "repository",
  "description": "Bind the workspace's main repository and close the onboarding gate's provisional window: a GitHub repository the workspace's GitHub App installation reaches, or a gitlab.com project connected with attach_gitlab_project.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "provider": {
            "const": "github"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 39
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "owner",
          "name"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "provider": {
            "const": "gitlab"
          },
          "projectPath": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1024
          }
        },
        "required": [
          "provider",
          "projectPath"
        ],
        "additionalProperties": false
      }
    ]
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "bindingId": {
        "type": "string"
      },
      "connectionId": {
        "type": "string"
      },
      "provider": {
        "type": "string",
        "enum": [
          "github",
          "gitlab"
        ]
      },
      "fullName": {
        "type": "string",
        "minLength": 1
      },
      "defaultRef": {
        "type": "string",
        "minLength": 1
      },
      "boundAt": {
        "type": "string"
      },
      "provisionalClosed": {
        "type": "boolean"
      }
    },
    "required": [
      "bindingId",
      "connectionId",
      "provider",
      "fullName",
      "defaultRef",
      "boundAt",
      "provisionalClosed"
    ],
    "additionalProperties": false
  }
}
