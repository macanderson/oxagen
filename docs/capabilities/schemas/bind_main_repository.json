{
  "name": "bind_main_repository",
  "domain": "repository",
  "description": "Bind a GitHub repository the workspace's GitHub App installation reaches as its main repo, and close the onboarding gate's provisional window.",
  "mode": "sync",
  "surfaces": ["api"],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "owner": {
        "type": "string",
        "minLength": 1,
        "maxLength": 39
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "required": ["owner", "name"],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "bindingId": {
        "type": "string"
      },
      "connectionId": {
        "type": "string"
      },
      "fullName": {
        "type": "string",
        "minLength": 1
      },
      "defaultRef": {
        "type": "string",
        "minLength": 1
      },
      "boundAt": {
        "type": "string"
      },
      "provisionalClosed": {
        "type": "boolean"
      }
    },
    "required": [
      "bindingId",
      "connectionId",
      "fullName",
      "defaultRef",
      "boundAt",
      "provisionalClosed"
    ],
    "additionalProperties": false
  }
}
