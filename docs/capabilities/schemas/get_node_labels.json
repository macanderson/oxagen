{
  "name": "get_node_labels",
  "domain": "graph",
  "description": "Read a customer-context node's full label set.",
  "mode": "sync",
  "surfaces": [
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "graph"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "nodeId": {
        "type": "string",
        "minLength": 1,
        "description": "publicId of the target node"
      }
    },
    "required": [
      "nodeId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "nodeId": {
        "type": "string"
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "nodeId",
      "labels"
    ],
    "additionalProperties": false
  }
}
