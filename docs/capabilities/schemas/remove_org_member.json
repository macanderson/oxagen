{
  "name": "remove_org_member",
  "domain": "org",
  "description": "Remove a member from the org. Revokes their role assignments and deactivates their principal. Blocked if the target is the last org owner. Audited as org.member_removed.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "organization"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "targetUserId": {
        "type": "string",
        "minLength": 1,
        "description": "The UUID of the user to remove from the org"
      }
    },
    "required": [
      "targetUserId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "removed": {
        "type": "boolean"
      },
      "targetUserId": {
        "type": "string"
      },
      "orgId": {
        "type": "string"
      }
    },
    "required": [
      "removed",
      "targetUserId",
      "orgId"
    ],
    "additionalProperties": false
  }
}
