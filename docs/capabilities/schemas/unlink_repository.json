{
  "name": "unlink_repository",
  "domain": "repository",
  "description": "Unlink a linked repository from the workspace. A repository that workspace.toml lists is removed by a steering PR. The steering repository cannot be unlinked, and binding history is kept.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "vcs"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "bindingId": {
        "type": "string"
      }
    },
    "required": [
      "bindingId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "bindingId": {
        "type": "string"
      },
      "fullName": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "unlinked",
          "proposed"
        ]
      },
      "unlinkedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "steeringPullRequest": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "reused": {
                "type": "boolean"
              }
            },
            "required": [
              "number",
              "url",
              "reused"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "bindingId",
      "fullName",
      "status",
      "unlinkedAt",
      "steeringPullRequest"
    ],
    "additionalProperties": false
  }
}
