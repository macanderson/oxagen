{
  "name": "publish_agent_def",
  "domain": "agent",
  "description": "Publish an agent version — marks it isPublished, computes a SHA-256 checksum over its canonical config, and sets it as the agent's active version. A published version is immutable thereafter",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "mutation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string",
        "description": "Agent public id (agt_…) or UUID"
      },
      "version": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "agentId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string"
      },
      "version": {
        "type": "integer",
        "minimum": 0
      },
      "checksum": {
        "type": "string"
      },
      "activeVersionId": {
        "type": "string"
      }
    },
    "required": [
      "agentId",
      "version",
      "checksum",
      "activeVersionId"
    ],
    "additionalProperties": false
  }
}
