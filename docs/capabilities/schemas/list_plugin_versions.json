{
  "name": "list_plugin_versions",
  "domain": "plugin",
  "description": "List version history for a connector plugin including changelog entries and breaking-change flags. Used by org admins to review update impact before upgrading.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "plugin"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pluginId": {
        "type": "string",
        "description": "Connector plugin identifier (e.g. 'github', 'google-drive')"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 20
      },
      "includeChangelog": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "pluginId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pluginId": {
        "type": "string"
      },
      "currentVersion": {
        "type": "string",
        "description": "Latest available version of this plugin"
      },
      "installedVersion": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "hasBreakingUpdate": {
        "type": "boolean",
        "description": "True when any version between installedVersion and currentVersion is breaking"
      },
      "versions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "description": "SemVer version string (e.g. '1.3.0')"
            },
            "releasedAt": {
              "type": "string",
              "description": "ISO 8601 release timestamp"
            },
            "isBreaking": {
              "type": "boolean",
              "description": "True when this version contains breaking config schema changes"
            },
            "breakingChanges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "changelog": {
              "type": "string"
            },
            "schemaVersion": {
              "type": "string",
              "description": "Schema format version (apiVersion tag) used by this plugin version"
            },
            "minimumPlatformVersion": {
              "type": "string"
            }
          },
          "required": [
            "version",
            "releasedAt",
            "isBreaking",
            "schemaVersion"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "pluginId",
      "currentVersion",
      "installedVersion",
      "hasBreakingUpdate",
      "versions"
    ],
    "additionalProperties": false
  }
}
