{
  "name": "list_memory_citations",
  "domain": "agent",
  "description": "List memory citations for an execution, optionally filtered by compliance (violations) or influence (what shaped the output).",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "memory"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "executionId": {
        "type": "string",
        "minLength": 1
      },
      "compliance": {
        "type": "string",
        "enum": [
          "COMPLIED",
          "DISCRETION",
          "VIOLATION",
          "NA"
        ]
      },
      "influenceIn": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "DECISIVE",
            "CONTRIBUTING",
            "CONSIDERED",
            "IGNORED"
          ]
        }
      }
    },
    "required": [
      "executionId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "citations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "citationId": {
              "type": "string"
            },
            "memoryId": {
              "type": "string"
            },
            "lesson": {
              "type": "string"
            },
            "influence": {
              "type": "string",
              "enum": [
                "DECISIVE",
                "CONTRIBUTING",
                "CONSIDERED",
                "IGNORED"
              ]
            },
            "compliance": {
              "type": "string",
              "enum": [
                "COMPLIED",
                "DISCRETION",
                "VIOLATION",
                "NA"
              ]
            },
            "enforcementAtCite": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expectedValue": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observedValue": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "agentRationale": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "citationId",
            "memoryId",
            "lesson",
            "influence",
            "compliance",
            "enforcementAtCite",
            "expectedValue",
            "observedValue",
            "agentRationale"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "citations"
    ],
    "additionalProperties": false
  }
}
