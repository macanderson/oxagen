{
  "name": "suggest_connection_mappings",
  "domain": "connection",
  "description": "Use an LLM to suggest entity type mappings for a connection based on previewed record types. Part of the setup wizard flow.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "ai"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connectionId": {
        "type": "string",
        "minLength": 1,
        "description": "Public ID or internal UUID of the connection"
      },
      "recordTypes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sourceRecordType": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "sampleFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sampleRecords": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "sourceRecordType",
            "displayName",
            "sampleFields"
          ],
          "additionalProperties": false
        },
        "description": "Record type samples to analyze (from connection.preview output)"
      },
      "existingEntityTypes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "connectionId",
      "recordTypes"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "suggestions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sourceRecordType": {
              "type": "string"
            },
            "suggestedEntityType": {
              "type": "string",
              "description": "Recommended entity type string (snake_case, e.g. 'task', 'code_change')"
            },
            "suggestedPropertyMappings": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Source field path → canonical property name mappings"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reasoning": {
              "type": "string",
              "description": "LLM explanation shown to the user in the setup wizard"
            }
          },
          "required": [
            "sourceRecordType",
            "suggestedEntityType",
            "suggestedPropertyMappings",
            "confidence",
            "reasoning"
          ],
          "additionalProperties": false
        }
      },
      "suggestionIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Public IDs of the persisted setup_suggestions rows"
      }
    },
    "required": [
      "suggestions",
      "suggestionIds"
    ],
    "additionalProperties": false
  }
}
