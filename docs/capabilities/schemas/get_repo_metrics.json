{
  "name": "get_repo_metrics",
  "domain": "repo",
  "description": "Get sync statistics and metrics for a repository connection.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "ingestion"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repoId": {
        "type": "string",
        "description": "Repository connection ID"
      }
    },
    "required": [
      "repoId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repoId": {
        "type": "string"
      },
      "displayName": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "pending_setup",
          "active",
          "paused",
          "failed"
        ]
      },
      "entityCount": {
        "type": "number",
        "description": "Total entities ingested from this repo"
      },
      "entityCountByType": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        },
        "description": "Entity count breakdown by type"
      },
      "lastSyncAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "lastSyncDurationMs": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "lastErrorAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "errorMessage": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "syncIntervalSeconds": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "estimatedNextSyncAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "repoId",
      "displayName",
      "status",
      "entityCount",
      "entityCountByType",
      "lastSyncAt",
      "lastSyncDurationMs",
      "lastErrorAt",
      "errorMessage",
      "syncIntervalSeconds",
      "estimatedNextSyncAt"
    ],
    "additionalProperties": false
  }
}
