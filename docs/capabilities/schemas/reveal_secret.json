{
  "name": "reveal_secret",
  "domain": "secret",
  "description": "Reveal a single secret's plaintext value (override ?? default) for an environment. Owner/Admin only; every reveal is recorded in the access log.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "secret"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "keyId": {
        "type": "string",
        "minLength": 1
      },
      "environmentId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "keyId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "key": {
        "type": "string"
      },
      "value": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "source": {
        "type": "string",
        "enum": [
          "override",
          "default",
          "unset"
        ]
      }
    },
    "required": [
      "key",
      "value",
      "source"
    ],
    "additionalProperties": false
  }
}
