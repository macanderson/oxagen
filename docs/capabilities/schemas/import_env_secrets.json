{
  "name": "import_env_secrets",
  "domain": "secret",
  "description": "Parse pasted .env text and (optionally) upsert keys + set values for the workspace defaults or a chosen environment. Returns a preview of new vs override rows; commit must be explicit.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "high",
    "category": "secret"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "environmentId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "commit": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "rows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "isNewKey": {
              "type": "boolean"
            },
            "sensitive": {
              "type": "boolean"
            },
            "target": {
              "type": "string",
              "enum": [
                "default",
                "override"
              ]
            },
            "willOverride": {
              "type": "boolean"
            }
          },
          "required": [
            "key",
            "isNewKey",
            "sensitive",
            "target",
            "willOverride"
          ],
          "additionalProperties": false
        }
      },
      "committed": {
        "type": "boolean"
      }
    },
    "required": [
      "rows",
      "committed"
    ],
    "additionalProperties": false
  }
}
