{
  "name": "install_integration",
  "domain": "integration",
  "description": "Install a plugin instance from catalog or custom URL. Fetches schema, validates config, and installs in workspace scope.",
  "mode": "async",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "plugin"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pluginId": {
        "type": "string",
        "description": "Plugin identifier from catalog (e.g., 'github', 'google-drive')"
      },
      "version": {
        "type": "string"
      },
      "schemaUrl": {
        "type": "string",
        "format": "uri"
      },
      "config": {
        "type": "object",
        "additionalProperties": {},
        "description": "Plugin configuration matching the schema"
      },
      "displayName": {
        "type": "string",
        "description": "Human-readable display name for this plugin instance"
      }
    },
    "required": [
      "pluginId",
      "config",
      "displayName"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "jobId": {
        "type": "string",
        "description": "Background install job ID"
      },
      "status": {
        "const": "queued"
      },
      "pluginId": {
        "type": "string"
      },
      "displayName": {
        "type": "string"
      }
    },
    "required": [
      "jobId",
      "status",
      "pluginId",
      "displayName"
    ],
    "additionalProperties": false
  }
}
