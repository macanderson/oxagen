{
  "name": "update_automation",
  "domain": "automation",
  "description": "Edit an existing automation: rename it, change its description, and/or replace its trigger configuration (conditions / schedule). Enable/disable is handled separately by automation.enable / automation.disable. Partial update — omit a field to leave it unchanged.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "automation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "automation_id": {
        "type": "string",
        "minLength": 1,
        "description": "Trigger public ID (plt_*) of the automation to update"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "description": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 500
          },
          {
            "type": "null"
          }
        ]
      },
      "triggerConfig": {
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "node.created",
              "node.updated",
              "node.deleted"
            ]
          },
          "conditionTree": {
            "x-zod-type": "ZodLazy"
          },
          "propertyConditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "property": {
                  "type": "string",
                  "description": "Property name to evaluate, e.g. 'status', 'value'"
                },
                "fromValue": {},
                "toValue": {},
                "operator": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "gt",
                    "lt",
                    "changed"
                  ],
                  "default": "eq"
                }
              },
              "required": [
                "property"
              ],
              "additionalProperties": false
            }
          },
          "cronExpression": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "automation_id"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "automation_id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "status": {
        "type": "string"
      },
      "triggerType": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      }
    },
    "required": [
      "automation_id",
      "name",
      "description",
      "status",
      "triggerType",
      "enabled"
    ],
    "additionalProperties": false
  }
}
