{
  "name": "approve_work_brief",
  "domain": "work",
  "description": "Approve the latest acceptance brief for a work item's current revision, so the item can be sent to an agent.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "item_id": {
        "type": "string"
      },
      "version": {
        "type": "integer",
        "minimum": 0
      },
      "item_revision": {
        "type": "integer",
        "minimum": 1
      },
      "brief_revision": {
        "type": "integer",
        "minimum": 1
      },
      "brief_digest": {
        "type": "string"
      }
    },
    "required": [
      "item_id",
      "version",
      "item_revision",
      "brief_revision",
      "brief_digest"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "held",
              "triaged",
              "needs_info",
              "changed",
              "ready",
              "sent",
              "running",
              "review",
              "done",
              "closed"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "state",
          "revision",
          "version"
        ],
        "additionalProperties": false
      },
      "repeat": {
        "type": "boolean"
      }
    },
    "required": [
      "item",
      "repeat"
    ],
    "additionalProperties": false
  }
}
