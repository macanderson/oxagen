{
  "name": "get_steering_repo",
  "domain": "repository",
  "description": "Read the workspace's steering repo: its provisioning status and step, the repository, the published version, its settings health, and each setting that differs.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "vcs"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "not_started",
          "provisioning",
          "ready",
          "failed",
          "blocked"
        ]
      },
      "step": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "pick_connection",
              "create_repository",
              "add_to_installation",
              "write_first_commit",
              "apply_settings",
              "register_webhook",
              "publish_version",
              "bind_repository"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "failedStep": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "pick_connection",
              "create_repository",
              "add_to_installation",
              "write_first_commit",
              "apply_settings",
              "register_webhook",
              "publish_version",
              "bind_repository"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "provider": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "github",
              "gitlab"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "repository": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "fullName": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "fullName",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "publishedVersion": {
        "anyOf": [
          {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "health": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "healthy",
              "drifted",
              "disconnected",
              "diverged"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "differences": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "setting": {
              "type": "string",
              "minLength": 1,
              "description": "The setting's path in the baseline, such as rulesets.oxagen_merges."
            },
            "expected": {
              "type": "string",
              "description": "The prescribed value, rendered as text."
            },
            "actual": {
              "type": "string",
              "description": "The value the host reports, rendered as text."
            },
            "changedBy": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "changedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "setting",
            "expected",
            "actual",
            "changedBy",
            "changedAt"
          ],
          "additionalProperties": false
        }
      },
      "legacySource": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "fullName": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "github",
                  "gitlab"
                ]
              }
            },
            "required": [
              "fullName",
              "url",
              "provider"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "connection": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "github",
                  "gitlab"
                ]
              },
              "id": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "The GitHub organization's or personal account's login, or the GitLab group's path."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "organization",
                  "user"
                ],
                "description": "organization for a GitHub organization or GitLab group, user for the owner's own personal GitHub account."
              }
            },
            "required": [
              "provider",
              "id",
              "name",
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "requestedName": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "connectionChoices": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "github",
                "gitlab"
              ]
            },
            "id": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "The GitHub organization's or personal account's login, or the GitLab group's path."
            },
            "kind": {
              "type": "string",
              "enum": [
                "organization",
                "user"
              ],
              "description": "organization for a GitHub organization or GitLab group, user for the owner's own personal GitHub account."
            }
          },
          "required": [
            "provider",
            "id",
            "name",
            "kind"
          ],
          "additionalProperties": false
        },
        "description": "The GitHub organizations and GitLab groups to choose from when setup stopped with choose_connection. Empty otherwise."
      },
      "importRun": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "running",
                  "waiting",
                  "done",
                  "failed"
                ]
              },
              "step": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "record_source",
                      "demote",
                      "provision",
                      "import",
                      "cleanup"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "fullName": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      }
                    },
                    "required": [
                      "fullName",
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pullRequests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "url": {
                      "type": "string"
                    },
                    "branch": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "number",
                    "url",
                    "branch"
                  ],
                  "additionalProperties": false
                },
                "description": "The import steering PRs, in the order a person merges them."
              },
              "cleanup": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "url": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "number",
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "code",
                      "message"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status",
              "step",
              "source",
              "pullRequests",
              "cleanup",
              "error"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "status",
      "step",
      "failedStep",
      "error",
      "provider",
      "repository",
      "publishedVersion",
      "health",
      "differences",
      "legacySource",
      "connection",
      "requestedName",
      "connectionChoices",
      "importRun"
    ],
    "additionalProperties": false
  }
}
