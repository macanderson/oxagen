{
  "name": "get_spend_drill",
  "domain": "spend",
  "description": "Read one operator, agent or tool's spend over a trailing window in this workspace: the daily series, the average per call and per run, its share of the workspace's spend, and the tools its runs called, every figure in micros with its basis.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "operator",
          "agent",
          "tool"
        ]
      },
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 92,
        "default": 30
      }
    },
    "required": [
      "kind",
      "key"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "operator",
          "agent",
          "tool"
        ]
      },
      "key": {
        "type": "string"
      },
      "period": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "total": {
        "type": "object",
        "properties": {
          "cost": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "micros": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "basis": {
                    "type": "string",
                    "enum": [
                      "gateway_observed",
                      "client_attested",
                      "mixed",
                      "estimated"
                    ]
                  }
                },
                "required": [
                  "micros",
                  "currency",
                  "basis"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "calls": {
            "type": "integer",
            "minimum": 0
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          },
          "proven": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "micros": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  }
                },
                "required": [
                  "micros",
                  "currency"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "micros": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  }
                },
                "required": [
                  "micros",
                  "currency"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "productiveRatio": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "cost",
          "calls",
          "runs",
          "proven",
          "accepted",
          "productiveRatio"
        ],
        "additionalProperties": false
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "day": {
              "type": "string"
            },
            "cost": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "micros": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "gateway_observed",
                        "client_attested",
                        "mixed",
                        "estimated"
                      ]
                    }
                  },
                  "required": [
                    "micros",
                    "currency",
                    "basis"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "calls": {
              "type": "integer",
              "minimum": 0
            },
            "runs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "day",
            "cost",
            "calls",
            "runs"
          ],
          "additionalProperties": false
        }
      },
      "averages": {
        "type": "object",
        "properties": {
          "perCall": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "micros": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  }
                },
                "required": [
                  "micros",
                  "currency"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "perRun": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "micros": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  }
                },
                "required": [
                  "micros",
                  "currency"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "perCall",
          "perRun"
        ],
        "additionalProperties": false
      },
      "share": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "byTool": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "calls": {
              "type": "integer",
              "minimum": 0
            },
            "runs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "name",
            "calls",
            "runs"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "kind",
      "key",
      "period",
      "total",
      "series",
      "averages",
      "share",
      "byTool"
    ],
    "additionalProperties": false
  }
}
