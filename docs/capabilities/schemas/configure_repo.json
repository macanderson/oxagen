{
  "name": "configure_repo",
  "domain": "repo",
  "description": "Set repo-specific filters, sync cadence, and field mappings. Specializes connection.configure for code repository connectors.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "ingestion"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repoId": {
        "type": "string",
        "description": "Repository connection ID (UUID or public ID)"
      },
      "recordTypes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "pathFilters": {
        "type": "object",
        "properties": {
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "labelFilters": {
        "type": "object",
        "properties": {
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "syncCadence": {
        "type": "string",
        "enum": [
          "manual",
          "polling",
          "webhook"
        ]
      },
      "pollingIntervalSeconds": {
        "type": "integer",
        "minimum": 0
      },
      "fieldMappings": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "required": [
      "repoId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repoId": {
        "type": "string"
      },
      "displayName": {
        "type": "string"
      },
      "recordTypes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "pathFilters": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "include",
              "exclude"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "labelFilters": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "include",
              "exclude"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "syncCadence": {
        "type": "string",
        "enum": [
          "manual",
          "polling",
          "webhook"
        ]
      },
      "pollingIntervalSeconds": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "updatedAt": {
        "type": "string"
      }
    },
    "required": [
      "repoId",
      "displayName",
      "recordTypes",
      "pathFilters",
      "labelFilters",
      "syncCadence",
      "pollingIntervalSeconds",
      "updatedAt"
    ],
    "additionalProperties": false
  }
}
