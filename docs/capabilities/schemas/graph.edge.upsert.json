{
  "name": "graph.edge.upsert",
  "domain": "graph",
  "description": "MERGE a typed relationship between two KnowledgeNodes. Edge type must be one of the allowed relationship types.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "graph"
  },
  "chain": {
    "produces": [
      "graph.edgeId"
    ],
    "consumes": [
      "graph.nodeId",
      "relationship"
    ],
    "chainHints": []
  },
  "render": {
    "componentId": "graph-edge-card"
  },
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fromNodeId": {
        "type": "string",
        "description": "publicId of the source KnowledgeNode"
      },
      "toNodeId": {
        "type": "string",
        "description": "publicId of the target KnowledgeNode"
      },
      "edgeType": {
        "type": "string",
        "enum": [
          "RELATED_TO",
          "PART_OF",
          "CAUSED_BY",
          "REFERENCES",
          "SIMILAR_TO",
          "DEPENDS_ON",
          "CREATED_BY",
          "MENTIONS"
        ],
        "description": "Relationship type between the two nodes"
      },
      "properties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "required": [
      "fromNodeId",
      "toNodeId",
      "edgeType"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "edgeId": {
        "type": "string",
        "description": "Composite identifier: fromNodeId:edgeType:toNodeId"
      },
      "created": {
        "type": "boolean",
        "description": "True if the edge was newly created, false if it already existed"
      }
    },
    "required": [
      "edgeId",
      "created"
    ],
    "additionalProperties": false
  }
}
