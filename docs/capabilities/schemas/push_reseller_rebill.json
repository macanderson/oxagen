{
  "name": "push_reseller_rebill",
  "domain": "billing",
  "description": "Push a customer's priced usage for a period to the reseller's Stripe account as an invoice, recording the run. Idempotent per customer+period; returns needsStripeConnection when no key is connected.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "billing"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "customerId": {
        "type": "string",
        "minLength": 1
      },
      "start": {
        "type": "string",
        "description": "ISO-8601 start of the billing period (inclusive)"
      },
      "end": {
        "type": "string",
        "description": "ISO-8601 end of the billing period (exclusive)"
      },
      "finalize": {
        "type": "boolean",
        "default": true
      }
    },
    "required": [
      "customerId",
      "start",
      "end"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "periodStart": {
            "type": "string"
          },
          "periodEnd": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "subtotalCents": {
            "type": "integer",
            "minimum": 0
          },
          "totalCents": {
            "type": "integer",
            "minimum": 0
          },
          "providerInvoiceId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "hostedInvoiceUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "pushed",
              "failed"
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "lineItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "matchKind": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "workspace",
                        "principal",
                        "capability"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rawCostCents": {
                  "type": "integer",
                  "minimum": 0
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 0
                },
                "unitPriceCents": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "amountCents": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "label",
                "matchKind",
                "rawCostCents",
                "quantity",
                "unitPriceCents",
                "amountCents"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "customerId",
          "customerName",
          "periodStart",
          "periodEnd",
          "currency",
          "subtotalCents",
          "totalCents",
          "providerInvoiceId",
          "hostedInvoiceUrl",
          "status",
          "error",
          "createdAt",
          "updatedAt",
          "lineItems"
        ],
        "additionalProperties": false
      },
      "needsStripeConnection": {
        "type": "boolean"
      }
    },
    "required": [
      "run",
      "needsStripeConnection"
    ],
    "additionalProperties": false
  }
}
