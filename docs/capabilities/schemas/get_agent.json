            "type": "string",
            "minLength": 1
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "agentKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "harness": {
            "type": "string",
            "enum": [
              "stella",
              "claude-code",
              "codex",
              "cursor",
              "claude-agent-sdk",
              "custom"
            ]
          },
          "managed": {
            "type": "boolean"
          },
          "principalId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "operatorId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "unenrolled",
              "enrolled",
              "suspended",
              "retired"
