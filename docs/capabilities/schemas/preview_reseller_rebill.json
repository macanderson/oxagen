{
  "name": "preview_reseller_rebill",
  "domain": "billing",
  "description": "Compute per-customer re-bill line items for a period: attribute observed usage to customers via attribution rules, then price each slice with the customer's plan. Does not push to Stripe.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "billing"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "start": {
        "type": "string",
        "description": "ISO-8601 start of the billing period (inclusive)"
      },
      "end": {
        "type": "string",
        "description": "ISO-8601 end of the billing period (exclusive)"
      },
      "customerId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "start",
      "end"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "range": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "previews": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "customerId": {
              "type": "string"
            },
            "customerName": {
              "type": "string"
            },
            "pricePlanId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pricePlanName": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency": {
              "type": "string"
            },
            "subtotalCents": {
              "type": "integer",
              "minimum": 0
            },
            "totalCents": {
              "type": "integer",
              "minimum": 0
            },
            "lineItems": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "matchKind": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "workspace",
                          "principal",
                          "capability"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rawCostCents": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unitPriceCents": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "amountCents": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "label",
                  "matchKind",
                  "rawCostCents",
                  "quantity",
                  "unitPriceCents",
                  "amountCents"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "customerId",
            "customerName",
            "pricePlanId",
            "pricePlanName",
            "currency",
            "subtotalCents",
            "totalCents",
            "lineItems"
          ],
          "additionalProperties": false
        }
      },
      "unattributedCostCents": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "range",
      "previews",
      "unattributedCostCents"
    ],
    "additionalProperties": false
  }
}
