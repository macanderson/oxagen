{
  "name": "list_waste",
  "domain": "spend",
  "description": "List this workspace's wasted spend over a day range by cause, with the runs that prove each cause: the model calls open findings claim, which sum to the unproductive spend headline, and the cache writes no call read. Answers the total wasted with its basis, its share of spend, the largest cause, and how many open findings claim calls outside the range.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "billing"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "period": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "x-server-validated": true,
            "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
          },
          "to": {
            "type": "string",
            "x-server-validated": true,
            "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "x-server-validated": true,
        "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
      }
    },
    "required": [
      "period"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "period": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "wasted": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "micros": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "basis": {
                "type": "string",
                "enum": [
                  "gateway_observed",
                  "client_attested",
                  "mixed",
                  "estimated"
                ]
              }
            },
            "required": [
              "micros",
              "currency",
              "basis"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "share": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "runsWithWaste": {
        "type": "integer",
        "minimum": 0
      },
      "largestCause": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "cache_write_never_read",
              "spin_loops",
              "retry_loops",
              "repeated_calls",
              "recurring_runs",
              "spend_with_no_outcome"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "causes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "enum": [
                "cache_write_never_read",
                "spin_loops",
                "retry_loops",
                "repeated_calls",
                "recurring_runs",
                "spend_with_no_outcome"
              ]
            },
            "wasted": {
              "type": "object",
              "properties": {
                "micros": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "gateway_observed",
                    "client_attested",
                    "mixed",
                    "estimated"
                  ]
                }
              },
              "required": [
                "micros",
                "currency",
                "basis"
              ],
              "additionalProperties": false
            },
            "runs": {
              "type": "integer",
              "minimum": 0
            },
            "runIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 10
            },
            "provingRuns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "runId": {
                    "type": "string"
                  },
                  "name": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 256
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "runId",
                  "name"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            }
          },
          "required": [
            "cause",
            "wasted",
            "runs",
            "runIds",
            "provingRuns"
          ],
          "additionalProperties": false
        }
      },
      "findingsOutsidePeriod": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "period",
      "wasted",
      "share",
      "runsWithWaste",
      "largestCause",
      "causes",
      "findingsOutsidePeriod"
    ],
    "additionalProperties": false
  }
}
