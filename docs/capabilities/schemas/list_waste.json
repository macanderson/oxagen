{
  "name": "list_waste",
  "domain": "spend",
  "description": "List this workspace's wasted spend over a day range by cause, each cause a pattern read off the cost rollup with the runs that prove it: the total wasted with its basis, its share of spend, and the largest cause.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "period": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "x-server-validated": true,
            "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
          },
          "to": {
            "type": "string",
            "x-server-validated": true,
            "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "x-server-validated": true,
        "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
      }
    },
    "required": [
      "period"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "period": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "wasted": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "micros": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "basis": {
                "type": "string",
                "enum": [
                  "gateway_observed",
                  "client_attested",
                  "mixed",
                  "estimated"
                ]
              }
            },
            "required": [
              "micros",
              "currency",
              "basis"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "share": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "runsWithWaste": {
        "type": "integer",
        "minimum": 0
      },
      "largestCause": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "cache_write_never_read"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "causes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "enum": [
                "cache_write_never_read"
              ]
            },
            "wasted": {
              "type": "object",
              "properties": {
                "micros": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "gateway_observed",
                    "client_attested",
                    "mixed",
                    "estimated"
                  ]
                }
              },
              "required": [
                "micros",
                "currency",
                "basis"
              ],
              "additionalProperties": false
            },
            "runs": {
              "type": "integer",
              "minimum": 0
            },
            "runIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 10
            }
          },
          "required": [
            "cause",
            "wasted",
            "runs",
            "runIds"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "period",
      "wasted",
      "share",
      "runsWithWaste",
      "largestCause",
      "causes"
    ],
    "additionalProperties": false
  }
}
