{
  "name": "list_executions",
  "domain": "agent",
  "description": "List recent top-level agent runs (executions) for the workspace, newest first, with keyset pagination — each row's status, origin, duration, token/cost figures.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 25
      },
      "before": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "planning",
          "running",
          "completed",
          "failed",
          "cancelled"
        ]
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "executions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "executionId": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "planning",
                "running",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "originType": {
              "type": "string"
            },
            "originId": {
              "type": "string"
            },
            "agentId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "startedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "completedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "latencyMs": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputTokens": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outputTokens": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "estimatedCostUsd": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "string"
            }
          },
          "required": [
            "executionId",
            "status",
            "originType",
            "originId",
            "agentId",
            "startedAt",
            "completedAt",
            "latencyMs",
            "inputTokens",
            "outputTokens",
            "estimatedCostUsd",
            "createdAt"
          ],
          "additionalProperties": false
        }
      },
      "nextCursor": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "executions",
      "nextCursor"
    ],
    "additionalProperties": false
  }
}
