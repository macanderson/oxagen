{
  "name": "fill_form",
  "domain": "form",
  "description": "Generatively fill or suggest values for page-level form fields based on a natural-language instruction. Returns per-field diffs — only fields the instruction implies are changed; all others are echoed unchanged.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "form"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "route": {
        "type": "string",
        "minLength": 1
      },
      "entitySummary": {
        "type": "string"
      },
      "instruction": {
        "type": "string",
        "minLength": 1
      },
      "fields": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "enum": [
                "text",
                "textarea",
                "number",
                "select",
                "boolean"
              ]
            },
            "current": {},
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "label",
            "type",
            "current"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "route",
      "instruction",
      "fields"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fields": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "current": {},
            "proposed": {},
            "changed": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "current",
            "proposed",
            "changed"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "fields"
    ],
    "additionalProperties": false
  }
}
