{
  "name": "get_conversation",
  "domain": "conversation",
  "description": "Read one of your conversations in this workspace with its messages, oldest first, or your most recently updated active conversation when no id is given",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "conversation"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "conversationId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 100
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "conversation": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "publicId": {
                "type": "string"
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string"
              },
              "archivedAt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "createdAt": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "publicId": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "user",
                        "assistant",
                        "system"
                      ]
                    },
                    "content": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "runId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "parkedCards": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "approvalId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "capability": {
                            "type": "string",
                            "minLength": 1
                          },
                          "expiresAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "approvalId",
                          "capability",
                          "expiresAt"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "toolCalls": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "toolCallId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "toolName": {
                            "type": "string",
                            "minLength": 1
                          },
                          "outcome": {
                            "type": "string",
                            "enum": [
                              "completed",
                              "failed",
                              "denied",
                              "cancelled",
                              "parked"
                            ]
                          },
                          "durationMs": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "approvalId": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "toolCallId",
                          "toolName",
                          "outcome",
                          "durationMs",
                          "approvalId"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "publicId",
                    "role",
                    "content",
                    "createdAt",
                    "runId",
                    "parkedCards",
                    "toolCalls"
                  ],
                  "additionalProperties": false
                }
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "publicId",
              "title",
              "status",
              "archivedAt",
              "createdAt",
              "updatedAt",
              "messages",
              "truncated"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "conversation"
    ],
    "additionalProperties": false
  }
}
