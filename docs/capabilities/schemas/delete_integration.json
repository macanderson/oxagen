{
  "name": "delete_integration",
  "domain": "integration",
  "description": "Remove a plugin instance and optionally purge its graph data from Neo4j.",
  "mode": "async",
  "surfaces": [
    "api",
    "mcp",
    "cli",
    "agent"
  ],
  "sensitivity": "destructive",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "plugin"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "integrationId": {
        "type": "string",
        "description": "Plugin instance ID"
      },
      "purgeData": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "integrationId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "jobId": {
        "type": "string",
        "description": "Background deletion job ID"
      },
      "status": {
        "const": "queued"
      },
      "integrationId": {
        "type": "string"
      },
      "purgeData": {
        "type": "boolean"
      }
    },
    "required": [
      "jobId",
      "status",
      "integrationId",
      "purgeData"
    ],
    "additionalProperties": false
  }
}
