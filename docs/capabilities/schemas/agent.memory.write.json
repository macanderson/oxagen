{
  "name": "agent.memory.write",
  "domain": "agent",
  "description": "Persist a weighted memory tied to a graph node per the oxagen-feature skill memory contract",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "memory"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "nodeRef": {
        "type": "string"
      },
      "weight": {
        "type": "string",
        "enum": [
          "low",
          "high",
          "critical"
        ]
      },
      "kind": {
        "type": "string",
        "enum": [
          "routine-change",
          "constraint",
          "bug-root-cause",
          "convention-deviation",
          "gotcha"
        ]
      },
      "lesson": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "source": {
        "type": "string",
        "enum": [
          "feature",
          "fix",
          "exception-watcher",
          "bug-report"
        ]
      },
      "relatedNodeIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "nodeRef",
      "weight",
      "kind",
      "lesson",
      "source"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "memoryId": {
        "type": "string"
      },
      "nodeRef": {
        "type": "string"
      },
      "edgesCreated": {
        "type": "number",
        "description": "Count of :ABOUT edges created to KnowledgeNode entities"
      }
    },
    "required": [
      "memoryId",
      "nodeRef",
      "edgesCreated"
    ],
    "additionalProperties": false
  }
}
