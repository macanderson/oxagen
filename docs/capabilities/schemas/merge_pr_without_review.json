{
  "name": "merge_pr_without_review",
  "domain": "context",
  "description": "Merge a proposal's Context PR without an approval and publish its record: refused unless the caller holds merge_pr_without_review, and refused on every other ground merge_context_pr refuses; the trailer and the ledger record that nobody reviewed it",
  "mode": "sync",
  "surfaces": [
    "api",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "governance"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "proposalId": {
        "type": "string"
      }
    },
    "required": [
      "proposalId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "proposalId": {
        "type": "string"
      },
      "status": {
        "const": "merged"
      },
      "record": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "lineageId": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "lineageId",
          "version",
          "path"
        ],
        "additionalProperties": false
      },
      "mergedCommit": {
        "type": "string"
      },
      "promotionEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "chainDigest": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "seq",
          "chainDigest"
        ],
        "additionalProperties": false
      },
      "bundleVersion": {
        "type": "object",
        "properties": {
          "before": {
            "type": "integer"
          },
          "after": {
            "type": "integer"
          }
        },
        "required": [
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "publishedVersion": {
        "anyOf": [
          {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "proposalId",
      "status",
      "record",
      "mergedCommit",
      "promotionEvent",
      "bundleVersion",
      "publishedVersion"
    ],
    "additionalProperties": false
  }
}
