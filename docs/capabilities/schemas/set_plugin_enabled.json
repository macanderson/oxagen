{
  "name": "set_plugin_enabled",
  "domain": "plugin",
  "description": "Enable or disable a plugin listing. scope='org' toggles the org listing's enabled flag; scope='workspace' upserts/disables an agent.mcp_servers row for this workspace from the org listing. Once the workspace's tools live in its steering repo, enabling a remote plugin the repo does not hold opens a steering PR instead, and the server stays off until that PR merges.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "plugin"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "enum": [
          "org",
          "workspace"
        ]
      },
      "orgListingId": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      }
    },
    "required": [
      "scope",
      "orgListingId",
      "enabled"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "workspaceServerId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "steeringPr": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "number",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "ok",
      "workspaceServerId"
    ],
    "additionalProperties": false
  }
}
