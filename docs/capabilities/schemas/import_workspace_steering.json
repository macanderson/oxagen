{
  "name": "import_workspace_steering",
  "domain": "repository",
  "description": "Move the workspace's steering from .oxagen/ in the repository it binds to a steering repo, and open the steering PRs a person merges. A workspace on a legacy sources connection sets startFresh instead: the run creates an empty steering repo and imports nothing.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ruleKinds": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "enum": [
            "business-rule",
            "code-rule"
          ]
        }
      },
      "constraintEffects": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "enum": [
            "require",
            "forbid"
          ]
        }
      },
      "startFresh": {
        "type": "boolean",
        "description": "Set true for a workspace on a legacy sources connection. The run creates an empty steering repo and imports nothing, and the steering repo steers the workspace from then on. The .oxagen/ files stay in the legacy repository."
      },
      "connection": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "gitlab"
            ]
          },
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "provider",
          "id"
        ],
        "additionalProperties": false,
        "description": "The GitHub organization or GitLab group to create the steering repo in, when setup stopped with choose_connection. One of get_steering_repo's connectionChoices."
      },
      "resetConnection": {
        "type": "boolean",
        "description": "Set true to clear the organization's stored steering connection first, so the run lists the GitHub organizations and GitLab groups again. Refused (conflict connection_in_use) once Oxagen has created a steering repo in the stored one."
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "outcome": {
        "type": "string",
        "enum": [
          "imported",
          "provisioned",
          "nothing_to_import",
          "needs_choices"
        ]
      },
      "steeringRepository": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "pullRequests": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string"
            },
            "number": {
              "type": "integer"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "branch",
            "number",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "cleanup": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "number",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "leftForAPerson": {
        "type": "integer",
        "minimum": 0
      },
      "rulesNeedingKind": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "constraintsNeedingEffect": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "outcome",
      "steeringRepository",
      "pullRequests",
      "cleanup",
      "leftForAPerson",
      "rulesNeedingKind",
      "constraintsNeedingEffect"
    ],
    "additionalProperties": false
  }
}
