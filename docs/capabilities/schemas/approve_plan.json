{
  "name": "approve_plan",
  "domain": "agent",
  "description": "Approve, deny, or amend a previously-proposed plan; approval releases the agent stream to execute the plan's side-effectful steps",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "planning"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "planId": {
        "type": "string"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "deny",
          "amend"
        ]
      },
      "amendedSteps": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "intent": {
              "type": "string"
            },
            "capability": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputPreview": {
              "anyOf": [
                {},
                {
                  "type": "null"
                }
              ]
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "required": [
            "id",
            "summary",
            "intent",
            "capability",
            "inputPreview"
          ],
          "additionalProperties": false
        }
      },
      "note": {
        "type": "string"
      }
    },
    "required": [
      "planId",
      "decision"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "planId": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "approved",
          "denied",
          "amended"
        ]
      }
    },
    "required": [
      "planId",
      "status"
    ],
    "additionalProperties": false
  }
}
