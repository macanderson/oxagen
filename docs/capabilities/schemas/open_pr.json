{
  "name": "open_pr",
  "domain": "repo",
  "description": "Open a pull request in a GitHub repository.",
  "mode": "sync",
  "surfaces": [
    "agent",
    "api",
    "mcp"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "high",
    "category": "vcs"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "owner": {
        "type": "string",
        "description": "Repository owner (user or organisation)"
      },
      "repo": {
        "type": "string",
        "description": "Repository name"
      },
      "title": {
        "type": "string",
        "description": "Pull request title"
      },
      "head": {
        "type": "string",
        "description": "Branch containing the changes (e.g. feature/my-branch). Must differ from base."
      },
      "base": {
        "type": "string",
        "description": "Branch the PR is targeting (e.g. main)"
      },
      "body": {
        "type": "string"
      },
      "draft": {
        "type": "boolean"
      }
    },
    "required": [
      "owner",
      "repo",
      "title",
      "head",
      "base"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "number": {
        "type": "integer",
        "description": "Pull request number"
      },
      "htmlUrl": {
        "type": "string",
        "description": "HTML URL of the pull request"
      }
    },
    "required": [
      "number",
      "htmlUrl"
    ],
    "additionalProperties": false
  }
}
