          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "waiting",
                    "rejected",
                    "import",
                    "stored"
                  ],
                  "description": "waiting, rejected, import for an earlier row of this commit, or stored"
                },
                "memory": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
