{
  "name": "commit_markdown_import",
  "domain": "context",
  "description": "Open one steering PR on steering/import-<date> with the Markdown import's records and Cedar policies marked add, and store its memories marked add as waiting memories with capture import. Records keep origin: user and provenance.source: import. The PR runs the steering checks, and nothing steers until it merges. A memory that repeats a waiting or rejected one is left out and named.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "governance"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "records": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The file the statement came from"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "description": "The line of the file the statement starts on"
            },
            "origin": {
              "type": "string",
              "enum": [
                "frontmatter",
                "split"
              ],
              "description": "frontmatter for a file that is one steering record already, split for a statement the model split out"
            },
            "lineage": {
              "type": "string",
              "maxLength": 200,
              "description": "The record's lineage, and its file name in the steering repo"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "description": "The record's name, at most 36 characters"
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000,
              "description": "What the record tells an agent: the record's body"
            },
            "kind": {
              "type": "string",
              "enum": [
                "business-rule",
                "code-rule",
                "constraint",
                "procedure",
                "skill",
                "fact",
                "preference",
                "memory"
              ]
            },
            "kindReason": {
              "type": "string",
              "maxLength": 300,
              "description": "One line on why the statement is this kind"
            },
            "force": {
              "type": "string",
              "enum": [
                "must",
                "should",
                "may",
                "info"
              ],
              "description": "must, should, may, or info, within the forces the kind allows"
            },
            "forceWords": {
              "type": "string",
              "maxLength": 200,
              "description": "The words in the statement that justify the force, or empty when the text gives no signal and the kind's default applies"
            },
            "effect": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "require",
                    "forbid"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "The statement's size in tokens. A must or should record adds this to every request."
            },
            "duplicate": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "lineage": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "published": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "lineage",
                    "path",
                    "published"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "conflict": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "lineage": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "published": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "lineage",
                    "path",
                    "published"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "action": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "add",
                    "skip"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "frontmatter": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "file",
            "line",
            "origin",
            "lineage",
            "label",
            "statement",
            "kind",
            "kindReason",
            "force",
            "forceWords",
            "effect",
            "tokens",
            "duplicate",
            "conflict",
            "action",
            "frontmatter"
          ],
          "additionalProperties": false,
          "x-server-validated": true,
          "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
        },
        "maxItems": 1250,
        "default": []
      },
      "policies": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The Markdown file the policies came from"
            },
            "path": {
              "type": "string",
              "description": "Where the policy file goes: policy/<file-slug>.cedar"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200000,
              "description": "The .cedar file: the prose above each block as a comment, then each statement with its @id"
            },
            "statements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The statement's @id"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The line of the file it starts on"
                  },
                  "effect": {
                    "type": "string",
                    "enum": [
                      "permit",
                      "forbid"
                    ]
                  }
                },
                "required": [
                  "id",
                  "line",
                  "effect"
                ],
                "additionalProperties": false
              }
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "line": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "statement",
                  "id",
                  "line",
                  "message"
                ],
                "additionalProperties": false
              },
              "description": "What the early checks found. A policy with any issue cannot be added."
            },
            "duplicate": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "replaces": {
              "type": "boolean",
              "description": "True when the steering repo already holds a different file at this path, which the commit replaces"
            },
            "action": {
              "type": "string",
              "enum": [
                "add",
                "skip"
              ]
            }
          },
          "required": [
            "file",
            "path",
            "text",
            "statements",
            "issues",
            "duplicate",
            "replaces",
            "action"
          ],
          "additionalProperties": false
        },
        "maxItems": 1250,
        "default": []
      },
      "memories": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The file the statement came from"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "description": "The line of the file the statement starts on"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "The memory's name, at most 200 characters"
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000,
              "description": "The memory's text. A row marked add holds at most 2,000 characters."
            },
            "kind": {
              "const": "memory",
              "description": "Always memory"
            },
            "force": {
              "const": "info",
              "description": "Always info. A memory carries no other force."
            },
            "duplicate": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "reason": {
                      "type": "string",
                      "enum": [
                        "waiting",
                        "rejected",
                        "import"
                      ],
                      "description": "waiting for a waiting memory, rejected for a statement a person rejected, import for an earlier row of this import"
                    },
                    "memory": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "file": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "line": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "reason",
                    "memory",
                    "file",
                    "line"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "issue": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "action": {
              "type": "string",
              "enum": [
                "add",
                "skip"
              ],
              "description": "add or skip. A row with a match or an issue defaults to skip."
            }
          },
          "required": [
            "file",
            "line",
            "label",
            "statement",
            "kind",
            "force",
            "duplicate",
            "issue",
            "action"
          ],
          "additionalProperties": false,
          "x-server-validated": true,
          "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
        },
        "maxItems": 1250,
        "default": []
      }
    },
    "additionalProperties": false,
    "x-server-validated": true,
    "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pullRequest": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "url": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "headSha": {
                "type": "string"
              }
            },
            "required": [
              "number",
              "url",
              "branch",
              "headSha"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "records": {
        "type": "integer",
        "minimum": 0,
        "description": "Records the PR holds"
      },
      "policies": {
        "type": "integer",
        "minimum": 0,
        "description": "Policy files the PR holds"
      },
      "skipped": {
        "type": "integer",
        "minimum": 0,
        "description": "Rows marked skip, left out of the PR and the memories"
      },
      "memories": {
        "type": "object",
        "properties": {
          "stored": {
