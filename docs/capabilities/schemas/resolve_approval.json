{
  "name": "resolve_approval",
  "domain": "agent",
  "description": "Approve or deny a pending tool-call approval request; resolution resumes the paused agent stream",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "approval"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "approvalId": {
        "type": "string",
        "x-server-validated": true,
        "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
      },
      "decision": {
        "type": "string",
        "enum": [
          "approved",
          "denied"
        ]
      },
      "note": {
        "type": "string"
      }
    },
    "required": [
      "approvalId",
      "decision"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "approvalId": {
        "type": "string"
      },
      "resolution": {
        "type": "string",
        "enum": [
          "approved",
          "denied"
        ]
      },
      "mandate": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "mandateId": {
                "type": "string"
              },
              "reserved": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "measure": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "unitOrCurrency": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "measure",
                    "value",
                    "unitOrCurrency"
                  ],
                  "additionalProperties": false
                }
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "held",
                  "released"
                ]
              }
            },
            "required": [
              "mandateId",
              "reserved",
              "outcome"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "approvalId",
      "resolution",
      "mandate"
    ],
    "additionalProperties": false
  }
}
