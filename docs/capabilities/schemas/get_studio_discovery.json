{
  "name": "get_studio_discovery",
  "domain": "tool",
  "description": "Read one server folder's latest tool discovery: its status, what asked for it, when it ran, its outcome, the sync steering PR, and the tools the gateway withholds until that PR merges. Null before the first discovery.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "governance"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "server": {
        "type": "string",
        "x-server-validated": true,
        "x-server-validated-note": "The server applies at least one further constraint that this schema does not express. Validating against this schema is necessary but not sufficient; the capability may still refuse the payload."
      }
    },
    "required": [
      "server"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "discovery": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "server": {
                "type": "string"
              },
              "mcpServerId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "running",
                  "succeeded",
                  "failed"
                ]
              },
              "trigger": {
                "type": "string",
                "enum": [
                  "schedule",
                  "list_changed",
                  "push",
                  "registry_version",
                  "manual",
                  "lock_merged"
                ]
              },
              "requestedAt": {
                "type": "string"
              },
              "requestedBy": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "startedAt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "finishedAt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "unchanged",
                      "pr_opened",
                      "pr_updated",
                      "needs_digest",
                      "skipped"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "toolCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "machine": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceKind": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceRepo": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourcePath": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceRef": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "schedule": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "on-change",
                      "daily",
                      "manual"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "upstreamDigest": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latestVersion": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pr": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "url": {
                        "type": "string"
                      },
                      "branch": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "number",
                      "url",
                      "branch"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "withheld": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stalled": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "server",
              "mcpServerId",
              "status",
              "trigger",
              "requestedAt",
              "requestedBy",
              "startedAt",
              "finishedAt",
              "error",
              "outcome",
              "toolCount",
              "machine",
              "sourceKind",
              "sourceRepo",
              "sourcePath",
              "sourceRef",
              "schedule",
              "upstreamDigest",
              "latestVersion",
              "pr",
              "withheld",
              "stalled"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "discovery"
    ],
    "additionalProperties": false
  }
}
