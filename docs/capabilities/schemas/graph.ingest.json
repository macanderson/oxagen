{
  "name": "graph.ingest",
  "domain": "graph",
  "description": "Extract entities and relationships from text and commit them to the knowledge graph as nodes and edges, with confidence labels. Reads the workspace graph prompt (and optional type hints) to decide which entity/edge types to look for, then upserts (idempotent — the upsert resolves duplicates). The bridge from web-search / document text to the ontology.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "knowledge"
  },
  "chain": {
    "produces": [
      "graph.nodeId",
      "graph.edgeId"
    ],
    "consumes": [
      "document.text",
      "search.results"
    ],
    "chainHints": [
      "graph.node.list",
      "document.generate"
    ]
  },
  "render": {
    "componentId": "graph-ingest-card"
  },
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000,
        "description": "The source text to extract entities and relationships from"
      },
      "sourceUrl": {
        "type": "string"
      },
      "entityTypeHints": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "maxEntities": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 25
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "entities": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "confidence": {
              "type": "number"
            },
            "created": {
              "type": "boolean"
            }
          },
          "required": [
            "nodeId",
            "name",
            "type",
            "confidence",
            "created"
          ],
          "additionalProperties": false
        }
      },
      "relationships": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "edgeId": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "edgeType": {
              "type": "string",
              "enum": [
                "RELATED_TO",
                "PART_OF",
                "CAUSED_BY",
                "REFERENCES",
                "SIMILAR_TO",
                "DEPENDS_ON",
                "CREATED_BY",
                "MENTIONS"
              ]
            },
            "confidence": {
              "type": "number"
            },
            "created": {
              "type": "boolean"
            }
          },
          "required": [
            "edgeId",
            "from",
            "to",
            "edgeType",
            "confidence",
            "created"
          ],
          "additionalProperties": false
        }
      },
      "summary": {
        "type": "string",
        "description": "Plain-language summary of what was ingested"
      }
    },
    "required": [
      "entities",
      "relationships",
      "summary"
    ],
    "additionalProperties": false
  }
}
