{
  "name": "list_agent_tools",
  "domain": "agent",
  "description": "List the capabilities surfaced as agent tools for the active workspace, after allowlist and risk filtering",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "includeExternal": {
        "type": "boolean",
        "default": true
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "tools": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "category": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "riskLevel": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "requiresApproval": {
              "type": "boolean"
            },
            "external": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "description",
            "domain",
            "category",
            "riskLevel",
            "requiresApproval",
            "external"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "tools"
    ],
    "additionalProperties": false
  }
}
