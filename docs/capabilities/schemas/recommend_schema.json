{
  "name": "recommend_schema",
  "domain": "schema",
  "description": "AI onboarding: read existing graph (graph.stats + graph_observed_labels ClickHouse telemetry + sampled ontology.query) and the workspace's enabled schemas → propose a starter schema or additions.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "schema"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sampleLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "default": 200
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "proposal": {
        "type": "object",
        "properties": {
          "schemas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "properties": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "key": {
                              "type": "string"
                            },
                            "dataType": {
                              "type": "string",
                              "enum": [
                                "string",
                                "number",
                                "integer",
                                "boolean",
                                "date",
                                "datetime",
                                "url",
                                "email",
                                "enum",
                                "json",
                                "array"
                              ]
                            },
                            "required": {
                              "type": "boolean"
                            },
                            "description": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "key",
                            "dataType",
                            "required"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  }
                },
                "relationshipTypes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "startLabel": {
                        "type": "string"
                      },
                      "endLabel": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "displayName",
                "labels",
                "relationshipTypes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schemas"
        ],
        "additionalProperties": false
      },
      "rationale": {
        "type": "string"
      },
      "sampledCount": {
        "type": "integer"
      }
    },
    "required": [
      "proposal",
      "rationale",
      "sampledCount"
    ],
    "additionalProperties": false
  }
}
