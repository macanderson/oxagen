{
  "name": "query_lineage",
  "domain": "lineage",
  "description": "Return the dispatch tree for one fan-out/run id — every subagent run reachable from a root dispatch, each carrying its principal (and Agent-RBAC delegation ceiling), observed ClickHouse spend, model/provider, and a derived outcome (pending/running/completed/failed/cancelled). Read-only; the data spine for the fleet-lineage explorer.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "dispatchId": {
        "type": "string",
        "minLength": 1,
        "description": "Public ID of the root fan-out (agent.subagent_fanouts.publicId) — the dispatchId returned by dispatch_subagent."
      },
      "maxDepth": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "default": 5
      },
      "maxNodes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 200
      }
    },
    "required": [
      "dispatchId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "dispatchId": {
        "type": "string"
      },
      "rootStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "completed",
          "partial",
          "timed_out"
        ]
      },
      "totalChildren": {
        "type": "integer"
      },
      "completedChildren": {
        "type": "integer"
      },
      "createdAt": {
        "type": "string"
      },
      "updatedAt": {
        "type": "string"
      },
      "nodes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string"
            },
            "fanoutId": {
              "type": "string"
            },
            "parentRunId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "childFanoutId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "capabilityName": {
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "principal": {
              "type": "object",
              "properties": {
                "id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "kind": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "human",
                        "agent",
                        "service"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "displayName": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "kind",
                "displayName"
              ],
              "additionalProperties": false
            },
            "delegationCeiling": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "principalId": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "principalId",
                    "displayName"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "provider": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "spend": {
              "type": "object",
              "properties": {
                "costUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "inputTokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "outputTokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "llmCalls": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "costUsd",
                "inputTokens",
                "outputTokens",
                "llmCalls"
              ],
              "additionalProperties": false
            },
            "delegationViolation": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "ruleId": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ruleId",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "startedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "completedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "runId",
            "fanoutId",
            "parentRunId",
            "childFanoutId",
            "depth",
            "capabilityName",
            "outcome",
            "attempts",
            "principal",
            "delegationCeiling",
            "model",
            "provider",
            "spend",
            "delegationViolation",
            "startedAt",
            "completedAt",
            "durationMs"
          ],
          "additionalProperties": false
        }
      },
      "nodeCount": {
        "type": "integer",
        "minimum": 0
      },
      "truncated": {
        "type": "boolean"
      },
      "maxDepthReached": {
        "type": "boolean"
      }
    },
    "required": [
      "dispatchId",
      "rootStatus",
      "totalChildren",
      "completedChildren",
      "createdAt",
      "updatedAt",
      "nodes",
      "nodeCount",
      "truncated",
      "maxDepthReached"
    ],
    "additionalProperties": false
  }
}
