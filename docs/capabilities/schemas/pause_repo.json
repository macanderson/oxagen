{
  "name": "pause_repo",
  "domain": "repo",
  "description": "Pause automatic syncing for a repository connection.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "cli",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "ingestion"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repoId": {
        "type": "string",
        "description": "Repository connection ID"
      }
    },
    "required": [
      "repoId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repoId": {
        "type": "string"
      },
      "status": {
        "const": "paused"
      },
      "pausedAt": {
        "type": "string"
      }
    },
    "required": [
      "repoId",
      "status",
      "pausedAt"
    ],
    "additionalProperties": false
  }
}
