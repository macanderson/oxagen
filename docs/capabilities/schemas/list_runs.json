              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "key",
          "dir"
        ],
        "additionalProperties": false
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      },
      "count": {
        "type": "boolean"
      },
      "countLive": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
