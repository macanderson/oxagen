    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      },
      "cursor": {
        "type": "string",
        "maxLength": 256
      },
      "pullRequests": {
        "type": "string",
        "enum": [
          "any",
          "with",
          "without"
        ]
      },
      "status": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "live",
            "sealed",
            "halted"
          ]
        },
        "minItems": 1,
        "maxItems": 3
      },
      "tier": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "contained",
            "gateway",
            "harness",
            "observe"
          ]
        },
        "minItems": 1,
        "maxItems": 4
      },
      "replayGrade": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "inspect",
            "view",
            "fork",
            "retry",
            "not_recorded"
          ]
        },
        "minItems": 1,
        "maxItems": 5
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "sort": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "started",
              "agent",
              "operator",
              "status",
              "tier",
              "replay",
              "cost"
            ]
          },
          "dir": {
            "type": "string",
