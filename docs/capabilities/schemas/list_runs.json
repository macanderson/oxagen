{
  "name": "list_runs",
  "domain": "run",
  "description": "List the runs recorded in this workspace, newest first: evidence-ledger runs and root wrapped-agent sessions in one cursor-paged list, with the operator, the model, the machine, status, counts and metered cost each row recorded. The in-app agent's own turns are not listed.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp"
  ],
  "sensitivity": "medium",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      },
      "cursor": {
        "type": "string",
        "maxLength": 256
      },
      "search": {
        "type": "string",
        "maxLength": 200
      },
      "harness": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "status": {
        "type": "string",
        "enum": [
          "live",
          "sealed",
          "halted"
        ]
      },
      "repository": {
        "type": "string",
        "maxLength": 500
      },
      "excludeRunId": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "runs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "ledger",
                "tacho"
              ]
            },
            "agentKey": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "operatorId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "operatorKind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "human",
                    "agent",
                    "service"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "operatorName": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "live",
                "sealed",
                "halted"
              ]
            },
            "turns": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "steps": {
              "type": "integer",
              "minimum": 0
            },
            "frames": {
              "type": "integer",
              "minimum": 0
            },
            "cost": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "micros": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "gateway_observed",
                        "client_attested",
                        "mixed",
                        "estimated"
                      ]
                    }
                  },
                  "required": [
                    "micros",
                    "currency",
                    "basis"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "taskRef": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "startedAt": {
              "type": "string"
            },
            "sealedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "replayGrade": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "inspect",
                    "view",
                    "fork",
                    "retry"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "verdict": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "flipped",
                    "failing",
                    "unmoved",
                    "unsatisfied",
                    "tampered",
                    "unverified",
                    "waived"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "enforcementTier": {
              "type": "string",
              "enum": [
                "gateway",
                "harness",
                "observe"
              ]
            },
            "completenessGaps": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "digest_only",
                  "body_missing",
                  "tool_bodies",
                  "model_calls",
                  "hooks_partial",
                  "unobserved_tail",
                  "chain_break",
                  "telemetry_gap"
                ]
              }
            },
            "canSummarize": {
              "type": "boolean"
            },
            "model": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "provider": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "tier": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "provider",
                    "tier"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "machine": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "hostname": {
                      "type": "string"
                    },
                    "platform": {
                      "type": "string"
                    },
                    "osVersion": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "arch": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "nodeVersion": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "hostname",
                    "platform",
                    "osVersion",
                    "arch",
                    "nodeVersion"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "harness": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "workingDirectory": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "repository": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "root": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "branch": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "commit": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "root",
                    "branch",
                    "commit"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "summary": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "generatedAt": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text",
                    "generatedAt",
                    "model"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "source",
            "agentKey",
            "operatorId",
            "operatorKind",
            "operatorName",
            "status",
            "turns",
            "steps",
            "frames",
            "cost",
            "taskRef",
            "startedAt",
            "sealedAt",
            "replayGrade",
            "verdict",
            "enforcementTier",
            "completenessGaps",
            "canSummarize",
            "model",
            "machine",
            "name",
            "summary"
          ],
          "additionalProperties": false
        }
      },
      "nextCursor": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "runs",
      "nextCursor"
    ],
    "additionalProperties": false
  }
}
