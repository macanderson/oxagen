{
  "name": "get_tacho_bundle",
  "domain": "tacho",
  "description": "Fetch the signed policy bundle an enrolled Tacho host caches and evaluates locally.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "host_enrollment_id": {
        "type": "string"
      },
      "etag": {
        "type": "string",
        "maxLength": 128
      }
    },
    "required": [
      "host_enrollment_id"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "not_modified": {
        "type": "boolean"
      },
      "etag": {
        "type": "string",
        "minLength": 1
      },
      "bundle": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "schema": {
                "const": "tacho.bundle.v1"
              },
              "version": {
                "type": "integer",
                "minimum": 0
              },
              "etag": {
                "type": "string",
                "minLength": 1
              },
              "issued_at": {
                "type": "string"
              },
              "expires_at": {
                "type": "string"
              },
              "host_enrollment_id": {
                "type": "string"
              },
              "host_status": {
                "type": "string",
                "enum": [
                  "active",
                  "paused",
                  "suspended",
                  "revoked"
                ]
              },
              "deny_generation": {
                "type": "object",
                "properties": {
                  "org": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "workspace": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "org",
                  "workspace"
                ],
                "additionalProperties": false
              },
              "permissions": {
                "type": "object",
                "properties": {
                  "allow": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 512
                    }
                  },
                  "deny": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 512
                    }
                  },
                  "ask": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 512
                    }
                  }
                },
                "required": [
                  "allow",
                  "deny",
                  "ask"
                ],
                "additionalProperties": false
              },
              "tools": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "risk_grade": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "critical"
                      ]
                    },
                    "read_only": {
                      "type": "boolean"
                    },
                    "capability_id": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "risk_grade",
                    "read_only"
                  ],
                  "additionalProperties": false
                }
              },
              "budget": {
                "type": "object",
                "properties": {
                  "session_limit_usd": {
                    "type": "number",
                    "minimum": 0
                  },
                  "daily_limit_usd": {
                    "type": "number",
                    "minimum": 0
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "observed",
                      "enforced"
                    ]
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              },
              "context": {
                "type": "object",
                "properties": {
                  "system": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 16384
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "system"
                ],
                "additionalProperties": false
              },
              "retention": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "digest_only",
                      "content_exact"
                    ]
                  },
                  "classes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 64
                    }
                  }
                },
                "required": [
                  "mode",
                  "classes"
                ],
                "additionalProperties": false
              },
              "mode": {
                "type": "string",
                "enum": [
                  "observe",
                  "enforce"
                ]
              },
              "signature": {
                "type": "object",
                "properties": {
                  "key_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alg": {
                    "const": "ed25519"
                  },
                  "sig": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "key_id",
                  "alg",
                  "sig"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schema",
              "version",
              "etag",
              "issued_at",
              "expires_at",
              "host_enrollment_id",
              "host_status",
              "deny_generation",
              "permissions",
              "tools",
              "budget",
              "context",
              "retention",
              "mode",
              "signature"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "not_modified",
      "etag",
      "bundle"
    ],
    "additionalProperties": false
  }
}
