{
  "name": "update_workspace_settings",
  "domain": "workspace",
  "description": "Update a workspace's general settings (partial): name, slug, and description. The active workspace unless workspaceId names another one in the organization. Org Owners and Admins, and the workspace's Owner or Admin, are checked in the handler.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "medium",
    "category": "workspace"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workspaceId": {
        "type": "string"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "slug": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "description": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2000
          },
          {
            "type": "null"
          }
        ]
      },
      "avatarUrl": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 512
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "avatarUrl": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "name",
      "slug",
      "description",
      "avatarUrl"
    ],
    "additionalProperties": false
  }
}
