{
  "name": "agent.trigger.list",
  "domain": "agent",
  "description": "List the (non-deleted) triggers configured for an agent in the current workspace",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string",
        "description": "Agent public id (agt_…) or UUID"
      }
    },
    "required": [
      "agentId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "triggers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "triggerId": {
              "type": "string"
            },
            "publicId": {
              "type": "string"
            },
            "triggerType": {
              "type": "string",
              "enum": [
                "manual",
                "schedule",
                "event"
              ]
            },
            "eventSource": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "eventType": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "connectionId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "filter": {
              "type": "object",
              "additionalProperties": {}
            },
            "schedule": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "triggerId",
            "publicId",
            "triggerType",
            "eventSource",
            "eventType",
            "connectionId",
            "filter",
            "schedule",
            "enabled"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "triggers"
    ],
    "additionalProperties": false
  }
}
