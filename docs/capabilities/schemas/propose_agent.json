{
  "name": "propose_agent",
  "domain": "agent",
  "description": "Write a new agent as a pull request: cut agents/<slug> from the main repository's production branch, commit .oxagen/agents/<slug>.toml and, for Claude Code, Cursor, and Stella, the subagent file generated from it, and open the pull request. Six checks (schema, key, belt, authority, budget, secret and PII scan) run first, and a failed check writes nothing. No row is written; register the agent after merge to create its identity.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "identity"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "minLength": 1,
        "maxLength": 18
      },
      "harness": {
        "type": "string",
        "enum": [
          "stella",
          "claude-code",
          "codex",
          "cursor",
          "claude-agent-sdk",
          "custom"
        ]
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536
      },
      "rationale": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "required": [
      "slug",
      "harness",
      "source"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "slug": {
        "type": "string"
      },
      "agentKey": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "path": {
        "type": "string"
      },
      "generatedPath": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "branch": {
        "type": "string"
      },
      "repository": {
        "type": "string"
      },
      "baseRef": {
        "type": "string"
      },
      "digest": {
        "type": "string"
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "schema",
                "key",
                "belt",
                "authority",
                "budget",
                "secrets"
              ]
            },
            "passed": {
              "type": "boolean"
            },
            "code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "passed",
            "code"
          ],
          "additionalProperties": false
        }
      },
      "commitSha": {
        "type": "string",
        "minLength": 1
      },
      "pullRequest": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "number",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "slug",
      "agentKey",
      "path",
      "generatedPath",
      "branch",
      "repository",
      "baseRef",
      "digest",
      "checks",
      "commitSha",
      "pullRequest"
    ],
    "additionalProperties": false
  }
}
