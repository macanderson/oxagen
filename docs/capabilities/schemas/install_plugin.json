{
  "name": "install_plugin",
  "domain": "plugin",
  "description": "Install a plugin into this workspace.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "plugin"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pluginType": {
        "type": "string",
        "enum": [
          "mcp_server",
          "integration",
          "agent_skill",
          "agent_capability",
          "knowledge_source"
        ],
        "default": "mcp_server"
      },
      "pluginId": {
        "type": "string"
      },
      "custom": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "endpointUrl": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "authKind": {
            "type": "string",
            "enum": [
              "oauth",
              "secret",
              "none"
            ]
          }
        },
        "required": [
          "name",
          "endpointUrl",
          "transport",
          "authKind"
        ],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "orgListingId": {
        "type": "string"
      },
      "authKind": {
        "type": "string",
        "enum": [
          "oauth",
          "secret",
          "none"
        ]
      }
    },
    "required": [
      "orgListingId",
      "authKind"
    ],
    "additionalProperties": false
  }
}
