{
  "name": "create_prepaid_invoice",
  "domain": "billing",
  "description": "Platform-operator only: issue an enterprise's prepaid order (a platform licence for a period, governed action units, usage credits) on a Stripe invoice sent for payment by transfer, and grant the units and credits when it is paid.",
  "mode": "sync",
  "surfaces": [],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "orgId": {
        "type": "string",
        "format": "uuid"
      },
      "orderId": {
        "type": "string",
        "format": "uuid"
      },
      "agreementRef": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      },
      "poNumber": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      },
      "currency": {
        "type": "string"
      },
      "licence": {
        "type": "object",
        "properties": {
          "amountCents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "periodStart": {
            "type": "string"
          },
          "periodEnd": {
            "type": "string"
          }
        },
        "required": [
          "amountCents",
          "periodStart",
          "periodEnd"
        ],
        "additionalProperties": false
      },
      "gau": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "ratePerGauMicros": {
            "type": "string"
          }
        },
        "required": [
          "quantity"
        ],
        "additionalProperties": false
      },
      "creditsCents": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "daysUntilDue": {
        "type": "integer",
        "minimum": 0,
        "maximum": 365,
        "default": 30
      },
      "grantOn": {
        "type": "string",
        "enum": [
          "paid",
          "issue"
        ],
        "default": "paid"
      },
      "memo": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "assistantSpendCapCents": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "orgId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "orderId": {
        "type": "string",
        "format": "uuid"
      },
      "orgId": {
        "type": "string",
        "format": "uuid"
      },
      "resumed": {
        "type": "boolean"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "open",
          "paid",
          "void",
          "uncollectible"
        ]
      },
      "agreementRef": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "poNumber": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "currency": {
        "type": "string"
      },
      "lines": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "licence",
                "gau",
                "credits"
              ]
            },
            "description": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "amountMicros": {
              "type": "string"
            },
            "periodStart": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "periodEnd": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "description",
            "quantity",
            "amountMicros",
            "periodStart",
            "periodEnd"
          ],
          "additionalProperties": false
        },
        "maxItems": 3
      },
      "totalMicros": {
        "type": "string"
      },
      "stripeInvoiceId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "invoiceNumber": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "hostedInvoiceUrl": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "null"
          }
        ]
      },
      "invoicePdfUrl": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "null"
          }
        ]
      },
      "grant": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "unitsGranted": {
                "type": "integer",
                "minimum": 0
              },
              "creditsGrantedCents": {
                "type": "integer",
                "minimum": 0
              },
              "assistantSpendCapCents": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "unitsGranted",
              "creditsGrantedCents"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "orderId",
      "orgId",
      "resumed",
      "status",
      "agreementRef",
      "poNumber",
      "currency",
      "lines",
      "totalMicros",
      "stripeInvoiceId",
      "invoiceNumber",
      "hostedInvoiceUrl",
      "invoicePdfUrl",
      "grant"
    ],
    "additionalProperties": false
  }
}
