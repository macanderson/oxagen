{
  "name": "get_ci_status",
  "domain": "repo",
  "description": "Read CI check-run and commit-status results for a ref in a GitHub repository.",
  "mode": "sync",
  "surfaces": [
    "agent",
    "api",
    "mcp"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "vcs"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "owner": {
        "type": "string",
        "description": "Repository owner (user or organisation)"
      },
      "repo": {
        "type": "string",
        "description": "Repository name"
      },
      "ref": {
        "type": "string",
        "description": "Branch name, commit SHA, or PR head ref to read CI for"
      }
    },
    "required": [
      "owner",
      "repo",
      "ref"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ref": {
        "type": "string",
        "description": "The ref that was queried"
      },
      "sha": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "overall": {
        "type": "string",
        "enum": [
          "passing",
          "failing",
          "pending",
          "neutral",
          "unknown"
        ],
        "description": "Aggregated CI verdict"
      },
      "counts": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "passed": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "pending": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer"
          },
          "neutral": {
            "type": "integer"
          }
        },
        "required": [
          "total",
          "passed",
          "failed",
          "pending",
          "skipped",
          "neutral"
        ],
        "additionalProperties": false,
        "description": "Tallies across all checks"
      },
      "runs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Check run or status context name"
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "in_progress",
                "completed"
              ],
              "description": "Lifecycle status of the check"
            },
            "conclusion": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "success",
                    "failure",
                    "neutral",
                    "cancelled",
                    "timed_out",
                    "action_required",
                    "skipped",
                    "stale"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "startedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "completedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "app": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "status",
            "conclusion",
            "url",
            "startedAt",
            "completedAt",
            "durationMs",
            "app"
          ],
          "additionalProperties": false
        },
        "description": "Every check run and legacy status"
      }
    },
    "required": [
      "ref",
      "sha",
      "overall",
      "counts",
      "runs"
    ],
    "additionalProperties": false
  }
}
