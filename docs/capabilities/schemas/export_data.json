{
  "name": "export_data",
  "domain": "privacy",
  "description": "Request a machine-readable ZIP export of personal or organizational data (GDPR Article 20, the right to data portability). Returns immediately with status 'queued'; poll GET /v1/{org}/{workspace}/privacy/export/{exportId} until it answers ready, then fetch the archive from that path's /download. No URL is returned: the bundle is a private object served by an authenticated route.",
  "mode": "async",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "privacy"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "enum": [
          "user",
          "org"
        ]
      },
      "orgId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "scope"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "exportId": {
        "type": "string",
        "format": "uuid"
      },
      "status": {
        "type": "string",
        "enum": [
          "queued",
          "processing",
          "ready",
          "failed"
        ]
      },
      "downloadUrl": {
        "type": "string",
        "format": "uri"
      }
    },
    "required": [
      "exportId",
      "status"
    ],
    "additionalProperties": false
  }
}
