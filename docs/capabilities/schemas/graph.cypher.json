{
  "name": "graph.cypher",
  "domain": "graph",
  "description": "Execute a Cypher query against the knowledge graph. When nlQuery=true, natural language is translated to Cypher by an LLM (sandboxed to read-only). Raw Cypher (nlQuery=false) is available to privileged roles only and supports both reads and writes.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "high",
    "category": "graph"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000,
        "description": "Either a Cypher query string (when nlQuery=false) or a natural-language description (when nlQuery=true)"
      },
      "nlQuery": {
        "type": "boolean",
        "default": false
      },
      "params": {
        "type": "object",
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "rows": {
        "type": "array",
        "items": {},
        "description": "Result rows as plain objects"
      },
      "columns": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Column names in result order"
      },
      "rowCount": {
        "type": "number",
        "description": "Number of rows returned"
      }
    },
    "required": [
      "rows",
      "columns",
      "rowCount"
    ],
    "additionalProperties": false
  }
}
