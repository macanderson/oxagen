{
  "name": "list_sandbox_logs",
  "domain": "agent",
  "description": "List captured stdout/stderr/command output for a durable sandbox session.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent",
    "cli"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "execution"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "description": "Durable-session id (sbx_…) returned by agent.sandbox.start."
      },
      "level": {
        "type": "string",
        "enum": [
          "normal",
          "debug"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000,
        "default": 500
      },
      "sinceMs": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "sessionId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "lines": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "ts": {
              "type": "string"
            },
            "stream": {
              "type": "string",
              "enum": [
                "stdout",
                "stderr",
                "system"
              ]
            },
            "level": {
              "type": "string",
              "enum": [
                "normal",
                "debug"
              ]
            },
            "command": {
              "type": "string"
            },
            "seq": {
              "type": "integer"
            },
            "line": {
              "type": "string"
            },
            "exitCode": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "ts",
            "stream",
            "level",
            "command",
            "seq",
            "line",
            "exitCode",
            "durationMs"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "lines"
    ],
    "additionalProperties": false
  }
}
