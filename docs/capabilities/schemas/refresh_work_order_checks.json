{
  "name": "refresh_work_order_checks",
  "domain": "work",
  "description": "Read again from GitHub the checks a send's pull request needs on its head commit, and record the required checks and each conclusion.",
  "mode": "sync",
  "surfaces": [
    "api"
  ],
  "sensitivity": "high",
  "agent": null,
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "item_id": {
        "type": "string"
      },
      "work_order_id": {
        "type": "string"
      }
    },
    "required": [
      "item_id",
      "work_order_id"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "held",
              "triaged",
              "needs_info",
              "changed",
              "ready",
              "sent",
              "running",
              "review",
              "done",
              "closed"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "state",
          "revision",
          "version"
        ],
        "additionalProperties": false
      },
      "repeat": {
        "type": "boolean"
      },
      "head_sha": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "required_checks": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "unread_reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "item",
      "repeat",
      "head_sha",
      "required_checks",
      "unread_reason"
    ],
    "additionalProperties": false
  }
}
