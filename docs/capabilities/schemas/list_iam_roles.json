{
  "name": "list_iam_roles",
  "domain": "iam",
  "description": "List the org's IAM roles with their capability grants (allow/deny/require_approval) and the number of principals assigned to each. Read-only — the human-readable face of the permitted-action link of the accountability chain.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "scopeKind": {
        "type": "string",
        "enum": [
          "org",
          "workspace"
        ]
      },
      "includeGrants": {
        "type": "boolean",
        "default": true
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 100
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "roles": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Public role id (rol_…)"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "scopeKind": {
              "type": "string",
              "enum": [
                "org",
                "workspace"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "agent"
              ],
              "description": "human for the seeded membership roles; agent for the seeded agent roles and every custom role, which only assign_agent_role binds"
            },
            "isSystemDefault": {
              "type": "boolean",
              "description": "True for system-seeded roles (Owner, Admin, …) — not user-deletable"
            },
            "version": {
              "type": "string"
            },
            "memberCount": {
              "type": "integer",
              "description": "Active (non-deleted, non-expired) principal assignments holding this role"
            },
            "grants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "capability": {
                    "type": "string",
                    "description": "Capability name the grant applies to"
                  },
                  "effect": {
                    "type": "string",
                    "enum": [
                      "allow",
                      "deny",
                      "require_approval"
                    ]
                  }
                },
                "required": [
                  "capability",
                  "effect"
                ],
                "additionalProperties": false
              },
              "description": "Capability grants carried by the role (empty when includeGrants=false)"
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Catalogue permission ids every capability of which the role allows (empty when includeGrants=false)"
            },
            "createdAt": {
              "type": "string",
              "description": "ISO-8601"
            },
            "createdBy": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "name",
            "description",
            "scopeKind",
            "kind",
            "isSystemDefault",
            "version",
            "memberCount",
            "grants",
            "permissions",
            "createdAt",
            "createdBy"
          ],
          "additionalProperties": false
        },
        "description": "Roles sorted system-defaults-first, then by name"
      },
      "total": {
        "type": "integer",
        "description": "Total roles matching the filter before pagination"
      },
      "hasMore": {
        "type": "boolean"
      },
      "limit": {
        "type": "integer"
      },
      "offset": {
        "type": "integer"
      },
      "catalog": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "group": {
              "type": "string",
              "enum": [
                "Runs",
                "Agents",
                "Tools and policy",
                "Repository",
                "Graph and steering",
                "Money",
                "Audit"
              ]
            },
            "description": {
              "type": "string"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "group",
            "description",
            "capabilities"
          ],
          "additionalProperties": false
        },
        "description": "The permission catalogue, in catalogue order"
      },
      "enforcement": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string",
            "description": "The org's plan tier"
          },
          "enforced": {
            "type": "boolean",
            "description": "True when the kernel's IAM check runs the resolver for this org (the enterprise tier); false when every capability is allowed and the roles here are documentation"
          }
        },
        "required": [
          "tier",
          "enforced"
        ],
        "additionalProperties": false,
        "description": "Whether the roles listed govern anything for this org"
      }
    },
    "required": [
      "roles",
      "total",
      "hasMore",
      "limit",
      "offset",
      "catalog",
      "enforcement"
    ],
    "additionalProperties": false
  }
}
