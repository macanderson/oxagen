{
  "name": "organization.create",
  "domain": "organization",
  "description": "Create a new organization with a globally-unique slug",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "high",
  "agent": {
    "requiresApproval": true,
    "riskLevel": "medium",
    "category": "organization"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "slug": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40
      },
      "planSlug": {
        "type": "string",
        "minLength": 1,
        "default": "free"
      },
      "type": {
        "type": "string",
        "enum": [
          "personal",
          "business"
        ],
        "default": "business"
      },
      "website": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
      },
      "industry": {
        "type": "string",
        "enum": [
          "software-it",
          "financial-services",
          "healthcare",
          "retail-ecommerce",
          "manufacturing",
          "education",
          "media-entertainment",
          "real-estate",
          "professional-services",
          "marketing-advertising",
          "telecommunications",
          "energy-utilities",
          "transportation-logistics",
          "travel-hospitality",
          "construction",
          "agriculture",
          "government",
          "nonprofit",
          "legal",
          "insurance",
          "automotive",
          "food-beverage",
          "pharmaceuticals",
          "other"
        ]
      },
      "employeeSize": {
        "type": "string",
        "enum": [
          "1",
          "2-10",
          "11-50",
          "51-200",
          "201-500",
          "501-1000",
          "1001-5000",
          "5001-10000",
          "10000+"
        ]
      },
      "billingEmail": {
        "type": "string",
        "format": "email",
        "maxLength": 320
      },
      "billingAddress": {
        "type": "object",
        "properties": {
          "line1": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "line2": {
            "type": "string",
            "maxLength": 255
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "region": {
            "type": "string",
            "maxLength": 100
          },
          "postalCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "country": {
            "type": "string"
          },
          "placeId": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "line1",
          "city",
          "postalCode",
          "country"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "name",
      "slug"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "publicId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "createdAt": {
        "type": "string"
      }
    },
    "required": [
      "publicId",
      "name",
      "slug",
      "type",
      "createdAt"
    ],
    "additionalProperties": false
  }
}
