{
  "name": "export_statement",
  "domain": "spend",
  "description": "Export this workspace's monthly spend statement as CSV: one line per operator, agent, model, tool, task and cost center (spend with no cost center on its own line) with runs, calls, cost in micros and in cents rounded half to even once, the basis, and proven and accepted spend kept apart. With rows set to runs, one line per run instead, with its agent, operator, work item, and cost.",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "medium",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "billing"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "month": {
        "type": "string"
      },
      "format": {
        "type": "string",
        "enum": [
          "csv"
        ],
        "default": "csv"
      },
      "rows": {
        "type": "string",
        "enum": [
          "groups",
          "runs"
        ],
        "default": "groups"
      }
    },
    "required": [
      "month"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "month": {
        "type": "string"
      },
      "filename": {
        "type": "string"
      },
      "mediaType": {
        "const": "text/csv"
      },
      "content": {
        "type": "string"
      },
      "lines": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "month",
      "filename",
      "mediaType",
      "content",
      "lines"
    ],
    "additionalProperties": false
  }
}
