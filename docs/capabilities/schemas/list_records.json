{
  "name": "list_records",
  "domain": "context",
  "description": "List the workspace's published steering records with kind, force, constraint effect, scope, lineage, commit and path, filtered by kind, scope, status or lineage",
  "mode": "sync",
  "surfaces": [
    "api",
    "mcp",
    "agent"
  ],
  "sensitivity": "low",
  "agent": {
    "requiresApproval": false,
    "riskLevel": "low",
    "category": "introspection"
  },
  "chain": {
    "produces": [],
    "consumes": [],
    "chainHints": []
  },
  "render": null,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "rule",
          "constraint",
          "procedure",
          "fact",
          "memory",
          "preference"
        ]
      },
      "sharingScope": {
        "type": "string",
        "enum": [
          "repository",
          "workspace"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "retired",
          "superseded"
        ]
      },
      "lineageId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "records": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "lineageId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "rule",
                    "constraint",
                    "procedure",
                    "fact",
                    "memory",
                    "preference"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "force": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "must",
                    "should",
                    "may",
                    "info"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "constraintEffect": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "require",
                    "forbid"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "sharingScope": {
              "type": "string",
              "enum": [
                "repository",
                "workspace"
              ]
            },
            "statement": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "retired",
                "superseded"
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "checksum": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "commit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "path": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "publishedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "updatedAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "lineageId",
            "title",
            "kind",
            "force",
            "constraintEffect",
            "sharingScope",
            "statement",
            "status",
            "version",
            "checksum",
            "commit",
            "path",
            "publishedAt",
            "updatedAt"
          ],
          "additionalProperties": false
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "records",
      "total"
    ],
    "additionalProperties": false
  }
}
