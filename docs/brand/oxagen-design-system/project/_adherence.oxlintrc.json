{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/code/**",
              "components/core/**",
              "components/feedback/**",
              "components/flows/**",
              "components/layout/**",
              "components/lib/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Aeonik|Aeonik Fono|Aeonik Mono))/i]",
        "message": "Font not provided by the design system. Available: Aeonik, Aeonik Fono, Aeonik Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|gradient|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, gradient."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|mono|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, mono, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconOnly|startIcon|endIcon|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconOnly, startIcon, endIcon, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:glow|gradientRing|interactive|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: glow, gradientRing, interactive."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|language|filename|showLineNumbers|copy|style|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: code, language, filename, showLineNumbers, copy, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:language|label|filename|code|key|ref|className|style|children)$/]",
        "message": "<CodeTab> doesn't accept that prop. Declared props: language, label, filename, code."
      },
      {
        "selector": "JSXOpeningElement[name.name='Collapse'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|icon|defaultOpen|open|onToggle|children|style|key|ref|className|style|children)$/]",
        "message": "<Collapse> doesn't accept that prop. Declared props: title, subtitle, icon, defaultOpen, open, onToggle, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|showValue|width|key|ref|className|style|children)$/]",
        "message": "<ConfidenceBar> doesn't accept that prop. Declared props: score, showValue, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|description|children|footer|width|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, description, children, footer, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Drawer'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|side|title|description|children|footer|size|key|ref|className|style|children)$/]",
        "message": "<Drawer> doesn't accept that prop. Declared props: open, onClose, side, title, description, children, footer, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Drawer'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:right|left|bottom)$/]",
        "message": "<Drawer> side must be one of 'right' | 'left' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|invalid|startIcon|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: size, invalid, startIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:language|node|size|key|ref|className|style|children)$/]",
        "message": "<LangIcon> doesn't accept that prop. Declared props: language, node, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='MainNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|key|ref|className|style|children)$/]",
        "message": "<MainNavItem> doesn't accept that prop. Declared props: id, label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|id|label|key|ref|className|style|children)$/]",
        "message": "<NodeChip> doesn't accept that prop. Declared props: kind, id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='WizardStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|render|key|ref|className|style|children)$/]",
        "message": "<WizardStep> doesn't accept that prop. Declared props: label, description, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='OxagenLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|key|ref|className|style|children)$/]",
        "message": "<OxagenLogo> doesn't accept that prop. Declared props: variant, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|actions|footer|inset|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, eyebrow, actions, footer, inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|badge|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: id, label, icon, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='Step'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|key|ref|className|style|children)$/]",
        "message": "<Step> doesn't accept that prop. Declared props: label, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|badge|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label, icon, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToastOptions'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|tone|icon|duration|key|ref|className|style|children)$/]",
        "message": "<ToastOptions> doesn't accept that prop. Declared props: title, description, tone, icon, duration."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
