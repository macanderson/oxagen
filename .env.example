# Oxagen environment contract. Copy to .env.local and fill values.
# .env.local is gitignored. Every variable here is required unless marked optional.

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Postgres (Neon in prod, Docker postgres locally) ──────────────────────────
DATABASE_URL=postgres://oxagen:oxagen@localhost:5432/oxagen

# ── ClickHouse (ClickHouse Cloud in prod, Docker locally) ─────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=oxagen

# ── Neo4j (AuraDB Free in prod, Docker locally) ───────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=oxagen-dev
NEO4J_DATABASE=neo4j

# ── Redis (Inngest dev server queue / session cache) ──────────────────────────
REDIS_URL=redis://localhost:6379

# ── Better Auth ───────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-byte-random
BETTER_AUTH_URL=http://localhost:3000

# ── OAuth providers ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Inngest ───────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── AI providers (Vercel AI SDK) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Linear (oxagen-v2 project — capability provenance per oxagen-feature skill)
LINEAR_API_KEY=

# ── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
