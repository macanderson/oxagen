# Oxagen environment contract. Copy to .env.local and fill values.
# .env.local is gitignored. Every variable here is required unless marked optional.

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Postgres (Neon in prod, Docker postgres locally) ──────────────────────────
# docker-compose.dev.yml maps host 5433 → container 5432 to avoid colliding
# with the oxagen-platform (v1) Postgres that occupies 5432 on the same machine.
DATABASE_URL=postgres://oxagen:oxagen@localhost:5433/oxagen

# ── ClickHouse (ClickHouse Cloud in prod, Docker locally) ─────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=oxagen

# ── Neo4j (AuraDB Free in prod, Docker locally) ───────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=oxagen-dev
NEO4J_DATABASE=neo4j

# ── Better Auth ───────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-byte-random
BETTER_AUTH_URL=http://localhost:3000
# Space-separated list of origins allowed to make cross-origin requests to the
# auth API. In dev: localhost variants. In prod: the vercel.app URL(s). The
# proxy.ts edge guard also validates session cookies, but this list enforces
# CORS at the Better Auth layer.
# Dev:     http://localhost:3000 http://localhost:4000
# Preview: https://oxagen-v2-app.vercel.app
# Prod:    https://oxagen-v2-app.vercel.app
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# ── Auth / token encryption ───────────────────────────────────────────────────
# Base64-encoded 256-bit master key (KEK) used to encrypt OAuth tokens at rest
# (Vercel-native — no cloud KMS). Required in prod and preview; leave blank in
# local dev to disable token encryption locally.
# Generate with: openssl rand -base64 32
AUTH_TOKEN_ENCRYPTION_KEY=

# ── OAuth providers ───────────────────────────────────────────────────────────
# Google uses TWO clients in the same Google Cloud project:
#  - LOGIN client: social sign-in (minimal openid/profile/email scopes). In use.
#  - DATA client:  Workspace data-source scopes (Drive/Sheets/Gmail/…), used by
#    the future genericOAuth `google-workspace` connection. Reserved — not wired
#    into login. Callback for data lives at /api/auth/oauth2/callback/google-workspace
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_DATA_CLIENT_ID=
GOOGLE_DATA_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Public Stripe key — inlined into the client bundle for Stripe.js init
# (distinct from the server-side STRIPE_PUBLISHABLE_KEY above).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# ── Billing / usage-meter (see packages/billing/src/pricing.ts) ───────────────
# Target BLENDED gross margin across all products, in (0,1). The gate solves
# the meter markup from this + the product mix. Change it, then run
# `pnpm billing:stripe-sync --apply` to push the new objective to Stripe.
OXAGEN_TARGET_MARGIN=0.65
# Optional: pin the exact solved markup so the runtime never recomputes the
# solve. `pnpm billing:stripe-sync` prints the value. Leave unset to derive
# from OXAGEN_TARGET_MARGIN + the code config (single source of truth).
# OXAGEN_METER_MARKUP=3.3190

# ── Inngest ───────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── AI provider keys (direct-provider fallback only) ─────────────────────────
# Primary path is the Vercel AI Gateway (see AI_GATEWAY_API_KEY below): the
# gateway holds the real provider credentials (BYOK) and model calls route
# through it. These two are an OPTIONAL local-dev fallback for talking to the
# providers directly when the gateway is bypassed — leave blank to force all
# traffic through the gateway. Do NOT set these in the Vercel project envs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Linear (oxagen-v2 project — capability provenance per oxagen-feature skill)
LINEAR_API_KEY=
LINEAR_PROJECT_ID=oxagen-v2-355ea6b2a3f7

# ── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Vercel AI Gateway (PRIMARY AI auth) ──────────────────────────────────────
# Single token for all model traffic. The gateway maps OXAGEN_LLM_* model ids
# (e.g. "anthropic/claude-haiku-4.5") to providers and injects the real provider
# keys server-side, so ANTHROPIC_API_KEY / OPENAI_API_KEY are not needed at
# runtime when this is set. Required in every deployed env (app, api, mcp).
AI_GATEWAY_API_KEY=

# ── AI Model Defaults ──────────────────────────────────────────────────────────
OXAGEN_LLM_FAST=anthropic/claude-haiku-4.5
OXAGEN_LLM_BALANCED=anthropic/claude-sonnet-4.6
OXAGEN_LLM_PRECISE=anthropic/claude-opus-4.8

# ── Env Manager tooling ───────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_API=
ENV_MANAGER_PORT=7799

# ── IAM enforcement ───────────────────────────────────────────────────────────
# Master switch for capability-level IAM checks. Default true (secure).
# Set false ONLY for break-glass / emergency access — requires justification
# comment and must be reverted before the end of the incident.
# Local dev: true  |  Preview: true  |  Prod: true
IAM_ENFORCEMENT_ENABLED=true

# ── Sandbox runtime ───────────────────────────────────────────────────────────
# Whether to execute tool calls in an isolated sandbox.
# Local dev: false (skip overhead)  |  Preview: true  |  Prod: true
SANDBOX_ENABLED=false
# Which driver backs the sandbox. Choices: modal | docker | vercel
# Local dev: docker  |  Preview+Prod: modal or vercel
SANDBOX_DRIVER=docker

# Modal sandboxed runner (SANDBOX_DRIVER=modal)
MODAL_RUNNER_URL=
MODAL_RUNNER_TOKEN=

# Vercel Sandbox runtime (SANDBOX_DRIVER=vercel)
VERCEL_SANDBOX_TOKEN=
VERCEL_SANDBOX_TEAM_ID=
VERCEL_SANDBOX_PROJECT_ID=
