# Oxagen environment contract — GENERATED from packages/config/src/registry.ts.
# Do not edit by hand: run `pnpm env:check --write` to regenerate.
# Copy to .env.local (gitignored) and fill values. NOTE markers flag vars not
# yet validated by baseEnvSchema (tracked in Linear).

# ── Node ──────────────────────────────────────────────────────────────────────
# Runtime mode. Vercel/Next set this automatically per deploy.  [optional]
NODE_ENV=development

# ── Postgres ──────────────────────────────────────────────────────────────────
# Neon Postgres connection string. Prod = live branch; preview/dev = dev branch.  [secret, required:development/preview/production]
DATABASE_URL=postgres://oxagen:oxagen@localhost:5433/oxagen

# ── ClickHouse ────────────────────────────────────────────────────────────────
# ClickHouse HTTPS endpoint.  [required:development/preview/production]
CLICKHOUSE_URL=http://localhost:8123

# ClickHouse user.  [required:development/preview/production]
CLICKHOUSE_USERNAME=default

# ClickHouse password (empty for local Docker).  [secret, optional]
CLICKHOUSE_PASSWORD=

# ClickHouse database name.  [optional]
CLICKHOUSE_DATABASE=oxagen

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Neo4j bolt(+s) URI.  [required:development/preview/production]
NEO4J_URI=bolt://localhost:7687

# Neo4j user.  [required:development/preview/production]
NEO4J_USERNAME=neo4j

# Neo4j password.  [secret, required:development/preview/production]
NEO4J_PASSWORD=

# Neo4j database.  [optional]
NEO4J_DATABASE=neo4j

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# OTLP HTTP collector URL (e.g. https://otel.example.com/v1/traces). When unset the SDK does not start and all spans are no-ops — safe for all envs. Rollback = leave unset.  [optional]
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com/v1/traces

# Standard OTEL comma-separated `key=value` header list sent to the collector (e.g. "authorization=Bearer xxx,x-tenant=oxagen"). Optional — for collectors that require auth headers. Parsed by packages/telemetry/src/tracer.ts.  [secret, optional]
OTEL_EXPORTER_OTLP_HEADERS=

# Service name tag on OTEL span resources (default: oxagen). Optional — leave unset to use the default.  [optional]
OTEL_SERVICE_NAME=oxagen

# ── Circuit breaker ───────────────────────────────────────────────────────────
# Consecutive failures before a breaker opens for a wrapped dependency call (Neo4j / Stripe / ClickHouse). Optional — defaults to 5 in packages/config/src/env.ts.  [optional]
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Milliseconds an open breaker waits before allowing a trial (half-open) request. Optional — defaults to 30000 in packages/config/src/env.ts.  [optional]
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# ── MCP ───────────────────────────────────────────────────────────────────────
# Per-request timeout (ms) for the app MCP OAuth authorize/callback flows when the MCP SDK fetches a third-party authorization server well-known / token endpoints. Bounds a hung server so it cannot stall the serverless function. Optional — defaults to 10000 in lib/mcp-oauth/safe-fetch.ts.  [optional]
MCP_OAUTH_FETCH_TIMEOUT_MS=10000

# ── Circuit breaker ───────────────────────────────────────────────────────────
# Consecutive successes required in the half-open state before a breaker closes. Optional — defaults to 1 in packages/config/src/env.ts.  [optional]
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=1

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max chat send/stream requests per minute per workspace (fallback: per org, then per IP) on /v1/**/chat/*. Optional — defaults to 60 in packages/config/src/env.ts.  [optional]
RATE_LIMIT_CHAT_PER_MIN=60

# Max agent-execution requests per minute per workspace (fallback: per org, then per IP) — code-exec / compose / sandbox ops / background-task start / A2A RPC. Optional — defaults to 30 in packages/config/src/env.ts.  [optional]
RATE_LIMIT_AGENT_EXEC_PER_MIN=30

# ── Error alerting ────────────────────────────────────────────────────────────
# When set, high-severity/unhandled server errors are POSTed as a Slack-compatible `{ text, blocks }` JSON payload here (Slack/Mattermost/Discord incoming webhook, or any compatible endpoint). BYO webhook — no vendor SDK. When unset, errors are still recorded to the ClickHouse error_events table; only the webhook alert is skipped.  [secret, optional]
ALERT_WEBHOOK_URL=

# ── Better Auth ───────────────────────────────────────────────────────────────
# Session/cookie signing secret (≥32 chars). Minted once per env and applied identically to api + app so sessions validate across both.  [secret, required:development/preview/production]
BETTER_AUTH_SECRET=

# Auth base URL (the app origin).  [required:development/preview/production]
BETTER_AUTH_URL=http://localhost:3000

# Space-separated origins allowed cross-origin access to the auth API.  [optional]
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Base64 256-bit KEK that wraps OAuth token encryption keys. Required in preview+production (enforced by the auth startup guard); blank locally disables it. Generate with `openssl rand -base64 32`.  [secret, required:preview/production]
AUTH_TOKEN_ENCRYPTION_KEY=

# Canonical production origin the shared social-login OAuth app's callback is registered against (OAuth Proxy productionURL). Preview deployments relay social login through this origin. Defaults to the production app URL when unset.  [optional]
OAUTH_PROXY_PRODUCTION_URL=https://app.oxagen.sh

# Dedicated secret the OAuth Proxy uses to encrypt/decrypt the relay payload between production and preview deployments. MUST be set to the SAME value in production AND preview for preview social login to work (production alone only passes through). Kept separate from BETTER_AUTH_SECRET to limit blast radius. Generate with `openssl rand -base64 32`.  [secret, optional]
OAUTH_PROXY_SECRET=

# ── OAuth providers ───────────────────────────────────────────────────────────
# Google LOGIN OAuth client id (social sign-in; minimal scopes).  [optional]
GOOGLE_LOGIN_CLIENT_ID=

# Google LOGIN OAuth client secret.  [secret, optional]
GOOGLE_LOGIN_CLIENT_SECRET=

# Google DATA OAuth client id (Workspace data scopes; future connection).  [optional]
GOOGLE_DATA_CLIENT_ID=

# Google DATA OAuth client secret.  [secret, optional]
GOOGLE_DATA_CLIENT_SECRET=

# GitHub LOGIN OAuth client id (social sign-in; minimal scopes).  [optional]
GITHUB_LOGIN_CLIENT_ID=

# GitHub LOGIN OAuth client secret.  [secret, optional]
GITHUB_LOGIN_CLIENT_SECRET=

# GitHub DATA OAuth client id (repo-ingestion scopes; future connection).  [optional]
GITHUB_DATA_CLIENT_ID=

# GitHub DATA OAuth client secret.  [secret, optional]
GITHUB_DATA_CLIENT_SECRET=

# Pre-registered OAuth clients for MCP authorization servers that do NOT support RFC 7591 dynamic client registration (GitHub MCP, notably). JSON object mapping the MCP server's endpoint HOST to the client registered with that provider, e.g. {"api.githubcopilot.com":{"client_id":"…","client_secret":"…"}}. Each provider app must list <app-origin>/api/v1/mcp/oauth/callback as its callback URL. When a host is absent the flow falls back to dynamic client registration as before.  [secret, optional]
MCP_OAUTH_PREREGISTERED_CLIENTS=

# ── github ────────────────────────────────────────────────────────────────────
# GitHub App OAuth client id — used for the data-connector OAuth flow.  [optional]
GITHUB_APP_CLIENT_ID=

# GitHub App OAuth client secret.  [secret, optional]
GITHUB_APP_CLIENT_SECRET=

# GitHub App webhook signing secret — validates inbound webhook payloads.  [secret, optional]
GITHUB_APP_WEBHOOK_SECRET=

# HMAC secret used to sign the OAuth state parameter for GitHub App installs.  [secret, optional]
GITHUB_APP_INSTALL_STATE_SECRET=

# GitHub App public slug (the path segment in https://github.com/apps/<slug>). Used to deep-link users to GitHub's install/configure page so they can add or remove orgs and repos. Optional — when unset the connection dialog derives the slug from an existing installation.  [optional]
GITHUB_APP_SLUG=

# GitHub App numeric ID. Required (with GITHUB_APP_PRIVATE_KEY) for the installation-token path in resolveGitHubToken() (ADR-020). Find it on the GitHub App settings page.  [optional]
GITHUB_APP_ID=

# PEM-encoded RSA private key for the GitHub App. Required (with GITHUB_APP_ID) for the installation-token path in resolveGitHubToken() (ADR-020). Generate in the GitHub App settings → Private keys.  [secret, optional]
GITHUB_APP_PRIVATE_KEY=

# Personal access token (PAT) used by GitHub write capabilities (repo.create, repo.file.put, repo.fork, repo.branch.create, repo.pr.open) as a LOCAL/DEMO-ONLY fallback. Per-workspace credential resolution is now live (GitHub App installation token + KMS-encrypted per-workspace OAuth — see resolveGitHubToken in packages/handlers/src/lib/github-token.ts), so this MUST NOT be set in production: a shared PAT bypasses per-workspace scoping. resolveGitHubToken logs a loud warning when it is used while NODE_ENV=production.  [secret, optional]
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Slack DATA OAuth client id for token refresh (ingestion cron). Token rotation must be enabled in the Slack app.  [optional]
SLACK_DATA_CLIENT_ID=

# Slack DATA OAuth client secret for token refresh (ingestion cron).  [secret, optional]
SLACK_DATA_CLIENT_SECRET=

# Zoom DATA OAuth client id for token refresh (ingestion cron). Zoom rotates the refresh token on each use.  [optional]
ZOOM_DATA_CLIENT_ID=

# Zoom DATA OAuth client secret for token refresh (ingestion cron).  [secret, optional]
ZOOM_DATA_CLIENT_SECRET=

# Salesforce DATA OAuth client id for token refresh (ingestion cron).  [optional]
SALESFORCE_DATA_CLIENT_ID=

# Salesforce DATA OAuth client secret for token refresh (ingestion cron).  [secret, optional]
SALESFORCE_DATA_CLIENT_SECRET=

# Microsoft DATA OAuth client id for token refresh (ingestion cron; MS Graph offline_access).  [optional]
MICROSOFT_DATA_CLIENT_ID=

# Microsoft DATA OAuth client secret for token refresh (ingestion cron).  [secret, optional]
MICROSOFT_DATA_CLIENT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Stripe secret key (sk_live in prod, sk_test in preview/dev).  [secret, required:development/preview/production]
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe publishable key (pk_live in prod, pk_test in preview/dev).  [required:development/preview/production]
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe webhook signing secret (whsec_).  [secret, required:development/preview/production]
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Browser-exposed Stripe publishable key for Stripe.js init.  [optional]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# When 'true', enables Stripe Tax automatic_tax on all checkout sessions. Ships dark; flip on only after Stripe Tax is registered/active in the dashboard.  [optional]
STRIPE_TAX_ENABLED=false

# ── Google Maps ───────────────────────────────────────────────────────────────
# Browser-exposed Google Maps / Places API key powering billing-address autocomplete in onboarding. Restrict to HTTP referrers in the Google Cloud console.  [optional]
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps URL-signing secret. Server-side only — must never be inlined into the browser bundle. Renamed from NEXT_PUBLIC_GOOGLE_MAPS_API_SECRET (which would have caused Next.js to expose it client-side). Consumed server-side only when URL signing is enabled.  [secret, optional]
GOOGLE_MAPS_URL_SIGNING_SECRET=

# ── Billing ───────────────────────────────────────────────────────────────────
# Target blended gross margin in (0,1). Drives the usage-meter markup; keep in sync with Stripe via `pnpm billing:stripe-sync --apply`.  [required:development/preview/production]
OXAGEN_TARGET_MARGIN=0.65

# Optional pinned solved meter markup (≥1). Leave unset to derive from OXAGEN_TARGET_MARGIN + the code config.  [optional]
OXAGEN_METER_MARKUP=

# Usage volume discount: percent off per OXAGEN_USAGE_DISCOUNT_INCREMENT dollars of usage credits purchased (e.g. 3 = 3% per increment ⇒ 15% at the $250 ceiling).  [required:development/preview/production]
OXAGEN_USAGE_DISCOUNT_PERCENT=3

# Usage volume discount: dollar increment that earns one OXAGEN_USAGE_DISCOUNT_PERCENT step (e.g. 50 = a discount step every $50 purchased).  [required:development/preview/production]
OXAGEN_USAGE_DISCOUNT_INCREMENT=50

# Usage volume discount: purchase amount (USD) at which the discount caps; above this it stays flat at the max. 3% per $50 up to $250 ⇒ 15% max.  [required:development/preview/production]
OXAGEN_USAGE_DISCOUNT_CEILING_USD=250

# ── Inngest ───────────────────────────────────────────────────────────────────
# Inngest event key. Required in preview+production.  [secret, required:preview/production]
INNGEST_EVENT_KEY=

# Inngest signing key. Required in preview+production.  [secret, required:preview/production]
INNGEST_SIGNING_KEY=

# ── File storage ──────────────────────────────────────────────────────────────
# Vercel Blob read/write token. Authenticates @oxagen/storage (avatar/image uploads). Swap-point for S3/R2.  [secret, optional]
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Selects the @oxagen/storage backend: 'vercel-blob' (default, prod) or 'fs' (local/CI filesystem driver, no token needed). The swap-point for an S3/R2 driver.  [optional]
STORAGE_DRIVER=vercel-blob

# Root directory for the 'fs' storage driver. Only read when STORAGE_DRIVER=fs. Absolute path used as-is; a relative path is anchored at process.cwd(); unset falls back to an OS-tmp directory.  [optional]
STORAGE_FS_ROOT=

# ── AI providers ──────────────────────────────────────────────────────────────
# Vercel AI Gateway token — the platform's single AI auth. @oxagen/ai routes every model call (text, image, embeddings, video) through the gateway; there is no direct-provider fallback, so this is required wherever AI runs.  [secret, required:preview/production]
AI_GATEWAY_API_KEY=

# CLI-only BYOK fallback: when no AI_GATEWAY_API_KEY exists anywhere, the CLI runs anthropic/* models directly against the Anthropic API with this key (other vendors and embeddings stay unavailable). The gateway key always wins when both are set. Never read by deployed services — platform AI is gateway-only.  [not-in-schema, secret, optional]
ANTHROPIC_API_KEY=

# Fast text tier ("Oxagen Fast") — the gateway model id @oxagen/ai resolves for the fast tier. The ask-page default.  [optional]
OXAGEN_LLM_FAST=anthropic/claude-haiku-4.5

# Balanced text tier ("Oxagen Balanced") — gateway model id for the balanced tier.  [optional]
OXAGEN_LLM_BALANCED=anthropic/claude-sonnet-5

# Precise text tier ("Oxagen Precise") — gateway model id for the precise tier.  [optional]
OXAGEN_LLM_PRECISE=anthropic/claude-fable-5

# Basic image tier ("Oxagen Basic") — default gateway image model for composer image generation.  [optional]
OXAGEN_LLM_IMAGE_BASIC=openai/gpt-image-1

# Advanced image tier ("Oxagen Advanced") — high-fidelity gateway image model.  [optional]
OXAGEN_LLM_IMAGE_ADVANCED=bfl/flux-2-max

# Basic video tier ("Oxagen Basic") — default gateway video model for composer video generation (pipeline stub).  [optional]
OXAGEN_LLM_VIDEO_BASIC=google/veo-3.0-fast-generate-001

# Advanced video tier ("Oxagen Advanced") — high-fidelity gateway video model.  [optional]
OXAGEN_LLM_VIDEO_ADVANCED=google/veo-3.0-generate-001

# ── Email ─────────────────────────────────────────────────────────────────────
# SMTP server host (Resend: smtp.resend.com).  [optional]
SMTP_HOST=smtp.resend.com

# SMTP port. 465 = implicit TLS; 587 = STARTTLS (TLS enforced).  [optional]
SMTP_PORT=587

# SMTP username (Resend: the literal "resend").  [optional]
SMTP_USERNAME=resend

# SMTP password — for Resend this is an API key (re_…).  [secret, optional]
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxx

# Default sender address. Its domain must be verified at the provider.  [optional]
SMTP_FROM_EMAIL=noreply@notifications.oxagen.sh

# Default sender display name.  [optional]
SMTP_FROM_NAME=Oxagen (DO NOT REPLY)

# ── Linear ────────────────────────────────────────────────────────────────────
# Linear API key (tooling/provenance; not read by deployed apps).  [secret, optional]
LINEAR_API_KEY=

# Linear project id for the oxagen-v2 project (tooling-only).  [not-in-schema, optional]
LINEAR_PROJECT_ID=oxagen-v2-355ea6b2a3f7

# ── Public URLs ───────────────────────────────────────────────────────────────
# Public app origin (browser-exposed).  [required:development/preview/production]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public api origin (browser-exposed).  [required:development/preview/production]
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin advertised in the A2A (Agent2Agent) protocol Agent Card's service endpoint and the /.well-known/agent-card.json URL. Optional — the A2A routes derive the origin from the live request; this only overrides the default for out-of-band card reads (MCP/CLI). Falls back to the API origin.  [optional]
A2A_PUBLIC_URL=http://localhost:4000

# Server-side app origin used to build plugin OAuth authorize/callback URLs (falls back to NEXT_PUBLIC_APP_URL). Not browser-exposed.  [optional]
APP_URL=http://localhost:3000

# Public marketing website origin (oxagen.sh). The /v1/cms/* lead routes use it to build the emailed reader link and CORS allows it as a cross-origin caller. Not browser-exposed.  [optional]
MARKETING_URL=http://localhost:8080

# MCP server origin used to build install instructions and client connections.  [optional]
MCP_URL=http://localhost:4100

# Optional override for the docs site origin (browser-exposed). When unset, apps/app resolves the correct URL per environment automatically (dev → http://localhost:3300; prod → https://docs.oxagen.ai). Set only to test a custom docs deployment. Validated as an optional URL by baseEnvSchema.  [optional]
NEXT_PUBLIC_DOCS_URL=

# chat_ux_v2 feature flag (apps/app chat UX overhaul, browser-exposed). "1" enables the new session-settings chat surface environment-wide; unset/anything else = off. A per-browser cookie override (?chat_ux_v2=1|0) wins over this default. Validated as an optional "0"|"1" enum by baseEnvSchema.  [optional]
NEXT_PUBLIC_CHAT_UX_V2=

# ── Security ──────────────────────────────────────────────────────────────────
# When true, Postgres RLS policies filter by org/workspace. Fail-closed: when UNSET it defaults ON in production (NODE_ENV/VERCEL_ENV=production) and OFF in dev/test/preview. A production process refuses to boot if this is forced to false (assertRlsEnforcedInProduction). Local dev override: set false in .env.local only if seeding/migration scripts need to bypass RLS; revert before running app code against the DB.  [optional]
TENANT_RLS_ENFORCEMENT_ENABLED=true

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Whether to execute tool calls in an isolated sandbox.  [optional]
SANDBOX_ENABLED=false

# Sandbox backend: modal | docker | vercel.  [optional]
SANDBOX_DRIVER=docker

# Modal sandboxed runner URL (SANDBOX_DRIVER=modal).  [optional]
MODAL_RUNNER_URL=

# Modal sandboxed runner token (SANDBOX_DRIVER=modal).  [secret, optional]
MODAL_RUNNER_TOKEN=

# Vercel Sandbox token (SANDBOX_DRIVER=vercel; OIDC auto-resolves on Vercel).  [secret, optional]
VERCEL_SANDBOX_TOKEN=

# Vercel Sandbox team id (SANDBOX_DRIVER=vercel).  [optional]
VERCEL_SANDBOX_TEAM_ID=

# Vercel Sandbox project id (SANDBOX_DRIVER=vercel).  [optional]
VERCEL_SANDBOX_PROJECT_ID=

# ── Observability ─────────────────────────────────────────────────────────────
# Pino log level for service loggers.  [optional]
LOG_LEVEL=debug

# Feature flag — set "false" to disable the Neo4j knowledge-graph writes.  [optional]
KNOWLEDGE_GRAPH_ENABLED=true

# Feature flag — set "1" or "true" to mount the durable-run API (POST /runs, GET /runs/:publicId, GET /runs/:publicId/events resumable SSE, POST /runs/:publicId/cancel) under apps/api's /v1/:org_slug/:workspace_slug scope (agent-engine v2 Phase 2 integration, docs/specs/agent-engine-v2/plan.md). OFF by default: every route under /runs 404s until this is set. Enqueues via @oxagen/agent-runner's RunStore (agent.agent_runs / agent.agent_run_events) — the durable worker that actually executes a claimed run is separate, dispatch-only wiring.  [not-in-schema, optional]
OXAGEN_DURABLE_RUNS=false

# HTTP port for the xmcp server.  [optional]
MCP_PORT=

# ── Release / build metadata ──────────────────────────────────────────────────
# Platform version string surfaced by @oxagen/config platformVersion(). Written by `pnpm release:*` and synced to every oxagen-v2-* Vercel project. Declared in turbo.json globalEnv so a version change busts the build cache. LOCAL: leave unset → falls back to package.json version. PROD/PREVIEW: the released semver. NOTE: read via raw process.env in @oxagen/config — not yet in baseEnvSchema (tracked).  [not-in-schema, optional]
PLATFORM_VERSION=

# ── Testing / e2e ─────────────────────────────────────────────────────────────
# Base URL Playwright drives in apps/app e2e (apps/app/playwright.config.ts). LOCAL: unset → defaults to http://localhost:3000. CI: the booted next server URL. NOTE: read via raw process.env — not in baseEnvSchema (test-only).  [not-in-schema, optional]
PLAYWRIGHT_BASE_URL=

# Set "true" in the vitest test lanes (declared in turbo.json test:unit/test:coverage env) so app code can branch to test-only behavior. Not for dev/preview/prod. NOTE: read via raw process.env — not in baseEnvSchema (test-only).  [not-in-schema, optional]
E2E_TEST=

# Set to "1" by tools/scripts/dev.ts for the local dev stack. Consumed by packages/auth to make local-env detection deterministic instead of racing NODE_ENV at module-load time (OXA-1752). Ignored on real Vercel deployments (VERCEL=1 guards it). NOTE: read via raw process.env — not in baseEnvSchema (dev-tooling only).  [not-in-schema, optional]
OXAGEN_LOCAL_DEV=

# ── env-manager tooling ───────────────────────────────────────────────────────
# Vercel API token (admin) the env-manager uses to read/write project env vars.  [not-in-schema, secret, optional]
VERCEL_TOKEN=

# Vercel team id (defaults to the oxagen team).  [not-in-schema, optional]
VERCEL_TEAM_ID=

# Vercel team slug for `pnpm env:pull` --scope (e.g. "oxagen"). Optional — when unset, the CLI resolves the team from each project's linked .vercel/project.json.  [not-in-schema, optional]
VERCEL_TEAM_SLUG=oxagen

# Local port for the env-manager web UI.  [not-in-schema, optional]
ENV_MANAGER_PORT=7799

# ── Security ──────────────────────────────────────────────────────────────────
# HMAC-SHA256 secret for signing audit-log export tokens. Required by the audit export route (apps/app) so exported files can be verified as untampered. Generate with `openssl rand -base64 32`.  [secret, required:production]
AUDIT_EXPORT_SIGNING_SECRET=

# ── Web Intelligence ──────────────────────────────────────────────────────────
# Tavily API key for web.search capability.  [secret, optional]
TAVILY_API_KEY=

# ── CLI ───────────────────────────────────────────────────────────────────────
# API token used by the CLI to authenticate requests; falls back to the value stored in ~/.oxagen/config.json.  [not-in-schema, secret, optional]
OXAGEN_API_TOKEN=

# Default org slug for CLI commands; falls back to the value stored in ~/.oxagen/config.json.  [not-in-schema, optional]
OXAGEN_ORG_ID=

# Default workspace slug for CLI commands; falls back to the value stored in ~/.oxagen/config.json.  [not-in-schema, optional]
OXAGEN_WORKSPACE_ID=

# Base URL for the Oxagen REST API, consumed by the CLI. Falls back to the default production API URL when unset.  [not-in-schema, optional]
OXAGEN_API_URL=http://localhost:4000

# Base URL for the Oxagen web app, where `oxagen login` opens the browser authorize page. Falls back to the default production app URL when unset.  [not-in-schema, optional]
OXAGEN_APP_URL=http://localhost:3000

# Vercel AI Gateway model slug used by the CLI's local agent loop (e.g. anthropic/claude-sonnet-5). Falls back to the value in ~/.config/oxagen/config.json, then a default.  [not-in-schema, optional]
OXAGEN_MODEL=

# Cross-tool opt-out convention (https://consoledonottrack.com): set to '1' to disable CLI usage telemetry. Checked before OXAGEN_TELEMETRY and the persisted telemetry.enabled config.  [not-in-schema, optional]
DO_NOT_TRACK=1

# Set to '0' to disable CLI usage telemetry for this invocation (equivalent to `oxagen telemetry off`). DO_NOT_TRACK=1 also disables it and takes precedence.  [not-in-schema, optional]
OXAGEN_TELEMETRY=0

# Default reasoning effort for models that support a thinking mode: low | medium | high | xhigh | max (xhigh/max are Anthropic-only depth tiers; other vendors clamp to high). Forwarded as reasoning config per vendor; models without a reasoning mode ignore it. Unset = model default (Anthropic adaptive thinking decides depth itself). Falls back to `effort` in ~/.config/oxagen/config.json / .oxagen/settings.json, then the model default.  [not-in-schema, optional]
OXAGEN_EFFORT=

# Motion mode for the CLI TUI animations: full | reduced | off. Overrides the persisted `motion` config; unset falls back to config, then 'full'. (OXAGEN_CLI_FUN=0 is a legacy alias that maps to 'reduced'.)  [not-in-schema, optional]
OXAGEN_CLI_MOTION=full

# Wall-clock bound in ms on the REPL's per-turn planner call (default 60000). Past the bound the turn degrades to a router-derived single-task plan instead of hanging. Set to '0' to disable the bound; a non-finite value is ignored.  [not-in-schema, optional]
OXAGEN_PLAN_TIMEOUT_MS=60000

# When '0', disables whimsical CLI animations: the REPL status rail's cat-and-mouse chase, and `oxagen init`'s space-invaders/OXAGEN-reveal loading animation (which falls back to plain progress lines instead). Any other value (or unset) keeps them on.  [not-in-schema, optional]
OXAGEN_CLI_FUN=

# When '0', the full-screen REPL starts with mouse-wheel transcript scrolling disabled (terminal-native text selection stays available). Any other value (or unset) enables mouse capture on launch; the /mouse command toggles it at runtime either way.  [not-in-schema, optional]
OXAGEN_CLI_MOUSE=

# When '1', the CLI one-shot runner skips session/fleet memory recall and remember entirely. Benchmark harnesses (SWE-bench) set it so recalled context from one instance can never leak into another when the same repo is reused across instances.  [not-in-schema, optional]
OXAGEN_DISABLE_MEMORY=

# When '1' or 'true', disables the CLI's code-graph context layer for the whole shell, so the context resolver goes straight to the grep fallback (logged). Unset/other values keep the graph-before-grep default on.  [not-in-schema, optional]
OXAGEN_GRAPH_DISABLED=

# Highest task complexity the CLI orchestrator handles on the coordinator model before dispatching to a worker. One of the complexity-scale labels; invalid values fall back to the built-in routing policy.  [not-in-schema, optional]
OXAGEN_ROUTING_TRIVIAL_MAX=

# Token budget guarding against low-value mid-turn model switches in the CLI orchestrator. Non-negative number; invalid values fall back to the built-in routing policy.  [not-in-schema, optional]
OXAGEN_ROUTING_SWITCH_BUDGET=

# Overrides the default code-worker model id the CLI orchestrator dispatches coding work to. Falls back to the registry's `workerModels.defaultCode`.  [not-in-schema, optional]
OXAGEN_ROUTING_CODE_WORKER=

# Overrides the cheap basic-work worker model id the CLI orchestrator dispatches lightweight work to. Falls back to the registry's `workerModels.cheapBasic`.  [not-in-schema, optional]
OXAGEN_ROUTING_BASIC_WORKER=

# When set, the CLI prints extra diagnostics (e.g. context-engine memory open failures) to stderr.  [not-in-schema, optional]
OXAGEN_DEBUG=

# Coordinator model for the CLI agent: "on-device" (default) or a cloud registry id like "haiku". Overrides `runtime.coordinator` in ~/.config/oxagen/config.json.  [not-in-schema, optional]
OXAGEN_COORDINATOR=

# On-device model id: "auto" (resolve the best code model for this device) or a pinned capability-table modelId. Overrides `runtime.onDevice.modelId` in the CLI config.  [not-in-schema, optional]
OXAGEN_ONDEVICE_MODEL=

# Override the on-device model weights cache directory (defaults to ~/.oxagen/models). Overrides `runtime.onDevice.cacheDir` in the CLI config.  [not-in-schema, optional]
OXAGEN_MODELS_CACHE_DIR=

# Gateway model slug the CLI turn pipeline uses to evaluate each prompt (completeness + complexity scoring, context hints, refined rewrite). Defaults to "local" — the deterministic cost-router heuristic, no model call.  [optional]
OXAGEN_LLM_EVALUATOR=

# Gateway model slug the CLI uses as the completeness-judge advisor — always distinct from the executor so work is never graded by the model that produced it. Defaults to the flagship Anthropic model (Fable 5); set a cross-vendor slug (e.g. an OpenAI model) for vendor-independent judging when a gateway key is available.  [optional]
OXAGEN_LLM_ADVISOR=

# Gateway model slug `oxagen solve` (best-of-N) uses as the comparative selector that picks the winning candidate. Defaults to the flagship Anthropic model (Fable 5); set a cross-vendor slug for vendor-independent selection when a gateway key is available.  [optional]
OXAGEN_LLM_SELECTOR=

# Set to any value to disable the interactive TUI in `oxagen` and always print classic help. Unset or empty = TUI enabled (when running interactively in a terminal).  [not-in-schema, optional]
OXAGEN_NO_TUI=

# Set to '1' to emit verbose per-call / per-import diagnostics during code graph analysis. Off by default as most misses are expected outcomes. Diagnostic output goes to stderr.  [optional]
OXAGEN_CODE_GRAPH_DEBUG=

# Selects the code-graph embedding backend for `semantic_search`: 'auto' (default — a local Ollama server if reachable, else an in-process ONNX model if installed, else the platform gateway if a key is configured, else no vector ranking), 'ollama', 'onnx' ('local' also accepted), 'gateway', or 'off'. Local providers are free, offline, and use no AI SDK, but their vectors are a different, smaller vector space than the platform's 1536-d index, so `graph push` never ships them — the server re-embeds those files instead. Overrides the `graph.embedProvider` value in ~/.config/oxagen/config.json; invalid values fall back to 'auto'.  [not-in-schema, optional]
OXAGEN_EMBED_PROVIDER=auto

# Base URL of the local Ollama server the CLI's 'ollama'/'auto' embedding provider talks to. Same variable name Ollama itself uses, so an existing Ollama setup needs no new config. Defaults to http://localhost:11434 when unset.  [not-in-schema, optional]
OLLAMA_HOST=http://localhost:11434

# Ollama embedding model the 'ollama'/'auto' embedding provider requests (must already be pulled — `ollama pull <model>`). Defaults to 'nomic-embed-text'. Does not affect the ONNX provider, which pins its own bundled model.  [not-in-schema, optional]
OXAGEN_EMBED_MODEL=nomic-embed-text

# Set to '1' to bypass the account-required gate (requireSession()) and return a synthetic benchmark session instead of exiting. Only for headless benchmark containers (bench/terminal-bench, bench/swe-bench) that run the agent path with no logged-in account — never set this outside a benchmark/CI sandbox.  [not-in-schema, optional]
OXAGEN_ALLOW_NO_SESSION=

# Set to '1' to make buildWorkspaceTools structurally deny edit_file/write_file on test-shaped paths (tests/, __tests__/, *.test.*, *_spec.rb, *Test.java, …), returning a denial the model sees instead of a silent no-op. For benchmark harnesses (SWE-bench) graded against hidden, fixed tests: an agent that edits the tests it will be scored against 'passes' locally but scores 0, since the edit is discarded before grading — never set this outside a benchmark/CI sandbox.  [optional]
OXAGEN_FORBID_TEST_EDITS=

# Speculative tool execution kill switch (ADR-030 — ON by default). After every read-tool result the engine predicts the model's likely next reads (truncation-marker follow-ups, top grep hit files, first glob entries) and executes them early into a per-turn promise cache; a matching real call awaits the same promise instead of re-doing the I/O. Read-only allowlist (read_file/grep/glob/list_dir); ANY other tool call invalidates the whole cache. Set to '0'/'false' to disable. The RunCodingAgentOptions.speculativeTools option wins over this var.  [not-in-schema, optional]
OXAGEN_SPECULATIVE_TOOLS=1

# Partitioned tool dispatch kill switch (agent-engine v2 Phase 0 — ON by default). The engine gates a step's tool executions through a fair FIFO shared/exclusive gate: non-mutating tools run concurrently capped at 8, mutating tools (bash/write_file/edit_file plus MaterializedTools.mutatingToolNames) run as exclusive barriers in call order — instead of the AI SDK's unawaited, uncapped execution of every call. Set to '0'/'false' to disable. The RunCodingAgentOptions.dispatchGuard option wins over this var.  [not-in-schema, optional]
OXAGEN_DISPATCH_GUARD=1

# Set to '1' or 'true' to allow stdio-transport MCP servers to be SPAWNED as child processes from workspace file-mcp plugin configs (packages/agent file-mcp.ts). Spawning is OFF by default because a workspace-scoped config could otherwise execute arbitrary commands on the API host — enable only for a trusted local/CLI runtime, never on shared server deployments. HTTP MCP transports are unaffected and always processed.  [not-in-schema, optional]
OXAGEN_ALLOW_STDIO_MCP=

# Set to '1' to default `oxagen solve` (best-of-N) candidates to the full evaluate→enhance→route→execute→judge→revise pipeline instead of the bare engine loop, when the `--pipeline` flag isn't passed explicitly. Lets a caller (e.g. the bench adapter's differentiated config) opt every `solve` invocation into the pricier, more thorough pipeline mode without passing the flag on every call. Neither the flag nor this var set ⇒ bare mode, the cheaper default.  [not-in-schema, optional]
OXAGEN_BEST_OF_N_PIPELINE=

# Set to '1' to default `oxagen solve` (best-of-N) candidates to auto-verify: union and re-run the test/lint/build commands any candidate ran, across every surviving candidate's worktree, before selection — when the `--verify-auto` flag isn't passed explicitly. Mirrors OXAGEN_BEST_OF_N_PIPELINE's precedence (flag wins, then env, neither ⇒ off) so the bench adapter's differentiated config can turn it on without passing the flag on every call.  [not-in-schema, optional]
OXAGEN_BEST_OF_N_VERIFY=

# Set to 'fork' or 'independent' to select best-of-N mode. Fork mode snapshots the trunk conversation at the diagnosis point and runs cache-forked tails per hypothesis, reusing the trunk's investigation at ~10× input discount via prompt caching. Independent mode runs N complete independent pipelines. Default is 'independent'.  [not-in-schema, optional]
OXAGEN_BEST_OF_N_MODE=independent

# Set to '1' (or pass `--local`) to force local BYOK mode even when logged in: the CLI runs the coordinator + workers with your own key — AI_GATEWAY_API_KEY (gateway-direct, any vendor; preferred) or ANTHROPIC_API_KEY (Anthropic API direct, Anthropic models only) — instead of routing through your Oxagen account. When not logged in, BYOK is used automatically if either key is present, so this flag is only needed to override an existing login.  [not-in-schema, optional]
OXAGEN_LOCAL=

# Path to the append-only JSON-lines commit ledger that records every agent commit so work is never lost even if a branch is force-moved or a worktree removed. Defaults to ~/.oxagen/commit-ledger.jsonl.  [not-in-schema, optional]
OXAGEN_COMMIT_LEDGER=~/.oxagen/commit-ledger.jsonl

# Force the agent system-prompt profile: 'interactive' (narrates for a live watcher) or 'headless' (strips narration, adds a verification protocol for autonomous/one-shot/SWE-bench runs). Unset ⇒ auto (headless when stdout is not a TTY, interactive otherwise).  [not-in-schema, optional]
OXAGEN_PROMPT_PROFILE=headless

# Wall-clock budget (ms) for the ENHANCE stage's code-graph pass. On a cold store the first graph query triggers a full tree-sitter build (minutes on a large repo), so headless one-shot bounds it to 15s by default; whatever resolved in budget is injected and the build keeps warming in the background. Set explicitly to override; 0 disables the bound. Unset ⇒ 15000 headless, unbounded interactive.  [not-in-schema, optional]
OXAGEN_ENHANCE_TIMEOUT_MS=15000

# Turn inactivity guard window (ms, default 300000). NOT a turn time cap: aborts a turn only when no model/tool progress lands within the window; any completed call, stream delta, or executing tool resets/defers it. For long CI waits prefer the built-in pre-abort CI probe (OXAGEN_CI_WAIT_CAP_MS) over raising this — a large window blinds the hang backstop. Non-finite or <=0 values are ignored.  [not-in-schema, optional]
OXAGEN_TURN_INACTIVITY_MS=300000

# Cap (ms, default 7200000 = 2h) on how long the turn inactivity guard may keep extending for a confirmed CI wait: before aborting, a turn that ran a CI-watch tool (gh run watch / gh pr checks…) makes one call-out, and still-pending checks extend the window until this cumulative cap. Green/failed/no-PR/probe-error never extends.  [not-in-schema, optional]
OXAGEN_CI_WAIT_CAP_MS=7200000

# Comma-separated gateway model slugs to use as a CROSS-VENDOR completeness judge panel instead of a single judge (majority rules, findings unioned). Higher cost, higher recall on incomplete work. Unset ⇒ single judge.  [not-in-schema, optional]
OXAGEN_JUDGE_PANEL=openai/gpt-5,google/gemini-2.5-pro

# Step count at which the mid-session completeness judge fires during a headless one-shot run. After this many tool-call steps in round 0, the pipeline pauses, runs judgeCompleteness, and injects any findings as a phase-B instruction before continuing — catching incomplete acceptance criteria (e.g. missing test cases) early rather than only at the end. 0 or unset disables the mid-session check. Default in headless mode: 20. Only for headless/benchmark runs.  [not-in-schema, optional]
OXAGEN_MID_JUDGE_STEPS=20

# Max judge→revise rounds the turn pipeline runs before giving up on an incomplete verdict. 0 disables auto-revision entirely. Unset ⇒ 1. Only affects the full (non-bare) pipeline — bare execution (best-of-N's default) has no judge/revise loop.  [not-in-schema, optional]
OXAGEN_MAX_REVISE_ROUNDS=2

# Mutation gate (layer 1) kill switch. ON by default: after a judged-complete round, the pipeline reverts the fix in a shadow (test files stay put), re-runs the agent's own passing test command, and demands a failure — a test that still passes without the fix witnesses nothing, and the verdict is overridden into a revise round. Set 0/false to disable. The RunTurnOptions.mutationVerify option wins over this var.  [not-in-schema, optional]
OXAGEN_MUTATION_VERIFY=1

# Mutation gate layer 2 (opt-in): when the witness check passes, apply deterministic one-line mutants to the fix's added lines and measure the kill rate (each mutant costs one witness-command run). Reported on the trace as mutationGates[].score.  [not-in-schema, optional]
OXAGEN_MUTATION_SCORE=1

# Per-command timeout (ms) for the mutation gate's witness re-runs in the fix-reverted shadow. Unset ⇒ 180000. A timed-out witness run counts as a failure (the shadow behaves differently without the fix), which still proves the tests witness the fix.  [not-in-schema, optional]
OXAGEN_MUTATION_TIMEOUT_MS=180000

# Perf #10: minimum judge confidence (0-100) an 'incomplete' verdict must carry before the pipeline spends a full execute+judge round revising it. A low-confidence incomplete call is a coin-flip that leans complete, so revising it doubles turn cost for marginal expected gain — confident-incomplete verdicts still revise. Default 40; 0 restores always-revise.  [not-in-schema, optional]
OXAGEN_REVISE_MIN_CONFIDENCE=40

# Complexity ceiling (0-100) under which pickTieredAdvisor substitutes a cheap 'fast' tier model as the completeness judge instead of the executor's own model, provided the diff also stays under OXAGEN_DIFF_BUDGET. An explicit OXAGEN_LLM_ADVISOR always wins. A non-positive value opts out entirely. Default 35.  [not-in-schema, optional]
OXAGEN_JUDGE_FAST_COMPLEXITY_MAX=35

# Enable the spec-first oracle gate (F2): at mid-session judge point, if no failing test repro has been executed, inject a corrective instruction instead of generic completeness judgment. Enforces test-before-patch discipline. 0 or unset disables. Only for headless/benchmark runs.  [optional]
OXAGEN_SPEC_GATE=1

# Deterministic judge-skip / adaptive compute ladder (ADR-021 §1). ON BY DEFAULT: the frontier completeness judge is skipped when executed evidence already settles the outcome (oracle flipped + touched tests green + diff within budget, or a read-only turn with no diff). Set to 0/false to OPT OUT and force the judge to run every round.  [optional]
OXAGEN_LADDER=0

# Line-count threshold (default 120) for the fast-path terminal condition in the adaptive ladder (F3). When oracle is 'flipped' and touched-file tests pass, if diff lines ≤ budget, skip judge and submit. Only applies while judge-skip is enabled (the default; opt out via OXAGEN_LADDER=0).  [optional]
OXAGEN_DIFF_BUDGET=120

# Hard cap on ladder rung (0–3) in the adaptive compute controller (F3). Prevents escalation beyond the specified rung even when signals suggest higher. Default 3 (no cap). 0–3 only; invalid values silently use default. Only applies while judge-skip is enabled (the default; opt out via OXAGEN_LADDER=0).  [optional]
OXAGEN_LADDER_MAX_RUNG=3

# Enable F1 deterministic zero-token localization: parse tracebacks and extract symbols from the issue to rank candidate files before the first LLM call. Default on (runs unless explicitly set to '0'). Unset or '1' enables, '0' disables.  [not-in-schema, optional]
OXAGEN_LOCALIZE=

# Enable F8 per-repo procedural priors: inject cached layout, conventions, and accrued pitfalls learned from prior instances. Requires both repo and priorsDir options to be set in the caller. Default off. Unset or '0' disables, '1' enables.  [not-in-schema, optional]
OXAGEN_REPO_PRIORS=1

# Enable F9 memory-recall applicability filter: drop recalled items with zero lexical overlap with the issue and candidate files, then optionally score survivors for semantic relevance. Reduces noise in injected memory. Default off. Unset or '0' disables, '1' enables.  [not-in-schema, optional]
OXAGEN_RECALL_FILTER=1

# Overrides the fleet store root (default `~/.oxagen/fleet`) that backs `oxagen fleet` session tracking (ADR-023). Used by tests and sandboxes to isolate the fleet store from a developer's real `~/.oxagen` directory; never set in deployed environments.  [not-in-schema, optional]
OXAGEN_FLEET_DIR=

# Toggles the ADR-028 time-travel sidecar record (`record/record.ndjson` + blob store) written by every `oxagen fleet` session. Recording is default-ON; set to `0` or `off` to disable. CLI-local only; never set in deployed environments.  [not-in-schema, optional]
OXAGEN_FLEET_RECORD=off

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Credential encryption backend for ingestion: 'env' (AES-256-GCM via INGESTION_ENCRYPTION_KEY) or 'kms' (AWS KMS).  [optional]
INGESTION_CRYPTO_PROVIDER=env

# Base64-encoded 32-byte master key for AES-256-GCM credential encryption (INGESTION_CRYPTO_PROVIDER=env).  [secret, required:preview/production]
INGESTION_ENCRYPTION_KEY=

# AWS KMS key ARN for credential encryption (INGESTION_CRYPTO_PROVIDER=kms).  [optional]
AWS_KMS_INGESTION_KEY_ARN=

# ── Billing ───────────────────────────────────────────────────────────────────
# Base64-encoded 32-byte master key for AES-256-GCM encryption of per-org reseller Stripe keys (reseller revenue). Optional: falls back to INGESTION_ENCRYPTION_KEY when unset.  [secret, optional]
BILLING_ENCRYPTION_KEY=

# ── Ingestion ─────────────────────────────────────────────────────────────────
# When '1', route GitHub feature inference through the Anthropic Message Batches API (async, half price) instead of per-file synchronous calls. Unset/absent = synchronous per-file (default).  [optional]
INGESTION_FEATURE_BATCH=

# ── Privacy ───────────────────────────────────────────────────────────────────
# Grace period in days before a hard-delete erasure job runs (GDPR Art.17). Set to 0 for immediate erasure in test envs.  [optional]
PRIVACY_ERASURE_GRACE_DAYS=0
