# Oxagen environment contract — GENERATED from packages/config/src/registry.ts.
# Do not edit by hand: run `pnpm env:check --write` to regenerate.
# Copy to .env.local (gitignored) and fill values. NOTE markers flag vars not
# yet validated by baseEnvSchema (tracked in Linear).

# ── Node ──────────────────────────────────────────────────────────────────────
# Runtime mode. Vercel/Next set this automatically per deploy.  [optional]
NODE_ENV=development

# ── Postgres ──────────────────────────────────────────────────────────────────
# Neon Postgres connection string. Prod = live branch; preview/dev = dev branch.  [secret, required:development/preview/production]
DATABASE_URL=postgres://oxagen:oxagen@localhost:5433/oxagen

# ── ClickHouse ────────────────────────────────────────────────────────────────
# ClickHouse HTTPS endpoint.  [required:development/preview/production]
CLICKHOUSE_URL=http://localhost:8123

# ClickHouse user.  [required:development/preview/production]
CLICKHOUSE_USERNAME=default

# ClickHouse password (empty for local Docker).  [secret, optional]
CLICKHOUSE_PASSWORD=

# ClickHouse database name.  [optional]
CLICKHOUSE_DATABASE=oxagen

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Neo4j bolt(+s) URI.  [required:development/preview/production]
NEO4J_URI=bolt://localhost:7687

# Neo4j user.  [required:development/preview/production]
NEO4J_USERNAME=neo4j

# Neo4j password.  [secret, required:development/preview/production]
NEO4J_PASSWORD=

# Neo4j database.  [optional]
NEO4J_DATABASE=neo4j

# Graph provisioner for paid organisations (ADR-098): pooled (Community, dev, CI), cypher (self-managed Enterprise: CREATE DATABASE org-<namespace>), aura (not implemented; refused).  [optional]
NEO4J_ORG_PROVISIONER=pooled

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# OTLP HTTP collector URL (e.g. https://otel.example.com/v1/traces). When unset the SDK does not start and all spans are no-ops — safe for all envs. Rollback = leave unset.  [optional]
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com/v1/traces

# Standard OTEL comma-separated `key=value` header list sent to the collector (e.g. "authorization=Bearer xxx,x-tenant=oxagen"). Optional — for collectors that require auth headers. Parsed by packages/telemetry/src/tracer.ts.  [secret, optional]
OTEL_EXPORTER_OTLP_HEADERS=

# Service name tag on OTEL span resources (default: oxagen). Optional — leave unset to use the default.  [optional]
OTEL_SERVICE_NAME=oxagen

# ── Circuit breaker ───────────────────────────────────────────────────────────
# Consecutive failures before a breaker opens for a wrapped dependency call (Neo4j / Stripe / ClickHouse). Optional — defaults to 5 in packages/config/src/env.ts.  [optional]
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Milliseconds an open breaker waits before allowing a trial (half-open) request. Optional — defaults to 30000 in packages/config/src/env.ts.  [optional]
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# ── MCP ───────────────────────────────────────────────────────────────────────
# Per-request timeout (ms) for the app MCP OAuth authorize/callback flows when the MCP SDK fetches a third-party authorization server well-known / token endpoints. Bounds a hung server so it cannot stall the serverless function. Optional — defaults to 10000 in lib/mcp-oauth/safe-fetch.ts.  [optional]
MCP_OAUTH_FETCH_TIMEOUT_MS=10000

# ── Circuit breaker ───────────────────────────────────────────────────────────
# Consecutive successes required in the half-open state before a breaker closes. Optional — defaults to 1 in packages/config/src/env.ts.  [optional]
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=1

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max chat send/stream requests per minute per workspace (fallback: per org, then per IP) on /v1/**/chat/*. Optional — defaults to 60 in packages/config/src/env.ts.  [optional]
RATE_LIMIT_CHAT_PER_MIN=60

# Comma-separated CIDRs or addresses of the proxies in front of apps/api. With the edge header (TRUST_EDGE_CLIENT_IP_HEADER) this is how a client address is attributed: the walk goes right through x-forwarded-for while each entry is a named proxy and stops at the first that is not, so a caller padding the header cannot move the result. NAME THE PROXIES' OWN SUBNETS, never an RFC1918 supernet like 10.0.0.0/8: a list wide enough to contain a caller makes the walk skip that caller as though it were a proxy and return an entry further left, which is one the caller wrote — the exact bypass this form exists to close. Once set it decides alone, and it returns nothing when no named proxy vouched for an entry, so it does not belong in a deployment whose edge rewrites x-forwarded-for to a single client address (ADR-083). Unset, no client address is derived at all, and the two things that read one both fail safe — the IAM ip_ranges / ip_allow conditions deny, and the pre-authentication IP ceilings on the Tacho and Stella machine routes skip rather than pooling every caller into one bucket. Empty by default, which means those IP controls are OFF and say so in the log.  [optional]
TRUSTED_PROXY_CIDRS=10.60.0.0/20,10.60.16.0/20

# Whether the x-oxagen-client-ip header written by the edge is believed. Optional — defaults to false. Set to "true" only AFTER the Caddy config that SETS that header (infra/tools/caddy/Caddyfile.alb) is uploaded and reloaded; until then the old config forwards a caller-supplied copy of it unchanged and the value would be attacker-controlled (ADR-083). Once that config is live it is what attributes the caller, because the same config rewrites x-forwarded-for to a single client address and leaves no proxy entry for TRUSTED_PROXY_CIDRS to vouch with.  [optional]
TRUST_EDGE_CLIENT_IP_HEADER=false

# ── Error alerting ────────────────────────────────────────────────────────────
# When set, high-severity/unhandled server errors are POSTed as a Slack-compatible `{ text, blocks }` JSON payload here (Slack/Mattermost/Discord incoming webhook, or any compatible endpoint). BYO webhook — no vendor SDK. When unset, errors are still recorded to the ClickHouse error_events table; only the webhook alert is skipped.  [secret, optional]
ALERT_WEBHOOK_URL=

# ── Better Auth ───────────────────────────────────────────────────────────────
# Session/cookie signing secret (≥32 chars). Minted once per env and applied identically to api + app so sessions validate across both.  [secret, required:development/preview/production]
BETTER_AUTH_SECRET=

# Auth base URL (the app origin).  [required:development/preview/production]
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated origins allowed cross-origin access to the auth API.  [optional]
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Base64 256-bit KEK that wraps OAuth token encryption keys. Required in preview+production (enforced by the auth startup guard); blank locally disables it. Generate with `openssl rand -base64 32`.  [secret, required:preview/production]
AUTH_TOKEN_ENCRYPTION_KEY=

# Canonical production origin the shared social-login OAuth app's callback is registered against (OAuth Proxy productionURL). Preview deployments relay social login through this origin. Defaults to the production app URL when unset.  [optional]
OAUTH_PROXY_PRODUCTION_URL=https://app.oxagen.sh

# Dedicated secret the OAuth Proxy uses to encrypt/decrypt the relay payload between production and preview deployments. MUST be set to the SAME value in production AND preview for preview social login to work (production alone only passes through). Kept separate from BETTER_AUTH_SECRET to limit blast radius. Generate with `openssl rand -base64 32`.  [secret, optional]
OAUTH_PROXY_SECRET=

# ── OAuth providers ───────────────────────────────────────────────────────────
# Google LOGIN OAuth client id (social sign-in; minimal scopes). Checklist: docs/specs/social-login-oauth-apps.md.  [required:preview/production]
GOOGLE_LOGIN_CLIENT_ID=

# Google LOGIN OAuth client secret. Checklist: docs/specs/social-login-oauth-apps.md.  [secret, required:preview/production]
GOOGLE_LOGIN_CLIENT_SECRET=

# Google DATA OAuth client id (Workspace data scopes; future connection).  [optional]
GOOGLE_DATA_CLIENT_ID=

# Google DATA OAuth client secret.  [secret, optional]
GOOGLE_DATA_CLIENT_SECRET=

# GitHub LOGIN OAuth App client id (social sign-in; minimal scopes). Not the GitHub App. Checklist: docs/specs/social-login-oauth-apps.md.  [required:preview/production]
GITHUB_LOGIN_CLIENT_ID=

# GitHub LOGIN OAuth App client secret. Checklist: docs/specs/social-login-oauth-apps.md.  [secret, required:preview/production]
GITHUB_LOGIN_CLIENT_SECRET=

# Pre-registered OAuth clients for MCP authorization servers that do NOT support RFC 7591 dynamic client registration (GitHub MCP, notably). JSON object mapping the MCP server's endpoint HOST to the client registered with that provider, e.g. {"api.githubcopilot.com":{"client_id":"…","client_secret":"…"}}. Each provider app must list <app-origin>/api/v1/mcp/oauth/callback as its callback URL. When a host is absent the flow falls back to dynamic client registration as before.  [secret, optional]
MCP_OAUTH_PREREGISTERED_CLIENTS=

# ── github ────────────────────────────────────────────────────────────────────
# GitHub App OAuth client id — used for the data-connector OAuth flow. Also read in-process by apps/app's Workspace settings dialog and by apps/mcp's get_main_repository tool (envGithubUrls in packages/handlers/src/repository.main.get.ts, invoked through the kernel's invoke() rather than an HTTP call), so it must reach both of those services too, not only the callback route in api.  [optional]
GITHUB_APP_CLIENT_ID=

# GitHub App OAuth client secret — what the public callback in api exchanges the returned code with. envGithubUrls (see GITHUB_APP_CLIENT_ID) also checks this is set in app and mcp, before publishing a Connect URL that api's callback could not finish without it.  [secret, optional]
GITHUB_APP_CLIENT_SECRET=

# GitHub App webhook signing secret — validates inbound webhook payloads.  [secret, optional]
GITHUB_APP_WEBHOOK_SECRET=

# Webhook signing secret for the SECOND GitHub App (oxagen-sh, app id 4055615), which delivers to the same /webhooks/github/app endpoint as oxagen-code-agent. Optional: unset means that App's deliveries are rejected.  [secret, optional]
GITHUB_WEBHOOK_SECRET=

# HMAC secret used to sign the OAuth state parameter for GitHub App installs. Signed and verified by api's callback, and also signed by envGithubUrls (see GITHUB_APP_CLIENT_ID) minting the same URLs in-process from app and mcp.  [secret, optional]
GITHUB_APP_INSTALL_STATE_SECRET=

# GitHub App public slug (the path segment in https://github.com/apps/<slug>). Used to deep-link users to GitHub's install/configure page so they can add or remove orgs and repos. Optional — when unset the connection dialog derives the slug from an existing installation. Also minted by envGithubUrls (see GITHUB_APP_CLIENT_ID) in-process from app and mcp.  [optional]
GITHUB_APP_SLUG=

# GitHub App numeric ID. Required (with GITHUB_APP_PRIVATE_KEY) for the installation-token path in resolveGitHubToken(). Find it on the GitHub App settings page. Also required in-process by app: repository.main.bind.ts and repository.installation.list.ts mint installation tokens directly when invoked from the Workspace settings dialog, not only from api/mcp.  [optional]
GITHUB_APP_ID=

# PEM-encoded RSA private key for the GitHub App. Required (with GITHUB_APP_ID) for the installation-token path in resolveGitHubToken(). Generate in the GitHub App settings → Private keys. Also required in-process by app — see GITHUB_APP_ID.  [secret, optional]
GITHUB_APP_PRIVATE_KEY=

# Personal access token (PAT) used by GitHub write capabilities (repo.create, repo.file.put, repo.fork, repo.branch.create, repo.pr.open) as a LOCAL/DEMO-ONLY fallback. Per-workspace credential resolution is now live (GitHub App installation token + KMS-encrypted per-workspace OAuth — see resolveGitHubToken in packages/handlers/src/lib/github-token.ts), so this MUST NOT be set in production: a shared PAT bypasses per-workspace scoping. resolveGitHubToken logs a loud warning when it is used while NODE_ENV=production.  [secret, optional]
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Slack DATA OAuth client id for token refresh (ingestion cron). Token rotation must be enabled in the Slack app.  [optional]
SLACK_DATA_CLIENT_ID=

# Slack DATA OAuth client secret for token refresh (ingestion cron).  [secret, optional]
SLACK_DATA_CLIENT_SECRET=

# Zoom DATA OAuth client id for token refresh (ingestion cron). Zoom rotates the refresh token on each use.  [optional]
ZOOM_DATA_CLIENT_ID=

# Zoom DATA OAuth client secret for token refresh (ingestion cron).  [secret, optional]
ZOOM_DATA_CLIENT_SECRET=

# Salesforce DATA OAuth client id for token refresh (ingestion cron).  [optional]
SALESFORCE_DATA_CLIENT_ID=

# Salesforce DATA OAuth client secret for token refresh (ingestion cron).  [secret, optional]
SALESFORCE_DATA_CLIENT_SECRET=

# Microsoft DATA OAuth client id for token refresh (ingestion cron; MS Graph offline_access).  [optional]
MICROSOFT_DATA_CLIENT_ID=

# Microsoft DATA OAuth client secret for token refresh (ingestion cron).  [secret, optional]
MICROSOFT_DATA_CLIENT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Stripe secret key. Every environment, production included, binds to the shared Stripe sandbox (sk_test_) until the maintainer cuts production over to live keys; see docs/ops/stripe-sandbox-mode.md.  [secret, required:development/preview/production]
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe publishable key. Every environment, production included, is the sandbox's pk_test_ key until the production cutover. Provisioning-only: no service reads it. The browser reads the NEXT_PUBLIC_ prefixed name, and env-manager pulls this one from the secret store so the two stay in step.  [optional]
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe webhook signing secret (whsec_) of the endpoint registered on the shared sandbox for this environment's API URL; production's is the sandbox endpoint for https://api.oxagen.sh/webhooks/stripe until the cutover.  [secret, required:development/preview/production]
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Browser-exposed Stripe publishable key for Stripe.js init. Inlined into the app bundle at build, so a rotation needs a rebuild. Sandbox pk_test_ in every environment until the production cutover.  [optional]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# When 'true', enables Stripe Tax automatic_tax on all checkout sessions. Ships dark; flip on only after Stripe Tax is registered/active in the dashboard.  [optional]
STRIPE_TAX_ENABLED=false

# ── Billing ───────────────────────────────────────────────────────────────────
# Target blended gross margin in (0,1). Drives the usage-meter markup; keep in sync with Stripe via `pnpm billing:stripe-sync --apply`.  [required:development/preview/production]
OXAGEN_TARGET_MARGIN=0.65

# Optional pinned solved meter markup (≥1). Leave unset to derive from OXAGEN_TARGET_MARGIN + the code config.  [optional]
OXAGEN_METER_MARKUP=

# Usage volume discount: percent off per OXAGEN_USAGE_DISCOUNT_INCREMENT dollars of usage credits purchased (e.g. 3 = 3% per increment ⇒ 15% at the $250 ceiling).  [required:development/preview/production]
OXAGEN_USAGE_DISCOUNT_PERCENT=3

# Usage volume discount: dollar increment that earns one OXAGEN_USAGE_DISCOUNT_PERCENT step (e.g. 50 = a discount step every $50 purchased).  [required:development/preview/production]
OXAGEN_USAGE_DISCOUNT_INCREMENT=50

# Usage volume discount: purchase amount (USD) at which the discount caps; above this it stays flat at the max. 3% per $50 up to $250 ⇒ 15% max.  [required:development/preview/production]
OXAGEN_USAGE_DISCOUNT_CEILING_USD=250

# Negotiated model rates as inline JSON, in USD per one million tokens: {"claude-sonnet-5":{"inputPer1M":2.40,"outputPer1M":12.00,"cachedInputPer1M":0.24,"cacheWrite5mPer1M":3.00}}. Leave unset unless you have negotiated rates with a model provider.  [not-in-schema, secret, optional]
OXAGEN_PRICE_OVERRIDES=

# Path to a JSON file of negotiated model rates, same shape as OXAGEN_PRICE_OVERRIDES. Wins over the inline value when both are set, so a mounted secret does not need the variable cleared.  [not-in-schema, optional]
OXAGEN_PRICE_OVERRIDES_FILE=

# ── Inngest ───────────────────────────────────────────────────────────────────
# Inngest event key. Required in preview+production.  [secret, required:preview/production]
INNGEST_EVENT_KEY=

# Inngest signing key. Required in preview+production.  [secret, required:preview/production]
INNGEST_SIGNING_KEY=

# HMAC secret this deployment signs Stella enterprise-telemetry enrollments with (create_stella_enrollment). A managed Stella install verifies the signature against its own copy of the same secret, named by the enrollment document's verification_secret_env — the two are distributed out of band. Unset means the capability refuses to mint rather than issuing an enrollment no install could verify.  [not-in-schema, secret, optional]
STELLA_ENROLLMENT_SIGNING_SECRET=

# Comma-separated HTTPS ingest endpoints this deployment serves for Stella operational telemetry. create_stella_enrollment refuses to sign an enrollment pointing anywhere else, so an operator cannot mint a valid document aiming a fleet of installs at a third party. Defaults to the public endpoint; plaintext entries are dropped.  [optional]
STELLA_TELEMETRY_INGEST_ENDPOINTS=https://api.oxagen.sh/v1/telemetry/stella/operational

# HMAC secret this deployment signs Tacho host enrollments with (create_tacho_enrollment). The collector on an enrolled host verifies the enrollment document against its own copy of the same secret, named by the document's verification_secret_env; the two are distributed out of band. Unset means the capability refuses to enrol a host.  [not-in-schema, secret, optional]
TACHO_ENROLLMENT_SIGNING_SECRET=

# Ed25519 private key (PKCS#8 PEM, newlines as \n) this deployment signs Tacho policy bundles with (get_tacho_bundle) and attests run exports with (export_run, ADR-058). The matching public key travels to each host at enrollment so tacho-hook verifies a cached bundle offline and fails closed on one it cannot verify, and into every export bundle so its verifier runs offline. Unset means enrollment, bundle and export refuse.  [not-in-schema, secret, optional]
TACHO_BUNDLE_SIGNING_PRIVATE_KEY=

# Comma-separated HTTPS base URLs of this deployment's Tacho machine endpoints (the /v1/tacho prefix). create_tacho_enrollment refuses to sign an enrollment pointing anywhere else, so an operator cannot aim a fleet of hosts at a third party. Defaults to the public endpoint; plaintext entries are dropped.  [not-in-schema, optional]
TACHO_INGEST_ENDPOINTS=https://api.oxagen.sh/v1/tacho

# The per-install bearer the Tacho collector's loopback listener requires. Written into each wrapped harness's settings and into a connected app's MCP config by `tacho enroll`, and read back by the hook and the `tacho mcp-stdio` shim. Never set by hand and never a deployment value: it is minted per machine at enrollment and lives in host.json.  [not-in-schema, secret, optional]
TACHO_LOCAL_TOKEN=

# Overrides where the Tacho host writes Cursor's `hooks.json` and `mcp.json`. Read on the operator's machine, not the server, and never a deployment value: it exists because Cursor can be installed against a non-default config directory, and enrolling the wrong one leaves the session unwrapped and silently unrecorded.  [not-in-schema, optional]
CURSOR_CONFIG_DIR=

# The XDG base directory the Tacho host falls back to when locating Cursor's config on Linux, after CURSOR_CONFIG_DIR and before ~/.cursor. Set by the operator's own environment rather than by Oxagen, and ignored on macOS and Windows, which do not follow the XDG layout.  [not-in-schema, optional]
XDG_CONFIG_HOME=

# Overrides the workspace MCP endpoint the Tacho collector's local gateway proxies to (ADR-078). Read on the host, not the server: it is how a local stack points the gateway at 127.0.0.1:4100 instead of the deployment's MCP host. Unset, the gateway uses the endpoints.mcp claim from the enrollment, then derives one from api_url.  [not-in-schema, optional]
TACHO_MCP_ENDPOINT=http://127.0.0.1:4100/mcp

# ── Context provider ──────────────────────────────────────────────────────────
# The organisation whose memory @oxagen/context-provider serves. Required, with no default: the Context Graph Protocol carries no tenant, so one process serves one workspace and which one is a deployment decision. A process started without it refuses rather than guessing.  [not-in-schema, optional]
OXAGEN_CONTEXT_ORG=acme

# The workspace whose memory @oxagen/context-provider serves. Required, with no default, for the reason OXAGEN_CONTEXT_ORG is.  [not-in-schema, optional]
OXAGEN_CONTEXT_WORKSPACE=platform

# The engram DuckDB file @oxagen/context-provider reads. Unset means an in-memory store, so every query answers with nothing — the right answer for a misconfigured process, rather than someone else's memory. DuckDB opens a file as a single writer, so the process that writes this database and the process that serves it must be different.  [not-in-schema, optional]
ENGRAM_DUCKDB_PATH=/var/lib/oxagen/engram.duckdb

# ── File storage ──────────────────────────────────────────────────────────────
# Vercel Blob read/write token. Authenticates @oxagen/storage (avatar/image uploads). Swap-point for S3/R2.  [secret, optional]
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Selects the @oxagen/storage backend: 'vercel-blob' (default, prod) or 'fs' (local/CI filesystem driver, no token needed). The swap-point for an S3/R2 driver.  [optional]
STORAGE_DRIVER=vercel-blob

# Root directory for the 'fs' storage driver. Only read when STORAGE_DRIVER=fs. Absolute path used as-is; a relative path is anchored at process.cwd(); unset falls back to an OS-tmp directory.  [optional]
STORAGE_FS_ROOT=

# ── AI providers ──────────────────────────────────────────────────────────────
# Vercel AI Gateway token — the platform's default AI auth. @oxagen/ai routes image, embeddings and video through the gateway always, and text too unless OXAGEN_MODEL_PROVIDER opts that deployment out, so this is required wherever AI runs.  [secret, required:preview/production]
AI_GATEWAY_API_KEY=

# Which provider serves language models: the gateway (default, and the metered path) or 'openrouter' for a deployment that cannot reach the gateway. Never an automatic fallback — an operator opts out explicitly, because a silent failover would move spend to another vendor's bill and skip metering. Image, video and embeddings stay on the gateway either way. The per-organisation keys ADR-131 mints are OpenRouter keys, so they are minted and consulted only when this is 'openrouter' (ADR-131 §9).  [optional]
OXAGEN_MODEL_PROVIDER=gateway

# OpenRouter token for language models. Read only when OXAGEN_MODEL_PROVIDER=openrouter; every other deployment stays valid without it.  [secret, optional]
OPENROUTER_API_KEY=

# OpenRouter provisioning key, not an inference key (ADR-131). Mints one capped token per organisation so the vendor reports usage per customer. It can create, read, disable and delete every key in the account, so it is read in one module and never reaches a provider client or a log. Unset means no key is minted and every organisation serves on the shared key. Read only when OXAGEN_MODEL_PROVIDER=openrouter: a minted key cannot serve on a gateway deployment, so none is minted there (ADR-131 §9).  [secret, optional]
OPENROUTER_MANAGEMENT_KEY=

# Daily USD ceiling on each organisation's minted OpenRouter key. A blast radius, not a budget: the credit gate bounds what a customer may spend, and this stops one runaway loop draining the account every other customer's assistant depends on. A key that hits it stops answering until midnight UTC, so set it well above a heavy legitimate day. Unset falls back to 25, which is the ceiling ADR-131 reasons about.  [optional]
OPENROUTER_ORG_KEY_DAILY_LIMIT_USD=25

# ── Agent engine ──────────────────────────────────────────────────────────────
# Where the Stella engine (stella-serve) listens. The in-app agent's turns run there; every model call and tool call comes back to this process to answer (ADR-053). Loopback on the node.  [required:production]
STELLA_SERVE_URL=http://127.0.0.1:4300

# Bearer token the Stella engine was started with. The same value the engine's own container reads under its prefix; without it the assistant reports the engine as unavailable.  [secret, required:production]
STELLA_SERVE_TOKEN=

# ── AI providers ──────────────────────────────────────────────────────────────
# CLI-only BYOK fallback: when no AI_GATEWAY_API_KEY exists anywhere, the CLI runs anthropic/* models directly against the Anthropic API with this key (other vendors and embeddings stay unavailable). The gateway key always wins when both are set. Never read by deployed services — platform AI is gateway-only.  [not-in-schema, secret, optional]
ANTHROPIC_API_KEY=

# Fast text tier ("Oxagen Fast") — the gateway model id @oxagen/ai resolves for the fast tier. The ask-page default.  [optional]
OXAGEN_LLM_FAST=anthropic/claude-haiku-4.5

# Balanced text tier ("Oxagen Balanced") — gateway model id for the balanced tier.  [optional]
OXAGEN_LLM_BALANCED=anthropic/claude-sonnet-5

# Precise text tier ("Oxagen Precise") — gateway model id for the precise tier.  [optional]
OXAGEN_LLM_PRECISE=anthropic/claude-fable-5

# ── Email ─────────────────────────────────────────────────────────────────────
# SMTP server host (Resend: smtp.resend.com).  [optional]
SMTP_HOST=smtp.resend.com

# SMTP port. 465 = implicit TLS; 587 = STARTTLS (TLS enforced).  [optional]
SMTP_PORT=587

# SMTP username (Resend: the literal "resend").  [optional]
SMTP_USERNAME=resend

# SMTP password — for Resend this is an API key (re_…).  [secret, optional]
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxx

# Default sender address. Its domain must be verified at the provider.  [optional]
SMTP_FROM_EMAIL=noreply@notifications.oxagen.sh

# Default sender display name.  [optional]
SMTP_FROM_NAME=Oxagen (DO NOT REPLY)

# ── CRM ───────────────────────────────────────────────────────────────────────
# Attio API access token. When set, apps/api upserts every lead captured by /v1/cms/leads into Attio as a person (and a company by email domain) with a note carrying the form details. Unset disables the sync; leads stay in cms.leads. Needs the record_permission:read-write, object_configuration:read and note:read-write scopes.  [secret, optional]
ATTIO_API_KEY=

# ── Linear ────────────────────────────────────────────────────────────────────
# Linear API key (tooling/provenance; not read by deployed apps).  [secret, optional]
LINEAR_API_KEY=

# Linear project id for the oxagen-v2 project (tooling-only).  [not-in-schema, optional]
LINEAR_PROJECT_ID=oxagen-v2-355ea6b2a3f7

# ── Public URLs ───────────────────────────────────────────────────────────────
# Public app origin (browser-exposed).  [required:development/preview/production]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public api origin (browser-exposed). The api and mcp read it too: the Inngest serve host, and the absolute download URL get_run_export mints.  [required:development/preview/production]
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side app origin used to build plugin OAuth authorize/callback URLs (falls back to NEXT_PUBLIC_APP_URL). Not browser-exposed.  [optional]
APP_URL=http://localhost:3000

# Public marketing website origin (oxagen.sh). The /v1/cms/* lead routes use it to build the emailed reader link and CORS allows it as a cross-origin caller. Not browser-exposed.  [optional]
MARKETING_URL=http://localhost:8080

# MCP server origin used to build install instructions and client connections.  [optional]
MCP_URL=http://localhost:4100

# Optional override for the docs site origin (browser-exposed). When unset, apps/app resolves the correct URL per environment automatically (dev → http://localhost:3300; prod → https://docs.oxagen.sh, per apps/app/src/lib/docs-url.ts). Set only to test a custom docs deployment. Validated as an optional URL by baseEnvSchema.  [optional]
NEXT_PUBLIC_DOCS_URL=

# chat_ux_v2 feature flag (apps/app chat UX overhaul, browser-exposed). "1" enables the new session-settings chat surface environment-wide; unset/anything else = off. A per-browser cookie override (?chat_ux_v2=1|0) wins over this default. Validated as an optional "0"|"1" enum by baseEnvSchema.  [optional]
NEXT_PUBLIC_CHAT_UX_V2=

# ── Security ──────────────────────────────────────────────────────────────────
# When true, Postgres RLS policies filter by org/workspace. Fail-closed: when UNSET it defaults ON in production (NODE_ENV/VERCEL_ENV=production) and OFF in dev/test/preview. A production process refuses to boot if this is forced to false (assertRlsEnforcedInProduction). Local dev override: set false in .env.local only if seeding/migration scripts need to bypass RLS; revert before running app code against the DB.  [optional]
TENANT_RLS_ENFORCEMENT_ENABLED=true

# ── Observability ─────────────────────────────────────────────────────────────
# Pino log level for service loggers.  [optional]
LOG_LEVEL=debug

# Feature flag — set "false" to disable the Neo4j knowledge-graph writes.  [optional]
KNOWLEDGE_GRAPH_ENABLED=true

# HTTP port for the xmcp server.  [optional]
MCP_PORT=

# ── Release / build metadata ──────────────────────────────────────────────────
# Platform version string surfaced by @oxagen/config platformVersion(). Written by `pnpm release:*` and synced to every oxagen-v2-* Vercel project. Declared in turbo.json globalEnv so a version change busts the build cache. LOCAL: leave unset → falls back to package.json version. PROD/PREVIEW: the released semver. NOTE: read via raw process.env in @oxagen/config — not yet in baseEnvSchema (tracked).  [not-in-schema, optional]
PLATFORM_VERSION=

# ── Testing / e2e ─────────────────────────────────────────────────────────────
# Base URL of the deprecated Playwright suite (apps/app_deprecated/playwright.config.ts, deleted with that app in WL-50). The rev1 harness (apps/app/playwright.config.ts) reads NEXT_PUBLIC_APP_URL and does not read this. NOTE: read via raw process.env — not in baseEnvSchema (test-only).  [not-in-schema, optional]
PLAYWRIGHT_BASE_URL=

# The exact string "true" on the e2e webServer (apps/app/playwright.config.ts) and the e2e seed (apps/app seed:e2e): packages/auth relaxes email verification, secure cookies and rate limiting on that value, off-Vercel only (local-env.ts). Declared in turbo.json test:e2e env. Not for dev/preview/prod. NOTE: read via raw process.env — not in baseEnvSchema (test-only).  [not-in-schema, optional]
E2E_TEST=

# Whether the e2e job resolved a Stripe test key: "1" when STRIPE_TEST_SECRET_KEY was mapped into STRIPE_SECRET_KEY, "0" on a fork pull request without one (pay.spec.ts skips). Set by the e2e webServer env (apps/app/playwright.config.ts) and the CI job (WL-48). NOTE: read via raw process.env — not in baseEnvSchema (test-only).  [not-in-schema, optional]
STRIPE_E2E=

# Set to "1" by tools/scripts/dev.ts for the local dev stack. Consumed by packages/auth to make local-env detection deterministic instead of racing NODE_ENV at module-load time. Ignored on real Vercel deployments (VERCEL=1 guards it). NOTE: read via raw process.env — not in baseEnvSchema (dev-tooling only).  [not-in-schema, optional]
OXAGEN_LOCAL_DEV=

# ── env-manager tooling ───────────────────────────────────────────────────────
# Vercel API token (admin) the env-manager uses to read/write project env vars.  [not-in-schema, secret, optional]
VERCEL_TOKEN=

# Vercel team id (defaults to the oxagen team).  [not-in-schema, optional]
VERCEL_TEAM_ID=

# Vercel team slug for `pnpm env:pull` --scope (e.g. "oxagen"). Optional — when unset, the CLI resolves the team from each project's linked .vercel/project.json.  [not-in-schema, optional]
VERCEL_TEAM_SLUG=oxagen

# Local port for the env-manager web UI.  [not-in-schema, optional]
ENV_MANAGER_PORT=7799

# ── Security ──────────────────────────────────────────────────────────────────
# HMAC-SHA256 secret for signing audit-log export tokens, so exported files can be verified as untampered. OPTIONAL: baseEnvSchema declares it `.optional()` and the audit export route falls back to BETTER_AUTH_SECRET when it is unset. Setting a dedicated value changes the signing key and invalidates outstanding export download URLs. Generate with `openssl rand -base64 32`.  [secret, optional]
AUDIT_EXPORT_SIGNING_SECRET=

# Extra hosts allowed to POST a Next server action to apps/app, comma-separated. Next rejects a server action whose Origin is not the deployment's own host, so a custom domain in front of the app has to be named here or every mutation 403s.  [not-in-schema, optional]
SERVER_ACTIONS_ALLOWED_ORIGINS=app.oxagen.sh

# ── CLI ───────────────────────────────────────────────────────────────────────
# Set to 1 or true to write the CLI's debug log to ~/.oxagen/logs (apps/cli/src/lib/debug-log.ts). Developer tooling, never set on a deployed service.  [not-in-schema, optional]
OXAGEN_CLI_DEBUG=

# Set to 0, off, false or no to suspend the steering-freshness gates (`oxagen steering gate`) for this shell only: no auto-sync and no refusal on stale steering. The escape hatch exists so a gate cannot wedge someone when a remote is unreachable, and it is deliberately environment-only so it cannot be committed and cannot outlive the shell that set it. Never set on a deployed service.  [not-in-schema, optional]
OXAGEN_STEERING_FRESHNESS=

# API token used by the CLI to authenticate requests; falls back to the value stored in ~/.oxagen/config.json.  [not-in-schema, secret, optional]
OXAGEN_API_TOKEN=

# Default org slug for CLI commands; falls back to the value stored in ~/.oxagen/config.json.  [not-in-schema, optional]
OXAGEN_ORG_ID=

# Default workspace slug for CLI commands; falls back to the value stored in ~/.oxagen/config.json.  [not-in-schema, optional]
OXAGEN_WORKSPACE_ID=

# Base URL for the Oxagen REST API, consumed by the CLI. Falls back to the default production API URL when unset.  [not-in-schema, optional]
OXAGEN_API_URL=http://localhost:4000

# Base URL for the Oxagen web app, where `oxagen login` opens the browser authorize page. Falls back to the default production app URL when unset.  [not-in-schema, optional]
OXAGEN_APP_URL=http://localhost:3000

# Cross-tool opt-out convention (https://consoledonottrack.com): set to '1' to disable CLI usage telemetry. Checked before OXAGEN_TELEMETRY and the persisted telemetry.enabled config.  [not-in-schema, optional]
DO_NOT_TRACK=1

# Set to '0' to disable CLI usage telemetry for this invocation (equivalent to `oxagen telemetry off`). DO_NOT_TRACK=1 also disables it and takes precedence.  [not-in-schema, optional]
OXAGEN_TELEMETRY=0

# When set, the CLI prints extra diagnostics (e.g. context-engine memory open failures) to stderr.  [not-in-schema, optional]
OXAGEN_DEBUG=

# Set to '1' or 'true' to allow stdio-transport MCP servers to be SPAWNED as child processes from workspace file-mcp plugin configs (packages/agent file-mcp.ts). Spawning is OFF by default because a workspace-scoped config could otherwise execute arbitrary commands on the API host — enable only for a trusted local/CLI runtime, never on shared server deployments. HTTP MCP transports are unaffected and always processed.  [not-in-schema, optional]
OXAGEN_ALLOW_STDIO_MCP=

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Credential encryption backend for ingestion: 'env' (AES-256-GCM via INGESTION_ENCRYPTION_KEY) or 'kms' (AWS KMS). Also read in-process by app and mcp: resolveGitHubToken's stored-OAuth-token path (packages/github/src/workspace-token.ts) decrypts through resolveIngestionCryptoAdapterForKeyId whenever repository.main.bind.ts or repository.installation.list.ts falls back off the installation-token path, and resolveWorkspaceGithubUserToken opens the stored token that backs the list_github_installations tool.  [optional]
INGESTION_CRYPTO_PROVIDER=env

# Base64-encoded 32-byte master key for AES-256-GCM credential encryption (INGESTION_CRYPTO_PROVIDER=env). Also required in-process by app and mcp — see INGESTION_CRYPTO_PROVIDER.  [secret, required:preview/production]
INGESTION_ENCRYPTION_KEY=

# AWS KMS key ARN for credential encryption (INGESTION_CRYPTO_PROVIDER=kms). Also required in-process by app and mcp — see INGESTION_CRYPTO_PROVIDER.  [optional]
AWS_KMS_INGESTION_KEY_ARN=

# ── Privacy ───────────────────────────────────────────────────────────────────
# Grace period in days before a hard-delete erasure job runs (GDPR Art.17). Set to 0 for immediate erasure in test envs.  [optional]
PRIVACY_ERASURE_GRACE_DAYS=0

# ── Operator scripts ──────────────────────────────────────────────────────────
# Set to 1 to include draft posts when building the static research blog (apps/web/scripts/build.mjs). Unset in every deploy, so drafts never ship.  [not-in-schema, optional]
BLOG_DRAFTS=1

# Port for the apps/web static dev server (apps/web/scripts/dev.mjs). Defaults to 5500; local convenience only, never read by a deploy.  [not-in-schema, optional]
WEB_PORT=5500

# Set to 1 to build apps/app or apps/docs with Next's standalone output. tools/scripts/package-for-node.sh sets it for the self-hosted node bundle; Vercel builds leave it unset and get the default output.  [not-in-schema, optional]
STANDALONE=1

# Container image the packaged node bundle's run manifest names. Defaults to node:24.21.0-alpine.  [not-in-schema, optional]
WRITE_MANIFEST_IMAGE=node:24.21.0-alpine

# npm automation token used to publish the CLI package. Unset skips the npm publish step of `pnpm release` rather than failing it.  [not-in-schema, secret, optional]
NPM_TOKEN=

# The desktop app's updater signing key (minisign; contents or a path). `pnpm dist:local` reads ~/.tauri/oxagen-desktop.key when this is unset; desktop.yml holds it as a secret. Unset builds carry no updater artifacts.  [not-in-schema, secret, optional]
TAURI_SIGNING_PRIVATE_KEY=

# Password of TAURI_SIGNING_PRIVATE_KEY. The key has none, so this is set to the empty string: an absent variable makes tauri prompt for one.  [not-in-schema, secret, optional]
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# The Developer ID tauri signs the macOS bundle with. `-` signs ad hoc, which `pnpm dist:local` and desktop.yml use when no Developer ID is configured.  [not-in-schema, optional]
APPLE_SIGNING_IDENTITY=-

# Base URL the published install.sh downloads CLI release archives from. Set it to install from a staging bucket instead of cli.oxagen.sh.  [not-in-schema, optional]
OXAGEN_INSTALL_BASE=https://cli.oxagen.sh/releases/latest

# Directory install.sh puts the oxagen binary in. Defaults to ~/.local/bin.  [not-in-schema, optional]
OXAGEN_INSTALL_DIR=$HOME/.local/bin

# Superuser Postgres connection used by provision-rls-role.ts to create the least-privilege app role. Kept separate from DATABASE_URL so the provisioning step cannot silently run through the restricted connection it is about to create.  [not-in-schema, secret, optional]
ADMIN_DATABASE_URL=

# Migration connection for Atlas's `prod` env (packages/database/atlas.hcl), read by db-migrate.yml and no other workflow. Holds a role that may run DDL against pre-existing schemas: the app role may only CREATE in schemas it owns, so migrating through DATABASE_URL fails 42501 on billing and friends.  [not-in-schema, secret, optional]
PRODUCTION_DATABASE_URL=

# Comma-separated stores `pnpm db:migrate` should migrate. Defaults to clickhouse,neo4j — Postgres is Atlas's job and is deliberately not in the list.  [not-in-schema, optional]
DB_MIGRATE_STORES=clickhouse,neo4j

# The ref `pnpm db:lint-migrations` compares new Atlas migrations against for its git-aware ordering check (#3387): a migration added since the merge base with this ref must sort after every migration already there. Defaults to origin/main.  [not-in-schema, optional]
DB_LINT_BASE_REF=origin/main

# The ref `pnpm db:lint-migrations` treats as the branch's own tip for its git-aware ordering check (#3387). CI's pull_request checkout puts HEAD on GitHub's synthetic merge commit, not the PR branch itself, which collapses the merge-base fail/warn distinction into one tier; the pipeline sets this to github.event.pull_request.head.sha to compare against the real PR head. Defaults to HEAD, which is correct everywhere else (a push checkout, a local branch).  [not-in-schema, optional]
DB_LINT_HEAD_REF=HEAD

# Superuser on the cluster tools/scripts/rds-sim-check.sh simulates RDS against. The script refuses to run without it.  [not-in-schema, optional]
PGSUPERUSER=

# Password for PGSUPERUSER.  [not-in-schema, secret, optional]
PGSUPERPASS=

# Production ClickHouse endpoint tools/scripts/backfill-claude-telemetry.ts writes backfilled session rows to.  [not-in-schema, optional]
PRODUCTION_ANALYTICS_URL=

# Username for PRODUCTION_ANALYTICS_URL.  [not-in-schema, optional]
PRODUCTION_ANALYTICS_USER=

# Password for PRODUCTION_ANALYTICS_USER.  [not-in-schema, secret, optional]
PRODUCTION_ANALYTICS_PASSWORD=

# Email stamped on rows the Claude telemetry backfill writes, so a backfilled session is attributable to whoever ran the script.  [not-in-schema, optional]
USER_EMAIL=

# Set to 1 to point the Inngest SDK at a local dev server instead of Inngest Cloud. tools/scripts/inngest-dev.ts sets it for every child turbo spawns.  [not-in-schema, optional]
INNGEST_DEV=1

# Google Cloud project the env-manager pulls Secret Manager secrets from. Defaults to oxagen-490023.  [not-in-schema, optional]
GCP_PROJECT=oxagen-490023

# Path to a local context-graph-protocol checkout. check-contextgraph-fixtures.ts verifies the vendored profile against it when set.  [not-in-schema, optional]
CONTEXT_GRAPH_PROTOCOL_DIR=

# How many recent commits on main check-main-verified.mjs asks about. Defaults to 10.  [not-in-schema, optional]
MAIN_VERIFIED_WINDOW=10

# How long after a commit lands check-main-verified.mjs refuses to conclude it has no run. The workflow races the registration of the run it looks for. Defaults to 10.  [not-in-schema, optional]
MAIN_VERIFIED_GRACE_MINUTES=10

# Upper bound on how long check-main-verified.mjs sleeps waiting the grace out before re-reading. Must stay below the workflow job's timeout-minutes. Defaults to 12.  [not-in-schema, optional]
MAIN_VERIFIED_MAX_WAIT_MINUTES=12

# GitHub owner whose repos the SCR corpus check reads. Defaults to macanderson.  [not-in-schema, optional]
SCR_OWNER=macanderson

# Path to the house brand kit checkout (oxagenai/oxagen-brand) sync-brand-assets.mjs copies marks and the branding skill from. Defaults to ../oxagen-brand.  [not-in-schema, optional]
OXAGEN_BRAND_KIT=

# Deprecated alias for OXAGEN_BRAND_KIT, accepted for one transition release.  [not-in-schema, optional]
OXAGEN_HOUSE_BRAND=

# Model the vision gate judges a diff with.  [not-in-schema, optional]
VISION_GATE_MODEL=

# Ref the vision gate diffs against. Defaults to origin/main.  [not-in-schema, optional]
VISION_GATE_BASE=origin/main

# Set to 1 to make a drifts verdict fail the vision gate instead of only printing it.  [not-in-schema, optional]
VISION_GATE_STRICT=1

# Ref the stale-merge-base check (#3237) treats as main's current tip. Defaults to origin/main.  [not-in-schema, optional]
STALE_MERGE_BASE_REF=origin/main

# Ref the stale-merge-base check (#3237) treats as the branch under review. Defaults to HEAD.  [not-in-schema, optional]
STALE_MERGE_BRANCH_REF=HEAD

# ── Infrastructure ────────────────────────────────────────────────────────────
# Name tag of the EC2 instance the infra/tools scripts target. Defaults to oxagen-app.  [not-in-schema, optional]
NODE_NAME=oxagen-app

# Name tag of the data-plane EC2 instance the DB-client tunnel scripts target. Defaults to oxagen-data.  [not-in-schema, optional]
DATA_NODE_NAME=oxagen-data

# Aurora writer endpoint for run-db-migrations.sh. Set it to skip the AWS lookup the script otherwise does.  [not-in-schema, optional]
AURORA_ENDPOINT=

# Port for AURORA_ENDPOINT. Defaults to 5432.  [not-in-schema, optional]
AURORA_PORT=5432

# EventBridge bus the log-event-publisher Lambda puts events on. The stack sets it on the function; the handler refuses to import without it.  [not-in-schema, optional]
EVENT_BUS_NAME=
