{
  "name": "@oxagen/env-manager",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "Local-only web UI to view env/secrets per environment and deploy the right values to the right Vercel project + environment. Requires a per-process access token and binds to 127.0.0.1.",
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 tsx --env-file-if-exists=../../.env.local src/server.ts",
    "start": "NODE_NO_WARNINGS=1 tsx --env-file-if-exists=../../.env.local src/server.ts",
    "pull": "NODE_NO_WARNINGS=1 tsx --env-file-if-exists=../../.env.local src/pull-secrets.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "NODE_NO_WARNINGS=1 vitest run",
    "test:coverage": "NODE_NO_WARNINGS=1 vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@oxagen/config": "workspace:*",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@types/node": "25.9.8",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
